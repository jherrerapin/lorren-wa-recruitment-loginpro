<!DOCTYPE html><html lang="es-CO"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title><%= pageTitle %> — LoginPro</title><link rel="icon" type="image/png" href="/public/favicon-loginpro.svg"/><link rel="stylesheet" href="/public/operaciones-nomina.css"/></head><body>
<nav class="navbar"><a href="/admin" class="brand"><img src="/public/loginpro.png" alt="LoginPro"/></a><a href="/admin">Panel</a><a href="/admin/operaciones">Operaciones / Despacho</a><a href="/admin/operaciones/asistencia">Asistencia</a><a href="/admin/operaciones/asistencia/nomina" class="active">Nómina</a><span class="spacer"></span><a href="/logout">Cerrar sesión</a></nav>
<main class="page"><% const selectedWorkerIds=String(report.filters.workerId||'').split(',').map((value)=>value.trim()).filter(Boolean); %>
<header class="header"><div><h1><%= pageTitle %></h1><p class="sub">Corte <%= report.period.from||'—' %> a <%= report.period.to||'—' %></p></div><div class="actions"><a class="btn" href="/admin/operaciones/asistencia">Asistencia</a><a class="btn btn-blue" href="/admin/operaciones/asistencia/nomina/export.csv?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">CSV</a><a class="btn btn-primary" href="/admin/operaciones/asistencia/nomina/export.xlsx?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">Excel</a></div></header>
<% if(success){ %><div class="alert alert-success"><%= success %></div><% } %><% if(error){ %><div class="alert alert-error"><%= error %></div><% } %><% if(role==='dev'&&report.filters.includeTest){ %><div class="test-mode"><span>Modo DEV activo: este cálculo incluye jornadas y sujetos de prueba.</span><div class="actions"><a class="btn" href="/admin/operaciones/pruebas">Volver al entorno de pruebas</a><a class="btn" href="/admin/operaciones/asistencia/nomina">Salir del modo de pruebas</a></div></div><% } %>
<section class="panel"><form method="get" action="/admin/operaciones/asistencia/nomina" class="filters" id="payroll-filters"><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %><div class="field"><label for="periodType">Tipo de corte</label><select id="periodType" name="periodType"><option value="WEEKLY" <%= report.period.periodType==='WEEKLY'?'selected':'' %>>Semanal</option><option value="BIWEEKLY" <%= report.period.periodType==='BIWEEKLY'?'selected':'' %>>Quincenal</option><option value="CUSTOM" <%= report.period.periodType==='CUSTOM'?'selected':'' %>>Personalizado</option></select></div><div class="field"><label>Fecha de referencia</label><input name="anchor" type="date" value="<%= report.period.anchor||report.period.from %>"/></div><div class="field custom-date"><label>Desde</label><input name="from" type="date" value="<%= report.period.from %>"/></div><div class="field custom-date"><label>Hasta</label><input name="to" type="date" value="<%= report.period.to %>"/></div><div class="field"><label for="clientId">Cliente</label><select id="clientId" name="clientId"><option value="">Todos</option><% for(const client of report.clients){ %><option value="<%= client.id %>" <%= report.filters.clientId===client.id?'selected':'' %>><%= client.name %></option><% } %></select></div><div class="field"><label for="operationPointId">Operación</label><select id="operationPointId" name="operationPointId"><option value="">Todas</option><% for(const client of report.clients){for(const point of client.operationPoints||[]){ %><option data-client="<%= client.id %>" value="<%= point.id %>" <%= report.filters.operationPointId===point.id?'selected':'' %>><%= client.name %> · <%= point.name %></option><% }} %></select></div><div class="field"><label for="workerId">Auxiliares</label><select id="workerId" name="workerId" multiple size="3"><% for(const worker of report.workers){ %><option value="<%= worker.id %>" <%= selectedWorkerIds.includes(worker.id)?'selected':'' %>><%= worker.fullName %><%= worker.documentNumber?` · ${worker.documentNumber}`:'' %></option><% } %></select><div class="field-hint">Solo aparecen auxiliares con información en este corte. Puedes seleccionar varios; sin selección se analizan todos.</div></div><div class="field"><label for="search">Buscar</label><input id="search" name="search" value="<%= report.filters.search %>" placeholder="Nombre, documento o teléfono"/></div><div class="field"><button class="btn btn-primary">Calcular periodo</button></div></form></section>
<section class="metrics"><article class="metric"><small>Auxiliares</small><strong><%= report.totals.workers %></strong></article><article class="metric"><small>Días trabajados</small><strong><%= report.totals.workedDays||0 %></strong></article><article class="metric deduction"><small>Días descontados</small><strong><%= report.totals.deductedDays||0 %></strong></article><article class="metric"><small>Días laborados netos</small><strong><%= report.totals.netWorkedDays||0 %></strong></article><article class="metric"><small>Total trabajado</small><strong><%= formatPayrollMinutes(report.totals.totalMinutes) %></strong></article><article class="metric"><small>Horas ordinarias</small><strong><%= report.totals.ordinaryHours||0 %></strong></article><article class="metric"><small>Horas extra</small><strong><%= report.totals.overtimeHours||0 %></strong></article><article class="metric <%= report.totals.workersWithNovelties?'warn':'' %>"><small>Con novedades</small><strong><%= report.totals.workersWithNovelties %></strong></article></section>
<%- include('partials/operacionesNominaTabla') %>
<section class="panel"><h2 style="margin-bottom:10px">Conceptos generados</h2><% const labels={HEDO:'Extra diurna ordinaria',HENO:'Extra nocturna ordinaria',HEDD:'Extra diurna dominical',HEND:'Extra nocturna dominical',HEDF:'Extra diurna festiva',HENF:'Extra nocturna festiva',RNO:'Recargo nocturno ordinario',RDD:'Recargo diurno dominical no compensado',RND:'Recargo nocturno dominical no compensado',RDF:'Recargo diurno festivo',RNF:'Recargo nocturno festivo',RDDC:'Recargo diurno dominical compensado',RNDC:'Recargo nocturno dominical compensado'}; %><div class="codes"><% for(const code of conceptCodes){ %><div class="code"><strong><%= code %></strong><small><%= labels[code] %></small></div><% } %></div></section></main>
<script>(()=>{const period=document.getElementById('periodType'),custom=document.querySelectorAll('.custom-date'),client=document.getElementById('clientId'),operation=document.getElementById('operationPointId');const syncPeriod=()=>{const show=period?.value==='CUSTOM';custom.forEach((item)=>{item.style.display=show?'flex':'none'})};const syncOperation=()=>{if(!client||!operation)return;[...operation.options].forEach((option,index)=>{if(index)option.hidden=Boolean(client.value&&option.dataset.client!==client.value)});if(operation.selectedOptions[0]?.hidden)operation.value=''};period?.addEventListener('change',syncPeriod);client?.addEventListener('change',syncOperation);syncPeriod();syncOperation()})()</script></body></html>