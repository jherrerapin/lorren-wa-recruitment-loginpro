<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Activar Portal del Auxiliar — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg:#f4f5f7; --surface:#fff; --surface-2:#f9fafb; --border:#e1e4e8; --text:#1a1d23; --muted:#6b7280; --navy:#1e2d3d; --teal:#0d7a6b; --teal-hover:#0a5f53; --amber:#92400e; --amber-light:#fef3c7; --red:#b91c1c; --red-light:#fee2e2; --green:#166534; --green-light:#dcfce7; --shadow:0 10px 28px rgba(15,23,42,.08); --font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
    body { font-family:var(--font); background:var(--bg); color:var(--text); min-height:100vh; }
    .navbar { background:var(--navy); min-height:52px; padding:0 24px; display:flex; align-items:center; gap:20px; }
    .navbar a { color:#cbd5e0; text-decoration:none; font-size:13px; font-weight:700; }
    .navbar a:hover { color:#fff; }
    .navbar .brand img { height:28px; display:block; }
    .navbar .spacer { flex:1; }
    .page { max-width:820px; margin:0 auto; padding:28px 20px 60px; display:grid; gap:18px; }
    .hero, .card { background:var(--surface); border:1px solid var(--border); border-radius:16px; box-shadow:var(--shadow); }
    .hero { padding:24px; display:flex; justify-content:space-between; gap:18px; align-items:flex-start; flex-wrap:wrap; background:linear-gradient(135deg,#fff 0%,#f0fdfa 100%); }
    .eyebrow { color:var(--teal); font-size:12px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; margin-bottom:8px; }
    h1 { color:var(--navy); font-size:28px; margin-bottom:8px; }
    h2 { color:var(--navy); font-size:18px; margin-bottom:8px; }
    p { color:var(--muted); line-height:1.6; }
    .card { padding:22px; }
    .field { display:flex; flex-direction:column; gap:7px; margin-top:16px; }
    label { font-size:12px; font-weight:900; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
    select, input { width:100%; border:1px solid var(--border); border-radius:10px; background:var(--surface-2); color:var(--text); padding:11px 12px; font-size:14px; }
    input[readonly] { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; }
    .actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:18px; }
    .btn { display:inline-flex; align-items:center; justify-content:center; min-height:38px; border:1px solid var(--border); border-radius:9px; padding:8px 14px; background:#fff; color:var(--navy); text-decoration:none; font-size:13px; font-weight:800; cursor:pointer; }
    .btn-primary { background:var(--teal); color:#fff; border-color:var(--teal); }
    .btn-primary:hover { background:var(--teal-hover); }
    .btn-danger { background:#fff; color:var(--red); border-color:#fecaca; }
    .btn:disabled { opacity:.55; cursor:not-allowed; }
    .alert { border-radius:10px; padding:12px 14px; margin-top:16px; font-size:13px; font-weight:700; }
    .alert-error { background:var(--red-light); color:var(--red); }
    .alert-success { background:var(--green-light); color:var(--green); }
    .alert-warning { background:var(--amber-light); color:var(--amber); }
    .hidden { display:none !important; }
    .result { margin-top:18px; border-top:1px solid var(--border); padding-top:18px; }
    .meta { font-size:13px; margin-top:8px; }
    .warning-box { margin-top:16px; padding:14px; border-radius:10px; background:var(--amber-light); color:var(--amber); font-size:13px; line-height:1.55; }
    .worker-state { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:12px; }
    .pill { display:inline-flex; align-items:center; min-height:28px; border-radius:999px; padding:5px 10px; font-size:12px; font-weight:850; }
    .pill-on { background:var(--green-light); color:var(--green); }
    .pill-off { background:#edf1f4; color:#596675; }
    .confirm-backdrop { position:fixed; inset:0; z-index:10020; display:none; align-items:center; justify-content:center; padding:18px; background:rgba(15,23,42,.52); backdrop-filter:blur(3px); }
    .confirm-backdrop.is-open { display:flex; }
    .confirm-card { width:min(460px,100%); overflow:hidden; border:1px solid #e1e6ef; border-radius:22px; background:#fff; box-shadow:0 28px 80px rgba(15,23,42,.28); opacity:0; transform:translateY(8px) scale(.98); transition:opacity .16s ease,transform .16s ease; }
    .confirm-backdrop.is-open .confirm-card { opacity:1; transform:translateY(0) scale(1); }
    .confirm-head { display:flex; gap:13px; align-items:flex-start; padding:20px 20px 12px; }
    .confirm-icon { width:42px; height:42px; flex:0 0 auto; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; font-size:22px; font-weight:900; background:#fef3c7; color:#b45309; }
    .confirm-backdrop[data-tone="danger"] .confirm-icon { background:#fff1f2; color:#be123c; }
    .confirm-title { margin:0; color:#172033; font-size:18px; line-height:1.2; font-weight:900; }
    .confirm-text { margin:7px 0 0; color:#64748b; font-size:13px; line-height:1.5; }
    .confirm-actions { display:flex; justify-content:flex-end; gap:9px; padding:15px 20px 20px; background:#f8fafc; border-top:1px solid #eef2f7; }
    .confirm-btn { min-height:38px; border-radius:999px; border:1px solid #d8e0ea; background:#fff; color:#172033; padding:8px 15px; font-weight:900; font-size:13px; cursor:pointer; box-shadow:0 1px 3px rgba(15,23,42,.08); }
    .confirm-btn:hover { border-color:var(--teal); color:var(--teal); }
    .confirm-ok { background:var(--teal); border-color:var(--teal); color:#fff; }
    .confirm-ok:hover { background:var(--teal-hover); border-color:var(--teal-hover); color:#fff; }
    .confirm-backdrop[data-tone="danger"] .confirm-ok { background:#be123c; border-color:#be123c; }
    .confirm-backdrop[data-tone="danger"] .confirm-ok:hover { background:#9f1239; border-color:#9f1239; }
    @media (max-width:640px) { .page { padding:18px 14px 42px; } .actions, .btn { width:100%; } .confirm-actions { display:grid; grid-template-columns:1fr; } .confirm-btn { width:100%; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/operaciones">Operaciones / Despacho</a>
    <span class="spacer"></span>
    <a href="/logout">Cerrar sesión</a>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Gestión de asistencia</div>
        <h1>Portal del Auxiliar</h1>
        <p>Genera el enlace para activar el celular del auxiliar.</p>
      </div>
      <a class="btn" href="/admin/operaciones/personal">Volver a Personal operativo</a>
    </section>

    <section class="card">
      <h2>Seleccionar auxiliar</h2>
      <% if (typeof loadError !== 'undefined' && loadError) { %>
        <div class="alert alert-error"><%= loadError %></div>
      <% } %>

      <form id="activation-form">
        <div class="field">
          <label for="workerId">Auxiliar</label>
          <select id="workerId" name="workerId" required <%= workers.length ? '' : 'disabled' %>>
            <option value="">Selecciona un auxiliar</option>
            <% workers.forEach((worker) => { %>
              <option
                value="<%= worker.id %>"
                data-worker-name="<%= worker.fullName %>"
                data-biometric-enrolled="<%= worker.biometric?.enrolled ? 'true' : 'false' %>"
              ><%= worker.label %><%= worker.isTestProfile ? ' · PERFIL DE PRUEBA' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div id="worker-state" class="worker-state hidden">
          <span id="biometric-pill" class="pill pill-off">Registro facial pendiente en el portal</span>
        </div>
        <div class="actions">
          <button class="btn btn-primary" id="generate-button" type="submit" <%= workers.length ? '' : 'disabled' %>>Generar enlace</button>
          <button class="btn btn-danger hidden" id="revoke-button" type="button">Eliminar rostro registrado</button>
        </div>
      </form>

      <div id="status" class="alert hidden" role="status" aria-live="polite"></div>

      <div id="result" class="result hidden">
        <h2>Enlace generado</h2>
        <p id="worker-name"></p>
        <div class="field">
          <label for="activation-url">Enlace completo</label>
          <input id="activation-url" type="text" readonly autocomplete="off" spellcheck="false" />
        </div>
        <p id="expires-at" class="meta"></p>
        <div class="actions"><button class="btn btn-primary" id="copy-button" type="button">Copiar enlace</button></div>
        <div class="warning-box">Envía este enlace al celular que usará el auxiliar.</div>
      </div>
    </section>
  </main>

  <div id="portal-confirm-dialog" class="confirm-backdrop" data-tone="warning" role="alertdialog" aria-modal="true" aria-labelledby="portal-confirm-title" aria-describedby="portal-confirm-text">
    <section class="confirm-card">
      <div class="confirm-head">
        <div class="confirm-icon" aria-hidden="true">!</div>
        <div>
          <h2 class="confirm-title" id="portal-confirm-title">Confirmar acción</h2>
          <p class="confirm-text" id="portal-confirm-text">¿Deseas continuar?</p>
        </div>
      </div>
      <div class="confirm-actions">
        <button class="confirm-btn" type="button" data-confirm-cancel>Cancelar</button>
        <button class="confirm-btn confirm-ok" type="button" data-confirm-ok>Continuar</button>
      </div>
    </section>
  </div>

  <script>
    (() => {
      const form = document.getElementById('activation-form');
      const workerSelect = document.getElementById('workerId');
      const generateButton = document.getElementById('generate-button');
      const revokeButton = document.getElementById('revoke-button');
      const workerState = document.getElementById('worker-state');
      const biometricPill = document.getElementById('biometric-pill');
      const status = document.getElementById('status');
      const result = document.getElementById('result');
      const workerName = document.getElementById('worker-name');
      const activationUrl = document.getElementById('activation-url');
      const expiresAt = document.getElementById('expires-at');
      const copyButton = document.getElementById('copy-button');
      const confirmDialog = document.getElementById('portal-confirm-dialog');
      const confirmTitle = document.getElementById('portal-confirm-title');
      const confirmText = document.getElementById('portal-confirm-text');
      const confirmOk = confirmDialog?.querySelector('[data-confirm-ok]');
      const confirmCancel = confirmDialog?.querySelector('[data-confirm-cancel]');

      function showStatus(message, type) {
        status.textContent = message;
        status.className = `alert ${type === 'success' ? 'alert-success' : type === 'warning' ? 'alert-warning' : 'alert-error'}`;
      }

      function askConfirmation(options = {}) {
        if (!confirmDialog || !confirmTitle || !confirmText || !confirmOk || !confirmCancel) return Promise.resolve(false);
        const previousFocus = document.activeElement;
        confirmTitle.textContent = options.title || 'Confirmar acción';
        confirmText.textContent = options.text || '¿Deseas continuar?';
        confirmOk.textContent = options.confirmLabel || 'Continuar';
        confirmCancel.textContent = options.cancelLabel || 'Cancelar';
        confirmDialog.dataset.tone = options.tone === 'danger' ? 'danger' : 'warning';
        confirmDialog.classList.add('is-open');
        confirmCancel.focus();

        return new Promise((resolve) => {
          let settled = false;
          const close = (value) => {
            if (settled) return;
            settled = true;
            confirmDialog.classList.remove('is-open');
            confirmOk.removeEventListener('click', accept);
            confirmCancel.removeEventListener('click', cancel);
            confirmDialog.removeEventListener('click', backdrop);
            document.removeEventListener('keydown', escape);
            if (previousFocus instanceof HTMLElement) previousFocus.focus();
            resolve(value);
          };
          const accept = () => close(true);
          const cancel = () => close(false);
          const backdrop = (event) => { if (event.target === confirmDialog) close(false); };
          const escape = (event) => { if (event.key === 'Escape') close(false); };
          confirmOk.addEventListener('click', accept);
          confirmCancel.addEventListener('click', cancel);
          confirmDialog.addEventListener('click', backdrop);
          document.addEventListener('keydown', escape);
        });
      }

      function selectedOption() { return workerSelect.options[workerSelect.selectedIndex] || null; }
      function selectedWorkerId() { return workerSelect.value || ''; }
      function biometricEnrolled() { return selectedOption()?.dataset.biometricEnrolled === 'true'; }

      function renderWorkerState() {
        const selected = Boolean(selectedWorkerId());
        workerState.classList.toggle('hidden', !selected);
        if (!selected) return;
        const enrolled = biometricEnrolled();
        biometricPill.textContent = enrolled ? 'Rostro registrado' : 'Registro facial pendiente en el portal';
        biometricPill.className = `pill ${enrolled ? 'pill-on' : 'pill-off'}`;
        revokeButton.classList.toggle('hidden', !enrolled);
      }

      function mobileSafeActivationUrl(rawUrl) {
        const url = new URL(rawUrl, window.location.origin);
        const fragmentParams = new URLSearchParams(url.hash.startsWith('#') ? url.hash.slice(1) : url.hash);
        const token = fragmentParams.get('token');
        if (token) { url.searchParams.set('token', token); url.hash = ''; }
        return url.toString();
      }

      workerSelect.addEventListener('change', renderWorkerState);

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const workerId = selectedWorkerId();
        if (!workerId) return showStatus('Selecciona un auxiliar.', 'error');
        const confirmed = await askConfirmation({
          title: 'Generar nuevo enlace',
          text: 'Se revocará cualquier enlace pendiente anterior para este auxiliar.',
          confirmLabel: 'Sí, generar enlace',
          tone: 'warning'
        });
        if (!confirmed) return;
        generateButton.disabled = true;
        result.classList.add('hidden');
        showStatus('Generando enlace…', 'warning');
        try {
          const response = await fetch('/admin/operaciones/portal-activaciones/emitir', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'attendance-admin' },
            body: JSON.stringify({ workerId })
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok || !payload.ok || !payload.activationUrl) throw new Error('activation_failed');
          activationUrl.value = mobileSafeActivationUrl(payload.activationUrl);
          workerName.textContent = `Auxiliar: ${payload.worker.fullName}`;
          const expiry = new Date(payload.expiresAt);
          expiresAt.textContent = Number.isNaN(expiry.getTime()) ? '' : `Vence: ${expiry.toLocaleString('es-CO')}`;
          result.classList.remove('hidden');
          showStatus('Enlace generado.', 'success');
        } catch {
          showStatus('No fue posible generar el enlace.', 'error');
        } finally {
          generateButton.disabled = false;
        }
      });

      revokeButton.addEventListener('click', async () => {
        if (!selectedWorkerId()) return;
        const confirmed = await askConfirmation({
          title: 'Eliminar rostro registrado',
          text: 'Se eliminará la plantilla facial vigente. El auxiliar deberá registrar nuevamente su rostro desde el portal.',
          confirmLabel: 'Sí, eliminar rostro',
          tone: 'danger'
        });
        if (!confirmed) return;
        revokeButton.disabled = true;
        try {
          const response = await fetch('/admin/operaciones/portal-activaciones/biometria/revocar', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'attendance-admin' },
            body: JSON.stringify({ workerId: selectedWorkerId() })
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok || !payload.ok) throw new Error('biometric_revocation_failed');
          selectedOption().dataset.biometricEnrolled = 'false';
          renderWorkerState();
          showStatus('Rostro eliminado. El auxiliar deberá registrarlo nuevamente desde su portal.', 'success');
        } catch {
          showStatus('No fue posible eliminar el rostro.', 'error');
        } finally {
          revokeButton.disabled = false;
        }
      });

      copyButton?.addEventListener('click', async () => {
        if (!activationUrl.value) return;
        try {
          await navigator.clipboard.writeText(activationUrl.value);
          showStatus('Enlace copiado.', 'success');
        } catch {
          activationUrl.focus();
          activationUrl.select();
          showStatus('El enlace quedó seleccionado para copiarlo.', 'warning');
        }
      });

      renderWorkerState();
    })();
  </script>
</body>
</html>
