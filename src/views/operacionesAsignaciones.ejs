<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Asignación operativa — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .board-layout { display: grid; grid-template-columns: 360px minmax(300px, 1fr) 430px; gap: 16px; align-items: start; }
    .board-panel { background: #fff; border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-sm); overflow: hidden; min-height: 420px; }
    .board-panel-head { padding: 16px 18px; border-bottom: 1px solid #edf2f7; background: #fff; }
    .board-panel-head h2 { color: var(--navy); font-size: 16px; margin-bottom: 4px; }
    .board-panel-head p { color: var(--muted); font-size: 13px; }
    .filters { display: grid; gap: 10px; padding: 14px; border-bottom: 1px solid #edf2f7; background: var(--surface-2); }
    .filters-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .worker-list, .request-list { max-height: calc(100vh - 360px); min-height: 360px; overflow-y: auto; padding: 12px; display: grid; gap: 10px; align-content: start; }
    .worker-card, .request-card, .assigned-card, .template-card, .incident-card { border: 1px solid var(--border); border-radius: 14px; background: #fff; padding: 12px; box-shadow: var(--shadow-sm); }
    .worker-card { cursor: grab; }
    .worker-card.same-day-assignment { border-color: #f59e0b; background: #fffbeb; box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.14), var(--shadow-sm); }
    .worker-card.same-day-assignment:hover { border-color: #d97706; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2), var(--shadow); }
    .worker-card:active { cursor: grabbing; }
    .worker-card[hidden] { display: none; }
    .worker-card strong, .request-card strong, .assigned-card strong, .incident-card strong { color: var(--navy); display: block; font-size: 14px; margin-bottom: 4px; }
    .meta { color: var(--muted); font-size: 12px; display: grid; gap: 2px; }
    .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
    .chip { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 8px; font-size: 10px; font-weight: 900; background: var(--blue-soft); color: var(--blue); }
    .chip.same-day-assignment { background: var(--amber-soft); color: var(--amber); }
    .request-card { color: inherit; display: block; }
    .request-card:hover, .request-card.active { border-color: var(--teal); box-shadow: var(--shadow); }
    .request-card.active { background: #f0fdfa; }
    .request-card .top { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
    .status-pill { display: inline-flex; border-radius: 999px; padding: 4px 8px; font-size: 10px; font-weight: 900; background: var(--amber-soft); color: var(--amber); white-space: nowrap; }
    .status-pill.complete { background: var(--green-soft); color: var(--green); }
    .request-actions, .assigned-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .request-actions form, .assigned-actions form { margin: 0; }
    .assignment-body { padding: 16px; display: grid; gap: 14px; }
    .selected-summary { border: 1px solid var(--border); background: var(--surface-2); border-radius: 14px; padding: 14px; }
    .drop-zone { border: 2px dashed #b6c2d2; border-radius: 16px; padding: 22px; min-height: 118px; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--muted); background: #fbfdff; font-weight: 800; }
    .drop-zone.drag-over { border-color: var(--teal); background: #f0fdfa; color: var(--teal); }
    .drop-zone.disabled { border-color: var(--green); background: var(--green-soft); color: var(--green); cursor: not-allowed; }
    .assigned-list { display: grid; gap: 10px; }
    .assigned-card { display: grid; gap: 10px; }
    .template-card textarea, .incident-card textarea, .assignment-message { width: 100%; min-height: 84px; border: 1px solid var(--border); border-radius: 10px; padding: 10px; font: inherit; resize: vertical; }
    .variable-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
    .variable-btn { border: 1px solid var(--border); background: var(--surface-2); color: var(--navy); border-radius: 999px; padding: 5px 9px; font-size: 11px; font-weight: 800; cursor: pointer; }
    .template-actions { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .internal-request { margin-top: 16px; }
    .internal-request summary { cursor: pointer; font-weight: 900; color: var(--navy); }
    .internal-request[open] { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 16px; box-shadow: var(--shadow-sm); }
    @media (max-width: 1180px) { .board-layout { grid-template-columns: 1fr; } .worker-list, .request-list { max-height: 480px; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Tablero de asignación</div>
        <h1>Asignación operativa</h1>
        <p>Selecciona una solicitud. El listado de auxiliares se ajusta automáticamente por la ciudad de la solicitud.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones">Volver a Operaciones</a>
        <a class="btn" href="/admin/operaciones/solicitudes">Solicitudes de servicio</a>
        <a class="btn" href="/admin/operaciones/novedades">Novedades</a>
        <a class="btn" href="/admin/operaciones/clientes">Clientes</a>
        <a class="btn" href="/admin/operaciones/personal">Personal operativo</a>
      </div>
    </section>

    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <% const assignedWorkerIds = new Set(selectedServiceRequest ? selectedServiceRequest.assignments.map((assignment) => assignment.workerId) : []); const availableWorkers = workers.filter((worker) => !assignedWorkerIds.has(worker.id)); %>

    <section class="board-layout">
      <aside class="board-panel workers-panel">
        <div class="board-panel-head">
          <h2>Auxiliares disponibles</h2>
          <p id="cityAutoFilterText">Selecciona una solicitud para aplicar filtro automático por ciudad.</p>
        </div>
        <form class="filters" method="get" action="/admin/operaciones/asignaciones">
          <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
          <div class="field"><label for="q">Buscar</label><input id="q" name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" /></div>
          <div class="filters-row">
            <div class="field"><label for="operationalCityId">Ciudad manual</label><select id="operationalCityId" name="operationalCityId"><option value="">Todas</option><% cities.forEach((city)=>{ %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select></div>
            <div class="field"><label for="locality">Localidad</label><select id="locality" name="locality"><option value="">Todas</option><% localities.forEach((item)=>{ %><option value="<%= item %>" <%= filters.locality===item?'selected':'' %>><%= item %></option><% }) %></select></div>
          </div>
          <div class="field"><label for="transportMode">Transporte</label><select id="transportMode" name="transportMode"><option value="">Todos</option><% transportModes.forEach((item)=>{ %><option value="<%= item %>" <%= filters.transportMode===item?'selected':'' %>><%= item %></option><% }) %></select></div>
          <div class="field"><label for="status">Estado</label><select id="status" name="status"><option value="">Todos</option><option value="AVAILABLE" <%= filters.status==='AVAILABLE'?'selected':'' %>>Disponible</option><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>Activo</option><option value="INACTIVE" <%= filters.status==='INACTIVE'?'selected':'' %>>Inactivo</option></select></div>
          <button class="btn btn-primary" type="submit">Filtrar auxiliares</button>
        </form>

        <div class="worker-list" id="workerList">
          <% if (!availableWorkers.length) { %>
            <div class="empty"><strong>No hay auxiliares disponibles con esos filtros.</strong>Si ya fueron asignados a esta solicitud, aparecerán en la columna de asignación. Si los quitas, vuelven a este listado.</div>
          <% } %>
          <div id="autoFilterEmpty" class="empty" hidden><strong>No hay auxiliares para la ciudad de esta solicitud.</strong>Revisa ciudades operativas, vacantes asignadas o ajusta filtros manuales.</div>
          <% availableWorkers.forEach((worker)=>{ const workerCityNames = worker.cities.map((entry)=>entry.city.name).join('|'); const vacancyCityNames = worker.vacancies.map((entry)=>entry.vacancy.city || '').join('|'); const hasSameDayAssignment = assignedWorkerIdsOnSelectedDate.has(worker.id); %>
            <article class="worker-card<%= hasSameDayAssignment ? ' same-day-assignment' : '' %>" draggable="true" data-worker-id="<%= worker.id %>" data-worker-cities="<%= workerCityNames %>" data-vacancy-cities="<%= vacancyCityNames %>">
              <strong><%= worker.fullName %></strong>
              <div class="meta">
                <span>Tel: <%= worker.phone || '-' %></span>
                <span>Doc: <%= [worker.documentType, worker.documentNumber].filter(Boolean).join(' ') || '-' %></span>
                <span>Ubicación: <%= worker.residenceCity || '-' %> · <%= worker.residenceLocality || '-' %></span>
                <span>Transporte: <%= worker.transportMode || '-' %></span>
              </div>
              <div class="chips">
                <% if (hasSameDayAssignment) { %><span class="chip same-day-assignment" title="Este auxiliar ya tiene otra asignación activa en la fecha seleccionada, pero puedes volver a asignarlo.">● Asignado en otra solicitud este día</span><% } %>
                <% worker.cities.slice(0,3).forEach((entry)=>{ %><span class="chip"><%= entry.city.name %></span><% }) %>
                <% worker.vacancies.slice(0,2).forEach((entry)=>{ %><span class="chip"><%= entry.vacancy.title %><% if (entry.vacancy.city) { %> — <%= entry.vacancy.city %><% } %></span><% }) %>
              </div>
            </article>
          <% }) %>
        </div>
      </aside>

      <aside class="board-panel requests-panel">
        <div class="board-panel-head">
          <h2>Solicitudes de servicio</h2>
          <p>Elige la solicitud sobre la que vas a trabajar.</p>
        </div>
        <div class="request-list">
          <% if (!serviceRequests.length) { %><div class="empty"><strong>No hay solicitudes.</strong>Crea clientes y comparte links públicos para recibir solicitudes.</div><% } %>
          <% serviceRequests.forEach((request)=>{ const assignedCount = request.assignments.length; const complete = assignedCount >= request.requiredWorkers; %>
            <article class="request-card <%= selectedServiceRequestId===request.id?'active':'' %>">
              <div class="top"><strong><%= request.clientName %></strong><span class="status-pill <%= complete ? 'complete' : '' %>"><%= request.status %></span></div>
              <div class="meta">
                <span><%= request.operationPointName || 'Sin punto' %> · <%= request.cityName || 'Sin ciudad' %></span>
                <span>Servicio: <%= request.serviceName || request.service?.name || 'Sin servicio' %></span>
                <span><%= new Date(request.serviceDate).toISOString().slice(0,10) %> · <%= request.startTime || '-' %> - <%= request.endTime || '-' %></span>
                <span>Asignados: <%= assignedCount %> / <%= request.requiredWorkers %></span>
              </div>
              <div class="request-actions">
                <a class="btn" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">Seleccionar</a>
                <a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a>
                <form method="post" action="/admin/operaciones/solicitudes/<%= request.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta solicitud de servicio?');"><button class="btn" type="submit">Eliminar</button></form>
              </div>
            </article>
          <% }) %>
        </div>
      </aside>

      <aside class="board-panel assignment-panel">
        <div class="board-panel-head"><h2>Asignación</h2><p>Arrastra auxiliares aquí para guardar la asignación.</p></div>
        <div class="assignment-body">
          <% if (selectedServiceRequest) { const selectedAssignedCount = selectedServiceRequest.assignments.length; const remainingWorkers = Math.max(selectedServiceRequest.requiredWorkers - selectedAssignedCount, 0); const selectedRequestComplete = remainingWorkers === 0; %>
            <div class="selected-summary" id="selectedRequestSummary" data-request-city="<%= selectedServiceRequest.cityName || '' %>">
              <strong><%= selectedServiceRequest.clientName %></strong>
              <div class="meta">
                <span><%= selectedServiceRequest.operationPointName || 'Sin punto' %> · <%= selectedServiceRequest.cityName || 'Sin ciudad' %></span>
                <span>Servicio: <%= selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || 'Sin servicio' %></span>
                <span><%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %> · <%= selectedServiceRequest.startTime || '-' %> - <%= selectedServiceRequest.endTime || '-' %></span>
                <span>Requeridos: <%= selectedServiceRequest.requiredWorkers %> · Asignados: <%= selectedAssignedCount %></span>
                <span><%= selectedRequestComplete ? 'Solicitud completa. No se pueden asignar más auxiliares.' : `Faltan ${remainingWorkers} auxiliares` %></span>
              </div>
            </div>
            <div id="assignmentDropZone" class="drop-zone <%= selectedRequestComplete ? 'disabled' : '' %>" data-disabled="<%= selectedRequestComplete ? 'true' : 'false' %>"><%= selectedRequestComplete ? 'Solicitud completa. No se pueden asignar más auxiliares.' : `Faltan ${remainingWorkers} auxiliares. Arrastra un auxiliar aquí para asignarlo a esta solicitud.` %></div>
            <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign"><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><input type="hidden" id="assignWorkerId" name="workerId" /></form>

            <% if (selectedRequestComplete) { %>
              <section class="template-card">
                <strong>Mensaje base para WhatsApp</strong>
                <p class="muted">Puedes editar la plantilla general o modificar el texto individual en cada auxiliar. Las variables se reemplazan antes de abrir WhatsApp.</p>
                <textarea id="globalTemplate">Cargando plantilla...</textarea>
                <div class="variable-row" data-target="globalTemplate">
                  <button type="button" class="variable-btn" data-var="{{nombre}}">Nombre</button><button type="button" class="variable-btn" data-var="{{cliente}}">Cliente</button><button type="button" class="variable-btn" data-var="{{operacion}}">Operación</button><button type="button" class="variable-btn" data-var="{{direccion}}">Dirección</button><button type="button" class="variable-btn" data-var="{{fecha}}">Fecha</button><button type="button" class="variable-btn" data-var="{{horaInicio}}">Hora inicio</button><button type="button" class="variable-btn" data-var="{{horaFin}}">Hora fin</button><button type="button" class="variable-btn" data-var="{{servicio}}">Servicio</button><button type="button" class="variable-btn" data-var="{{ciudad}}">Ciudad</button>
                </div>
                <div class="template-actions"><button class="btn" id="resetIndividualMessages" type="button">Aplicar plantilla a todos</button><button class="btn btn-primary" id="saveTemplate" type="button">Guardar plantilla general</button></div>
              </section>
            <% } %>

            <div class="assigned-list">
              <% if (!selectedServiceRequest.assignments.length) { %><div class="empty"><strong>Sin auxiliares asignados.</strong>Arrastra auxiliares disponibles para cubrir la solicitud.</div><% } %>
              <% selectedServiceRequest.assignments.forEach((assignment)=>{ const workerPhone = assignment.worker.phone || ''; %>
                <article class="assigned-card" data-assignment-id="<%= assignment.id %>" data-worker-id="<%= assignment.worker.id %>" data-worker-name="<%= assignment.worker.fullName %>" data-worker-phone="<%= workerPhone %>" data-client="<%= selectedServiceRequest.clientName || '' %>" data-operation="<%= selectedServiceRequest.operationPointName || '' %>" data-address="<%= selectedServiceRequest.address || '' %>" data-city="<%= selectedServiceRequest.cityName || '' %>" data-service="<%= selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || '' %>" data-date="<%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %>" data-start="<%= selectedServiceRequest.startTime || '' %>" data-end="<%= selectedServiceRequest.endTime || '' %>">
                  <div><strong><%= assignment.worker.fullName %></strong><div class="meta"><span><%= assignment.worker.phone || 'Sin teléfono' %></span><span><%= assignment.status %></span></div></div>
                  <% if (selectedRequestComplete) { %>
                    <textarea class="assignment-message" placeholder="Mensaje individual para este auxiliar"></textarea>
                    <div class="variable-row"><button type="button" class="variable-btn" data-var="{{nombre}}">Nombre</button><button type="button" class="variable-btn" data-var="{{operacion}}">Operación</button><button type="button" class="variable-btn" data-var="{{direccion}}">Dirección</button><button type="button" class="variable-btn" data-var="{{horaInicio}}">Hora inicio</button><button type="button" class="variable-btn" data-var="{{servicio}}">Servicio</button></div>
                  <% } %>
                  <div class="assigned-actions">
                    <% if (selectedRequestComplete) { %><a class="btn btn-primary whatsapp-link" target="_blank" rel="noopener">WhatsApp</a><% } %>
                    <details class="incident-card"><summary>Crear novedad</summary><form method="post" action="/admin/operaciones/asignaciones/novedades"><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="workerId" value="<%= assignment.worker.id %>" /><div class="field"><label>Tipo</label><select name="type" required><option value="NO_SHOW">No llegó</option><option value="CANCELACION">Cancelación</option><option value="REEMPLAZO">Requiere reemplazo</option><option value="CLIENTE_REPORTA">Reporte del cliente</option><option value="OTRA">Otra</option></select></div><div class="field"><label>Descripción</label><textarea name="description" required></textarea></div><button class="btn" type="submit">Guardar novedad</button></form></details>
                    <form method="post" action="/admin/operaciones/asignaciones/unassign"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">Quitar</button></form>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty"><strong>Selecciona una solicitud.</strong>Necesitas una solicitud activa antes de asignar auxiliares.</div>
            <div id="assignmentDropZone" class="drop-zone">Selecciona una solicitud antes de asignar auxiliares.</div>
          <% } %>
        </div>
      </aside>
    </section>

    <% if (role === 'dev') { %>
      <details class="internal-request"><summary>Crear solicitud interna de prueba</summary><p class="muted" style="margin:8px 0 14px;">Uso interno temporal. Puedes seleccionar un servicio configurado por cliente para dejar la solicitud clasificada.</p><form method="post" action="/admin/operaciones/asignaciones/solicitudes"><div class="form-grid"><div class="field"><label>Cliente</label><input name="clientName" required /></div><div class="field"><label>Operación / punto</label><input name="operationPointName" /></div><div class="field"><label>Servicio del cliente</label><select name="serviceId"><option value="">Sin servicio configurado</option><% clients.forEach((client)=>{ if (client.services.length) { %><optgroup label="<%= client.name %>"><% client.services.forEach((service)=>{ %><option value="<%= service.id %>"><%= service.name %></option><% }) %></optgroup><% } }) %></select></div><div class="field"><label>Ciudad</label><input name="cityName" /></div><div class="field"><label>Dirección</label><input name="address" /></div><div class="field"><label>Fecha</label><input type="date" name="serviceDate" required /></div><div class="field"><label>Auxiliares requeridos</label><input type="number" name="requiredWorkers" min="1" required /></div><div class="field"><label>Hora inicio</label><input type="time" name="startTime" /></div><div class="field"><label>Hora fin</label><input type="time" name="endTime" /></div><div class="field full"><label>Notas</label><textarea name="notes"></textarea></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Crear solicitud interna</button></div></form></details>
    <% } %>
  </main>

  <script>
    const dropZone = document.getElementById('assignmentDropZone');
    const assignForm = document.getElementById('assignForm');
    const assignWorkerId = document.getElementById('assignWorkerId');
    const hasSelectedRequest = Boolean('<%= selectedServiceRequestId %>');
    const isDropZoneDisabled = dropZone?.dataset.disabled === 'true';
    const selectedRequestSummary = document.getElementById('selectedRequestSummary');
    const selectedRequestCity = selectedRequestSummary?.dataset.requestCity || '';
    const cityAutoFilterText = document.getElementById('cityAutoFilterText');
    const autoFilterEmpty = document.getElementById('autoFilterEmpty');
    const normalizeCity = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();
    const compatibleCitiesForRequest = (cityName) => { const normalized = normalizeCity(cityName); if (!normalized) return []; if (normalized === 'siberia') return ['siberia', 'bogota', 'bogota d.c.', 'bogota dc', 'madrid', 'funza', 'mosquera']; return [normalized]; };
    function applyAutomaticCityFilter() { const allowedCities = compatibleCitiesForRequest(selectedRequestCity); const workerCards = Array.from(document.querySelectorAll('.worker-card')); if (!allowedCities.length) { if (cityAutoFilterText) cityAutoFilterText.textContent = 'Selecciona una solicitud para aplicar filtro automático por ciudad.'; if (autoFilterEmpty) autoFilterEmpty.hidden = true; return; } let visibleCount = 0; workerCards.forEach((card) => { const workerCities = String(card.dataset.workerCities || '').split('|').map(normalizeCity).filter(Boolean); const vacancyCities = String(card.dataset.vacancyCities || '').split('|').map(normalizeCity).filter(Boolean); const isVisible = workerCities.some((city) => allowedCities.includes(city)) || vacancyCities.some((city) => allowedCities.includes(city)); card.hidden = !isVisible; if (isVisible) visibleCount += 1; }); if (cityAutoFilterText) cityAutoFilterText.textContent = selectedRequestCity ? `Filtro automático aplicado por ciudad: ${selectedRequestCity}${normalizeCity(selectedRequestCity) === 'siberia' ? ' (incluye Bogotá, Madrid, Funza y Mosquera)' : ''}.` : 'Selecciona una solicitud para aplicar filtro automático por ciudad.'; if (autoFilterEmpty) autoFilterEmpty.hidden = visibleCount > 0; }
    document.querySelectorAll('.worker-card[draggable="true"]').forEach((card) => { card.addEventListener('dragstart', (event) => { event.dataTransfer.setData('text/plain', card.dataset.workerId); }); });
    applyAutomaticCityFilter();
    if (dropZone) { dropZone.addEventListener('dragover', (event) => { if (isDropZoneDisabled) return; event.preventDefault(); dropZone.classList.add('drag-over'); }); dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over')); dropZone.addEventListener('drop', (event) => { event.preventDefault(); dropZone.classList.remove('drag-over'); if (isDropZoneDisabled) { alert('Solicitud completa. No se pueden asignar más auxiliares.'); return; } if (!hasSelectedRequest || !assignForm || !assignWorkerId) { alert('Selecciona una solicitud antes de asignar auxiliares.'); return; } const workerId = event.dataTransfer.getData('text/plain'); if (!workerId) return; assignWorkerId.value = workerId; assignForm.submit(); }); }

    const defaultTemplate = 'Hola {{nombre}}, te confirmamos asignacion para {{fecha}} en {{operacion}}. Direccion: {{direccion}}. Horario: {{horaInicio}} - {{horaFin}}. Servicio: {{servicio}}. Cliente: {{cliente}}. Por favor confirma recibido.';
    const globalTemplate = document.getElementById('globalTemplate');
    const assignedCards = Array.from(document.querySelectorAll('.assigned-card'));
    function replaceVariables(template, card) { const values = { nombre: card.dataset.workerName || '', cliente: card.dataset.client || '', operacion: card.dataset.operation || '', direccion: card.dataset.address || '', ciudad: card.dataset.city || '', servicio: card.dataset.service || '', fecha: card.dataset.date || '', horaInicio: card.dataset.start || '', horaFin: card.dataset.end || '' }; return String(template || '').replace(/{{\s*(nombre|cliente|operacion|direccion|ciudad|servicio|fecha|horaInicio|horaFin)\s*}}/g, (_, key) => values[key] || ''); }
    function normalizePhone(phone) { const digits = String(phone || '').replace(/\D/g, ''); if (!digits) return ''; if (digits.startsWith('57')) return digits; if (digits.length === 10) return `57${digits}`; return digits; }
    function refreshWhatsappLinks() { assignedCards.forEach((card) => { const textarea = card.querySelector('.assignment-message'); const link = card.querySelector('.whatsapp-link'); if (!textarea || !link) return; const message = replaceVariables(textarea.value || globalTemplate?.value || defaultTemplate, card); const phone = normalizePhone(card.dataset.workerPhone); link.href = phone ? `https://wa.me/${phone}?text=${encodeURIComponent(message)}` : `https://wa.me/?text=${encodeURIComponent(message)}`; }); }
    async function loadTemplate() { if (!globalTemplate) return; try { const response = await fetch('/admin/operaciones/api/asignacion-template'); const data = await response.json(); globalTemplate.value = data.content || defaultTemplate; } catch (_error) { globalTemplate.value = defaultTemplate; } assignedCards.forEach((card) => { const textarea = card.querySelector('.assignment-message'); if (textarea) textarea.value = globalTemplate.value; }); refreshWhatsappLinks(); }
    document.querySelectorAll('.variable-btn').forEach((button) => { button.addEventListener('click', () => { const container = button.closest('.variable-row'); const targetId = container?.dataset.target; const target = targetId ? document.getElementById(targetId) : button.closest('.assigned-card')?.querySelector('.assignment-message'); if (!target) return; const start = target.selectionStart || target.value.length; const end = target.selectionEnd || target.value.length; target.value = `${target.value.slice(0, start)}${button.dataset.var}${target.value.slice(end)}`; target.focus(); target.selectionStart = target.selectionEnd = start + button.dataset.var.length; refreshWhatsappLinks(); }); });
    document.querySelectorAll('.assignment-message').forEach((textarea) => textarea.addEventListener('input', refreshWhatsappLinks));
    globalTemplate?.addEventListener('input', refreshWhatsappLinks);
    document.getElementById('resetIndividualMessages')?.addEventListener('click', () => { assignedCards.forEach((card) => { const textarea = card.querySelector('.assignment-message'); if (textarea && globalTemplate) textarea.value = globalTemplate.value; }); refreshWhatsappLinks(); });
    document.getElementById('saveTemplate')?.addEventListener('click', async () => { if (!globalTemplate) return; const response = await fetch('/admin/operaciones/asignaciones/template', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content: globalTemplate.value }) }); alert(response.ok ? 'Plantilla guardada.' : 'No fue posible guardar la plantilla.'); });
    loadTemplate();
  </script>
</body>
</html>
