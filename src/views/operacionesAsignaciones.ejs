<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Asignación operativa — LoginPro</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: #f3f6fb; color: #0f172a; }
    .navbar { display:flex; align-items:center; gap:16px; padding:12px 20px; background:#0b1220; color:#fff; }
    .navbar a { color:#d8e2ff; text-decoration:none; font-weight:600; }
    .navbar .brand img { width:120px; height:auto; display:block; }
    .nav-active { color:#fff !important; }
    .navbar form { margin-left:auto; }
    .navbar button { background:#1f2a44; border:1px solid #364870; color:#fff; border-radius:8px; padding:8px 12px; cursor:pointer; }

    .page { max-width: 1400px; margin: 0 auto; padding: 20px; }
    .page-header { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:16px; }
    .page-header h1 { margin:0; font-size:28px; }
    .page-header p { margin:4px 0 0; color:#475569; }
    .secondary-btn { border:1px solid #cbd5e1; background:#fff; color:#0f172a; padding:10px 14px; border-radius:10px; text-decoration:none; font-weight:600; }
    .flash { background:#dcfce7; border:1px solid #86efac; color:#166534; padding:10px 12px; border-radius:10px; margin-bottom:16px; }

    .board-layout { display:grid; grid-template-columns: 1.2fr 1fr 1fr; gap:16px; align-items:start; }
    .workers-panel, .requests-panel, .assignment-panel, .filter-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:0 4px 16px rgba(15,23,42,.05); }
    .panel-header { padding:14px 16px; border-bottom:1px solid #eef2f7; }
    .panel-header h2, .panel-header h3 { margin:0; font-size:18px; }
    .panel-content { padding:14px 16px; }

    .filter-card form { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:8px; }
    .filter-card input, .filter-card select { width:100%; padding:9px 10px; border:1px solid #cbd5e1; border-radius:8px; font-size:13px; }
    .filter-card button { grid-column: span 2; padding:10px; border:none; border-radius:8px; background:#1d4ed8; color:#fff; font-weight:700; cursor:pointer; }

    .worker-list, .request-list, .assigned-list { display:flex; flex-direction:column; gap:10px; }
    .worker-card, .request-card, .assigned-worker { border:1px solid #dbe3ef; border-radius:12px; padding:12px; background:#fff; }
    .worker-card { cursor:grab; }
    .worker-card h4 { margin:0 0 8px; font-size:16px; }
    .meta { color:#334155; font-size:13px; margin:2px 0; }
    .chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
    .chip, .status-pill { font-size:11px; padding:4px 8px; border-radius:999px; background:#eef2ff; color:#3730a3; border:1px solid #c7d2fe; }
    .status-pill { background:#ecfeff; border-color:#a5f3fc; color:#0e7490; font-weight:700; }

    .request-card { text-decoration:none; color:inherit; display:block; }
    .request-card.active { border-color:#2563eb; box-shadow:0 0 0 2px #dbeafe inset; background:#f8fbff; }

    .drop-zone { margin-top:12px; border:2px dashed #94a3b8; border-radius:12px; min-height:86px; display:flex; align-items:center; justify-content:center; text-align:center; padding:12px; background:#f8fafc; color:#334155; transition:.2s ease; }
    .drop-zone.is-over { border-color:#2563eb; background:#eff6ff; color:#1d4ed8; }
    .assigned-worker { display:flex; justify-content:space-between; align-items:center; gap:10px; }
    .assigned-worker form button { border:1px solid #fecaca; background:#fff1f2; color:#be123c; border-radius:8px; padding:7px 10px; cursor:pointer; }

    details.dev-only { margin-top:16px; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:10px 14px; }
    .dev-note { margin:8px 0 12px; color:#7c2d12; background:#ffedd5; border:1px solid #fed7aa; border-radius:8px; padding:8px 10px; }

    @media (max-width: 1200px) { .board-layout { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <form method="post" action="/logout"><button type="submit">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <header class="page-header">
      <div>
        <h1>Asignación operativa</h1>
        <p>Selecciona una solicitud y asigna auxiliares disponibles.</p>
      </div>
      <a class="secondary-btn" href="/admin/operaciones">Volver a Operaciones</a>
    </header>

    <% if (message) { %><p class="flash"><%= message %></p><% } %>

    <section class="board-layout">
      <div class="workers-panel">
        <div class="panel-header"><h2>Auxiliares disponibles</h2></div>
        <div class="panel-content">
          <div class="filter-card">
            <div class="panel-content">
              <form method="get" action="/admin/operaciones/asignaciones">
                <input id="q" name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" />
                <select id="operationalCityId" name="operationalCityId"><option value="">Todas las ciudades</option><% cities.forEach((city) => { %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select>
                <select id="vacancyId" name="vacancyId"><option value="">Todas las vacantes</option><% vacancies.forEach((vacancy) => { %><option value="<%= vacancy.id %>" <%= filters.vacancyId===vacancy.id?'selected':'' %>><%= vacancy.title %></option><% }) %></select>
                <select id="transportMode" name="transportMode"><option value="">Todos los transportes</option><% transportModes.forEach((mode) => { %><option value="<%= mode %>" <%= filters.transportMode===mode?'selected':'' %>><%= mode %></option><% }) %></select>
                <select id="locality" name="locality"><option value="">Todas las localidades</option><% localities.forEach((value) => { %><option value="<%= value %>" <%= filters.locality===value?'selected':'' %>><%= value %></option><% }) %></select>
                <select id="status" name="status"><option value="">Todos los estados</option><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>ACTIVE</option><option value="INACTIVE" <%= filters.status==='INACTIVE'?'selected':'' %>>INACTIVE</option></select>
                <button type="submit">Aplicar filtros</button>
              </form>
            </div>
          </div>

          <div id="workersList" class="worker-list" style="margin-top:12px;">
            <% workers.forEach((worker) => { %>
              <article class="worker-card" draggable="true" data-worker-id="<%= worker.id %>">
                <h4><%= worker.fullName %></h4>
                <p class="meta">📞 <%= worker.phone || '-' %></p>
                <p class="meta">🪪 <%= worker.documentNumber || '-' %></p>
                <p class="meta">📍 <%= worker.cityName || '-' %> / <%= worker.locality || '-' %></p>
                <p class="meta">🛵 <%= worker.transportMode || '-' %></p>
                <div class="chips"><span class="chip">Ciudades operativas: <%= (worker.operationalCities || []).map((c) => c.name).join(', ') || 'N/A' %></span></div>
                <div class="chips"><span class="chip">Perfiles: <%= (worker.vacancies || []).map((v) => v.title).join(', ') || 'N/A' %></span><span class="status-pill"><%= worker.status || 'N/A' %></span></div>
              </article>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="requests-panel">
        <div class="panel-header"><h2>Solicitudes operativas</h2></div>
        <div class="panel-content request-list">
          <% serviceRequests.forEach((request) => { %>
            <a class="request-card <%= selectedServiceRequestId===request.id ? 'active' : '' %>" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">
              <strong><%= request.clientName %></strong>
              <p class="meta">Punto: <%= request.operationPointName || '-' %></p>
              <p class="meta">Ciudad: <%= request.cityName || '-' %></p>
              <p class="meta">Fecha: <%= new Date(request.serviceDate).toISOString().slice(0,10) %></p>
              <p class="meta">Horario: <%= request.startTime || '-' %> - <%= request.endTime || '-' %></p>
              <p class="meta">Requeridos: <%= request.requiredWorkers %> | Asignados: <%= request.assignments.length %></p>
              <span class="status-pill"><%= request.status %></span>
            </a>
          <% }) %>
        </div>
      </div>

      <div class="assignment-panel">
        <div class="panel-header"><h2>Asignación</h2></div>
        <div class="panel-content">
          <% if (selectedServiceRequest) { %>
            <h3 style="margin-top:0;"><%= selectedServiceRequest.clientName %></h3>
            <p class="meta"><%= selectedServiceRequest.operationPointName || '-' %> · <%= selectedServiceRequest.cityName || '-' %></p>
            <p class="meta"><%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %> · <%= selectedServiceRequest.startTime || '-' %> - <%= selectedServiceRequest.endTime || '-' %></p>
            <p class="meta">Requeridos: <%= selectedServiceRequest.requiredWorkers %> | Asignados: <%= selectedServiceRequest.assignments.length %></p>
          <% } else { %>
            <p class="meta">No hay solicitud seleccionada.</p>
          <% } %>

          <div id="assignmentDropZone" class="drop-zone">
            <% if (!selectedServiceRequestId) { %>
              <p>Selecciona una solicitud antes de asignar auxiliares.</p>
            <% } else { %>
              <p>Suelta aquí los auxiliares para asignarlos.</p>
            <% } %>
          </div>

          <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign">
            <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
            <input type="hidden" id="assignWorkerId" name="workerId" value="" />
          </form>

          <% if (selectedServiceRequest) { %>
            <h3>Auxiliares asignados</h3>
            <div class="assigned-list">
              <% selectedServiceRequest.assignments.forEach((assignment) => { %>
                <div class="assigned-worker">
                  <div>
                    <strong><%= assignment.worker.fullName %></strong>
                    <p class="meta"><%= assignment.worker.phone || '-' %> · <%= assignment.status %></p>
                  </div>
                  <form method="post" action="/admin/operaciones/asignaciones/unassign">
                    <input type="hidden" name="assignmentId" value="<%= assignment.id %>" />
                    <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequest.id %>" />
                    <button type="submit">Quitar</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <% if (role === 'dev') { %>
      <details class="dev-only">
        <summary><strong>Crear solicitud interna de prueba</strong></summary>
        <p class="dev-note">Uso interno temporal mientras se habilitan los links públicos por operación.</p>
        <form method="post" action="/admin/operaciones/asignaciones/solicitudes" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px;">
          <input name="clientName" placeholder="Cliente" required />
          <input name="operationPointName" placeholder="Punto" />
          <input name="cityName" placeholder="Ciudad" />
          <input name="address" placeholder="Dirección" />
          <input name="serviceDate" type="date" required />
          <input name="startTime" placeholder="Hora inicio" />
          <input name="endTime" placeholder="Hora fin" />
          <input name="requiredWorkers" type="number" min="1" value="1" required />
          <input name="notes" placeholder="Notas" style="grid-column:span 2;" />
          <button type="submit" style="grid-column:span 2;padding:10px;border:none;border-radius:8px;background:#1d4ed8;color:#fff;font-weight:700;">Crear</button>
        </form>
      </details>
    <% } %>
  </main>

  <script>
    (function () {
      const selectedServiceRequestId = '<%= selectedServiceRequestId || "" %>';
      const workersList = document.getElementById('workersList');
      const dropZone = document.getElementById('assignmentDropZone');
      const assignWorkerId = document.getElementById('assignWorkerId');
      const assignForm = document.getElementById('assignForm');

      workersList?.addEventListener('dragstart', (event) => {
        const card = event.target.closest('[data-worker-id]');
        if (!card || !event.dataTransfer) return;
        event.dataTransfer.setData('text/plain', card.dataset.workerId);
      });

      dropZone?.addEventListener('dragover', (event) => {
        event.preventDefault();
        dropZone.classList.add('is-over');
      });
      dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('is-over'));
      dropZone?.addEventListener('drop', (event) => {
        event.preventDefault();
        dropZone.classList.remove('is-over');
        const workerId = event.dataTransfer?.getData('text/plain');
        if (!selectedServiceRequestId) return window.alert('Selecciona una solicitud antes de asignar auxiliares.');
        if (!workerId || !assignWorkerId || !assignForm) return;
        assignWorkerId.value = workerId;
        assignForm.submit();
      });
    })();
  </script>
</body>
</html>
