<!doctype html><html><head><meta charset='utf-8'><title>Asignaciones</title><style>.worker-list{max-height:calc(100vh - 360px);overflow-y:auto}.request-list{max-height:calc(100vh - 360px);overflow-y:auto}</style></head><body>
<nav><a href='/admin'><img src='/public/logo-loginpro.svg' alt='LoginPro'></a></nav>
<header><a href='/admin/operaciones'>Volver a Operaciones</a> <a href='/admin/operaciones/asignaciones'>Solicitudes de servicio</a> <a href='/admin/operaciones/clientes'>Clientes</a> <a href='/admin/operaciones/personal'>Personal operativo</a></header>
<div class='worker-list'>
<% workers.forEach((worker)=>{ %><article draggable="true" data-worker-id='<%= worker.id %>'><strong><%= worker.fullName %></strong><div><%= worker.phone||'-' %></div><div><%= worker.residenceLocality||'-' %></div><div><%= worker.transportMode||'-' %></div></article><% }) %>
</div>
<div class='request-list'>
<% serviceRequests.forEach((request)=>{ %><article><strong><%= request.clientName %></strong><div><%= request.operationPointName||'-' %></div><div><%= new Date(request.serviceDate).toISOString().slice(0,10) %> <%= request.startTime||'-' %>-<%= request.endTime||'-' %></div><div><%= request.requiredWorkers %>/<%= request.assignments.length %></div><div><%= request.status %></div><a href='/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar'>Editar</a></article><% }) %>
</div>
<% if (role === 'dev') { %><details><summary>Crear solicitud interna</summary><p>Uso interno. Para clientes, usa el link público de la operación.</p><form method='post' action='/admin/operaciones/asignaciones/solicitudes'><input name='clientName' required><input type='date' name='serviceDate' required><input type='number' name='requiredWorkers' min='1' required><button>Crear nueva solicitud interna</button></form></details><% } %>
<div id='assignmentDropZone'></div>
<form id='assignForm' method='post' action='/admin/operaciones/asignaciones/assign'><input type='hidden' name='serviceRequestId' value='<%= selectedServiceRequestId %>'><input type='hidden' id='assignWorkerId' name='workerId'></form>
<form method='post' action='/admin/operaciones/asignaciones/unassign'></form></body></html>
