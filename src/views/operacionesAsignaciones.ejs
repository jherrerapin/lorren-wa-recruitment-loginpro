<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Asignación operativa — LoginPro</title>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <form method="post" action="/logout"><button type="submit">Cerrar sesión</button></form>
  </nav>

  <% if (message) { %><p><%= message %></p><% } %>
  <section>
    <form method="get" action="/admin/operaciones/asignaciones">
      <input id="q" name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" />
      <select id="operationalCityId" name="operationalCityId"><option value="">Todas</option><% cities.forEach((city) => { %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select>
      <select id="vacancyId" name="vacancyId"><option value="">Todas</option><% vacancies.forEach((vacancy) => { %><option value="<%= vacancy.id %>" <%= filters.vacancyId===vacancy.id?'selected':'' %>><%= vacancy.title %></option><% }) %></select>
      <select id="transportMode" name="transportMode"><option value="">Todos</option><% transportModes.forEach((mode) => { %><option value="<%= mode %>" <%= filters.transportMode===mode?'selected':'' %>><%= mode %></option><% }) %></select>
      <select id="locality" name="locality"><option value="">Todas</option><% localities.forEach((value) => { %><option value="<%= value %>" <%= filters.locality===value?'selected':'' %>><%= value %></option><% }) %></select>
      <select id="status" name="status"><option value="">Todos</option><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>ACTIVE</option><option value="INACTIVE" <%= filters.status==='INACTIVE'?'selected':'' %>>INACTIVE</option></select>
      <button type="submit">Filtrar</button>
    </form>

    <div id="workersList">
      <% workers.forEach((worker) => { %>
        <div class="worker-card" draggable="true" data-worker-id="<%= worker.id %>">
          <h3><%= worker.fullName %></h3>
          <div><%= worker.phone || '-' %></div>
        </div>
      <% }) %>
    </div>
  </section>

  <section>
    <h2>Solicitudes operativas</h2>
    <ul>
      <% serviceRequests.forEach((request) => { %>
        <li>
          <a href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">
            <strong><%= request.clientName %></strong> | <%= request.operationPointName || '-' %> | <%= request.cityName || '-' %> | <%= new Date(request.serviceDate).toISOString().slice(0,10) %> | <%= request.startTime || '-' %> - <%= request.endTime || '-' %> | req: <%= request.requiredWorkers %> | asig: <%= request.assignments.length %> | <%= request.status %>
          </a>
        </li>
      <% }) %>
    </ul>

    <h3>Crear solicitud rápida</h3>
    <form method="post" action="/admin/operaciones/asignaciones/solicitudes">
      <input name="clientName" placeholder="Cliente" required />
      <input name="operationPointName" placeholder="Punto" />
      <input name="cityName" placeholder="Ciudad" />
      <input name="address" placeholder="Dirección" />
      <input name="serviceDate" type="date" required />
      <input name="startTime" placeholder="Hora inicio" />
      <input name="endTime" placeholder="Hora fin" />
      <input name="requiredWorkers" type="number" min="1" value="1" required />
      <input name="notes" placeholder="Notas" />
      <button type="submit">Crear</button>
    </form>

    <% if (selectedServiceRequest) { %>
      <h3>Operación seleccionada</h3>
      <p><%= selectedServiceRequest.clientName %> / <%= selectedServiceRequest.operationPointName || '-' %></p>
      <p><%= selectedServiceRequest.cityName || '-' %> / <%= selectedServiceRequest.address || '-' %></p>
      <p><%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %> <%= selectedServiceRequest.startTime || '' %> - <%= selectedServiceRequest.endTime || '' %></p>
      <p>Requeridos: <%= selectedServiceRequest.requiredWorkers %> | Asignados: <%= selectedServiceRequest.assignments.length %> | Estado: <%= selectedServiceRequest.status %></p>
    <% } %>

    <div id="assignmentDropZone">
      <% if (!selectedServiceRequestId) { %>
      <p>Crea o selecciona una solicitud antes de asignar auxiliares.</p>
      <% } else { %>
      <p>Arrastra aquí para asignar.</p>
      <% } %>
    </div>
    <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign">
      <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
      <input type="hidden" id="assignWorkerId" name="workerId" value="" />
    </form>

    <% if (selectedServiceRequest) { %>
      <h3>Asignados actuales</h3>
      <% selectedServiceRequest.assignments.forEach((assignment) => { %>
        <div>
          <strong><%= assignment.worker.fullName %></strong> - <%= assignment.worker.phone || '-' %> - <%= assignment.status %>
          <form method="post" action="/admin/operaciones/asignaciones/unassign">
            <input type="hidden" name="assignmentId" value="<%= assignment.id %>" />
            <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequest.id %>" />
            <button type="submit">Quitar</button>
          </form>
        </div>
      <% }) %>
    <% } %>
  </section>

  <script>
    (function () {
      const selectedServiceRequestId = '<%= selectedServiceRequestId || "" %>';
      const workersList = document.getElementById('workersList');
      const dropZone = document.getElementById('assignmentDropZone');
      const assignWorkerId = document.getElementById('assignWorkerId');
      const assignForm = document.getElementById('assignForm');

      workersList?.addEventListener('dragstart', (event) => {
        const card = event.target.closest('[data-worker-id]');
        if (!card || !event.dataTransfer) return;
        event.dataTransfer.setData('text/plain', card.dataset.workerId);
      });

      dropZone?.addEventListener('dragover', (event) => event.preventDefault());
      dropZone?.addEventListener('drop', (event) => {
        event.preventDefault();
        const workerId = event.dataTransfer?.getData('text/plain');
        if (!selectedServiceRequestId) return window.alert('Crea o selecciona una solicitud antes de asignar auxiliares.');
        if (!workerId || !assignWorkerId || !assignForm) return;
        assignWorkerId.value = workerId;
        assignForm.submit();
      });
    })();
  </script>
</body>
</html>
