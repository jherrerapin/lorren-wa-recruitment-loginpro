<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Asignación operativa — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg:#f4f5f7; --surface:#fff; --surface-2:#f9fafb; --border:#e1e4e8; --text:#1a1d23; --muted:#6b7280; --navy:#1e2d3d; --teal:#0d7a6b; --teal-hover:#0a5f53; --shadow-sm:0 1px 3px rgba(0,0,0,.08); --shadow-md:0 10px 28px rgba(15,23,42,.08); --radius:12px; --font:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    body { font-family: var(--font); background: var(--bg); color: var(--text); font-size: 14px; }
    .navbar { background: var(--navy); padding: 0 24px; display: flex; align-items: center; gap: 20px; min-height: 52px; box-shadow: 0 2px 8px rgba(0,0,0,.2); }
    .navbar a { color: #cbd5e0; text-decoration: none; font-size: 13px; font-weight: 600; padding: 4px 2px; border-bottom: 2px solid transparent; }
    .navbar a:hover, .navbar a.nav-active { color: #fff; border-bottom-color: #4fd1c5; }
    .navbar .brand img { height: 28px; display: block; }
    .navbar .spacer { flex: 1; }
    .btn-logout { background: transparent; border: 1px solid rgba(255,255,255,.25); color: #cbd5e0 !important; padding: 6px 12px !important; border-radius: 7px; cursor: pointer; font-size: 12px; font-weight: 600; }
    .page { max-width: 1320px; margin: 0 auto; padding: 28px 20px 60px; display: grid; gap: 18px; }
    .hero { background: linear-gradient(135deg, #fff 0%, #f0fdfa 100%); border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-md); }
    .hero h1 { color: var(--navy); font-size: 30px; margin-bottom: 8px; }
    .hero p { color: var(--muted); }
    .board { display: grid; grid-template-columns: minmax(340px, 1fr) minmax(380px, 1fr); gap: 16px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
    .card-head { padding: 16px 18px; border-bottom: 1px solid #eaecef; }
    .card-head h2 { color: var(--navy); font-size: 17px; }
    .card-head p { color: var(--muted); font-size: 13px; margin-top: 2px; }
    .card-body { padding: 16px; }
    .filters-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
    .field { display: flex; flex-direction: column; gap: 5px; }
    .field label { color: var(--muted); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
    input, select { width: 100%; border: 1px solid var(--border); border-radius: 9px; padding: 9px 10px; background: var(--surface-2); color: var(--text); }
    .workers-list { display: grid; gap: 10px; max-height: 62vh; overflow: auto; padding-right: 4px; }
    .worker-card { border: 1px solid #dce2e8; border-radius: 12px; background: #fff; padding: 12px; display: grid; gap: 7px; cursor: grab; }
    .worker-card:active { cursor: grabbing; }
    .worker-card h3 { color: var(--navy); font-size: 15px; }
    .meta { color: var(--muted); font-size: 12px; }
    .pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 8px; font-size: 11px; font-weight: 700; background: #e7f5f3; color: var(--teal); margin-right: 4px; margin-bottom: 4px; }
    .placeholder-grid { display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
    .placeholder { border: 1px dashed #ccd5e1; border-radius: 10px; padding: 12px; background: #f8fafc; }
    .placeholder strong { display: block; color: var(--navy); font-size: 12px; margin-bottom: 4px; text-transform: uppercase; }
    .drop-zone { min-height: 180px; border: 2px dashed #94a3b8; border-radius: 12px; background: #f8fafc; padding: 12px; color: var(--muted); display: grid; gap: 8px; align-content: start; }
    .drop-zone.drag-over { border-color: var(--teal); background: #ecfdf5; }
    .drop-empty { color: var(--muted); font-size: 13px; }
    .dropped-worker { border: 1px solid #bfe6df; background: #fff; border-radius: 9px; padding: 8px 10px; }
    .actions { margin-top: 10px; }
    .btn { border: 1px solid var(--border); border-radius: 9px; padding: 8px 12px; background: #fff; font-weight: 700; cursor: pointer; }
    .btn-primary { background: var(--teal); color: #fff; border-color: var(--teal); }
    .btn-primary:hover { background: var(--teal-hover); }
    @media (max-width: 980px) { .board { grid-template-columns: 1fr; } .navbar { flex-wrap: wrap; height:auto; padding:10px 16px; } .navbar .spacer { display: none; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <h1>Asignación operativa</h1>
      <p>Selecciona una operación y asigna auxiliares disponibles.</p>
    </section>

    <section class="board">
      <article class="card">
        <div class="card-head">
          <h2>Auxiliares disponibles</h2>
          <p>Filtra y arrastra auxiliares operativos a la zona de asignación.</p>
        </div>
        <div class="card-body">
          <form method="get" action="/admin/operaciones/asignaciones" class="filters-grid">
            <div class="field" style="grid-column: span 2;">
              <label for="q">Búsqueda</label>
              <input id="q" name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" />
            </div>
            <div class="field"><label for="operationalCityId">Ciudad operativa</label><select id="operationalCityId" name="operationalCityId"><option value="">Todas</option><% cities.forEach((city) => { %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select></div>
            <div class="field"><label for="vacancyId">Vacante</label><select id="vacancyId" name="vacancyId"><option value="">Todas</option><% vacancies.forEach((vacancy) => { %><option value="<%= vacancy.id %>" <%= filters.vacancyId===vacancy.id?'selected':'' %>><%= vacancy.title %></option><% }) %></select></div>
            <div class="field"><label for="transportMode">Transporte</label><select id="transportMode" name="transportMode"><option value="">Todos</option><% transportModes.forEach((mode) => { %><option value="<%= mode %>" <%= filters.transportMode===mode?'selected':'' %>><%= mode %></option><% }) %></select></div>
            <div class="field"><label for="locality">Localidad</label><select id="locality" name="locality"><option value="">Todas</option><% localities.forEach((value) => { %><option value="<%= value %>" <%= filters.locality===value?'selected':'' %>><%= value %></option><% }) %></select></div>
            <div class="field"><label for="status">Estado</label><select id="status" name="status"><option value="">Todos</option><option value="ACTIVE" <%= filters.status==='ACTIVE'?'selected':'' %>>ACTIVE</option><option value="INACTIVE" <%= filters.status==='INACTIVE'?'selected':'' %>>INACTIVE</option></select></div>
            <div class="actions"><button class="btn btn-primary" type="submit">Filtrar</button></div>
          </form>

          <div class="workers-list" id="workersList">
            <% if (!workers.length) { %>
              <p class="meta">No hay auxiliares con los filtros actuales.</p>
            <% } %>
            <% workers.forEach((worker) => { %>
              <div class="worker-card" draggable="true" data-worker-id="<%= worker.id %>" id="worker-<%= worker.id %>">
                <h3><%= worker.fullName %></h3>
                <div class="meta">📞 <%= worker.phone || '-' %></div>
                <div class="meta"><%= [worker.documentType, worker.documentNumber].filter(Boolean).join(' ') || '-' %></div>
                <div class="meta">🏙️ <%= worker.residenceCity || '-' %> · <%= worker.residenceLocality || '-' %></div>
                <div class="meta">🚲 <%= worker.transportMode || '-' %></div>
                <div>
                  <% if (worker.cities.length) { worker.cities.forEach((entry) => { %><span class="pill"><%= entry.city.name %></span><% }) } else { %><span class="meta">Sin ciudades operativas</span><% } %>
                </div>
                <div>
                  <% if (worker.vacancies.length) { worker.vacancies.forEach((entry) => { %><span class="pill"><%= entry.vacancy.title %></span><% }) } else { %><span class="meta">Sin vacantes habilitadas</span><% } %>
                </div>
                <div class="meta">Estado: <strong><%= worker.operationalStatus %></strong></div>
              </div>
            <% }) %>
          </div>
        </div>
      </article>

      <article class="card">
        <div class="card-head">
          <h2>Operación seleccionada</h2>
          <p>Selecciona una solicitud operativa para iniciar la asignación.</p>
        </div>
        <div class="card-body">
          <div class="placeholder-grid">
            <div class="placeholder"><strong>Cliente / punto</strong>Pendiente de selección</div>
            <div class="placeholder"><strong>Fecha y hora</strong>Pendiente de selección</div>
            <div class="placeholder"><strong>Auxiliares requeridos</strong>Pendiente de selección</div>
            <div class="placeholder"><strong>Auxiliares asignados</strong>Solo preparación visual</div>
          </div>

          <div id="assignmentDropZone" class="drop-zone">
            <div class="drop-empty">Arrastra auxiliares aquí para preparar la asignación.</div>
          </div>
          <div class="actions"><button type="button" id="clearAssignmentSelection" class="btn">Limpiar selección</button></div>
        </div>
      </article>
    </section>
  </main>

  <script>
    (function () {
      const workersList = document.getElementById('workersList');
      const dropZone = document.getElementById('assignmentDropZone');
      const clearBtn = document.getElementById('clearAssignmentSelection');
      const selected = new Set();

      workersList?.addEventListener('dragstart', (event) => {
        const card = event.target.closest('[data-worker-id]');
        if (!card || !event.dataTransfer) return;
        event.dataTransfer.setData('text/plain', card.dataset.workerId);
      });

      dropZone?.addEventListener('dragover', (event) => { event.preventDefault(); dropZone.classList.add('drag-over'); });
      dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
      dropZone?.addEventListener('drop', (event) => {
        event.preventDefault();
        dropZone.classList.remove('drag-over');
        const workerId = event.dataTransfer?.getData('text/plain');
        if (!workerId || selected.has(workerId)) return;
        const original = document.querySelector(`[data-worker-id="${workerId}"]`);
        if (!original) return;

        const empty = dropZone.querySelector('.drop-empty');
        if (empty) empty.remove();

        const item = document.createElement('div');
        item.className = 'dropped-worker';
        item.dataset.workerId = workerId;
        item.innerHTML = `<strong>${original.querySelector('h3')?.textContent || 'Auxiliar'}</strong><div class="meta">${original.querySelector('.meta')?.textContent || ''}</div>`;
        dropZone.appendChild(item);
        selected.add(workerId);
      });

      clearBtn?.addEventListener('click', () => {
        selected.clear();
        dropZone.innerHTML = '<div class="drop-empty">Arrastra auxiliares aquí para preparar la asignación.</div>';
      });
    })();
  </script>
</body>
</html>
