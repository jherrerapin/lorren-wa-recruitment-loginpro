<% if(role==='dev'&&report.filters.clientId){ %>
<section class="panel"><div class="policy-head"><div><h2>Parámetros de jornada</h2><p class="sub">Jornada flexible: 7 h son la referencia diaria. El exceso de un día cubre faltantes de otros días trabajados de la misma semana; solo el remanente mayor a 30 min se reconoce como hora extra. No existen máximos diarios o semanales de horas extra ni un día de descanso configurable.</p></div></div><form method="post" action="/admin/operaciones/asistencia/nomina/policy"><input type="hidden" name="clientId" value="<%= report.filters.clientId %>"/><input type="hidden" name="periodType" value="<%= report.period.periodType %>"/><input type="hidden" name="from" value="<%= report.period.from %>"/><input type="hidden" name="to" value="<%= report.period.to %>"/><input type="hidden" name="anchor" value="<%= report.period.anchor %>"/><input type="hidden" name="extraPeriodType" value="<%= (report.overtimePeriod||report.period).periodType %>"/><input type="hidden" name="extraFrom" value="<%= (report.overtimePeriod||report.period).from %>"/><input type="hidden" name="extraTo" value="<%= (report.overtimePeriod||report.period).to %>"/><input type="hidden" name="extraAnchor" value="<%= (report.overtimePeriod||report.period).anchor||(report.overtimePeriod||report.period).from %>"/><input type="hidden" name="filterWorkerId" value="<%= report.filters.workerId||'' %>"/><% if(report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %><div class="policy-grid"><div class="field"><label>Referencia diaria</label><input name="dailyOrdinaryHours" type="number" min="7" max="7" step="1" value="7" readonly required/><small>El exceso cubre primero faltantes de otros días trabajados.</small></div><div class="field"><label>Inicio nocturno</label><select name="nightStartHour"><% for(let hour=0;hour<24;hour+=1){ %><option value="<%= hour %>" <%= selectedPolicy.nightStartMinute===hour*60?'selected':'' %>><%= String(hour).padStart(2,'0') %>:00</option><% } %></select></div><div class="field"><label>Fin nocturno</label><select name="nightEndHour"><% for(let hour=0;hour<24;hour+=1){ %><option value="<%= hour %>" <%= selectedPolicy.nightEndMinute===hour*60?'selected':'' %>><%= String(hour).padStart(2,'0') %>:00</option><% } %></select></div><div class="field"><label>Descuento almuerzo abierto</label><input name="incompleteBreakPenaltyMinutes" type="number" min="0" max="480" value="<%= selectedPolicy.incompleteBreakPenaltyMinutes %>" required/></div><div class="field"><label>Reconocer llegada anticipada</label><select name="recognizeEarlyArrival"><option value="false" <%= !selectedPolicy.recognizeEarlyArrival?'selected':'' %>>No</option><option value="true" <%= selectedPolicy.recognizeEarlyArrival?'selected':'' %>>Sí</option></select></div><div class="field"><button class="btn btn-primary">Guardar parámetros</button></div></div></form></section>
<% } %>
<section class="panel payroll-results-panel">
  <% const restLabels={VACACIONES:'Vacaciones',INCAPACIDAD_EPS:'Incapacidad EPS',SUSPENSION:'Suspensión',INCAPACIDAD_ARL:'Incapacidad ARL',NO_REMUNERADA:'No remunerada',REMUNERADO:'Remunerado',COMPENSATORIO:'Compensatorio'}; %>
  <div class="table-wrap"><% if(!report.rows.length){ %><div class="empty">No hay jornadas ni descansos para el periodo seleccionado.</div><% }else{ %><table><thead><tr><th>Auxiliar</th><th>Días remunerados</th><th>Días no remunerados</th><th>Permisos remunerados</th><th>Incapacidades</th><th>Turnos nocturnos</th><th>Domingos</th><th>Festivos</th><th>Total</th><th>Ordinarias</th><th>Extra</th><% for(const code of conceptCodes){ %><th><%= code %></th><% } %><th>Detalle</th></tr></thead><tbody>
  <% for(const row of report.rows){const dayKeys=new Set((row.daily||[]).flatMap((day)=>[day.dateKey,...(day.civilDateKeys||[])]));const periodSource=(row.novelties||[]).filter((novelty)=>!novelty.dateKey||!dayKeys.has(novelty.dateKey));const periodNovelties=[];for(const novelty of periodSource){const existing=periodNovelties.find((item)=>item.code===novelty.code&&item.message===novelty.message);if(existing)existing.occurrences+=1;else periodNovelties.push({...novelty,occurrences:1});} %>
  <tr><td><strong><%= row.fullName %></strong><small><%= row.documentType %> <%= row.documentNumber||'Sin documento' %></small></td><td><%= row.remuneratedDays||0 %></td><td><%= row.unremuneratedDays||0 %></td><td><%= row.paidPermissionDays||0 %></td><td><%= row.incapacityDays||0 %></td><td><%= row.nightShiftCount||0 %></td><td><%= row.sundayCount||0 %></td><td><%= row.holidayCount||0 %></td><td><%= row.totalHours %></td><td><%= row.ordinaryHours %></td><td><%= row.overtimeHours %></td><% for(const code of conceptCodes){ %><td><%= row.conceptHours[code]||0 %></td><% } %><td><details><summary>Ver días, marcaciones y descansos<% if((row.novelties||[]).length){ %> <span class="novelty-count">· <%= row.novelties.length %> novedad(es)</span><% } %></summary><div class="daily">
    <% if(periodNovelties.length){ %><div class="period-novelties"><% for(const novelty of periodNovelties){ %><div class="novelty-line <%= novelty.blocking===false?'info':'' %>"><strong><%= novelty.blocking===false?'Informativa:':'Requiere revisión:' %></strong> <%= novelty.message||'Existe una novedad pendiente de descripción.' %><% if(novelty.occurrences>1){ %> · <%= novelty.occurrences %> ocurrencias<% } %></div><% } %></div><% } %>
    <% if((row.restAssignments||[]).length){ %><div class="rest-summary"><% for(const rest of row.restAssignments){ %><div class="rest-summary-row"><strong><%= rest.restDate %> · <%= restLabels[rest.reason]||rest.reason %></strong><% if(rest.dayAdjustment===-1){ %> · Descuenta 1 día laborado<% } %><% if(rest.originSundayDate){ %><small>Domingo que generó el compensatorio: <%= rest.originSundayDate %></small><% } %></div><% } %></div><% } %>
    <% for(const day of row.daily){const source=(row.novelties||[]).filter((novelty)=>novelty.dateKey===day.dateKey||(day.civilDateKeys||[]).includes(novelty.dateKey));const dayNovelties=[];for(const novelty of source){const existing=dayNovelties.find((item)=>item.code===novelty.code&&item.message===novelty.message);if(existing)existing.occurrences+=1;else dayNovelties.push({...novelty,occurrences:1});} %>
    <div class="daily-row"><div><strong><%= day.dateKey %></strong><div class="day-flags"><% if(day.isHoliday){ %><span class="badge badge-holiday">Festivo</span><% } %><% if(day.isRestDay){ %><span class="badge badge-rest">Domingo</span><% } %></div></div><div><%= day.clientNames.join(', ') %><small><%= day.operationNames.join(', ') %></small></div><div><%= day.totalHours %> h</div><div><small>Ordinarias: <%= day.ordinaryHours %> h</small><small>Extra: <%= day.overtimeHours %> h</small></div><div>
      <% if(day.isRestDay&&day.compensationStatus){if(day.compensationManagedByRestAssignment){ %><span class="badge <%= day.compensationStatus==='COMPENSATED'?'badge-ok':'badge-warn' %>"><%= day.compensationStatus==='COMPENSATED'?'Compensado · descanso compensatorio asignado':'No compensado · sin descanso compensatorio asignado' %></span><% }else{ %><form method="post" action="/admin/operaciones/asistencia/nomina/compensation"><input type="hidden" name="workerId" value="<%= row.workerId %>"/><input type="hidden" name="filterWorkerId" value="<%= report.filters.workerId||'' %>"/><input type="hidden" name="dateKey" value="<%= day.compensationDateKey||day.dateKey %>"/><input type="hidden" name="periodType" value="<%= report.period.periodType %>"/><input type="hidden" name="from" value="<%= report.period.from %>"/><input type="hidden" name="to" value="<%= report.period.to %>"/><input type="hidden" name="anchor" value="<%= report.period.anchor %>"/><input type="hidden" name="extraPeriodType" value="<%= (report.overtimePeriod||report.period).periodType %>"/><input type="hidden" name="extraFrom" value="<%= (report.overtimePeriod||report.period).from %>"/><input type="hidden" name="extraTo" value="<%= (report.overtimePeriod||report.period).to %>"/><input type="hidden" name="extraAnchor" value="<%= (report.overtimePeriod||report.period).anchor||(report.overtimePeriod||report.period).from %>"/><input type="hidden" name="clientId" value="<%= report.filters.clientId %>"/><input type="hidden" name="operationPointId" value="<%= report.filters.operationPointId %>"/><input type="hidden" name="search" value="<%= report.filters.search %>"/><select name="status"><option value="PENDING" <%= day.compensationStatus==='PENDING'?'selected':'' %>>Compensatorio pendiente</option><option value="NOT_COMPENSATED" <%= day.compensationStatus==='NOT_COMPENSATED'?'selected':'' %>>No compensado</option><option value="COMPENSATED" <%= day.compensationStatus==='COMPENSATED'?'selected':'' %>>Compensado</option></select><button class="btn">Guardar</button></form><% }} %>
      <% if((day.markings||[]).length){ %><div class="marking-trace"><div class="marking-trace-title">Marcaciones del día</div><% for(const marking of day.markings){ %><div class="marking-session"><strong><%= marking.clientName %> · <%= marking.operationName %></strong><div class="marking-inline"><span>Entrada <b><%= marking.arrivalLabel %></b></span><span>Almuerzo <b><%= marking.breakStartLabel %> → <%= marking.breakEndLabel %></b></span><span>Salida <b><%= marking.departureLabel %></b></span></div><% for(const correction of marking.corrections||[]){ %><div class="manual-correction-note"><strong>Corrección manual · <%= correction.markTypeLabel %>:</strong> <%= correction.previousLabel %> → <%= correction.newLabel %>. <strong>Observación de coordinación:</strong> <%= correction.reason %></div><% } %></div><% } %></div><% }else{ %><div class="novelty">Sin marcaciones detalladas para este cálculo.</div><% } %>
      <% if(dayNovelties.length){ %><div class="novelty-list"><% for(const novelty of dayNovelties){ %><div class="novelty-line <%= novelty.blocking===false?'info':'' %>"><strong><%= novelty.blocking===false?'Informativa:':'Requiere revisión:' %></strong> <%= novelty.message||'Existe una novedad pendiente de descripción.' %><% if(novelty.occurrences>1){ %> · <%= novelty.occurrences %> ocurrencias<% } %></div><% } %></div><% } %>
    </div></div><% } %>
  </div></details></td></tr><% } %></tbody></table><% } %></div>
</section>