<% const waTitle = typeof whatsappTitle === 'string' && whatsappTitle ? whatsappTitle : 'WhatsApp de despacho';
   const waEyebrow = typeof whatsappEyebrow === 'string' && whatsappEyebrow ? whatsappEyebrow : 'Operaciones / Despacho';
   const waDescription = typeof whatsappDescription === 'string' && whatsappDescription ? whatsappDescription : 'Gestiona la conexión visual de la línea usada para enviar notificaciones de despacho.';
   const waStatusEndpoint = typeof statusEndpoint === 'string' && statusEndpoint ? statusEndpoint : '/admin/operaciones/whatsapp/estado';
   const waCloseEndpoint = typeof closeSessionEndpoint === 'string' && closeSessionEndpoint ? closeSessionEndpoint : '/admin/operaciones/whatsapp/cerrar-sesion';
   const waBackUrl = typeof backUrl === 'string' && backUrl ? backUrl : '/admin/operaciones';
   const waBackLabel = typeof backLabel === 'string' && backLabel ? backLabel : 'Volver a Operaciones';
   const waAssignmentUrl = typeof assignmentUrl === 'string' && assignmentUrl ? assignmentUrl : '/admin/operaciones/asignaciones';
   const waAssignmentLabel = typeof assignmentLabel === 'string' && assignmentLabel ? assignmentLabel : 'Asignaciones';
   const technicalErrorValue = typeof technicalLastError === 'string' ? technicalLastError : null;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= waTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .status-layout { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(320px, 520px); gap: 18px; align-items: start; }
    .status-card { background: #fff; border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-sm); padding: 20px; display: grid; gap: 14px; }
    .status-card.connected { border-color: var(--green); background: var(--green-soft); }
    .status-label { display: inline-flex; width: fit-content; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 900; background: var(--amber-soft); color: var(--amber); }
    .status-label.connected { background: #dcfce7; color: #166534; }
    .status-label.error { background: #fee2e2; color: #991b1b; }
    .qr-panel { align-items: center; text-align: center; }
    .qr-image { width: min(420px, 100%); border: 10px solid #fff; border-radius: 18px; box-shadow: var(--shadow); background: #fff; }
    .alert { border: 1px solid #fecaca; background: #fff5f5; color: #991b1b; border-radius: 14px; padding: 12px 14px; font-weight: 800; }
    .info-box { border: 1px solid #bfdbfe; background: #eff6ff; color: #1e40af; border-radius: 14px; padding: 12px 14px; font-weight: 800; }
    .technical-box { border: 1px dashed #cbd5e1; background: #f8fafc; color: #334155; border-radius: 14px; padding: 12px 14px; font-size: 12px; line-height: 1.45; word-break: break-word; }
    .muted-strong { color: var(--muted); font-weight: 800; }
    .inline-action-form { display: inline-flex; margin: 0; }
    @media (max-width: 900px) { .status-layout { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow"><%= waEyebrow %></div>
        <h1><%= waTitle %></h1>
        <p><%= waDescription %></p>
      </div>
      <div class="actions">
        <a class="btn" href="<%= waBackUrl %>"><%= waBackLabel %></a>
        <a class="btn" href="<%= waAssignmentUrl %>"><%= waAssignmentLabel %></a>
        <button class="btn btn-primary" type="button" id="refreshStatus">Actualizar estado</button>
        <form class="inline-action-form" method="post" action="<%= waCloseEndpoint %>" onsubmit="return confirm('¿Cerrar esta sesión de WhatsApp? Tendrás que escanear un nuevo QR para reconectar.');">
          <button class="btn" type="submit">Cerrar sesión de WhatsApp</button>
        </form>
      </div>
    </section>

    <% if (typeof message === 'string' && message) { %><div class="section-note"><%= message %></div><% } %>

    <section class="status-layout">
      <article class="status-card <%= ready ? 'connected' : '' %>" id="statusCard">
        <span class="status-label <%= ready ? 'connected' : lastError ? 'error' : '' %>" id="statusLabel"><%= ready ? 'Conectado' : lastError ? 'Requiere revisión' : 'No conectado' %></span>
        <h2 id="statusTitle"><%= ready ? `${waTitle} conectado` : 'Sesión pendiente de conexión' %></h2>
        <p class="muted-strong" id="readyAt" <%= lastReadyAt ? '' : 'hidden' %>>Conectado desde: <span data-raw-ready-at="<%= lastReadyAt || '' %>"><%= lastReadyAt || '' %></span></p>
        <p><%= waDescription %></p>
        <div class="alert" id="errorBox" <%= lastError ? '' : 'hidden' %>><%= lastError || '' %></div>
        <% if (role === 'dev') { %>
          <details class="technical-box" id="technicalDetails" <%= technicalErrorValue ? '' : 'hidden' %>>
            <summary>Detalle técnico para dev</summary>
            <div id="technicalError"><%= technicalErrorValue || '' %></div>
            <% if (typeof authDataPath === 'string' && authDataPath) { %><div style="margin-top:8px">Sesión: <%= authDataPath %> · <%= authStorageMode || 'Sin definir' %></div><% } %>
          </details>
        <% } %>
      </article>

      <article class="status-card qr-panel" id="qrPanel">
        <div id="connectedMessage" <%= ready ? '' : 'hidden' %>>
          <h2><%= waTitle %> conectado</h2>
          <p class="muted-strong">Ya puedes volver al entorno correspondiente y enviar mensajes.</p>
        </div>
        <div id="qrContainer" <%= !ready && qrImage ? '' : 'hidden' %>>
          <img class="qr-image" id="qrImage" src="<%= qrImage || '' %>" alt="QR de vinculación de <%= waTitle %>" />
          <p class="muted-strong">Escanea este QR desde el celular que utilizarás para esta sesión.</p>
        </div>
        <div id="waitingQr" <%= !ready && !qrImage && !lastError ? '' : 'hidden' %>>
          <h2>Preparando conexión...</h2>
          <p class="muted-strong">La pantalla se actualiza automáticamente cada 3 segundos.</p>
        </div>
        <div class="info-box" id="unavailableBox" <%= !ready && !qrImage && lastError ? '' : 'hidden' %>>
          La conexión aún no está disponible. Actualiza el estado en unos segundos y revisa el detalle técnico si continúa igual.
        </div>
      </article>
    </section>
  </main>

  <script>
    const isDev = <%= role === 'dev' ? 'true' : 'false' %>;
    const statusEndpoint = <%- JSON.stringify(waStatusEndpoint) %>;
    const connectedTitle = <%- JSON.stringify(`${waTitle} conectado`) %>;
    const fallbackOperationalError = <%- JSON.stringify(`La conexión de ${waTitle} no está disponible en este momento.`) %>;
    const statusLabel = document.getElementById('statusLabel');
    const statusTitle = document.getElementById('statusTitle');
    const statusCard = document.getElementById('statusCard');
    const readyAt = document.getElementById('readyAt');
    const readyAtText = readyAt?.querySelector('span');
    const errorBox = document.getElementById('errorBox');
    const technicalDetails = document.getElementById('technicalDetails');
    const technicalError = document.getElementById('technicalError');
    const connectedMessage = document.getElementById('connectedMessage');
    const qrContainer = document.getElementById('qrContainer');
    const qrImage = document.getElementById('qrImage');
    const waitingQr = document.getElementById('waitingQr');
    const unavailableBox = document.getElementById('unavailableBox');

    function formatBogotaDateTime(value) {
      if (!value) return '';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return value;
      return new Intl.DateTimeFormat('es-CO', {
        timeZone: 'America/Bogota',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true
      }).format(parsed).replace(/\s*a\.\s*m\./i, ' a. m.').replace(/\s*p\.\s*m\./i, ' p. m.');
    }

    function renderReadyAt(value) {
      const formatted = formatBogotaDateTime(value);
      setHidden(readyAt, !formatted);
      if (readyAtText) {
        readyAtText.dataset.rawReadyAt = value || '';
        readyAtText.textContent = formatted;
      }
    }

    function setHidden(element, hidden) { if (element) element.hidden = hidden; }
    function renderStatus(data) {
      const hasError = Boolean(data.lastError || data.technicalLastError);
      statusLabel.textContent = data.ready ? 'Conectado' : hasError ? 'Requiere revisión' : 'No conectado';
      statusLabel.className = 'status-label ' + (data.ready ? 'connected' : hasError ? 'error' : '');
      statusCard.classList.toggle('connected', Boolean(data.ready));
      statusTitle.textContent = data.ready ? connectedTitle : 'Sesión pendiente de conexión';
      renderReadyAt(data.lastReadyAt);
      setHidden(errorBox, !hasError);
      if (errorBox) errorBox.textContent = hasError ? (data.lastError || fallbackOperationalError) : '';
      setHidden(technicalDetails, !isDev || !data.technicalLastError);
      if (technicalError) technicalError.textContent = data.technicalLastError || '';
      setHidden(connectedMessage, !data.ready);
      setHidden(qrContainer, data.ready || !data.qrImage);
      setHidden(waitingQr, data.ready || Boolean(data.qrImage) || hasError);
      setHidden(unavailableBox, data.ready || Boolean(data.qrImage) || !hasError);
      if (data.qrImage && qrImage && qrImage.src !== data.qrImage) qrImage.src = data.qrImage;
    }

    async function refreshStatus() {
      try {
        const response = await fetch(statusEndpoint, {
          cache: 'no-store',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) throw new Error(`Estado HTTP ${response.status}`);
        renderStatus(await response.json());
      } catch (error) {
        console.error('No fue posible consultar el estado de WhatsApp.', error);
        renderStatus({ ready: false, qrImage: null, lastError: fallbackOperationalError, technicalLastError: null, lastReadyAt: null });
      }
    }

    document.getElementById('refreshStatus')?.addEventListener('click', refreshStatus);
    renderReadyAt(readyAtText?.dataset.rawReadyAt || readyAtText?.textContent || '');
    refreshStatus();
    window.setInterval(refreshStatus, 3000);
  </script>
</body>
</html>
