<%
  const screenTitle = typeof whatsappTitle === 'string' && whatsappTitle ? whatsappTitle : 'WhatsApp oficial de despacho';
  const screenEyebrow = typeof whatsappEyebrow === 'string' && whatsappEyebrow ? whatsappEyebrow : 'Operaciones / Despacho';
  const screenDescription = typeof whatsappDescription === 'string' && whatsappDescription
    ? whatsappDescription
    : 'Integración oficial con WhatsApp Business Platform de Meta.';
  const basePath = typeof whatsappBasePath === 'string' && whatsappBasePath ? whatsappBasePath : '/admin/operaciones/whatsapp';
  const returnHref = typeof whatsappReturnHref === 'string' && whatsappReturnHref ? whatsappReturnHref : '/admin/operaciones';
  const returnLabel = typeof whatsappReturnLabel === 'string' && whatsappReturnLabel ? whatsappReturnLabel : 'Volver a Operaciones';
  const assignmentsHref = typeof whatsappAssignmentsHref === 'string' && whatsappAssignmentsHref ? whatsappAssignmentsHref : '/admin/operaciones/asignaciones';
  const assignmentsLabel = typeof whatsappAssignmentsLabel === 'string' && whatsappAssignmentsLabel ? whatsappAssignmentsLabel : 'Asignaciones';
  const isDevView = role === 'dev';
  const monitorHref = isDevView && typeof whatsappMonitorHref === 'string' && whatsappMonitorHref ? whatsappMonitorHref : null;
  const missing = isDevView && typeof missingConfiguration !== 'undefined' && Array.isArray(missingConfiguration) ? missingConfiguration : [];
  const schedule = typeof automationSettings !== 'undefined' && automationSettings ? automationSettings : {
    available: false,
    assignmentAutoSendTime: null,
    pendingConfirmationAlertTime: null,
    alertPhoneConfigured: false
  };
  const hasOutboundHistory = typeof outboundHistory !== 'undefined' && outboundHistory !== null;
  const history = hasOutboundHistory ? outboundHistory : {
    dateKey: '', items: [], pagination: { page: 1, total: 0, totalPages: 1, hasPrevious: false, hasNext: false },
    summary: { total: 0, accepted: 0, sent: 0, delivered: 0, read: 0, failed: 0, deliveryUnknown: 0, confirmed: 0, historical: 0, withoutProviderStatus: 0 }
  };
  const conversation = typeof selectedConversation !== 'undefined' && selectedConversation ? selectedConversation : null;
  const deliveryStatusLabel = (state, reconstructed = false) => {
    if (state === 'DELIVERY_UNKNOWN') return 'Entrega sin confirmar';
    if (state === 'CONFIRMED') return 'Confirmado por auxiliar';
    const labels = {
      ACCEPTED: 'Aceptado por Meta',
      SENT: 'Enviado por WhatsApp',
      DELIVERED: 'Entregado',
      READ: 'Leído',
      FAILED: 'Fallido'
    };
    if (labels[state]) return labels[state];
    return reconstructed ? 'Sin estado Meta histórico' : 'Sin estado Meta';
  };
  const providerStatusClass = (status) => {
    if (status === 'DELIVERY_UNKNOWN') return 'delivery-unknown';
    if (status === 'CONFIRMED') return 'confirmed';
    return ['ACCEPTED', 'SENT', 'DELIVERED', 'READ', 'FAILED'].includes(status) ? status.toLowerCase() : 'unknown';
  };
  const sourceLabel = (source) => ({
    ASSIGNMENT_CONFIRMATION: 'Asignación',
    WINDOW_CHECK_TEMPLATE: 'Verificación de ventana',
    DEV_MANUAL: 'Manual DEV',
    WEBHOOK_AUTO_REPLY: 'Respuesta automática',
    AUTO_CONFIRMATION_REPLY: 'Respuesta automática',
    WEBHOOK_INBOUND: 'Respuesta del auxiliar',
    RECONSTRUIDO_ASIGNACION: 'Asignación · evidencia histórica',
    RECONSTRUIDO_RESPUESTA: 'Respuesta · evidencia histórica',
    RECONSTRUIDO_AUTO_REPLY: 'Respuesta automática · evidencia histórica',
    EVIDENCIA_VENTANA: 'Evidencia histórica de conversación'
  })[source] || source || 'Despacho';
  const historyTime = (value) => {
    if (!value) return 'Hora no disponible';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return new Intl.DateTimeFormat('es-CO', {
      timeZone: 'America/Bogota', hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true
    }).format(date);
  };
  const historyDateTime = (value) => {
    if (!value) return 'Fecha no disponible';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return new Intl.DateTimeFormat('es-CO', {
      timeZone: 'America/Bogota', day: '2-digit', month: '2-digit', year: 'numeric',
      hour: 'numeric', minute: '2-digit', hour12: true
    }).format(date);
  };
  const historyUrl = (page, workerId = null) => {
    const params = new URLSearchParams();
    if (history.dateKey) params.set('date', history.dateKey);
    if (page && Number(page) > 1) params.set('page', String(page));
    if (workerId) params.set('workerId', String(workerId));
    const query = params.toString();
    return `${basePath}${query ? `?${query}` : ''}`;
  };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= screenTitle %> — LoginPro</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .cloud-grid{display:grid;grid-template-columns:minmax(300px,1fr) minmax(320px,1fr);gap:16px;align-items:start}.cloud-grid.single{grid-template-columns:minmax(300px,760px)}
    .cloud-card{background:#fff;border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow-sm);padding:20px;display:grid;gap:13px}.cloud-card.ready{border-color:var(--green);background:var(--green-soft)}
    .status-pill{display:inline-flex;width:fit-content;border-radius:999px;padding:6px 12px;font-size:12px;font-weight:900;background:#fee2e2;color:#991b1b}.status-pill.ready{background:#dcfce7;color:#166534}
    .meta-list{display:grid;gap:8px;margin:0;padding:0;list-style:none}.meta-row{display:grid;grid-template-columns:minmax(140px,.7fr) minmax(0,1fr);gap:10px;padding:9px 0;border-bottom:1px solid #edf2f7}.meta-row:last-child{border-bottom:0}.meta-key{color:var(--muted);font-size:12px;font-weight:850}.meta-value{color:var(--navy);font-size:12px;font-weight:800;overflow-wrap:anywhere}
    .alert{border:1px solid #fecaca;background:#fff5f5;color:#991b1b;border-radius:14px;padding:12px 14px;font-weight:800}.info{border:1px solid #bfdbfe;background:#eff6ff;color:#1e40af;border-radius:14px;padding:12px 14px;font-weight:800;line-height:1.45}.technical{border:1px dashed #cbd5e1;background:#f8fafc;color:#334155;border-radius:14px;padding:12px 14px;font-size:12px;line-height:1.45;word-break:break-word}.missing-list{margin:0;padding-left:18px;color:#991b1b;font-size:12px;font-weight:800}
    .schedule-card,.history-card,.conversation-card{margin-bottom:16px;background:#fff;border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow-sm);padding:18px;display:grid;gap:13px}.schedule-head,.history-head,.conversation-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;flex-wrap:wrap}.schedule-head h2,.history-head h2,.conversation-head h2{margin:0;color:var(--navy);font-size:18px}.schedule-form{display:grid;grid-template-columns:repeat(2,minmax(220px,1fr)) auto;gap:12px;align-items:end}.schedule-field{display:grid;gap:5px}.schedule-field label{color:var(--navy);font-size:12px;font-weight:900}.schedule-field input[type="time"]{width:100%;border:1px solid var(--border);border-radius:10px;padding:10px 11px;font:inherit;background:#fff;color:var(--navy)}.schedule-field small{color:var(--muted);font-size:10.5px;line-height:1.35}.schedule-note{border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0;padding:10px 12px;color:#475569;font-size:11px;line-height:1.45}.schedule-feedback{border-radius:10px;padding:10px 12px;font-size:12px;font-weight:800}.schedule-feedback.success{background:#dcfce7;color:#166534}.schedule-feedback.error{background:#fee2e2;color:#991b1b}
    .history-filter{display:flex;gap:8px;align-items:end;flex-wrap:wrap}.history-field{display:grid;gap:5px;min-width:190px}.history-field label{color:var(--navy);font-size:12px;font-weight:900}.history-field input{min-height:42px;border:1px solid var(--border);border-radius:10px;padding:8px 10px;font:inherit;background:#fff;color:var(--navy)}.history-help{margin:0;color:var(--muted);font-size:11px;line-height:1.45}.history-summary{display:flex;gap:7px;flex-wrap:wrap}.history-summary span{display:inline-flex;border-radius:999px;padding:5px 9px;background:#f1f5f9;color:#475569;font-size:10px;font-weight:900}.history-list{display:grid;gap:10px}.history-item{border:1px solid #e2e8f0;border-radius:14px;padding:13px;display:grid;gap:8px;background:#fff}.history-item-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap}.history-recipient{display:grid;gap:2px}.history-recipient strong{color:var(--navy);font-size:13px}.history-recipient span,.history-meta{color:var(--muted);font-size:10.5px}.history-status{display:inline-flex;width:fit-content;border-radius:999px;padding:5px 8px;font-size:10px;font-weight:900}.history-status.accepted{background:#fef3c7;color:#92400e}.history-status.sent{background:#dbeafe;color:#1d4ed8}.history-status.delivered,.history-status.confirmed{background:#dcfce7;color:#166534}.history-status.read{background:#ccfbf1;color:#115e59}.history-status.failed{background:#fee2e2;color:#991b1b}.history-status.delivery-unknown{background:#ffedd5;color:#9a3412}.history-status.unknown{background:#f1f5f9;color:#475569}.history-body{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;color:#1e293b;font:inherit;font-size:11.5px;line-height:1.5}.history-diagnostic{border-radius:10px;background:#fff1f2;color:#9f1239;padding:8px 10px;font-size:10.5px;line-height:1.4;overflow-wrap:anywhere}.history-empty{border:1px dashed #cbd5e1;border-radius:12px;padding:18px;text-align:center;color:var(--muted);font-size:12px}.history-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.history-pagination{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;padding-top:2px}.history-pagination .history-help{font-weight:800}
    .conversation-person{display:grid;gap:3px}.conversation-person strong{color:var(--navy);font-size:15px}.conversation-person span{color:var(--muted);font-size:12px;font-weight:750}.conversation-list{display:grid;gap:9px}.conversation-message{max-width:min(88%,720px);border-radius:15px;padding:10px 12px;display:grid;gap:6px}.conversation-message.inbound{justify-self:start;background:#f1f5f9;border:1px solid #e2e8f0}.conversation-message.outbound{justify-self:end;background:#ecfdf5;border:1px solid #bbf7d0}.conversation-message p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;line-height:1.45}.conversation-meta{display:flex;gap:6px;flex-wrap:wrap;color:var(--muted);font-size:9.5px;font-weight:750}.conversation-legacy{font-style:italic}.conversation-window{font-size:11px;color:#475569;background:#f8fafc;border-radius:10px;padding:8px 10px}
    @media(max-width:900px){.cloud-grid{grid-template-columns:1fr}.meta-row{grid-template-columns:1fr;gap:3px}.schedule-form{grid-template-columns:1fr}.history-filter{align-items:stretch}.history-field{min-width:0;width:100%}.history-filter .btn{width:100%}.conversation-message{max-width:96%}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (isDevView) { %><a href="/admin/monitor">Monitor bot</a><% } %><span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div><div class="eyebrow"><%= screenEyebrow %></div><h1><%= screenTitle %></h1><p><%= screenDescription %></p></div>
      <div class="actions">
        <a class="btn" href="<%= returnHref %>"><%= returnLabel %></a><a class="btn" href="<%= assignmentsHref %>"><%= assignmentsLabel %></a>
        <% if (monitorHref) { %><a class="btn" href="<%= monitorHref %>">Asignados mañana · DEV</a><% } %>
        <button class="btn btn-primary" type="button" id="refreshStatus">Actualizar estado</button>
      </div>
    </section>

    <% if (typeof message === 'string' && message) { %><div class="section-note"><%= message %></div><% } %>

    <section class="schedule-card" aria-label="Horarios automáticos de WhatsApp de Despacho">
      <div class="schedule-head"><div><h2>Horarios automáticos de confirmación</h2></div></div>
      <% if (typeof settingsMessage === 'string' && settingsMessage) { %><div class="schedule-feedback success"><%= settingsMessage %></div><% } %>
      <% if (typeof settingsError === 'string' && settingsError) { %><div class="schedule-feedback error"><%= settingsError %></div><% } %>
      <% if (schedule.available) { %>
        <form class="schedule-form" method="post" action="<%= basePath %>/programacion-automatica">
          <div class="schedule-field">
            <label for="dispatchAssignmentAutoSendTime">Enviar confirmaciones automáticamente</label>
            <input id="dispatchAssignmentAutoSendTime" name="dispatchAssignmentAutoSendTime" type="time" value="<%= schedule.assignmentAutoSendTime || '' %>" />
            <small>Desde esa hora se intentará enviar el mensaje estándar a los auxiliares que tú asignaste para mañana y que todavía estén pendientes de primer envío.</small>
          </div>
          <div class="schedule-field">
            <label for="dispatchPendingConfirmationAlertTime">Avisarme quiénes siguen sin confirmar</label>
            <input id="dispatchPendingConfirmationAlertTime" name="dispatchPendingConfirmationAlertTime" type="time" value="<%= schedule.pendingConfirmationAlertTime || '' %>" />
            <small>A esa hora recibirás en tu WhatsApp de alertas la lista de auxiliares pendientes, con nombre y número. Debe ser una hora posterior a la del envío automático.</small>
          </div>
          <button class="btn btn-primary" type="submit">Guardar horarios</button>
        </form>
        <div class="schedule-note">
          El reporte de pendientes se enviará al número configurado en <a href="/admin/operaciones">Mis alertas de despacho por WhatsApp</a>. Estado actual: <strong><%= schedule.alertPhoneConfigured ? 'número configurado' : 'falta configurar el número' %></strong>. Deja un horario vacío si quieres desactivar esa automatización.
        </div>
      <% } else { %>
        <div class="alert">No fue posible asociar los horarios a tu usuario. Puedes seguir usando Despacho, pero esta automatización no podrá guardarse hasta resolver el perfil.</div>
      <% } %>
    </section>

    <% if (hasOutboundHistory) { %>
      <section class="history-card" aria-label="Historial diario de mensajes de WhatsApp de Despacho">
        <div class="history-head">
          <div><h2>Mensajes enviados por día</h2><p class="history-help">Consulta los envíos de Despacho y la evidencia disponible de Meta. El teléfono se muestra completo porque esta es una superficie administrativa autenticada.</p></div>
          <form class="history-filter" method="get" action="<%= basePath %>">
            <div class="history-field">
              <label for="dispatchHistoryDate">Fecha en Bogotá</label>
              <input id="dispatchHistoryDate" name="date" type="date" value="<%= history.dateKey %>" required />
            </div>
            <button class="btn btn-primary" type="submit">Consultar</button>
          </form>
        </div>
        <p class="history-help"><strong>Evidencia:</strong> “Aceptado por Meta” y “Enviado por WhatsApp” no equivalen a entrega. “Entregado” confirma entrega reportada por Meta; “Leído” es evidencia posterior; “Confirmado por auxiliar” representa una respuesta humana. “Entrega sin confirmar” significa que Lórren agotó el margen de espera sin recibir evidencia suficiente y requiere revisión, no que Meta haya reportado un fallo.</p>
        <div class="history-summary" aria-label="Resumen de estados de entrega">
          <span>Total del día: <%= history.summary?.total || 0 %></span>
          <span>Mostrados: <%= history.summary?.pageCount || 0 %></span>
          <span>Leídos: <%= history.summary?.read || 0 %></span>
          <span>Entregados: <%= history.summary?.delivered || 0 %></span>
          <span>Enviados: <%= history.summary?.sent || 0 %></span>
          <span>Aceptados: <%= history.summary?.accepted || 0 %></span>
          <span>Sin entrega confirmada: <%= history.summary?.deliveryUnknown || 0 %></span>
          <span>Confirmados: <%= history.summary?.confirmed || 0 %></span>
          <span>Fallidos: <%= history.summary?.failed || 0 %></span>
        </div>
        <% if (Array.isArray(history.items) && history.items.length) { %>
          <div class="history-list">
            <% history.items.forEach((item) => { const visibleState = item.deliveryState || item.providerStatus; %>
              <article class="history-item">
                <div class="history-item-head">
                  <div class="history-recipient">
                    <strong><%= item.workerName || 'Destinatario sin nombre relacionado' %></strong>
                    <span><%= item.phoneDisplay || item.phone || 'Sin número' %> · <%= historyTime(item.at) %></span>
                  </div>
                  <span class="history-status <%= providerStatusClass(visibleState) %>"><%= deliveryStatusLabel(visibleState, item.reconstructed) %></span>
                </div>
                <div class="history-meta"><%= sourceLabel(item.source) %> · <%= item.messageType || 'UNKNOWN' %></div>
                <p class="history-body"><%= item.body || '(mensaje sin texto)' %></p>
                <% if (item.providerStatus === 'FAILED' && item.providerDiagnostic) { %>
                  <div class="history-diagnostic"><strong>Detalle de Meta:</strong> <%= item.providerDiagnostic %></div>
                <% } %>
                <div class="history-actions">
                  <% if (item.workerId) { %><a class="btn" href="<%= historyUrl(history.pagination?.page || 1, item.workerId) %>#dispatchConversation">Ver conversación</a><% } %>
                  <% if (item.reconstructed) { %><span class="history-help">Evidencia histórica: el contenido original no se reconstruye desde datos actuales.</span><% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="history-empty">No hay mensajes outbound auditados ni evidencia histórica de asignaciones para esta fecha.</div>
        <% } %>
        <% if ((history.pagination?.totalPages || 1) > 1) { %>
          <div class="history-pagination">
            <div class="history-actions">
              <% if (history.pagination?.hasPrevious) { %><a class="btn" href="<%= historyUrl((history.pagination.page || 1) - 1) %>">← Anterior</a><% } %>
              <% if (history.pagination?.hasNext) { %><a class="btn" href="<%= historyUrl((history.pagination.page || 1) + 1) %>">Siguiente →</a><% } %>
            </div>
            <p class="history-help">Página <%= history.pagination?.page || 1 %> de <%= history.pagination?.totalPages || 1 %>.</p>
          </div>
        <% } %>
      </section>

      <% if (conversation) { %>
        <section class="conversation-card" id="dispatchConversation" aria-label="Historial de conversación de WhatsApp de Despacho">
          <div class="conversation-head">
            <div class="conversation-person">
              <h2>Conversación de Despacho</h2>
              <strong><%= conversation.workerName || (Array.isArray(conversation.workerNames) ? conversation.workerNames.join(' / ') : 'Auxiliar') %></strong>
              <span><%= conversation.phoneDisplay || conversation.phone || 'Sin número' %></span>
            </div>
            <a class="btn" href="<%= historyUrl(history.pagination?.page || 1) %>">Cerrar conversación</a>
          </div>
          <div class="conversation-window">Ventana de atención: <strong><%= conversation.windowStatus || 'SIN EVIDENCIA' %></strong><% if (conversation.lastInboundAt) { %> · último mensaje recibido <%= historyDateTime(conversation.lastInboundAt) %><% } %>.</div>
          <% if (Array.isArray(conversation.messageHistory) && conversation.messageHistory.length) { %>
            <div class="conversation-list">
              <% conversation.messageHistory.forEach((item) => { const visibleState = item.deliveryState || item.providerStatus; %>
                <article class="conversation-message <%= item.direction === 'INBOUND' ? 'inbound' : 'outbound' %>">
                  <p><%= item.body || '(mensaje sin texto)' %></p>
                  <div class="conversation-meta">
                    <span><%= item.direction === 'INBOUND' ? 'Auxiliar → Lórren' : 'Lórren → auxiliar' %></span>
                    <span>· <%= historyDateTime(item.at) %></span>
                    <span>· <%= sourceLabel(item.source) %></span>
                    <% if (item.direction === 'OUTBOUND' && visibleState) { %><span>· <%= deliveryStatusLabel(visibleState, item.reconstructed) %></span><% } %>
                    <% if (item.reconstructed) { %><span class="conversation-legacy">· evidencia histórica</span><% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="history-empty">No hay mensajes de Despacho persistidos o reconstruibles para este auxiliar.</div>
          <% } %>
          <p class="history-help">Este historial usa exclusivamente la auditoría y las confirmaciones de WhatsApp de Despacho; no mezcla conversaciones del bot de Reclutamiento.</p>
        </section>
      <% } %>
    <% } %>

    <section class="cloud-grid <%= isDevView ? '' : 'single' %>">
      <article class="cloud-card <%= ready ? 'ready' : '' %>" id="statusCard">
        <span class="status-pill <%= ready ? 'ready' : '' %>" id="statusPill"><%= ready ? (isDevView ? 'Configurado' : 'Disponible') : (isDevView ? 'Configuración incompleta' : 'No disponible') %></span>
        <h2 id="statusTitle"><%= ready ? (isDevView ? 'WhatsApp Business Platform listo' : 'Canal de WhatsApp disponible') : (isDevView ? 'Faltan datos de configuración' : 'Canal de WhatsApp no disponible') %></h2>
        <% if (isDevView) { %>
          <p>Despacho se comunica directamente con la API oficial de Meta. Esta integración no utiliza WhatsApp Web, códigos QR, Chromium ni dispositivos vinculados.</p>
        <% } else { %>
          <p>Desde Asignaciones puedes continuar usando las acciones de WhatsApp habilitadas para tu perfil. La configuración técnica del canal está reservada para DEV.</p>
        <% } %>
        <div class="alert" id="errorBox" <%= lastError ? '' : 'hidden' %>><%= lastError || '' %></div>
        <% if (isDevView) { %>
          <div class="alert" id="missingBox" <%= missing.length ? '' : 'hidden' %>><strong>Variables pendientes:</strong><ul class="missing-list" id="missingList"><% missing.forEach((item) => { %><li><%= item %></li><% }) %></ul></div>
          <details class="technical" id="technicalDetails" <%= typeof technicalLastError !== 'undefined' && technicalLastError ? '' : 'hidden' %>><summary>Detalle técnico para dev</summary><div id="technicalError"><%= typeof technicalLastError !== 'undefined' ? (technicalLastError || '') : '' %></div></details>
        <% } %>
      </article>

      <% if (isDevView) { %>
        <article class="cloud-card">
          <h2>Configuración activa · solo DEV</h2>
          <ul class="meta-list">
            <li class="meta-row"><span class="meta-key">Proveedor</span><span class="meta-value" id="provider"><%= provider || 'META_CLOUD_API' %></span></li>
            <li class="meta-row"><span class="meta-key">Graph API</span><span class="meta-value" id="graphVersion"><%= graphVersion || '—' %></span></li>
            <li class="meta-row"><span class="meta-key">Phone Number ID</span><span class="meta-value" id="phoneNumberId"><%= phoneNumberIdMasked || '—' %></span></li>
            <li class="meta-row"><span class="meta-key">Plantilla de asignación</span><span class="meta-value" id="assignmentTemplate"><%= assignmentTemplateName || '—' %></span></li>
            <% if (typeof programmingTemplateName !== 'undefined' && programmingTemplateName) { %><li class="meta-row"><span class="meta-key">Plantilla de programación</span><span class="meta-value" id="programmingTemplate"><%= programmingTemplateName %></span></li><% } %>
            <li class="meta-row"><span class="meta-key">Idioma</span><span class="meta-value" id="templateLanguage"><%= templateLanguage || '—' %></span></li>
            <li class="meta-row"><span class="meta-key">Webhook</span><span class="meta-value" id="webhookPath"><%= webhookPath || '/webhook/dispatch' %></span></li>
            <li class="meta-row"><span class="meta-key">Último envío</span><span class="meta-value" id="lastOutbound"><%= lastOutboundAt || 'Sin registro desde este proceso' %></span></li>
            <li class="meta-row"><span class="meta-key">Última confirmación recibida</span><span class="meta-value" id="lastInbound"><%= lastInboundAt || 'Sin registro desde este proceso' %></span></li>
            <li class="meta-row"><span class="meta-key">Último estado Meta</span><span class="meta-value" id="lastProvider"><%= lastProviderStatus || '—' %></span></li>
          </ul>
          <div class="info">La aprobación y el contenido de las plantillas se administran en WhatsApp Manager. Los secretos no se muestran ni se guardan en esta vista.</div>
        </article>
      <% } %>
    </section>
  </main>

  <script>
    const isDev = <%= isDevView ? 'true' : 'false' %>;
    const statusEndpoint = <%- JSON.stringify(`${basePath}/estado`) %>;
    const statusCard = document.getElementById('statusCard'); const statusPill = document.getElementById('statusPill'); const statusTitle = document.getElementById('statusTitle'); const errorBox = document.getElementById('errorBox');
    const missingBox = document.getElementById('missingBox'); const missingList = document.getElementById('missingList'); const technicalDetails = document.getElementById('technicalDetails'); const technicalError = document.getElementById('technicalError');
    function formatBogota(value){if(!value)return 'Sin registro desde este proceso';const date=new Date(value);if(Number.isNaN(date.getTime()))return value;return new Intl.DateTimeFormat('es-CO',{timeZone:'America/Bogota',year:'numeric',month:'2-digit',day:'2-digit',hour:'numeric',minute:'2-digit',second:'2-digit',hour12:true}).format(date);}
    function text(id,value){const element=document.getElementById(id);if(element)element.textContent=value??'—';}
    function renderStatus(data){
      const ready=Boolean(data.ready);statusCard?.classList.toggle('ready',ready);
      if(statusPill){statusPill.classList.toggle('ready',ready);statusPill.textContent=ready?(isDev?'Configurado':'Disponible'):(isDev?'Configuración incompleta':'No disponible');}
      if(statusTitle)statusTitle.textContent=ready?(isDev?'WhatsApp Business Platform listo':'Canal de WhatsApp disponible'):(isDev?'Faltan datos de configuración':'Canal de WhatsApp no disponible');
      const error=data.lastError||(isDev?data.technicalLastError:null);if(errorBox){errorBox.hidden=!error;errorBox.textContent=error||'';}
      if(!isDev)return;
      const missing=Array.isArray(data.missingConfiguration)?data.missingConfiguration:[];if(missingBox)missingBox.hidden=missing.length===0;if(missingList)missingList.innerHTML=missing.map((item)=>`<li>${String(item).replace(/[<>&"]/g,'')}</li>`).join('');
      if(technicalDetails)technicalDetails.hidden=!data.technicalLastError;if(technicalError)technicalError.textContent=data.technicalLastError||'';
      text('provider',data.provider||'META_CLOUD_API');text('graphVersion',data.graphVersion||'—');text('phoneNumberId',data.phoneNumberIdMasked||'—');text('assignmentTemplate',data.assignmentTemplateName||'—');text('programmingTemplate',data.programmingTemplateName||'—');text('templateLanguage',data.templateLanguage||'—');text('webhookPath',data.webhookPath||'/webhook/dispatch');text('lastOutbound',formatBogota(data.lastOutboundAt));text('lastInbound',formatBogota(data.lastInboundAt));text('lastProvider',data.lastProviderStatus||'—');
    }
    async function refreshStatus(){try{const response=await fetch(statusEndpoint,{cache:'no-store',credentials:'same-origin',headers:{Accept:'application/json'}});if(!response.ok)throw new Error(`HTTP ${response.status}`);renderStatus(await response.json());}catch(error){console.error('No fue posible consultar el estado de WhatsApp de despacho.',error);}}
    document.getElementById('refreshStatus')?.addEventListener('click',refreshStatus);refreshStatus();window.setInterval(refreshStatus,15000);
  </script>
</body>
</html>
