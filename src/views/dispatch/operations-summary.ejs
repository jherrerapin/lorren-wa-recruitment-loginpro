<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Resumen operativo - LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .head{background:#fff;border:1px solid var(--border);border-radius:16px;padding:18px;box-shadow:var(--shadow-sm);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .head h1{margin:0;color:var(--navy)}
    .head p{margin:5px 0 0;color:var(--muted)}
    .client{background:#fff;border:1px solid var(--border);border-radius:16px;padding:16px;box-shadow:var(--shadow-sm);margin-top:14px}
    .request{background:#f8fafc;border:1px solid var(--border);border-radius:12px;padding:12px;margin-top:10px}
    .top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
    .muted{color:var(--muted);font-size:12px}
    .pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900;background:#e0f2fe;color:#075985}
    .pill-red{background:#fee2e2;color:#b91c1c}
    .worker{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:8px;margin-top:7px}
    .empty{background:#fff;border:1px dashed var(--border);border-radius:16px;padding:24px;text-align:center;color:var(--muted);margin-top:14px}
    .request-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}
    .request-actions form{margin:0}
    .danger-btn{border-color:#fecaca;background:#fff5f5;color:#b91c1c}
    .danger-btn:hover{background:#fee2e2}
    .locked-note{font-size:12px;color:var(--muted);font-weight:800}
    .detail{display:flex;flex-wrap:wrap;gap:6px 12px;margin-top:6px;color:var(--muted);font-size:12px}
    .incident-list{border-top:1px solid #e5e7eb;margin-top:12px;padding-top:10px;display:grid;gap:7px}
    .incident-row{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:8px;font-size:13px}
    .incident-row strong{color:var(--navy)}
    .incident-report{border:1px solid #bfdbfe;background:#eff6ff;border-radius:12px;padding:11px;margin-top:12px;display:grid;gap:9px}
    .incident-report summary{cursor:pointer;color:#1e40af;font-weight:900}
    .incident-context{background:#fff;border:1px solid #bfdbfe;border-radius:10px;padding:9px;color:var(--navy);font-size:12px;display:grid;gap:3px}
    .incident-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .incident-form-grid .full{grid-column:1 / -1}
    .incident-worker-field[hidden]{display:none}
    .async-toast{position:fixed;right:18px;bottom:18px;max-width:360px;background:#172033;color:#fff;border-radius:14px;padding:11px 13px;box-shadow:var(--shadow);font-size:13px;line-height:1.35;z-index:9999;opacity:0;transform:translateY(8px);transition:opacity .18s,transform .18s}.async-toast.show{opacity:1;transform:translateY(0)}
    @media(max-width:640px){.incident-form-grid{grid-template-columns:1fr}.incident-form-grid .full{grid-column:auto}.request-actions .btn,.request-actions button{width:100%}}
  </style>
</head>
<body>
  <% const fmtTime = (value) => { const match = String(value || '').trim().match(/^([01]?\d|2[0-3]):([0-5]\d)$/); if (!match) return value || '-'; let hour = Number(match[1]); const suffix = hour >= 12 ? 'PM' : 'AM'; hour = hour % 12 || 12; return `${hour}:${match[2]} ${suffix}`; }; %>
  <% const fmtHorario = (request) => request.endTime ? `${fmtTime(request.startTime)} - ${fmtTime(request.endTime)}` : fmtTime(request.startTime); %>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <a href="/admin/operaciones/asignaciones?fecha=<%= encodeURIComponent(selectedDate) %>">Asignación de auxiliares</a>
    <span class="spacer"></span>
  </nav>
  <main class="page">
    <section class="head">
      <div>
        <div class="eyebrow">Resumen operativo</div>
        <h1><%= meta?.title || 'Solicitudes del día' %></h1>
        <p>Fecha: <strong><%= selectedDate %></strong> · Registros: <strong><%= serviceRequests.length %></strong></p>
      </div>
      <div>
        <a class="btn" href="/admin/operaciones?fecha=<%= encodeURIComponent(selectedDate) %>">Volver</a>
        <a class="btn btn-primary" href="/admin/operaciones/asignaciones?fecha=<%= encodeURIComponent(selectedDate) %>">Asignaciones</a>
        <a class="btn" href="/admin/operaciones/solicitudes">Crear solicitud</a>
      </div>
    </section>
    <% if (!serviceRequests.length) { %><section class="empty">No hay solicitudes para este filtro.</section><% } %>
    <% for (const group of groupedByClient) { const clientName = group[0]; const requests = group[1]; %>
      <section class="client">
        <h2><%= clientName %></h2>
        <% for (const request of requests) { const active = activeAssignments(request); const confirmed = confirmedAssignments(request); const locked = isServiceRequestEditLocked(request); %>
          <article class="request">
            <div class="top">
              <div><strong><%= request.operationPointName || 'Sin operación' %></strong><div class="muted"><%= request.serviceName || request.service?.name || 'Sin servicio' %> · <%= fmtHorario(request) %></div></div>
              <div><span class="pill"><%= statusLabel(request.status) %></span><div class="muted"><%= active.length %>/<%= request.requiredWorkers || 0 %> asignados · <%= confirmed.length %>/<%= request.requiredWorkers || 0 %> confirmados</div></div>
            </div>
            <div class="detail"><span><strong>Ciudad:</strong> <%= request.cityName || '-' %></span><span><strong>Dirección:</strong> <%= request.address || '-' %></span></div>
            <% if (!active.length) { %><div class="worker muted">Sin auxiliares asignados.</div><% } %>
            <% active.forEach((assignment, index) => { const worker = assignment.worker || {}; %>
              <div class="worker"><strong><%= index + 1 %>. <%= worker.fullName || 'Auxiliar' %></strong><div class="muted"><%= worker.documentType || '' %> <%= worker.documentNumber || 'Sin documento' %> · <%= assignmentStatusLabel(assignment.status) %></div></div>
            <% }) %>
            <% if (request.incidents && request.incidents.length) { %>
              <div class="incident-list">
                <strong>Novedades abiertas</strong>
                <% request.incidents.forEach((incident) => { %>
                  <div class="incident-row">
                    <div><strong><%= incident.type %></strong><div class="muted"><%= incident.description %></div></div>
                    <span class="pill pill-red"><%= incident.status %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <div class="request-actions">
              <a class="btn btn-primary" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>&fecha=<%= encodeURIComponent(selectedDate) %>">Asignar / revisar</a>
              <% if (!locked) { %>
                <a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a>
                <form method="post" action="/admin/operaciones/solicitudes/<%= request.id %>/eliminar"><button class="btn danger-btn" type="submit">Eliminar</button></form>
              <% } else { %>
                <span class="locked-note">Consulta: edición y eliminación bloqueadas porque ya pasaron más de 2 horas desde la hora del servicio. La novedad sí se puede reportar.</span>
              <% } %>
            </div>
            <details class="incident-report">
              <summary>Reportar novedad de esta solicitud</summary>
              <div class="incident-context">
                <span><strong>Cliente:</strong> <%= request.clientName || 'Sin cliente' %></span>
                <span><strong>Operación:</strong> <%= request.operationPointName || 'Sin operación' %> · <%= request.cityName || 'Sin ciudad' %></span>
                <span><strong>Fecha y hora:</strong> <%= selectedDate %> · <%= fmtHorario(request) %></span>
                <span><strong>Auxiliares asignados:</strong> <%= request.assignments.length || 0 %></span>
              </div>
              <form method="post" action="/admin/operaciones/asignaciones/novedades" class="incident-create-form">
                <input type="hidden" name="serviceRequestId" value="<%= request.id %>" />
                <div class="incident-form-grid">
                  <div class="field">
                    <label>Tipo de novedad</label>
                    <select name="type" class="incident-type" required>
                      <option value="">Selecciona tipo</option>
                      <option value="INASISTENCIA">Inasistencia</option>
                      <option value="RETRASO">Retraso</option>
                      <option value="REEMPLAZO">Reemplazo / cambio de auxiliar</option>
                      <option value="CLIENTE">Novedad del cliente</option>
                      <option value="OPERATIVA">Novedad operativa</option>
                      <option value="OTRO">Otro</option>
                    </select>
                  </div>
                  <div class="field incident-worker-field" hidden>
                    <label>Auxiliar asignado relacionado</label>
                    <select name="assignmentWorker" class="incident-worker-select">
                      <option value="">Selecciona auxiliar asignado</option>
                      <% request.assignments.forEach((assignment) => { %>
                        <option value="<%= assignment.id %>|<%= assignment.workerId %>"><%= assignment.worker?.fullName || 'Auxiliar' %> — <%= assignmentStatusLabel(assignment.status) %></option>
                      <% }) %>
                    </select>
                    <input type="hidden" name="assignmentId" class="incident-assignment-id" />
                    <input type="hidden" name="workerId" class="incident-worker-id" />
                  </div>
                  <div class="field"><label>Reportado por</label><input name="reportedBy" placeholder="Nombre de quien reporta" /></div>
                  <div class="field full"><label>Descripción</label><textarea name="description" required placeholder="Describe qué ocurrió, impacto y acción esperada"></textarea></div>
                </div>
                <div class="request-actions"><button class="btn btn-primary" type="submit">Registrar novedad</button></div>
              </form>
            </details>
          </article>
        <% } %>
      </section>
    <% } %>
  </main>
  <div class="async-toast" id="asyncToast" role="status" aria-live="polite"></div>
  <script src="/public/service-request-delete-confirm.js"></script>
  <script>
    const incidentTypesWithWorker = new Set(['INASISTENCIA', 'RETRASO', 'REEMPLAZO']);
    const toast = document.getElementById('asyncToast');
    function showToast(message){if(!toast)return;toast.textContent=message;toast.classList.add('show');window.clearTimeout(showToast._t);showToast._t=window.setTimeout(()=>toast.classList.remove('show'),3000);}
    const initialMessage = new URLSearchParams(window.location.search).get('message');
    if (initialMessage) showToast(initialMessage);
    function reloadWithMessage(message){const url=new URL(window.location.href);url.searchParams.set('message',message);window.location.href=url.toString();}
    document.querySelectorAll('.incident-create-form').forEach((form) => {
      const typeSelect = form.querySelector('.incident-type');
      const workerField = form.querySelector('.incident-worker-field');
      const workerSelect = form.querySelector('.incident-worker-select');
      const assignmentInput = form.querySelector('.incident-assignment-id');
      const workerInput = form.querySelector('.incident-worker-id');
      function syncWorkerRequirement() {
        const requiresWorker = incidentTypesWithWorker.has(typeSelect.value);
        workerField.hidden = !requiresWorker;
        workerSelect.required = requiresWorker;
        if (!requiresWorker) {
          workerSelect.value = '';
          assignmentInput.value = '';
          workerInput.value = '';
        }
      }
      workerSelect?.addEventListener('change', () => {
        const [assignmentId = '', workerId = ''] = String(workerSelect.value || '').split('|');
        assignmentInput.value = assignmentId;
        workerInput.value = workerId;
      });
      typeSelect?.addEventListener('change', syncWorkerRequirement);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        syncWorkerRequirement();
        if (workerSelect.required && !workerSelect.value) {
          alert('Selecciona el auxiliar asignado relacionado con esta novedad.');
          return;
        }
        const button = form.querySelector('button[type="submit"]');
        const originalText = button?.textContent || 'Registrar novedad';
        if (button) { button.disabled = true; button.textContent = 'Registrando...'; }
        try {
          const payload = new URLSearchParams(new FormData(form));
          const response = await fetch(form.action, { method: 'POST', body: payload, headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'X-Requested-With': 'fetch' }, redirect: 'follow' });
          if (!response.ok) throw new Error('No fue posible registrar la novedad.');
          reloadWithMessage('Novedad registrada.');
        } catch (error) {
          showToast(error.message || 'No fue posible registrar la novedad.');
          if (button) { button.disabled = false; button.textContent = originalText; }
        }
      });
      syncWorkerRequirement();
    });
  </script>
</body>
</html>
