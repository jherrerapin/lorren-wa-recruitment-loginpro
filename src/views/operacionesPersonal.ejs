<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f4f5f7;
      --surface: #ffffff;
      --surface-2: #f9fafb;
      --border: #e1e4e8;
      --text: #1a1d23;
      --muted: #6b7280;
      --navy: #1e2d3d;
      --teal: #0d7a6b;
      --teal-hover: #0a5f53;
      --red: #b91c1c;
      --red-light: #fee2e2;
      --red-hover: #991b1b;
      --green: #166534;
      --green-light: #dcfce7;
      --blue: #1d4ed8;
      --blue-light: #dbeafe;
      --amber: #92400e;
      --amber-light: #fef3c7;
      --purple: #6b21a8;
      --purple-light: #f3e8ff;
      --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
      --shadow-md: 0 10px 28px rgba(15,23,42,.08);
      --radius: 12px;
      --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    body { font-family: var(--font); background: var(--bg); color: var(--text); font-size: 14px; }
    .navbar { background: var(--navy); padding: 0 24px; display: flex; align-items: center; gap: 20px; min-height: 52px; box-shadow: 0 2px 8px rgba(0,0,0,.2); }
    .navbar a { color: #cbd5e0; text-decoration: none; font-size: 13px; font-weight: 600; padding: 4px 2px; border-bottom: 2px solid transparent; }
    .navbar a:hover, .navbar a.nav-active { color: #fff; border-bottom-color: #4fd1c5; }
    .navbar .brand img { height: 28px; display: block; }
    .navbar .spacer { flex: 1; }
    .btn-logout { background: transparent; border: 1px solid rgba(255,255,255,.25); color: #cbd5e0 !important; padding: 6px 12px !important; border-radius: 7px; cursor: pointer; font-size: 12px; font-weight: 600; }
    .page { max-width: 1240px; margin: 0 auto; padding: 28px 20px 60px; display: grid; gap: 18px; }
    .hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; flex-wrap: wrap; background: linear-gradient(135deg, #fff 0%, #f0fdfa 100%); border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-md); }
    .eyebrow { color: var(--teal); font-size: 12px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 8px; }
    h1 { color: var(--navy); font-size: 28px; line-height: 1.15; margin-bottom: 8px; }
    .subtitle { color: var(--muted); line-height: 1.6; max-width: 720px; }
    .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; border: 1px solid var(--border); border-radius: 8px; padding: 7px 13px; background: var(--surface); color: var(--navy); text-decoration: none; font-size: 12px; font-weight: 700; cursor: pointer; box-shadow: var(--shadow-sm); white-space: nowrap; }
    .btn-primary { background: var(--teal); border-color: var(--teal); color: #fff; }
    .btn-primary:hover { background: var(--teal-hover); }
    .btn-secondary:hover { border-color: var(--teal); color: var(--teal); }
    .btn-danger { background: var(--red); border-color: var(--red); color: #fff; }
    .btn-danger:hover { background: var(--red-hover); }
    .btn-danger-outline { border-color: var(--red); color: var(--red); background: var(--surface); }
    .btn-danger-outline:hover { background: var(--red-light); }
    .btn:disabled { opacity: .45; cursor: not-allowed; pointer-events: none; }
    .alert { border: 1px solid #bfdbfe; background: var(--blue-light); color: var(--blue); border-radius: 12px; padding: 12px 14px; font-size: 13px; font-weight: 700; }
    .filters-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow-sm); }
    .filters-head { margin-bottom: 14px; }
    .filters-head h2 { color: var(--navy); font-size: 16px; margin-bottom: 3px; }
    .filters-head p { color: var(--muted); font-size: 13px; }
    .filters-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: end; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label { color: var(--muted); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
    select { width: 100%; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: var(--surface-2); color: var(--text); font-size: 14px; outline: none; }
    select:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,122,107,.12); }
    .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
    .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid #eaecef; flex-wrap: wrap; }
    .panel-head h2 { color: var(--navy); font-size: 17px; }
    .panel-head p { color: var(--muted); font-size: 13px; margin-top: 2px; }
    .bulk-bar { display: flex; align-items: center; gap: 10px; padding: 10px 20px; background: #fff7ed; border-bottom: 1px solid #fed7aa; flex-wrap: wrap; }
    .bulk-bar span { font-size: 13px; font-weight: 700; color: #92400e; }
    #bulk-bar { display: none; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 1020px; }
    th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid #eaecef; vertical-align: middle; }
    th { background: var(--surface-2); color: var(--muted); font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: .06em; }
    td { color: var(--text); font-size: 13px; }
    td.actions-cell { white-space: nowrap; }
    .check-col { width: 40px; text-align: center !important; padding: 10px 8px !important; }
    input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--teal); cursor: pointer; }
    tr.selected-row { background: #f0fdfa; }
    .muted { color: var(--muted); }
    .worker-name { color: var(--navy); font-weight: 800; }
    .pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 9px; font-size: 11px; font-weight: 800; margin: 2px 3px 2px 0; }
    .pill-green { color: var(--green); background: var(--green-light); }
    .pill-blue { color: var(--blue); background: var(--blue-light); }
    .pill-amber { color: var(--amber); background: var(--amber-light); }
    .pill-purple { color: var(--purple); background: var(--purple-light); }
    .pill-red { color: var(--red); background: var(--red-light); }
    .row-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .empty { padding: 42px 20px; text-align: center; color: var(--muted); }
    .empty strong { display: block; color: var(--navy); font-size: 16px; margin-bottom: 6px; }
    /* Modal */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1000; align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 16px; padding: 28px 28px 24px; max-width: 480px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,.18); }
    .modal h3 { color: var(--navy); font-size: 18px; margin-bottom: 10px; }
    .modal p { color: var(--muted); font-size: 14px; line-height: 1.6; margin-bottom: 20px; }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
    @media (max-width: 900px) { .navbar { flex-wrap: wrap; height: auto; padding: 10px 16px; } .navbar .spacer { display: none; } .filters-grid { grid-template-columns: 1fr 1fr; } .hero { padding: 20px; } }
    @media (max-width: 640px) { .page { padding: 18px 14px 42px; } .filters-grid { grid-template-columns: 1fr; } .hero-actions, .btn { width: 100%; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Equipo operativo</div>
        <h1><%= pageTitle %></h1>
        <p class="subtitle"><%= subtitle %></p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/admin/operaciones/personal/nuevo">+ Crear auxiliar manual</a>
        <a class="btn btn-secondary" href="/admin/operaciones/personal/importar-excel">&#11014; Importar Excel</a>
        <a class="btn btn-secondary" href="/admin/operaciones">Volver a Operaciones</a>
        <% if (role === 'dev') { %>
          <form method="post" action="/admin/operaciones/sync-contratados">
            <button type="submit" class="btn btn-primary">Sincronizar contratados</button>
          </form>
        <% } %>
      </div>
    </section>

    <% if (message) { %><div class="alert"><%= message %></div><% } %>

    <section class="filters-card">
      <div class="filters-head">
        <h2>Filtros de personal</h2>
        <p>Consulta disponibilidad por ciudad operativa, vacante o estado.</p>
      </div>
      <form method="get" action="/admin/operaciones/personal" class="filters-grid">
        <div class="field">
          <label for="operationalCityId">Ciudad operativa</label>
          <select id="operationalCityId" name="operationalCityId">
            <option value="">Todas las ciudades operativas</option>
            <% cities.forEach((city) => { %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="vacancyId">Vacante / perfil</label>
          <select id="vacancyId" name="vacancyId">
            <option value="">Todas las vacantes</option>
            <% vacancies.forEach((vacancy) => { %><option value="<%= vacancy.id %>" <%= filters.vacancyId===vacancy.id?'selected':'' %>><%= vacancy.title %> — <%= vacancy.city || 'Sin ciudad' %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Filtrar</button>
      </form>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>Listado de personal operativo</h2>
          <p>Personas disponibles para asignación a operaciones.</p>
        </div>
      </div>

      <!-- Barra de acciones masivas -->
      <div class="bulk-bar" id="bulk-bar">
        <span id="bulk-count">0 seleccionados</span>
        <button type="button" class="btn btn-danger" id="btn-bulk-delete">🗑 Eliminar seleccionados</button>
        <button type="button" class="btn btn-secondary" id="btn-bulk-cancel">Cancelar</button>
      </div>

      <% if (!workers.length) { %>
        <div class="empty">
          <strong>No hay personal contratado disponible.</strong>
          Solo se muestran auxiliares con estado "Contratado". Puedes importar desde Excel o sincronizar candidatos contratados.
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table id="workers-table">
            <thead>
              <tr>
                <th class="check-col"><input type="checkbox" id="check-all" title="Seleccionar todos" /></th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Documento</th>
                <th>Ciudad residencia</th>
                <th>Ciudades operativas</th>
                <th>Vacantes / perfiles</th>
                <th>Origen</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% workers.forEach((w) => { %>
                <% 
                  const sourceMap = { CANDIDATE: '🤖 Bot', MANUAL: '✍️ Manual', EXCEL_IMPORT: '📊 Excel masivo' };
                  const sourceLabel = sourceMap[w.source] || w.source;
                  const sourcePillClass = w.source === 'CANDIDATE' ? 'pill-green' : w.source === 'EXCEL_IMPORT' ? 'pill-purple' : 'pill-blue';
                  const isActive = w.operationalStatus === 'ACTIVE' || w.operationalStatus === 'CONTRATADO';
                %>
                <tr data-id="<%= w.id %>">
                  <td class="check-col">
                    <input type="checkbox" class="row-check" value="<%= w.id %>" />
                  </td>
                  <td><span class="worker-name"><%= w.fullName %></span></td>
                  <td><%= w.phone || '-' %></td>
                  <td><%= [w.documentType, w.documentNumber].filter(Boolean).join(' ') || '-' %></td>
                  <td><%= w.residenceCity || w.residenceLocality || '-' %></td>
                  <td>
                    <% if (w.cities.length) { %>
                      <% w.cities.forEach((entry) => { %><span class="pill pill-blue"><%= entry.city.name %></span><% }) %>
                    <% } else { %><span class="muted">Sin ciudades habilitadas</span><% } %>
                  </td>
                  <td>
                    <% if (w.vacancies.length) { %>
                      <% w.vacancies.forEach((entry) => { %><span class="pill pill-amber"><%= entry.vacancy.title %> — <%= entry.vacancy.city || 'Sin ciudad' %></span><% }) %>
                    <% } else { %><span class="muted">Sin perfiles habilitados</span><% } %>
                  </td>
                  <td><span class="pill <%= sourcePillClass %>"><%= sourceLabel %></span></td>
                  <td class="actions-cell">
                    <div class="row-actions">
                      <a class="btn btn-secondary" href="/operaciones/admin-worker/<%= w.id %>/editar">Editar</a>
                      <form method="post" action="/admin/operaciones/personal/<%= w.id %>/toggle" style="display:inline">
                        <button class="btn btn-secondary" type="submit"><%= isActive ? 'Desactivar' : 'Reactivar' %></button>
                      </form>
                      <button type="button" class="btn btn-danger-outline btn-single-delete"
                        data-id="<%= w.id %>" data-name="<%= w.fullName %>">Eliminar</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Modal confirmación eliminar uno -->
  <div class="modal-overlay" id="modal-single">
    <div class="modal">
      <h3>Eliminar auxiliar</h3>
      <p id="modal-single-msg">¿Estás seguro de que deseas eliminar a este auxiliar? Esta acción lo marcará como inactivo.</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="modal-single-cancel">Cancelar</button>
        <form method="post" id="modal-single-form">
          <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal confirmación eliminar varios -->
  <div class="modal-overlay" id="modal-bulk">
    <div class="modal">
      <h3>Eliminar seleccionados</h3>
      <p id="modal-bulk-msg">¿Confirmas la eliminación de los auxiliares seleccionados?</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="modal-bulk-cancel">Cancelar</button>
        <form method="post" action="/admin/operaciones/personal/eliminar-bulk" id="modal-bulk-form">
          <input type="hidden" name="ids" id="bulk-ids-input" value="" />
          <button type="submit" class="btn btn-danger">Sí, eliminar todos</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    // ── Selección de filas ──────────────────────────────────────────────────
    const checkAll = document.getElementById('check-all');
    const bulkBar = document.getElementById('bulk-bar');
    const bulkCount = document.getElementById('bulk-count');
    const bulkIdsInput = document.getElementById('bulk-ids-input');

    function getChecked() {
      return [...document.querySelectorAll('.row-check:checked')];
    }
    function refreshBulkBar() {
      const checked = getChecked();
      if (checked.length > 0) {
        bulkBar.style.display = 'flex';
        bulkCount.textContent = checked.length + ' seleccionado' + (checked.length > 1 ? 's' : '');
      } else {
        bulkBar.style.display = 'none';
      }
      const rows = document.querySelectorAll('.row-check');
      checkAll.indeterminate = checked.length > 0 && checked.length < rows.length;
      checkAll.checked = rows.length > 0 && checked.length === rows.length;
    }
    function highlightRows() {
      document.querySelectorAll('.row-check').forEach((cb) => {
        cb.closest('tr').classList.toggle('selected-row', cb.checked);
      });
    }

    if (checkAll) {
      checkAll.addEventListener('change', () => {
        document.querySelectorAll('.row-check').forEach((cb) => { cb.checked = checkAll.checked; });
        highlightRows();
        refreshBulkBar();
      });
    }
    document.querySelectorAll('.row-check').forEach((cb) => {
      cb.addEventListener('change', () => { highlightRows(); refreshBulkBar(); });
    });

    document.getElementById('btn-bulk-cancel')?.addEventListener('click', () => {
      document.querySelectorAll('.row-check').forEach((cb) => { cb.checked = false; });
      if (checkAll) { checkAll.checked = false; checkAll.indeterminate = false; }
      highlightRows();
      refreshBulkBar();
    });

    // ── Modal eliminar uno ──────────────────────────────────────────────────
    const modalSingle = document.getElementById('modal-single');
    const modalSingleMsg = document.getElementById('modal-single-msg');
    const modalSingleForm = document.getElementById('modal-single-form');

    document.querySelectorAll('.btn-single-delete').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const name = btn.dataset.name;
        modalSingleMsg.textContent = `¿Eliminar a "${name}"? Quedará marcado como inactivo.`;
        modalSingleForm.action = `/admin/operaciones/personal/${id}/eliminar`;
        modalSingle.classList.add('open');
      });
    });
    document.getElementById('modal-single-cancel')?.addEventListener('click', () => modalSingle.classList.remove('open'));
    modalSingle?.addEventListener('click', (e) => { if (e.target === modalSingle) modalSingle.classList.remove('open'); });

    // ── Modal eliminar varios ───────────────────────────────────────────────
    const modalBulk = document.getElementById('modal-bulk');
    const modalBulkMsg = document.getElementById('modal-bulk-msg');

    document.getElementById('btn-bulk-delete')?.addEventListener('click', () => {
      const checked = getChecked();
      if (!checked.length) return;
      bulkIdsInput.value = checked.map((cb) => cb.value).join(',');
      modalBulkMsg.textContent = `¿Confirmas eliminar ${checked.length} auxiliar${checked.length > 1 ? 'es' : ''}? Quedarán marcados como inactivos.`;
      modalBulk.classList.add('open');
    });
    document.getElementById('modal-bulk-cancel')?.addEventListener('click', () => modalBulk.classList.remove('open'));
    modalBulk?.addEventListener('click', (e) => { if (e.target === modalBulk) modalBulk.classList.remove('open'); });
  </script>
</body>
</html>
