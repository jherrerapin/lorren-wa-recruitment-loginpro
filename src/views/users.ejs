<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Usuarios de reclutamiento | LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f4f5f7; --surface: #fff; --surface-2: #f9fafb; --border: #e1e4e8;
      --text: #1a1d23; --text-muted: #6b7280; --navy: #1e2d3d; --teal: #0d7a6b;
      --teal-hover: #0a5f53; --teal-light: #e6f4f1; --red: #dc2626; --red-light: #fee2e2;
      --green: #166534; --green-light: #dcfce7; --amber: #92400e; --amber-light: #fef3c7;
      --shadow-sm: 0 1px 3px rgba(0,0,0,.08); --radius: 8px; --radius-lg: 12px;
      --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    body { font-family: var(--font); background: var(--bg); color: var(--text); font-size: 14px; }
    .navbar { background: var(--navy); padding: 0 24px; display: flex; align-items: center; gap: 20px; min-height: 52px; box-shadow: 0 2px 8px rgba(0,0,0,.2); }
    .navbar a { color: #cbd5e0; text-decoration: none; font-size: 13px; font-weight: 500; padding: 4px 2px; border-bottom: 2px solid transparent; }
    .navbar a:hover { color: #fff; border-bottom-color: rgba(255,255,255,.3); }
    .navbar a.nav-active { color: #fff; border-bottom-color: #4fd1c5; }
    .navbar .brand img { height: 28px; display: block; }
    .navbar .spacer { flex: 1; }
    .btn-logout { background: transparent; border: 1px solid rgba(255,255,255,.25); color: #cbd5e0 !important; padding: 5px 12px !important; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 500; }
    .page { max-width: 1240px; margin: 0 auto; padding: 28px 20px 60px; display: grid; gap: 18px; }
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .page-header h1 { font-size: 22px; color: var(--navy); }
    .page-header p { color: var(--text-muted); font-size: 13px; margin-top: 4px; max-width: 760px; line-height: 1.5; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 18px; }
    .card h2 { font-size: 16px; color: var(--navy); margin-bottom: 10px; }
    .form-card { padding: 24px; border-color: #dce3ea; }
    .form-head h2 { margin-bottom: 6px; }
    .form-head p { color: var(--text-muted); font-size: 13px; }
    .form-section { margin-top: 16px; border: 1px solid #e6ebf0; border-radius: 10px; padding: 14px; background: #fcfdff; }
    .form-section-title { font-size: 12px; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; }
    .permission-card { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 1px solid #99f6e4; background: #f0fdfa; border-radius: 10px; cursor: pointer; }
    .permission-card input { margin-top: 2px; }
    .permission-card strong { display: block; color: #0f766e; font-size: 14px; margin-bottom: 3px; }
    .permission-card small { display: block; color: #0f766e; font-size: 12px; line-height: 1.4; }
    .form-actions { margin-top: 16px; display: flex; justify-content: flex-end; }
    .alert { padding: 12px 14px; border-radius: var(--radius); font-size: 13px; font-weight: 600; }
    .alert-success { background: var(--green-light); color: var(--green); border: 1px solid #86efac; }
    .alert-error { background: var(--red-light); color: var(--red); border: 1px solid #fca5a5; }
    .alert-info { background: #eef6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; }
    .full { grid-column: 1 / -1; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; }
    .field input, .field select { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 14px; background: var(--surface-2); outline: none; }
    .field select[multiple] { min-height: 132px; padding: 6px; }
    .field select[multiple] option { padding: 7px 8px; border-radius: 5px; }
    .field input:focus, .field select:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,122,107,.12); }
    .field .checkbox-label { flex-direction: row; align-items: center; gap: 8px; color: var(--text); text-transform: none; letter-spacing: 0; font-size: 14px; }
    .field .checkbox-label input { width: auto; }
    .hint { font-size: 12px; color: #7b8794; line-height: 1.45; }
    .scope-note { margin-top: 8px; padding: 9px 10px; border-radius: 8px; background: #eef6ff; color: #1d4ed8; font-size: 12px; line-height: 1.45; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn { border: none; border-radius: 8px; padding: 10px 14px; cursor: pointer; font-size: 13px; font-weight: 700; }
    .form-actions .btn { min-width: 170px; }
    .btn-primary { background: var(--teal); color: #fff; }
    .btn-primary:hover { background: var(--teal-hover); }
    .btn-secondary { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
    .btn-danger { background: var(--red-light); color: var(--red); border: 1px solid #fca5a5; }
    .btn-warning { background: var(--amber-light); color: var(--amber); border: 1px solid #fcd34d; }
    .btn-edit { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .btn-edit:hover { background: #dbeafe; }
    .btn-sm { padding: 6px 10px; font-size: 12px; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 12px 10px; border-bottom: 1px solid #eaecef; vertical-align: top; }
    th { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }
    td small { display: block; color: var(--text-muted); margin-top: 4px; }
    tbody tr:hover { background: #f8fafc; }
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .badge-active { background: var(--green-light); color: var(--green); }
    .badge-inactive { background: var(--red-light); color: var(--red); }
    .inline-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 8px; }
    .inline-form input { min-width: 190px; }
    .recovery-box { margin-top: 8px; padding: 12px 14px; border-radius: var(--radius); border: 1px dashed #60a5fa; background: #eff6ff; color: #1d4ed8; font-size: 13px; font-weight: 700; }
    .edit-drawer { display: none; margin-top: 12px; padding: 14px; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 10px; min-width: 470px; }
    .edit-drawer.open { display: block; }
    .edit-drawer .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; }
    .edit-drawer .field input, .edit-drawer .field select { padding: 8px 10px; font-size: 13px; }
    .edit-drawer-title { font-size: 12px; font-weight: 800; color: #0f766e; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
    .dispatch-row { display: flex; align-items: center; gap: 8px; margin-top: 6px; font-size: 13px; }
    .dispatch-row input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--teal); }
    .edit-drawer-actions { margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end; }
    .empty { padding: 24px; text-align: center; color: var(--text-muted); }
    @media (max-width: 900px) {
      .navbar { flex-wrap: wrap; height: auto; padding: 10px 16px; gap: 10px 16px; }
      .navbar .spacer { display: none; }
      .navbar form { width: 100%; }
      .btn-logout { width: 100%; display: inline-flex; align-items: center; justify-content: center; }
      .page { padding: 18px 14px 42px; }
      .page-header { align-items: stretch; }
      .actions, .inline-form { flex-direction: column; align-items: stretch; }
      .inline-form input { min-width: 0; width: 100%; }
    }
    @media (max-width: 820px) {
      .grid, .edit-drawer .grid { grid-template-columns: 1fr; }
      .full { grid-column: 1; }
      table, thead, tbody, tr, td, th { display: block; }
      thead { display: none; }
      tr { border-bottom: 1px solid #eaecef; padding: 10px 0; }
      td { border: none; padding: 8px 0; }
      .edit-drawer { min-width: 0; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Candidatos</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/users" class="nav-active">Usuarios</a>
    <% if (role === 'dev' || canAccessDispatch) { %><a href="/admin/operaciones">Operaciones / Despacho</a><% } %>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <%
    const allowedCities = manageableScopeOptions.allowedCities || [];
    const allowedVacancies = manageableScopeOptions.allowedVacancies || [];
    function parseUserCities(value) {
      if (!value) return [];
      const raw = String(value).trim();
      if (!raw) return [];
      if (raw.startsWith('[')) {
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) return parsed.map((city) => String(city).trim()).filter(Boolean);
        } catch (error) {}
      }
      return [raw];
    }
  %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>Usuarios de reclutamiento</h1>
        <p>Crea y administra reclutadores. En la edición puedes conceder acceso total, acceso a varias ciudades con todas sus vacantes, o acceso a una sola vacante.</p>
      </div>
    </div>

    <% if (successMsg) { %><div class="alert alert-success"><%= successMsg %></div><% } %>
    <% if (errorMsg) { %><div class="alert alert-error"><%= errorMsg %></div><% } %>
    <% if (revealedRecoveryCode && highlightedUsername) { %>
      <div class="alert alert-info">Código de recuperación vigente para <strong><%= highlightedUsername %></strong>:<div class="recovery-box"><%= revealedRecoveryCode %></div></div>
    <% } %>

    <section class="card form-card">
      <div class="form-head">
        <h2>Crear usuario</h2>
        <p>El usuario puede crearse con alcance total, una ciudad o una vacante. Después podrás ampliar su acceso desde “Editar datos”.</p>
      </div>
      <form method="post" action="/admin/users/create">
        <div class="form-section">
          <h3 class="form-section-title">Acceso del usuario</h3>
          <div class="grid">
            <div class="field">
              <label for="password">Contraseña inicial</label>
              <input id="password" name="password" type="password" minlength="6" required />
              <span class="hint">Mínimo 6 caracteres.</span>
            </div>
            <div class="field">
              <label for="recoveryPhone">Teléfono de recuperación</label>
              <input id="recoveryPhone" name="recoveryPhone" type="text" />
            </div>
            <div class="field">
              <label for="recoveryEmail">Correo de recuperación</label>
              <input id="recoveryEmail" name="recoveryEmail" type="email" />
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section-title">Alcance inicial de reclutamiento</h3>
          <div class="grid">
            <div class="field">
              <label for="accessScope">Alcance</label>
              <select id="accessScope" name="accessScope">
                <% if (manageableScopeOptions.canCreateAll) { %><option value="ALL">Todas las vacantes</option><% } %>
                <% if (allowedCities.length) { %><option value="CITY" <%= manageableScopeOptions.canCreateAll ? '' : 'selected' %>>Solo una ciudad</option><% } %>
                <% if (allowedVacancies.length) { %><option value="VACANCY">Una vacante específica</option><% } %>
              </select>
            </div>
            <div class="field" id="cityField">
              <label for="scopeCity">Ciudad</label>
              <select id="scopeCity" name="scopeCity">
                <option value="">Selecciona una ciudad</option>
                <% for (const city of allowedCities) { %><option value="<%= city %>"><%= city %></option><% } %>
              </select>
            </div>
            <div class="field full" id="vacancyField">
              <label for="scopeVacancyId">Vacante</label>
              <select id="scopeVacancyId" name="scopeVacancyId">
                <option value="">Selecciona una vacante</option>
                <% for (const vacancy of allowedVacancies) { %><option value="<%= vacancy.id %>"><%= vacancy.city %> · <%= vacancy.title || vacancy.role %></option><% } %>
              </select>
            </div>
          </div>
        </div>

        <% if (role === 'dev') { %>
          <div class="form-section">
            <h3 class="form-section-title">Permisos del panel</h3>
            <label class="permission-card" for="canAccessDispatch">
              <input id="canAccessDispatch" name="canAccessDispatch" type="checkbox" value="true" />
              <span><strong>Permitir acceso a Operaciones / Despacho</strong><small>Permite entrar al panel operativo además del alcance de reclutamiento seleccionado.</small></span>
            </label>
          </div>
        <% } %>

        <div class="form-actions"><button class="btn btn-primary" type="submit">Crear usuario</button></div>
      </form>
      <p class="hint" style="margin-top:12px;">El username se genera automáticamente como <strong>reclutador-...</strong>. Si ya existe, el sistema agrega un consecutivo.</p>
    </section>

    <section class="card">
      <h2>Usuarios creados</h2>
      <% if (!users.length) { %>
        <div class="empty">Todavía no hay usuarios creados en base de datos para este alcance.</div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Usuario</th><th>Alcance</th><th>Permisos</th><th>Estado</th><th>Recuperación</th><th>Acciones</th></tr></thead>
            <tbody>
              <% for (const user of users) { %>
                <%
                  const selectedUserCities = parseUserCities(user.scopeCity);
                  const selectedCitySet = new Set(selectedUserCities);
                %>
                <tr>
                  <td>
                    <strong><%= user.username %></strong>
                    <% if (user.username === highlightedUsername) { %><small>Último usuario intervenido</small><% } %>
                    <small>Creado por: <%= user.createdByUsername || 'Sistema' %></small>
                  </td>
                  <td>
                    <%= describeUserScope(user) %>
                    <% if (user.accessScope === 'CITY' && selectedUserCities.length > 1) { %><small>Incluye todas las vacantes de estas ciudades.</small><% } %>
                    <% if (user.scopeVacancy?.city) { %><small>Ciudad operativa: <%= user.scopeVacancy.city %></small><% } %>
                  </td>
                  <td><%= user.canAccessDispatch ? 'Operaciones / Despacho' : 'Reclutamiento' %></td>
                  <td>
                    <span class="badge <%= user.isActive ? 'badge-active' : 'badge-inactive' %>"><%= user.isActive ? 'Activo' : 'Inactivo' %></span>
                    <small>Último cambio de contraseña: <%= user.lastPasswordResetAt ? user.lastPasswordResetAt.toLocaleString('es-CO', { hour12: false }) : 'Sin registro' %></small>
                  </td>
                  <td>
                    <small>Tel: <%= user.recoveryPhone || '—' %></small>
                    <small>Correo recuperación: <%= user.recoveryEmail || '—' %></small>
                    <small>El usuario puede recuperar acceso desde /recover con el código vigente.</small>
                  </td>
                  <td>
                    <form method="post" action="/admin/users/<%= user.id %>/toggle" class="inline-form">
                      <button type="submit" class="btn <%= user.isActive ? 'btn-danger' : 'btn-secondary' %>"><%= user.isActive ? 'Desactivar' : 'Activar' %></button>
                    </form>
                    <form method="post" action="/admin/users/<%= user.id %>/reset-recovery-code" class="inline-form">
                      <button type="submit" class="btn btn-warning">Regenerar código</button>
                    </form>
                    <form method="post" action="/admin/users/<%= user.id %>/reset-password" class="inline-form">
                      <input name="newPassword" type="password" minlength="6" placeholder="Nueva contraseña" required />
                      <button type="submit" class="btn btn-secondary">Resetear contraseña</button>
                    </form>
                    <div class="inline-form"><button type="button" class="btn btn-edit btn-sm" onclick="toggleEditDrawer('<%= user.id %>')">Editar datos y acceso</button></div>

                    <div class="edit-drawer" id="edit-drawer-<%= user.id %>">
                      <form method="post" action="/admin/locations/users/<%= user.id %>/edit">
                        <p class="edit-drawer-title">Editar usuario <%= user.username %></p>
                        <div class="grid">
                          <div class="field">
                            <label for="edit-recoveryEmail-<%= user.id %>">Correo de recuperación</label>
                            <input id="edit-recoveryEmail-<%= user.id %>" name="recoveryEmail" type="email" value="<%= user.recoveryEmail || '' %>" placeholder="correo@dominio.com" />
                          </div>
                          <div class="field">
                            <label for="edit-recoveryPhone-<%= user.id %>">Teléfono de recuperación</label>
                            <input id="edit-recoveryPhone-<%= user.id %>" name="recoveryPhone" type="text" value="<%= user.recoveryPhone || '' %>" placeholder="3001234567" />
                          </div>

                          <div class="field full">
                            <label for="edit-accessScope-<%= user.id %>">Alcance de reclutamiento</label>
                            <select id="edit-accessScope-<%= user.id %>" name="accessScope" data-edit-scope="<%= user.id %>">
                              <option value="ALL" <%= user.accessScope === 'ALL' ? 'selected' : '' %>>Todas las ciudades y vacantes</option>
                              <option value="CITY" <%= user.accessScope === 'CITY' ? 'selected' : '' %>>Una o varias ciudades</option>
                              <option value="VACANCY" <%= user.accessScope === 'VACANCY' ? 'selected' : '' %>>Una vacante específica</option>
                            </select>
                          </div>

                          <div class="field full" id="edit-city-field-<%= user.id %>">
                            <label for="edit-scopeCities-<%= user.id %>">Ciudades permitidas</label>
                            <select id="edit-scopeCities-<%= user.id %>" name="scopeCities" multiple>
                              <% for (const city of allowedCities) { %><option value="<%= city %>" <%= selectedCitySet.has(city) ? 'selected' : '' %>><%= city %></option><% } %>
                            </select>
                            <span class="hint">Puedes seleccionar varias. En computador usa Ctrl o Cmd; en celular toca cada ciudad disponible.</span>
                          </div>

                          <div class="field full" id="edit-vacancy-field-<%= user.id %>">
                            <label for="edit-scopeVacancyId-<%= user.id %>">Vacante específica</label>
                            <select id="edit-scopeVacancyId-<%= user.id %>" name="scopeVacancyId">
                              <option value="">Selecciona una vacante</option>
                              <% for (const vacancy of allowedVacancies) { %><option value="<%= vacancy.id %>" <%= user.scopeVacancyId === vacancy.id ? 'selected' : '' %>><%= vacancy.city %> · <%= vacancy.title || vacancy.role %></option><% } %>
                            </select>
                          </div>

                          <% if (role === 'dev') { %>
                            <div class="field full">
                              <label>Permisos adicionales</label>
                              <label class="dispatch-row"><input type="checkbox" name="canAccessDispatch" value="true" <%= user.canAccessDispatch ? 'checked' : '' %> />Acceso a Operaciones / Despacho</label>
                            </div>
                          <% } %>
                        </div>
                        <div class="scope-note">Al seleccionar varias ciudades, el usuario podrá ver candidatos y vacantes de todas ellas. El cambio se aplica cuando el usuario vuelva a iniciar sesión.</div>
                        <div class="edit-drawer-actions">
                          <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEditDrawer('<%= user.id %>')">Cancelar</button>
                          <button type="submit" class="btn btn-primary btn-sm">Guardar cambios</button>
                        </div>
                      </form>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </div>

  <script>
    (function () {
      const accessScope = document.getElementById('accessScope');
      const cityField = document.getElementById('cityField');
      const vacancyField = document.getElementById('vacancyField');

      function syncCreateScopeVisibility() {
        const scope = accessScope ? accessScope.value : 'ALL';
        if (cityField) cityField.style.display = scope === 'CITY' ? 'flex' : 'none';
        if (vacancyField) vacancyField.style.display = scope === 'VACANCY' ? 'flex' : 'none';
      }

      if (accessScope) {
        accessScope.addEventListener('change', syncCreateScopeVisibility);
        syncCreateScopeVisibility();
      }

      document.querySelectorAll('[data-edit-scope]').forEach(function (select) {
        select.addEventListener('change', function () { syncEditScope(select.dataset.editScope); });
        syncEditScope(select.dataset.editScope);
      });
    })();

    function syncEditScope(userId) {
      const scopeSelect = document.getElementById('edit-accessScope-' + userId);
      const cityField = document.getElementById('edit-city-field-' + userId);
      const vacancyField = document.getElementById('edit-vacancy-field-' + userId);
      const scope = scopeSelect ? scopeSelect.value : 'ALL';
      if (cityField) cityField.style.display = scope === 'CITY' ? 'flex' : 'none';
      if (vacancyField) vacancyField.style.display = scope === 'VACANCY' ? 'flex' : 'none';
    }

    function toggleEditDrawer(userId) {
      const drawer = document.getElementById('edit-drawer-' + userId);
      if (!drawer) return;
      drawer.classList.toggle('open');
      if (drawer.classList.contains('open')) syncEditScope(userId);
    }
  </script>
</body>
</html>
