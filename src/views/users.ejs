<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Usuarios de reclutamiento | LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f4f5f7; --surface: #fff; --surface-2: #f9fafb; --border: #e1e4e8;
      --text: #1a1d23; --text-muted: #6b7280; --navy: #1e2d3d; --teal: #0d7a6b;
      --teal-hover: #0a5f53; --teal-light: #e6f4f1; --red: #dc2626; --red-light: #fee2e2;
      --green: #166534; --green-light: #dcfce7; --amber: #92400e; --amber-light: #fef3c7;
      --shadow-sm: 0 1px 3px rgba(0,0,0,.08); --radius: 8px; --radius-lg: 12px;
      --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    body { font-family: var(--font); background: var(--bg); color: var(--text); font-size: 14px; }
    .navbar { background: var(--navy); padding: 0 24px; display: flex; align-items: center; gap: 20px; height: 52px; box-shadow: 0 2px 8px rgba(0,0,0,.2); }
    .navbar a { color: #cbd5e0; text-decoration: none; font-size: 13px; font-weight: 500; padding: 4px 2px; border-bottom: 2px solid transparent; }
    .navbar a:hover { color: #fff; border-bottom-color: rgba(255,255,255,.3); }
    .navbar a.nav-active { color: #fff; border-bottom-color: #4fd1c5; }
    .navbar .brand img { height: 28px; display: block; }
    .navbar .spacer { flex: 1; }
    .btn-logout { background: transparent; border: 1px solid rgba(255,255,255,.25); color: #cbd5e0 !important; padding: 5px 12px !important; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 500; }
    .page { max-width: 1240px; margin: 0 auto; padding: 28px 20px 60px; display: grid; gap: 18px; }
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .page-header h1 { font-size: 22px; color: var(--navy); }
    .page-header p { color: var(--text-muted); font-size: 13px; margin-top: 4px; max-width: 820px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 18px; }
    .card h2 { font-size: 16px; color: var(--navy); margin-bottom: 10px; }
    .form-card { padding: 24px; border-color: #dce3ea; }
    .form-head h2 { margin-bottom: 6px; }
    .form-head p { color: var(--text-muted); font-size: 13px; }
    .form-section { margin-top: 16px; border: 1px solid #e6ebf0; border-radius: 10px; padding: 14px; background: #fcfdff; }
    .form-section-title { font-size: 12px; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; }
    .permission-card { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 1px solid #99f6e4; background: #f0fdfa; border-radius: 10px; cursor: pointer; }
    .permission-card input { margin-top: 2px; }
    .permission-card strong { display: block; color: #0f766e; font-size: 14px; margin-bottom: 3px; }
    .permission-card small { display: block; color: #0f766e; font-size: 12px; line-height: 1.4; }
    .form-actions { margin-top: 16px; display: flex; justify-content: flex-end; }
    .alert { padding: 12px 14px; border-radius: var(--radius); font-size: 13px; font-weight: 600; }
    .alert-success { background: var(--green-light); color: var(--green); border: 1px solid #86efac; }
    .alert-error { background: var(--red-light); color: var(--red); border: 1px solid #fca5a5; }
    .alert-info { background: #eef6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; }
    .full { grid-column: 1 / -1; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .04em; }
    .field input, .field select { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 14px; background: var(--surface-2); outline: none; }
    .field input:focus, .field select:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13,122,107,.12); }
    .hint { font-size: 12px; color: #7b8794; line-height: 1.45; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn { border: none; border-radius: 8px; padding: 10px 14px; cursor: pointer; font-size: 13px; font-weight: 700; }
    .form-actions .btn { min-width: 170px; }
    .btn-primary { background: var(--teal); color: #fff; }
    .btn-primary:hover { background: var(--teal-hover); }
    .btn-secondary { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
    .btn-danger { background: var(--red-light); color: var(--red); border: 1px solid #fca5a5; }
    .btn-warning { background: var(--amber-light); color: var(--amber); border: 1px solid #fcd34d; }
    .btn-edit { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .btn-edit:hover { background: #dbeafe; }
    .btn-sm { padding: 6px 10px; font-size: 12px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 12px 10px; border-bottom: 1px solid #eaecef; vertical-align: top; }
    th { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }
    td small { display: block; color: var(--text-muted); margin-top: 4px; }
    tbody tr:hover { background: #f8fafc; }
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .badge-active { background: var(--green-light); color: var(--green); }
    .badge-inactive { background: var(--red-light); color: var(--red); }
    .inline-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 8px; }
    .inline-form input { min-width: 190px; }
    .recovery-box { margin-top: 8px; padding: 12px 14px; border-radius: var(--radius); border: 1px dashed #60a5fa; background: #eff6ff; color: #1d4ed8; font-size: 13px; font-weight: 700; }
    .edit-drawer { display: none; margin-top: 12px; padding: 14px; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 10px; min-width: 620px; }
    .edit-drawer.open { display: block; }
    .edit-drawer .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; }
    .edit-drawer .field input, .edit-drawer .field select { padding: 8px 10px; font-size: 13px; }
    .edit-drawer-title { font-size: 12px; font-weight: 800; color: #0f766e; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
    .dispatch-row { display: flex !important; flex-direction: row; align-items: center; gap: 8px; margin-top: 6px; color: var(--text) !important; text-transform: none !important; letter-spacing: 0 !important; font-size: 13px !important; }
    .dispatch-row input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--teal); }
    .edit-drawer-actions { margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end; }
    .access-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; max-height: 230px; overflow-y: auto; }
    .access-option { display: flex !important; flex-direction: row; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; color: var(--text) !important; text-transform: none !important; letter-spacing: 0 !important; font-size: 13px !important; cursor: pointer; }
    .access-option:hover { background: var(--teal-light); }
    .access-option input { width: auto !important; min-width: 0 !important; }
    .vacancy-access-list { display: grid; gap: 10px; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; max-height: 330px; overflow-y: auto; }
    .vacancy-city-group { display: none; padding: 10px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; }
    .vacancy-city-title { display: block; margin-bottom: 6px; color: var(--navy); font-size: 12px; }
    .vacancy-empty { padding: 10px; color: var(--text-muted); font-size: 12px; text-align: center; }
    .scope-vacancy-item { margin-top: 3px; }
    .empty { padding: 24px; text-align: center; color: var(--text-muted); }
    @media (max-width: 900px) {
      .navbar { flex-wrap: wrap; height: auto; padding: 10px 16px; gap: 10px 16px; }
      .navbar .spacer { display: none; }
      .navbar form { width: 100%; }
      .btn-logout { width: 100%; display: inline-flex; align-items: center; justify-content: center; }
      .page { padding: 18px 14px 42px; }
      .page-header { align-items: stretch; }
      .actions, .inline-form { flex-direction: column; align-items: stretch; }
      .inline-form input { min-width: 0; width: 100%; }
    }
    @media (max-width: 820px) {
      .grid { grid-template-columns: 1fr; }
      .full { grid-column: 1; }
      .edit-drawer { min-width: 0; }
      .edit-drawer .grid, .access-list { grid-template-columns: 1fr; }
      table, thead, tbody, tr, td, th { display: block; }
      thead { display: none; }
      tr { border-bottom: 1px solid #eaecef; padding: 10px 0; }
      td { border: none; padding: 8px 0; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Candidatos</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/users" class="nav-active">Usuarios</a>
    <% if (role === 'dev' || canAccessDispatch) { %><a href="/admin/operaciones">Operaciones / Despacho</a><% } %>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <%
    const allowedCities = manageableScopeOptions.allowedCities || [];
    const allowedVacancies = manageableScopeOptions.allowedVacancies || [];
    const parseAccessMetadata = (rawValue) => {
      const empty = { cities: [], vacancyIds: [] };
      if (Array.isArray(rawValue)) return { cities: rawValue.filter(Boolean), vacancyIds: [] };
      const raw = typeof rawValue === 'string' ? rawValue.trim() : '';
      if (!raw) return empty;
      if (raw.startsWith('{')) {
        try {
          const parsed = JSON.parse(raw);
          return {
            cities: Array.isArray(parsed?.cities) ? parsed.cities.filter(Boolean) : [],
            vacancyIds: Array.isArray(parsed?.vacancyIds) ? parsed.vacancyIds.filter(Boolean) : []
          };
        } catch (_error) { return empty; }
      }
      if (raw.startsWith('[')) {
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) return { cities: parsed.filter(Boolean), vacancyIds: [] };
        } catch (_error) { return empty; }
      }
      return { cities: [raw], vacancyIds: [] };
    };
  %>

  <div class="page">
    <div class="page-header">
      <div>
        <h1>Usuarios de reclutamiento</h1>
        <p>Al editar un usuario, primero selecciona una o varias ciudades y después marca únicamente las vacantes que podrá administrar. Marcar una ciudad no concede acceso automático a todas sus vacantes.</p>
      </div>
    </div>

    <% if (successMsg) { %><div class="alert alert-success"><%= successMsg %></div><% } %>
    <% if (errorMsg) { %><div class="alert alert-error"><%= errorMsg %></div><% } %>
    <% if (revealedRecoveryCode && highlightedUsername) { %>
      <div class="alert alert-info">Código de recuperación vigente para <strong><%= highlightedUsername %></strong>:<div class="recovery-box"><%= revealedRecoveryCode %></div></div>
    <% } %>

    <section class="card form-card">
      <div class="form-head"><h2>Crear usuario</h2><p>Define el acceso inicial. Después puedes ajustar varias vacantes desde la edición del usuario.</p></div>
      <form method="post" action="/admin/users/create">
        <div class="form-section">
          <h3 class="form-section-title">Acceso del usuario</h3>
          <div class="grid">
            <div class="field"><label for="password">Contraseña inicial</label><input id="password" name="password" type="password" minlength="6" required /><span class="hint">Mínimo 6 caracteres.</span></div>
            <div class="field"><label for="recoveryPhone">Teléfono de recuperación</label><input id="recoveryPhone" name="recoveryPhone" type="text" /></div>
            <div class="field"><label for="recoveryEmail">Correo de recuperación</label><input id="recoveryEmail" name="recoveryEmail" type="email" /></div>
          </div>
        </div>
        <div class="form-section">
          <h3 class="form-section-title">Alcance inicial de reclutamiento</h3>
          <div class="grid">
            <div class="field"><label for="accessScope">Alcance</label><select id="accessScope" name="accessScope">
              <% if (manageableScopeOptions.canCreateAll) { %><option value="ALL">Todas las vacantes</option><% } %>
              <% if (allowedCities.length) { %><option value="CITY" <%= manageableScopeOptions.canCreateAll ? '' : 'selected' %>>Una ciudad</option><% } %>
              <% if (allowedVacancies.length) { %><option value="VACANCY">Una vacante específica</option><% } %>
            </select></div>
            <div class="field" id="cityField"><label for="scopeCity">Ciudad</label><select id="scopeCity" name="scopeCity"><option value="">Selecciona una ciudad</option><% for (const city of allowedCities) { %><option value="<%= city %>"><%= city %></option><% } %></select></div>
            <div class="field full" id="vacancyField"><label for="scopeVacancyId">Vacante</label><select id="scopeVacancyId" name="scopeVacancyId"><option value="">Selecciona una vacante</option><% for (const vacancy of allowedVacancies) { %><option value="<%= vacancy.id %>"><%= vacancy.city %> · <%= vacancy.title || vacancy.role %></option><% } %></select></div>
          </div>
        </div>
        <% if (role === 'dev') { %><div class="form-section"><h3 class="form-section-title">Permisos del panel</h3><label class="permission-card" for="canAccessDispatch"><input id="canAccessDispatch" name="canAccessDispatch" type="checkbox" value="true" /><span><strong>Permitir acceso a Operaciones / Despacho</strong><small>Permite entrar al panel operativo además del alcance de reclutamiento seleccionado.</small></span></label></div><% } %>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Crear usuario</button></div>
      </form>
      <p class="hint" style="margin-top:12px;">El username se genera automáticamente como <strong>reclutador-...</strong>. Si ya existe, el sistema agrega un consecutivo.</p>
    </section>

    <section class="card">
      <h2>Usuarios creados</h2>
      <% if (!users.length) { %><div class="empty">Todavía no hay usuarios creados en base de datos para este alcance.</div><% } else { %>
        <table>
          <thead><tr><th>Usuario</th><th>Alcance</th><th>Permisos</th><th>Estado</th><th>Recuperación</th><th>Acciones</th></tr></thead>
          <tbody>
            <% for (const user of users) {
              const metadata = parseAccessMetadata(user.scopeCity);
              const userVacancyIds = [...new Set([...metadata.vacancyIds, user.scopeVacancyId].filter(Boolean))];
              const selectedVacancies = allowedVacancies.filter((vacancy) => userVacancyIds.includes(vacancy.id));
              const userCities = [...new Set([...metadata.cities, ...selectedVacancies.map((vacancy) => vacancy.city)].filter(Boolean))];
            %>
              <tr>
                <td><strong><%= user.username %></strong><% if (user.username === highlightedUsername) { %><small>Último usuario intervenido</small><% } %><small>Creado por: <%= user.createdByUsername || 'Sistema' %></small></td>
                <td>
                  <% if (user.accessScope === 'ALL') { %>
                    Todas las vacantes
                  <% } else if (selectedVacancies.length) { %>
                    <%= selectedVacancies.length === 1 ? '1 vacante seleccionada' : `${selectedVacancies.length} vacantes seleccionadas` %>
                    <% for (const vacancy of selectedVacancies) { %><small class="scope-vacancy-item"><%= vacancy.city %> · <%= vacancy.title || vacancy.role %></small><% } %>
                  <% } else { %>
                    <%= describeUserScope(user) %>
                    <small>Acceso anterior pendiente de convertir a vacantes específicas.</small>
                  <% } %>
                </td>
                <td><%= user.canAccessDispatch ? 'Reclutamiento + Operaciones / Despacho' : 'Reclutamiento' %></td>
                <td><span class="badge <%= user.isActive ? 'badge-active' : 'badge-inactive' %>"><%= user.isActive ? 'Activo' : 'Inactivo' %></span><small>Último cambio de contraseña: <%= user.lastPasswordResetAt ? user.lastPasswordResetAt.toLocaleString('es-CO', { hour12: false }) : 'Sin registro' %></small></td>
                <td><small>Tel: <%= user.recoveryPhone || '—' %></small><small>Correo: <%= user.recoveryEmail || '—' %></small><small>Recuperación disponible desde /recover.</small></td>
                <td>
                  <form method="post" action="/admin/users/<%= user.id %>/toggle" class="inline-form"><button type="submit" class="btn <%= user.isActive ? 'btn-danger' : 'btn-secondary' %>"><%= user.isActive ? 'Desactivar' : 'Activar' %></button></form>
                  <form method="post" action="/admin/users/<%= user.id %>/reset-recovery-code" class="inline-form"><button type="submit" class="btn btn-warning">Regenerar código</button></form>
                  <form method="post" action="/admin/users/<%= user.id %>/reset-password" class="inline-form"><input name="newPassword" type="password" minlength="6" placeholder="Nueva contraseña" required /><button type="submit" class="btn btn-secondary">Resetear contraseña</button></form>
                  <div class="inline-form"><button type="button" class="btn btn-edit btn-sm" onclick="toggleEditDrawer('<%= user.id %>')">Editar datos y acceso</button></div>

                  <div class="edit-drawer" id="edit-drawer-<%= user.id %>">
                    <form method="post" action="/admin/locations/users/<%= user.id %>/access">
                      <p class="edit-drawer-title">Editar usuario <%= user.username %></p>
                      <div class="grid">
                        <div class="field"><label for="edit-recoveryEmail-<%= user.id %>">Correo de recuperación</label><input id="edit-recoveryEmail-<%= user.id %>" name="recoveryEmail" type="email" value="<%= user.recoveryEmail || '' %>" placeholder="correo@dominio.com" /></div>
                        <div class="field"><label for="edit-recoveryPhone-<%= user.id %>">Teléfono de recuperación</label><input id="edit-recoveryPhone-<%= user.id %>" name="recoveryPhone" type="text" value="<%= user.recoveryPhone || '' %>" placeholder="3001234567" /></div>
                        <div class="field full">
                          <label for="edit-accessScope-<%= user.id %>">Alcance de reclutamiento</label>
                          <select id="edit-accessScope-<%= user.id %>" name="accessScope" onchange="syncEditScopeVisibility('<%= user.id %>')">
                            <option value="ALL" <%= user.accessScope === 'ALL' ? 'selected' : '' %>>Todas las ciudades y vacantes</option>
                            <option value="VACANCY" <%= user.accessScope !== 'ALL' ? 'selected' : '' %>>Vacantes seleccionadas por ciudad</option>
                          </select>
                        </div>
                        <div class="field full" id="edit-cityField-<%= user.id %>">
                          <label>1. Ciudades para consultar vacantes</label>
                          <div class="access-list">
                            <% for (const city of allowedCities) { %>
                              <label class="access-option">
                                <input type="checkbox" name="scopeCities" value="<%= city %>" <%= userCities.includes(city) ? 'checked' : '' %> onchange="syncVacancyGroups('<%= user.id %>')" />
                                <span><%= city %></span>
                              </label>
                            <% } %>
                          </div>
                          <span class="hint">La ciudad solamente filtra la lista siguiente. No concede acceso por sí sola.</span>
                        </div>
                        <div class="field full" id="edit-vacancyField-<%= user.id %>">
                          <label>2. Vacantes permitidas</label>
                          <div class="vacancy-access-list">
                            <% for (const city of allowedCities) {
                              const cityVacancies = allowedVacancies.filter((vacancy) => vacancy.city === city);
                            %>
                              <div class="vacancy-city-group" data-city="<%= city %>">
                                <strong class="vacancy-city-title"><%= city %></strong>
                                <% if (!cityVacancies.length) { %>
                                  <div class="vacancy-empty">Esta ciudad no tiene vacantes disponibles.</div>
                                <% } else { %>
                                  <% for (const vacancy of cityVacancies) { %>
                                    <label class="access-option">
                                      <input type="checkbox" name="scopeVacancyIds" value="<%= vacancy.id %>" <%= userVacancyIds.includes(vacancy.id) ? 'checked' : '' %> />
                                      <span><%= vacancy.title || vacancy.role %></span>
                                    </label>
                                  <% } %>
                                <% } %>
                              </div>
                            <% } %>
                            <div class="vacancy-empty" id="edit-vacancyEmpty-<%= user.id %>">Selecciona una ciudad para ver sus vacantes.</div>
                          </div>
                          <span class="hint">Debes marcar al menos una vacante. Las vacantes nuevas no se habilitarán automáticamente.</span>
                        </div>
                        <% if (role === 'dev') { %><div class="field full"><label>Permisos adicionales</label><label class="dispatch-row"><input type="checkbox" name="canAccessDispatch" value="true" <%= user.canAccessDispatch ? 'checked' : '' %> />Acceso a Operaciones / Despacho</label></div><% } %>
                      </div>
                      <div class="edit-drawer-actions"><button type="button" class="btn btn-secondary btn-sm" onclick="toggleEditDrawer('<%= user.id %>')">Cancelar</button><button type="submit" class="btn btn-primary btn-sm">Guardar cambios</button></div>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>

  <script>
    (function () {
      const accessScope = document.getElementById('accessScope');
      const cityField = document.getElementById('cityField');
      const vacancyField = document.getElementById('vacancyField');
      function syncCreateScopeVisibility() {
        const scope = accessScope ? accessScope.value : 'ALL';
        if (cityField) cityField.style.display = scope === 'CITY' ? 'flex' : 'none';
        if (vacancyField) vacancyField.style.display = scope === 'VACANCY' ? 'flex' : 'none';
      }
      if (accessScope) { accessScope.addEventListener('change', syncCreateScopeVisibility); syncCreateScopeVisibility(); }
    })();

    function syncVacancyGroups(userId) {
      const cityField = document.getElementById('edit-cityField-' + userId);
      const vacancyField = document.getElementById('edit-vacancyField-' + userId);
      const emptyMessage = document.getElementById('edit-vacancyEmpty-' + userId);
      if (!cityField || !vacancyField) return;

      const selectedCities = new Set(
        Array.from(cityField.querySelectorAll('input[name="scopeCities"]:checked'))
          .map((input) => input.value)
      );
      let visibleGroups = 0;

      vacancyField.querySelectorAll('.vacancy-city-group').forEach((group) => {
        const visible = selectedCities.has(group.dataset.city);
        group.style.display = visible ? 'block' : 'none';
        if (visible) {
          visibleGroups += 1;
        } else {
          group.querySelectorAll('input[name="scopeVacancyIds"]').forEach((input) => { input.checked = false; });
        }
      });

      if (emptyMessage) emptyMessage.style.display = visibleGroups ? 'none' : 'block';
    }

    function syncEditScopeVisibility(userId) {
      const accessScope = document.getElementById('edit-accessScope-' + userId);
      const cityField = document.getElementById('edit-cityField-' + userId);
      const vacancyField = document.getElementById('edit-vacancyField-' + userId);
      const selectedAccess = accessScope ? accessScope.value === 'VACANCY' : false;
      if (cityField) cityField.style.display = selectedAccess ? 'flex' : 'none';
      if (vacancyField) vacancyField.style.display = selectedAccess ? 'flex' : 'none';
      if (selectedAccess) syncVacancyGroups(userId);
    }

    function toggleEditDrawer(userId) {
      const drawer = document.getElementById('edit-drawer-' + userId);
      if (!drawer) return;
      drawer.classList.toggle('open');
      if (drawer.classList.contains('open')) syncEditScopeVisibility(userId);
    }
  </script>
</body>
</html>
