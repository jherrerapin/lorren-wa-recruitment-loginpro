<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aprendizajes de Lórren — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; }
    body { margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; background:#f4f5f7; color:#1a1d23; }
    .navbar { background:#1e2d3d; padding:0 24px; display:flex; align-items:center; gap:20px; height:52px; position:sticky; top:0; z-index:100; box-shadow:0 2px 8px rgba(0,0,0,.2); }
    .navbar a { color:#cbd5e0; text-decoration:none; font-size:13px; font-weight:500; padding:4px 2px; border-bottom:2px solid transparent; }
    .navbar a:hover, .navbar a.nav-active { color:#fff; border-bottom-color:#4fd1c5; }
    .navbar .brand img { height:28px; display:block; }
    .spacer { flex:1; }
    .btn-logout { background:transparent; border:1px solid rgba(255,255,255,.25); color:#cbd5e0; padding:5px 12px; border-radius:6px; cursor:pointer; font-size:12px; }
    .page { max-width:1100px; margin:0 auto; padding:24px 20px 48px; }
    h1 { margin:0; font-size:22px; color:#1e2d3d; }
    .sub { color:#64748b; margin:4px 0 20px; font-size:14px; }
    .card { background:#fff; border:1px solid #e1e4e8; border-radius:12px; padding:18px; margin-bottom:18px; box-shadow:0 1px 3px rgba(0,0,0,.06); }
    .card h2 { margin:0 0 12px; font-size:17px; color:#1e2d3d; }
    .alert { padding:10px 14px; border-radius:8px; margin-bottom:16px; font-size:13px; font-weight:700; border:1px solid transparent; }
    .alert-success { background:#dcfce7; color:#166534; border-color:#86efac; }
    .alert-error { background:#fee2e2; color:#b91c1c; border-color:#fca5a5; }
    .grid { display:grid; grid-template-columns:180px 1fr; gap:12px; align-items:start; }
    label { display:block; font-size:12px; font-weight:800; color:#475569; text-transform:uppercase; letter-spacing:.04em; margin-bottom:6px; }
    select, input, textarea { width:100%; border:1px solid #d1d5db; border-radius:8px; padding:9px 10px; font:inherit; background:#fff; }
    textarea { min-height:120px; resize:vertical; }
    .actions { display:flex; gap:10px; justify-content:flex-end; margin-top:14px; }
    button { border:0; border-radius:8px; padding:9px 14px; font-weight:800; cursor:pointer; }
    .btn-primary { background:#0d7a6b; color:white; }
    .btn-secondary { background:#e2e8f0; color:#334155; }
    .entry { border:1px solid #e2e8f0; border-radius:10px; padding:14px; margin-top:12px; background:#f8fafc; }
    .entry-head { display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; align-items:flex-start; }
    .pill { display:inline-block; padding:3px 8px; border-radius:999px; background:#e0f2fe; color:#075985; font-size:12px; font-weight:800; }
    .pill-off { background:#fee2e2; color:#991b1b; }
    .meta { color:#64748b; font-size:12px; margin-top:4px; }
    .content { white-space:pre-wrap; margin-top:10px; line-height:1.45; color:#334155; }
    .hint { color:#64748b; font-size:13px; line-height:1.45; }
    @media (max-width:720px) { .navbar { flex-wrap:wrap; height:auto; padding:10px 16px; } .grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Candidatos</a>
    <a href="/admin/vacancies">Vacantes</a>
    <% if (canManageUsers) { %><a href="/admin/users">Usuarios</a><% } %>
    <a href="/admin/operaciones">Operaciones / Despacho</a>
    <a href="/admin/monitor">Monitor</a>
    <a href="/admin/bot-knowledge" class="nav-active">Aprendizajes Lórren</a>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <h1>Aprendizajes manuales de Lórren</h1>
    <p class="sub">Memoria curada por desarrollo para ajustar contexto, tono y reglas conversacionales sin quemar frases literales.</p>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="card">
      <h2>Agregar aprendizaje</h2>
      <p class="hint">Úsalo para enseñar criterios, aclaraciones y contexto estable. Evita pegar respuestas textuales; escribe principios que Lórren pueda adaptar según intención y momento del candidato.</p>
      <form method="post" action="/admin/bot-knowledge">
        <div class="grid">
          <div>
            <label for="scope">Alcance</label>
            <select id="scope" name="scope">
              <option value="GLOBAL">Global</option>
              <option value="VACANCY">Vacante</option>
            </select>
          </div>
          <div>
            <label for="vacancyId">Vacante (solo si el alcance es vacante)</label>
            <select id="vacancyId" name="vacancyId">
              <option value="">Sin vacante específica</option>
              <% for (const vacancy of vacancies) { %>
                <option value="<%= vacancy.id %>"><%= vacancy.city %> — <%= vacancy.title || vacancy.role %> <%= vacancy.isActive && vacancy.acceptingApplications ? '' : '(pausada/inactiva)' %></option>
              <% } %>
            </select>
          </div>
          <div>
            <label for="tags">Etiquetas</label>
            <input id="tags" name="tags" placeholder="tono, objeciones, agenda" />
          </div>
          <div>
            <label for="content">Información para alimentar a Lórren</label>
            <textarea id="content" name="content" required placeholder="Ej: Si el candidato solo agradece después de recibir una confirmación, no enviar un nuevo mensaje. Si pregunta por identidad, decir una vez que es Lórren, asistente de selección de LoginPro."></textarea>
          </div>
        </div>
        <div class="actions"><button type="submit" class="btn-primary">Guardar aprendizaje</button></div>
      </form>
    </section>

    <section class="card">
      <h2>Aprendizajes existentes</h2>
      <% if (!entries || entries.length === 0) { %>
        <p class="hint">Aún no hay aprendizajes manuales registrados.</p>
      <% } %>
      <% for (const entry of entries) { %>
        <article class="entry">
          <div class="entry-head">
            <div>
              <span class="pill <%= entry.isActive ? '' : 'pill-off' %>"><%= entry.isActive ? 'Activo' : 'Pausado' %></span>
              <span class="pill"><%= entry.scope %></span>
              <% if (entry.tags) { %><span class="pill"><%= entry.tags %></span><% } %>
              <div class="meta">Actualizado: <%= formatDateTimeCO(entry.updatedAt) %> · Por: <%= entry.updatedBy || entry.createdBy || 'dev' %></div>
            </div>
            <form method="post" action="/admin/bot-knowledge/<%= entry.id %>/toggle">
              <input type="hidden" name="isActive" value="<%= entry.isActive ? 'false' : 'true' %>" />
              <button type="submit" class="btn-secondary"><%= entry.isActive ? 'Pausar' : 'Activar' %></button>
            </form>
          </div>
          <div class="content"><%= entry.content %></div>
        </article>
      <% } %>
    </section>
  </main>
</body>
</html>
