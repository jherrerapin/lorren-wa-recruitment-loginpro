<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Historial operativo — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg:#f4f5f7; --surface:#fff; --surface-2:#f9fafb; --border:#e1e4e8; --text:#1a1d23; --muted:#6b7280; --navy:#1e2d3d; --teal:#0d7a6b; --green:#166534; --green-light:#dcfce7; --blue:#1d4ed8; --blue-light:#dbeafe; --amber:#92400e; --amber-light:#fef3c7; --red:#b91c1c; --red-light:#fee2e2; --shadow-sm:0 1px 3px rgba(0,0,0,.08); --shadow-md:0 10px 28px rgba(15,23,42,.08); --font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
    body { font-family: var(--font); background: var(--bg); color: var(--text); font-size: 14px; }
    .navbar { background: var(--navy); padding: 0 24px; display:flex; align-items:center; gap:20px; min-height:52px; box-shadow:0 2px 8px rgba(0,0,0,.2); }
    .navbar a { color:#cbd5e0; text-decoration:none; font-size:13px; font-weight:600; padding:4px 2px; border-bottom:2px solid transparent; }
    .navbar a:hover,.navbar a.nav-active{color:#fff;border-bottom-color:#4fd1c5}.navbar .brand img{height:28px;display:block}.navbar .spacer{flex:1}.btn-logout{background:transparent;border:1px solid rgba(255,255,255,.25);color:#cbd5e0!important;padding:6px 12px!important;border-radius:7px;cursor:pointer;font-size:12px;font-weight:600}
    .page{max-width:1240px;margin:0 auto;padding:28px 20px 60px;display:grid;gap:18px}.hero{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;flex-wrap:wrap;background:linear-gradient(135deg,#fff 0%,#f0fdfa 100%);border:1px solid var(--border);border-radius:18px;padding:24px;box-shadow:var(--shadow-md)}.eyebrow{color:var(--teal);font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}h1{color:var(--navy);font-size:28px;line-height:1.15;margin-bottom:8px}.subtitle{color:var(--muted);line-height:1.6;max-width:760px}.actions{display:flex;gap:10px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:36px;border:1px solid var(--border);border-radius:8px;padding:7px 13px;background:var(--surface);color:var(--navy);text-decoration:none;font-size:12px;font-weight:800;cursor:pointer;box-shadow:var(--shadow-sm);white-space:nowrap}.btn-primary{background:var(--teal);border-color:var(--teal);color:#fff}.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px;box-shadow:var(--shadow-sm)}.stat-card span{display:block;color:var(--muted);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.stat-card strong{display:block;color:var(--navy);font-size:28px;margin-top:6px}.stat-card small{display:block;color:var(--muted);font-size:12px;margin-top:4px}.panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-sm);overflow:hidden}.panel-head{padding:16px 20px;border-bottom:1px solid #eaecef}.panel-head h2{color:var(--navy);font-size:17px}.panel-head p{color:var(--muted);font-size:13px;margin-top:2px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:1060px}th,td{text-align:left;padding:12px 14px;border-bottom:1px solid #eaecef;vertical-align:top}th{background:var(--surface-2);color:var(--muted);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.06em}td{font-size:13px}.muted{color:var(--muted)}.pill{display:inline-flex;border-radius:999px;padding:3px 9px;font-size:11px;font-weight:900}.pill-green{color:var(--green);background:var(--green-light)}.pill-blue{color:var(--blue);background:var(--blue-light)}.pill-amber{color:var(--amber);background:var(--amber-light)}.pill-red{color:var(--red);background:var(--red-light)}.profile-card{display:grid;gap:6px}.profile-card strong{color:var(--navy);font-size:17px}.empty{padding:42px 20px;text-align:center;color:var(--muted)}.empty strong{display:block;color:var(--navy);font-size:16px;margin-bottom:6px}.worker-state-alert{border:1px solid #fecaca;background:var(--red-light);color:#7f1d1d;border-radius:12px;padding:13px 15px;font-size:13px;line-height:1.5}.worker-state-alert strong{color:var(--red)}.worker-status{display:inline-flex;border-radius:999px;padding:2px 8px;font-size:11px;font-weight:900}.worker-status.active{color:var(--green);background:var(--green-light)}.worker-status.inactive{color:var(--red);background:var(--red-light)}.alert{border:1px solid #bfdbfe;background:var(--blue-light);color:var(--blue);border-radius:12px;padding:12px 14px;font-size:13px;font-weight:700}@media(max-width:900px){.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.navbar{flex-wrap:wrap;height:auto;padding:10px 16px}.navbar .spacer{display:none}}@media(max-width:640px){.stats-grid{grid-template-columns:1fr}.page{padding:18px 14px 42px}.actions,.btn{width:100%}}
  </style>
</head>
<body>
  <% const statusLabel = (value) => ({ ASSIGNED: 'Asignado', CONFIRMATION_PENDING: 'Pendiente confirmación', CONFIRMED: 'Confirmado', NO_CONFIRMO: 'No confirmó', CANCELLED: 'Cancelado' }[value] || value || '-'); %>
  <% const pillClass = (value) => value === 'CONFIRMED' ? 'pill-green' : value === 'NO_CONFIRMO' ? 'pill-red' : activeStatuses.includes(value) ? 'pill-blue' : 'pill-amber'; %>
  <% const formatDate = (value) => value ? new Date(value).toISOString().slice(0,10) : '-'; %>
  <% const formatDateTime = (value) => value ? new Intl.DateTimeFormat('es-CO', { timeZone:'America/Bogota', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit' }).format(new Date(value)) : '-'; %>
  <% const workerIsActive = worker.operationalStatus === 'CONTRATADO'; %>
  <% const workerStatusLabel = (value) => ({ CONTRATADO: 'Activo', DISABLED: 'Desactivado', INACTIVE: 'Inactivo', ELIMINADO: 'Desactivado' }[value] || value || 'Sin estado'); %>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <a href="/admin/operaciones/personal">Personal operativo</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Historial de auxiliar operativo</div>
        <h1><%= worker.fullName %></h1>
        <p class="subtitle">Estadísticas e historial de asignaciones por operación, fecha y hora. Esta vista sirve para evaluar comportamiento operativo del auxiliar sin mezclarlo con la auditoría del panel.</p>
        <div class="profile-card">
          <span class="muted">Estado: <span class="worker-status <%= workerIsActive ? 'active' : 'inactive' %>"><%= workerStatusLabel(worker.operationalStatus) %></span> · Código: <%= worker.operationalStatus || '-' %> · Origen: <%= worker.source || '-' %></span>
          <span class="muted">Ciudades operativas: <%= worker.cities?.length ? worker.cities.map((entry)=>entry.city.name).join(', ') : 'Sin ciudades habilitadas' %></span>
        </div>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones/personal">Volver al personal</a>
        <a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ir a asignaciones</a>
      </div>
    </section>

    <% if (!workerIsActive) { %>
      <div class="worker-state-alert"><strong>Auxiliar <%= workerStatusLabel(worker.operationalStatus).toLowerCase() %>.</strong> No está disponible para nuevas asignaciones. Sus registros históricos de asignación se conservan y continúan visibles en esta página.</div>
    <% } %>
    <% if (message) { %><div class="alert"><%= message %></div><% } %>

    <section class="stats-grid">
      <article class="stat-card"><span>Total asignaciones</span><strong><%= stats.total %></strong><small>Histórico registrado</small></article>
      <article class="stat-card"><span>Confirmadas</span><strong><%= stats.confirmed %></strong><small>Tasa: <%= stats.confirmationRate %>%</small></article>
      <article class="stat-card"><span>No confirmó</span><strong><%= stats.noConfirmo %></strong><small>Casos marcados por despacho</small></article>
      <article class="stat-card"><span>Operaciones</span><strong><%= stats.operationsCount %></strong><small>Más frecuente: <%= stats.topOperation || '-' %></small></article>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Historial de asignaciones</h2>
        <p>Incluye cliente, operación, servicio, fecha, horario, estado, fecha/hora de asignación y usuario que asignó, incluso cuando el auxiliar ya está desactivado.</p>
      </div>
      <% if (!assignments.length) { %>
        <div class="empty"><strong>Sin asignaciones registradas.</strong>Este auxiliar aún no tiene historial operativo.</div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Cliente / operación</th><th>Servicio</th><th>Fecha servicio</th><th>Horario</th><th>Estado</th><th>Asignado por</th><th>Fecha asignación</th></tr></thead>
            <tbody>
              <% assignments.forEach((assignment) => { const request = assignment.serviceRequest || {}; %>
                <tr>
                  <td><strong><%= request.clientName || '-' %></strong><div class="muted"><%= request.operationPointName || 'Sin operación' %> · <%= request.cityName || 'Sin ciudad' %></div></td>
                  <td><%= request.serviceName || request.service?.name || 'Sin servicio' %></td>
                  <td><%= formatDate(request.serviceDate) %></td>
                  <td><%= request.endTime ? `${request.startTime || '-'} - ${request.endTime}` : (request.startTime || '-') %></td>
                  <td><span class="pill <%= pillClass(assignment.status) %>"><%= statusLabel(assignment.status) %></span></td>
                  <td><%= assignment.createdByUsername || 'Sin usuario' %></td>
                  <td><%= formatDateTime(assignment.createdAt) %><div class="muted">Actualizado: <%= formatDateTime(assignment.updatedAt) %></div></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
