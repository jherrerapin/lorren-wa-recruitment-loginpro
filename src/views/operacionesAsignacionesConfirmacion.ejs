<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Asignación operativa — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .board-layout{display:grid;grid-template-columns:360px minmax(320px,1fr)430px;gap:16px;align-items:start}.board-panel{background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-sm);overflow:hidden;min-height:420px}.board-panel-head{padding:16px 18px;border-bottom:1px solid #edf2f7}.board-panel-head h2{color:var(--navy);font-size:16px;margin-bottom:4px}.board-panel-head p{color:var(--muted);font-size:13px}.filters{display:grid;gap:10px;padding:14px;border-bottom:1px solid #edf2f7;background:var(--surface-2)}.filters-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.worker-list,.request-list{max-height:calc(100vh - 360px);min-height:360px;overflow-y:auto;padding:12px;display:grid;gap:10px;align-content:start}.worker-card,.request-card,.assigned-card,.template-card{border:1px solid var(--border);border-radius:14px;background:#fff;padding:12px;box-shadow:var(--shadow-sm)}.worker-card{cursor:grab}.worker-card[hidden]{display:none}.worker-card strong,.request-card strong,.assigned-card strong{color:var(--navy);display:block;font-size:14px;margin-bottom:4px}.meta{color:var(--muted);font-size:12px;display:grid;gap:2px}.chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}.chip{display:inline-flex;border-radius:999px;padding:3px 8px;font-size:10px;font-weight:900;background:var(--blue-soft);color:var(--blue)}.request-card:hover,.request-card.active{border-color:var(--teal);box-shadow:var(--shadow)}.request-card.active{background:#f0fdfa}.request-card .top{display:flex;justify-content:space-between;gap:10px}.status-pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900;background:var(--amber-soft);color:var(--amber);white-space:nowrap}.status-pill.complete{background:var(--green-soft);color:var(--green)}.status-pill.pending-confirmation{background:var(--blue-soft);color:var(--blue)}.request-actions,.assigned-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.request-actions form,.assigned-actions form{margin:0}.assignment-body{padding:16px;display:grid;gap:14px}.selected-summary{border:1px solid var(--border);background:var(--surface-2);border-radius:14px;padding:14px}.drop-zone{border:2px dashed #b6c2d2;border-radius:16px;padding:22px;min-height:118px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);background:#fbfdff;font-weight:800}.drop-zone.drag-over{border-color:var(--teal);background:#f0fdfa;color:var(--teal)}.drop-zone.disabled{border-color:var(--green);background:var(--green-soft);color:var(--green);cursor:not-allowed}.assigned-list{display:grid;gap:10px}.assigned-card{display:grid;gap:10px}.template-card textarea,.assignment-message{width:100%;min-height:84px;border:1px solid var(--border);border-radius:10px;padding:10px;font:inherit;resize:vertical}.variable-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.variable-btn{border:1px solid var(--border);background:var(--surface-2);color:var(--navy);border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900;cursor:pointer}@media(max-width:1180px){.board-layout{grid-template-columns:1fr}.worker-list,.request-list{max-height:480px}}
    .notify-block{border:2px solid var(--green);border-radius:14px;background:var(--green-soft);padding:16px;display:grid;gap:12px}.notify-block h3{color:var(--green);font-size:14px;margin:0}.notify-contact{font-size:13px;color:var(--navy);display:grid;gap:3px}.notify-contact span{color:var(--muted)}.notify-preview{background:#fff;border:1px solid var(--border);border-radius:10px;padding:12px;font-size:12px;color:var(--navy);white-space:pre-wrap;line-height:1.6;max-height:180px;overflow-y:auto}.notify-actions{display:flex;gap:10px;flex-wrap:wrap}.notify-actions a{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:13px;font-weight:800;text-decoration:none;transition:opacity .15s}.notify-email{background:var(--navy);color:#fff}.notify-email:hover{opacity:.85}.notify-whatsapp{background:#25d366;color:#fff}.notify-whatsapp:hover{opacity:.85}.notify-no-contact{font-size:12px;color:var(--muted);font-style:italic}
    .notify-managed-field{display:grid;gap:4px}.notify-managed-field label{font-size:12px;font-weight:800;color:var(--navy)}.notify-managed-field input{width:100%;border:1px solid var(--border);border-radius:8px;padding:7px 10px;font:inherit;font-size:13px;background:#fff;color:var(--navy)}.notify-managed-field input:focus{outline:2px solid var(--teal);outline-offset:1px}.notify-managed-field .field-hint{font-size:11px;color:var(--muted)}.notify-managed-required{border-color:var(--red,#e53e3e)!important;background:#fff5f5!important}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %><span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>
  <% const activeCodes=['ASSIGNED','CONFIRMATION_PENDING','CONFIRMED']; %>
  <% const requestLabel=(v)=>({PENDING_ASSIGNMENT:'Pendiente de asignación',ASSIGNMENT_PARTIAL:'Asignación parcial',PENDING_CONFIRMATION:'Pendiente de confirmación',ASSIGNMENT_COMPLETE:'Asignación completa',CANCELLED:'Cancelada'}[v]||v||'Pendiente'); %>
  <% const assignmentLabel=(v)=>({ASSIGNED:'Asignado',CONFIRMATION_PENDING:'Pendiente de confirmación',CONFIRMED:'Confirmado',NO_CONFIRMO:'No confirmó',CANCELLED:'Cancelado'}[v]||v||'Asignado'); %>
  <main class="page">
    <section class="hero">
      <div><div class="eyebrow">Tablero de asignación</div><h1>Asignación operativa</h1><p>La solicitud solo se cierra cuando la cantidad de auxiliares confirmados cubre el total requerido.</p></div>
      <div class="actions"><a class="btn" href="/admin/operaciones">Volver a Operaciones</a><a class="btn" href="/admin/operaciones/solicitudes">Solicitudes de servicio</a><a class="btn" href="/admin/operaciones/novedades">Novedades</a><a class="btn" href="/admin/operaciones/clientes">Clientes</a><a class="btn" href="/admin/operaciones/personal">Personal operativo</a></div>
    </section>
    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <section class="board-layout">
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Auxiliares disponibles</h2><p id="cityAutoFilterText">Selecciona una solicitud para aplicar filtro automático por ciudad.</p></div>
        <form class="filters" method="get" action="/admin/operaciones/asignaciones" autocomplete="off">
          <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
          <div class="field"><label>Buscar</label><input name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" /></div>
          <div class="filters-row"><div class="field"><label>Ciudad</label><select name="operationalCityId" onchange="this.form.submit()"><option value="">Todas</option><% cities.forEach((city)=>{ %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select></div><div class="field"><label>Localidad</label><select name="locality"><option value="">Todas</option><% localities.forEach((item)=>{ %><option value="<%= item %>" <%= filters.locality===item?'selected':'' %>><%= item %></option><% }) %></select></div></div>
          <div class="field"><label>Transporte</label><select name="transportMode"><option value="">Todos</option><% transportModes.forEach((item)=>{ %><option value="<%= item %>" <%= filters.transportMode===item?'selected':'' %>><%= item %></option><% }) %></select></div>
          <button class="btn btn-primary" type="submit">Filtrar auxiliares</button>
        </form>
        <div class="worker-list" id="workerList">
          <% if (!availableWorkers.length) { %><div class="empty"><strong>No hay auxiliares disponibles.</strong>Los asignados quedan bloqueados para esta solicitud.</div><% } %>
          <div id="autoFilterEmpty" class="empty" hidden><strong>No hay auxiliares para la ciudad de esta solicitud.</strong>Ajusta filtros o revisa ciudades/perfiles.</div>
          <% availableWorkers.forEach((worker)=>{ const workerCityNames=worker.cities.map((entry)=>entry.city.name).join('|'); const vacancyCityNames=worker.vacancies.map((entry)=>entry.vacancy.city||'').join('|'); %>
            <article class="worker-card" draggable="true" data-worker-id="<%= worker.id %>" data-worker-cities="<%= workerCityNames %>" data-vacancy-cities="<%= vacancyCityNames %>"><strong><%= worker.fullName %></strong><div class="meta"><span>Tel: <%= worker.phone || '-' %></span><span>Ubicación: <%= worker.residenceCity || '-' %> · <%= worker.residenceLocality || '-' %></span><span>Transporte: <%= worker.transportMode || '-' %></span></div><div class="chips"><% worker.cities.slice(0,3).forEach((entry)=>{ %><span class="chip"><%= entry.city.name %></span><% }) %><% worker.vacancies.slice(0,2).forEach((entry)=>{ %><span class="chip"><%= entry.vacancy.title %><% if(entry.vacancy.city){ %> — <%= entry.vacancy.city %><% } %></span><% }) %></div></article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Solicitudes de servicio</h2><p>Elige la solicitud sobre la que vas a trabajar.</p></div>
        <div class="request-list">
          <% serviceRequests.forEach((request)=>{ const activeCount=request.assignments.filter((item)=>activeCodes.includes(item.status)).length; const confirmedCount=request.assignments.filter((item)=>item.status==='CONFIRMED').length; const complete=confirmedCount>=request.requiredWorkers; const waiting=!complete&&activeCount>=request.requiredWorkers; %>
            <article class="request-card <%= selectedServiceRequestId===request.id?'active':'' %>"><div class="top"><strong><%= request.clientName %></strong><span class="status-pill <%= complete?'complete':waiting?'pending-confirmation':'' %>"><%= requestLabel(request.status) %></span></div><div class="meta"><span><%= request.operationPointName || 'Sin punto' %> · <%= request.cityName || 'Sin ciudad' %></span><span>Servicio: <%= request.serviceName || request.service?.name || 'Sin servicio' %></span><span><%= new Date(request.serviceDate).toISOString().slice(0,10) %> · <%= request.startTime || '-' %> - <%= request.endTime || '-' %></span><span>Asignados activos: <%= activeCount %> / <%= request.requiredWorkers %></span><span>Confirmados: <%= confirmedCount %> / <%= request.requiredWorkers %></span></div><div class="request-actions"><a class="btn" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">Seleccionar</a><a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a></div></article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel"><div class="board-panel-head"><h2>Asignación</h2><p>Primero asigna, luego confirma auxiliar por auxiliar.</p></div><div class="assignment-body">
        <% if (selectedServiceRequest) { const activeAssignments=selectedServiceRequest.assignments.filter((item)=>activeCodes.includes(item.status)); const selectedActiveCount=activeAssignments.length; const selectedConfirmedCount=selectedServiceRequest.assignments.filter((item)=>item.status==='CONFIRMED').length; const remainingWorkers=Math.max(selectedServiceRequest.requiredWorkers-selectedActiveCount,0); const coverageComplete=selectedActiveCount>=selectedServiceRequest.requiredWorkers; const selectedRequestComplete=selectedConfirmedCount>=selectedServiceRequest.requiredWorkers; %>
          <div class="selected-summary" id="selectedRequestSummary" data-request-city="<%= selectedServiceRequest.cityName || '' %>"><strong><%= selectedServiceRequest.clientName %></strong><div class="meta"><span><%= selectedServiceRequest.operationPointName || 'Sin punto' %> · <%= selectedServiceRequest.cityName || 'Sin ciudad' %></span><span>Servicio: <%= selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || 'Sin servicio' %></span><span>Requeridos: <%= selectedServiceRequest.requiredWorkers %> · Activos: <%= selectedActiveCount %> · Confirmados: <%= selectedConfirmedCount %></span><span><%= selectedRequestComplete?'Solicitud cerrada por confirmación completa.':coverageComplete?'Cobertura completa. Falta confirmar auxiliares.':`Faltan ${remainingWorkers} auxiliares por asignar.` %></span></div></div>
          <div id="assignmentDropZone" class="drop-zone <%= coverageComplete?'disabled':'' %>" data-disabled="<%= coverageComplete?'true':'false' %>"><%= coverageComplete?'Cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.':`Faltan ${remainingWorkers} auxiliares. Arrastra un auxiliar aquí.` %></div>
          <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign"><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><input type="hidden" id="assignWorkerId" name="workerId" /></form>
          <% if (coverageComplete && !selectedRequestComplete) { %><section class="template-card"><strong>Mensaje base para WhatsApp</strong><p class="muted">Envía el mensaje y luego marca confirmado o no confirmado. El cierre depende de confirmaciones, no solo de asignaciones.</p><textarea id="globalTemplate">Hola {{nombre}}, te confirmamos asignacion para {{fecha}} en {{operacion}}. Direccion: {{direccion}}. Horario: {{horaInicio}} - {{horaFin}}. Servicio: {{servicio}}. Cliente: {{cliente}}. Por favor confirma recibido.</textarea><div class="variable-row" data-target="globalTemplate"><button type="button" class="variable-btn" data-var="{{nombre}}">Nombre</button><button type="button" class="variable-btn" data-var="{{operacion}}">Operación</button><button type="button" class="variable-btn" data-var="{{direccion}}">Dirección</button><button type="button" class="variable-btn" data-var="{{fecha}}">Fecha</button><button type="button" class="variable-btn" data-var="{{horaInicio}}">Hora inicio</button><button type="button" class="variable-btn" data-var="{{servicio}}">Servicio</button></div></section><% } %>

          <%
            /* ── BLOQUE DE NOTIFICACIÓN AL SOLICITANTE ── */
            if (selectedRequestComplete) {
              const confirmedAssignments = selectedServiceRequest.assignments.filter((a) => a.status === 'CONFIRMED');
              const reqName  = selectedServiceRequest.requestedByName  || '';
              const reqPhone = selectedServiceRequest.requestedByPhone || '';
              const reqEmail = selectedServiceRequest.requestedByEmail || '';
              const hasContact = !!(reqPhone || reqEmail);
              const serviceDate = new Date(selectedServiceRequest.serviceDate).toISOString().slice(0, 10);
              const serviceName = selectedServiceRequest.serviceName || (selectedServiceRequest.service && selectedServiceRequest.service.name) || 'Sin servicio';
              const operationPoint = selectedServiceRequest.operationPointName || '';
              const city    = selectedServiceRequest.cityName || '';
              const address = selectedServiceRequest.address  || '';
              const startTime = selectedServiceRequest.startTime || '';
              const endTime   = selectedServiceRequest.endTime   || '';

              const workerLines = confirmedAssignments.map((a, i) => {
                const docType = a.worker.documentType  || '';
                const docNum  = a.worker.documentNumber || '';
                const docStr  = (docType && docNum) ? (docType + ' ' + docNum) : (docNum || 'Sin documento');
                return (i + 1) + '. ' + a.worker.fullName + ' — ' + docStr;
              }).join('\n');

              const emailSubject = 'Auxiliares confirmados — ' + selectedServiceRequest.clientName + ' (' + serviceDate + ')';

              const rawPhone = reqPhone.replace(/\D/g, '');
              const waPhone  = rawPhone ? (rawPhone.startsWith('57') ? rawPhone : rawPhone.length === 10 ? '57' + rawPhone : rawPhone) : '';
          %>
          <section class="notify-block">
            <h3>&#x2705; Notificar al solicitante</h3>
            <% if (reqName || reqPhone || reqEmail) { %>
            <div class="notify-contact">
              <% if (reqName)  { %><span><strong>Nombre:</strong> <%- reqName  %></span><% } %>
              <% if (reqPhone) { %><span><strong>Tel / WhatsApp:</strong> <%- reqPhone %></span><% } %>
              <% if (reqEmail) { %><span><strong>Correo:</strong> <%- reqEmail %></span><% } %>
            </div>
            <% } else { %>
            <p class="notify-no-contact">Esta solicitud no tiene datos de contacto del solicitante registrados.</p>
            <% } %>

            <%/* Campo obligatorio: quién gestiona la asignación */%>
            <div class="notify-managed-field">
              <label for="notifyManagedBy">Gestionado por <span style="color:var(--red,#e53e3e)">*</span></label>
              <input
                type="text"
                id="notifyManagedBy"
                placeholder="Nombre de quien gestionó la asignación"
                autocomplete="off"
                maxlength="80"
              />
              <span class="field-hint">Requerido. Se incluirá al final del mensaje de correo y WhatsApp.</span>
            </div>

            <div class="notify-preview" id="notifyPreview"></div>

            <% if (hasContact) { %>
            <div class="notify-actions">
              <% if (reqEmail) { %>
              <a id="notifyEmailLink" href="#" class="notify-email" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
                Enviar por correo
              </a>
              <% } %>
              <% if (waPhone || reqPhone) { %>
              <a id="notifyWaLink" href="#" class="notify-whatsapp" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                Abrir WhatsApp
              </a>
              <% } %>
            </div>
            <% } %>
          </section>

          <script>
            (function(){
              const managedInput  = document.getElementById('notifyManagedBy');
              const preview       = document.getElementById('notifyPreview');
              const emailLink     = document.getElementById('notifyEmailLink');
              const waLink        = document.getElementById('notifyWaLink');

              const reqName       = <%- JSON.stringify(reqName) %>;
              const reqEmail      = <%- JSON.stringify(reqEmail) %>;
              const waPhone       = <%- JSON.stringify(waPhone) %>;
              const reqPhone      = <%- JSON.stringify(reqPhone) %>;
              const workerLines   = <%- JSON.stringify(workerLines) %>;
              const serviceDate   = <%- JSON.stringify(serviceDate) %>;
              const startTime     = <%- JSON.stringify(startTime) %>;
              const endTime       = <%- JSON.stringify(endTime) %>;
              const serviceName   = <%- JSON.stringify(serviceName) %>;
              const operationPoint= <%- JSON.stringify(operationPoint) %>;
              const city          = <%- JSON.stringify(city) %>;
              const address       = <%- JSON.stringify(address) %>;
              const emailSubject  = <%- JSON.stringify(emailSubject) %>;

              function buildMsg(managedBy) {
                const lines = [];
                lines.push('Estimado/a' + (reqName ? ' ' + reqName : '') + ',');
                lines.push('');
                lines.push('Le informamos que los auxiliares confirmados para su servicio son:');
                lines.push('');
                lines.push(workerLines);
                lines.push('');
                lines.push('Detalles del servicio:');
                lines.push('- Fecha: ' + serviceDate);
                lines.push('- Horario: ' + startTime + (endTime ? ' - ' + endTime : ''));
                lines.push('- Servicio: ' + serviceName);
                if (operationPoint) lines.push('- Punto de operación: ' + operationPoint + (city ? ', ' + city : ''));
                if (address) lines.push('- Dirección: ' + address);
                lines.push('');
                lines.push('Quedamos atentos a cualquier inquietud.');
                if (managedBy && managedBy.trim()) {
                  lines.push('');
                  lines.push('Gestionado por: ' + managedBy.trim());
                }
                return lines.join('\n');
              }

              function refreshNotify() {
                const managedBy = managedInput ? managedInput.value : '';
                const msg = buildMsg(managedBy);

                if (preview) preview.textContent = msg;

                const hasManagedBy = managedBy && managedBy.trim().length > 0;

                if (managedInput) {
                  managedInput.classList.toggle('notify-managed-required', !hasManagedBy);
                }

                if (emailLink) {
                  if (!hasManagedBy) {
                    emailLink.href = '#';
                    emailLink.onclick = function(e){ e.preventDefault(); managedInput && managedInput.focus(); managedInput && managedInput.classList.add('notify-managed-required'); alert('Debes indicar quién gestionó la asignación antes de enviar.'); return false; };
                  } else {
                    emailLink.onclick = null;
                    emailLink.href = reqEmail
                      ? 'mailto:' + reqEmail + '?subject=' + encodeURIComponent(emailSubject) + '&body=' + encodeURIComponent(msg)
                      : '#';
                  }
                }

                if (waLink) {
                  if (!hasManagedBy) {
                    waLink.href = '#';
                    waLink.onclick = function(e){ e.preventDefault(); managedInput && managedInput.focus(); managedInput && managedInput.classList.add('notify-managed-required'); alert('Debes indicar quién gestionó la asignación antes de enviar.'); return false; };
                  } else {
                    waLink.onclick = null;
                    const waHref = waPhone
                      ? 'https://wa.me/' + waPhone + '?text=' + encodeURIComponent(msg)
                      : (reqPhone ? 'https://wa.me/?text=' + encodeURIComponent(msg) : '#');
                    waLink.href = waHref;
                  }
                }
              }

              if (managedInput) managedInput.addEventListener('input', refreshNotify);
              refreshNotify();
            })();
          </script>

          <% } /* end selectedRequestComplete */ %>

          <div class="assigned-list"><% selectedServiceRequest.assignments.forEach((assignment)=>{ const assignmentActive=activeCodes.includes(assignment.status); const assignmentWaiting=assignmentActive&&assignment.status!=='CONFIRMED'; %><article class="assigned-card" data-worker-name="<%= assignment.worker.fullName %>" data-worker-phone="<%= assignment.worker.phone || '' %>" data-client="<%= selectedServiceRequest.clientName || '' %>" data-operation="<%= selectedServiceRequest.operationPointName || '' %>" data-address="<%= selectedServiceRequest.address || '' %>" data-city="<%= selectedServiceRequest.cityName || '' %>" data-service="<%= selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || '' %>" data-date="<%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %>" data-start="<%= selectedServiceRequest.startTime || '' %>" data-end="<%= selectedServiceRequest.endTime || '' %>"><div><strong><%= assignment.worker.fullName %></strong><div class="meta"><span><%= assignment.worker.phone || 'Sin teléfono' %></span><span>Estado: <%= assignmentLabel(assignment.status) %></span><% if (assignment.notes) { %><span>Nota: <%= assignment.notes %></span><% } %></div></div><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><textarea class="assignment-message"></textarea><% } %><div class="assigned-actions"><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><a class="btn btn-primary whatsapp-link" target="_blank" rel="noopener">WhatsApp</a><% } %><% if (assignmentWaiting) { %><form method="post" action="/admin/operaciones/asignaciones/confirmar"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn btn-primary" type="submit">Marcar confirmado</button></form><form method="post" action="/admin/operaciones/asignaciones/no-confirmado"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">No confirmó</button></form><% } %><form method="post" action="/admin/operaciones/asignaciones/unassign"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">Quitar</button></form></div></article><% }) %></div>
        <% } else { %><div class="empty"><strong>Selecciona una solicitud.</strong>Necesitas una solicitud activa antes de asignar auxiliares.</div><div id="assignmentDropZone" class="drop-zone">Selecciona una solicitud.</div><% } %>
      </div></aside>
    </section>
  </main>
  <script>
    const dropZone=document.getElementById('assignmentDropZone'),assignForm=document.getElementById('assignForm'),assignWorkerId=document.getElementById('assignWorkerId'),hasSelectedRequest=Boolean('<%= selectedServiceRequestId %>'),isDropZoneDisabled=dropZone?.dataset.disabled==='true',selectedRequestSummary=document.getElementById('selectedRequestSummary'),selectedRequestCity=selectedRequestSummary?.dataset.requestCity||'',cityAutoFilterText=document.getElementById('cityAutoFilterText'),autoFilterEmpty=document.getElementById('autoFilterEmpty');
    window.addEventListener('pageshow',(event)=>{if(event.persisted)window.location.reload();});
    const normalizeCity=(value)=>String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();const compatibleCitiesForRequest=(cityName)=>{const n=normalizeCity(cityName);if(!n)return[];if(n==='siberia')return['siberia','bogota','bogota d.c.','bogota dc','madrid','funza','mosquera'];return[n];};
    function applyAutomaticCityFilter(){const allowed=compatibleCitiesForRequest(selectedRequestCity);const cards=Array.from(document.querySelectorAll('.worker-card'));if(!allowed.length){if(autoFilterEmpty)autoFilterEmpty.hidden=true;return;}let count=0;cards.forEach((card)=>{const workerCities=String(card.dataset.workerCities||'').split('|').map(normalizeCity).filter(Boolean);const vacancyCities=String(card.dataset.vacancyCities||'').split('|').map(normalizeCity).filter(Boolean);const visible=workerCities.some((city)=>allowed.includes(city))||vacancyCities.some((city)=>allowed.includes(city));card.hidden=!visible;if(visible)count+=1;});if(cityAutoFilterText)cityAutoFilterText.textContent=`Filtro automático aplicado por ciudad: ${selectedRequestCity}.`;if(autoFilterEmpty)autoFilterEmpty.hidden=count>0;}
    document.querySelectorAll('.worker-card[draggable="true"]').forEach((card)=>card.addEventListener('dragstart',(event)=>event.dataTransfer.setData('text/plain',card.dataset.workerId)));applyAutomaticCityFilter();
    if(dropZone){dropZone.addEventListener('dragover',(event)=>{if(isDropZoneDisabled)return;event.preventDefault();dropZone.classList.add('drag-over');});dropZone.addEventListener('dragleave',()=>dropZone.classList.remove('drag-over'));dropZone.addEventListener('drop',(event)=>{event.preventDefault();dropZone.classList.remove('drag-over');if(isDropZoneDisabled){alert('La solicitud ya tiene cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.');return;}if(!hasSelectedRequest||!assignForm||!assignWorkerId){alert('Selecciona una solicitud antes de asignar auxiliares.');return;}const workerId=event.dataTransfer.getData('text/plain');if(!workerId)return;assignWorkerId.value=workerId;assignForm.submit();});}
    const globalTemplate=document.getElementById('globalTemplate');const cards=Array.from(document.querySelectorAll('.assigned-card'));function normalizePhone(phone){const digits=String(phone||'').replace(/\D/g,'');if(!digits)return'';if(digits.startsWith('57'))return digits;if(digits.length===10)return`57${digits}`;return digits;}function renderMessage(template,card){const values={nombre:card.dataset.workerName||'',cliente:card.dataset.client||'',operacion:card.dataset.operation||'',direccion:card.dataset.address||'',ciudad:card.dataset.city||'',servicio:card.dataset.service||'',fecha:card.dataset.date||'',horaInicio:card.dataset.start||'',horaFin:card.dataset.end||''};return String(template||'').replace(/{{\s*(nombre|cliente|operacion|direccion|ciudad|servicio|fecha|horaInicio|horaFin)\s*}}/g,(_,key)=>values[key]||'');}function refreshLinks(){cards.forEach((card)=>{const textarea=card.querySelector('.assignment-message'),link=card.querySelector('.whatsapp-link');if(!textarea||!link)return;if(!textarea.value&&globalTemplate)textarea.value=globalTemplate.value;const phone=normalizePhone(card.dataset.workerPhone);const text=renderMessage(textarea.value||globalTemplate?.value||'',card);link.href=phone?`https://wa.me/${phone}?text=${encodeURIComponent(text)}`:`https://wa.me/?text=${encodeURIComponent(text)}`;});}globalTemplate?.addEventListener('input',refreshLinks);document.querySelectorAll('.assignment-message').forEach((textarea)=>textarea.addEventListener('input',refreshLinks));document.querySelectorAll('.variable-btn').forEach((button)=>button.addEventListener('click',()=>{const targetId=button.closest('.variable-row')?.dataset.target;const target=targetId?document.getElementById(targetId):button.closest('.assigned-card')?.querySelector('.assignment-message');if(!target)return;const start=target.selectionStart||target.value.length;const end=target.selectionEnd||target.value.length;target.value=`${target.value.slice(0,start)}${button.dataset.var}${target.value.slice(end)}`;target.focus();target.selectionStart=target.selectionEnd=start+button.dataset.var.length;refreshLinks();}));refreshLinks();
  </script>
</body>
</html>
