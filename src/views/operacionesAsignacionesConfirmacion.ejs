<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Asignación operativa — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .assignment-page{max-width:min(2040px,calc(100vw - 32px));width:100%;}
    .board-layout{display:grid;grid-template-columns:minmax(420px,.78fr) minmax(480px,1fr) minmax(480px,.9fr);gap:14px;align-items:start}
    .board-panel{background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-sm);overflow:hidden;min-height:420px;min-width:0}
    .board-panel-head{padding:12px 14px;border-bottom:1px solid #edf2f7}.board-panel-head h2{color:var(--navy);font-size:15px;margin-bottom:3px}.board-panel-head p{color:var(--muted);font-size:12px}
    .filters{display:grid;gap:7px;padding:10px;border-bottom:1px solid #edf2f7;background:var(--surface-2)}.filters-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}
    .worker-toolbar{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px;align-items:center;padding:7px 9px;border-bottom:1px solid #edf2f7;background:#fff;position:relative;z-index:1}.worker-toolbar strong{font-size:12px;color:var(--navy);line-height:1.2;white-space:nowrap}.worker-toolbar-actions{display:flex;justify-content:flex-end;gap:6px;flex-wrap:wrap}.worker-toolbar .btn{width:auto;min-width:118px;justify-content:center;padding:6px 10px;font-size:11px;white-space:nowrap}
    .date-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:end;padding:10px;border-bottom:1px solid #edf2f7;background:#fff}.date-toolbar .field{gap:4px}.date-toolbar .btn{min-height:34px;padding:7px 10px;font-size:11px;width:auto}.date-note{padding:7px 10px;border-bottom:1px solid #edf2f7;background:#f8fafc;color:var(--muted);font-size:11px;font-weight:800;line-height:1.25}.date-note strong{color:var(--navy)}
    .worker-list{max-height:calc(100vh - 380px);min-height:300px;overflow-y:auto;padding:6px;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:5px;align-content:start}.request-list{max-height:calc(100vh - 430px);min-height:330px;overflow-y:auto;padding:8px;display:grid;gap:7px;align-content:start}
    .worker-card,.request-card,.assigned-card,.template-card{border:1px solid var(--border);border-radius:10px;background:#fff;padding:9px;box-shadow:var(--shadow-sm)}
    .worker-card{cursor:grab;display:grid;grid-template-columns:18px minmax(0,1fr);gap:6px;align-items:start;padding:6px 7px;border-radius:9px;min-width:0}.worker-card.same-day-assignment{border:1px solid #f59e0b;background:#fffaf0;box-shadow:none}.worker-card.same-day-assignment strong{color:#92400e}.worker-card.selected{border-color:var(--teal);background:#f0fdfa;box-shadow:0 0 0 2px rgba(13,122,107,.12)}.worker-card.drag-batch{opacity:.82;transform:scale(.99)}.worker-card[hidden],.request-card[hidden]{display:none!important}
    .worker-select{width:15px;height:15px;margin:2px 0 0 0;accent-color:var(--teal)}.worker-main{min-width:0}.worker-card strong,.request-card strong,.assigned-card strong{color:var(--navy);display:block;font-size:12.5px;margin-bottom:2px;line-height:1.12;overflow-wrap:anywhere}.worker-card .meta{font-size:10.5px;gap:2px 8px;display:flex;flex-wrap:wrap;line-height:1.25}.meta{color:var(--muted);font-size:12px;display:grid;gap:2px;min-width:0}.meta span{overflow-wrap:anywhere}.chips{display:flex;flex-wrap:wrap;gap:3px;margin-top:4px}.chip{display:inline-flex;align-items:center;border-radius:999px;padding:2px 6px;font-size:9px;font-weight:900;background:var(--blue-soft);color:var(--blue);max-width:100%;overflow:hidden;text-overflow:ellipsis;line-height:1.15}.chip.same-day-assignment{background:#f59e0b;color:#fff;font-size:9px;padding:2px 6px}.worker-heading{display:flex;align-items:center;justify-content:space-between;gap:6px;min-width:0}.worker-heading strong{margin-bottom:0;min-width:0}.contract-value{display:inline-flex;align-items:center;flex:0 0 auto;border:1px solid #dbe3ec;border-radius:999px;padding:1px 5px;background:#f8fafc;color:#475569;font-size:8.5px;font-weight:800;line-height:1.1;white-space:nowrap}
    .request-card:hover,.request-card.active{border-color:var(--teal);box-shadow:var(--shadow)}.request-card.active{background:#f0fdfa}.request-card .top{display:flex;justify-content:space-between;gap:10px}.status-pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900;background:var(--amber-soft);color:var(--amber);white-space:nowrap}.status-pill.complete{background:var(--green-soft);color:var(--green)}.status-pill.pending-confirmation{background:var(--blue-soft);color:var(--blue)}.request-actions,.assigned-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:7px;align-items:center}.request-actions form,.assigned-actions form{margin:0}.assignment-body{padding:12px;display:grid;gap:10px}.selected-summary{border:1px solid var(--border);background:var(--surface-2);border-radius:14px;padding:11px}.selected-summary.out-of-date{opacity:.58}.drop-zone{border:2px dashed #b6c2d2;border-radius:14px;padding:14px;min-height:80px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);background:#fbfdff;font-weight:800;font-size:13px}.drop-zone.drag-over{border-color:var(--teal);background:#f0fdfa;color:var(--teal)}.drop-zone.disabled{border-color:var(--green);background:var(--green-soft);color:var(--green);cursor:not-allowed}.assigned-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:6px;align-items:start}
    .assigned-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:start;padding:7px 8px;border-radius:10px;box-shadow:var(--shadow-sm);transition:opacity .15s,transform .15s}.assigned-card.is-updating{opacity:.55;pointer-events:none}.assigned-card.is-removed{opacity:0;transform:translateY(-4px)}.assigned-card strong{font-size:12px;margin-bottom:2px}.assigned-card .meta{font-size:10.5px;gap:1px}.assigned-main{min-width:0}.assigned-actions{justify-content:flex-end;margin-top:0}.assigned-actions .btn{padding:5px 8px;font-size:10.5px}.icon-remove-btn,.icon-action{width:28px;height:28px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-weight:900;line-height:1;cursor:pointer;padding:0}.icon-remove-btn{border:1px solid #fecaca;background:#fff5f5;color:#b91c1c;font-size:20px}.icon-remove-btn:hover{background:#fee2e2;border-color:#fca5a5}.icon-action{border:1px solid var(--border);font-size:15px}.icon-action:disabled{opacity:.65;cursor:not-allowed}.icon-whatsapp{background:#25d366;color:#fff;border-color:#25d366}.icon-email{background:var(--navy);color:#fff;border-color:var(--navy)}
    .rest-panel{margin-top:14px;background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-sm);padding:14px;display:grid;gap:12px}.rest-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}.rest-head h2{margin:0;color:var(--navy);font-size:16px}.rest-head p{margin:3px 0 0;color:var(--muted);font-size:12px}.rest-date-chip{background:#eef2ff;color:#3730a3;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900}.rest-drop-zone{border:2px dashed #8b5cf6;background:#faf5ff;color:#6d28d9;min-height:88px}.rest-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px}.rest-card{border:1px solid #ddd6fe;background:#faf5ff;border-radius:10px;padding:10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.rest-card strong{color:var(--navy);font-size:12px}.rest-card .meta{font-size:10.5px}.rest-card form{margin:0}.rest-card .btn{padding:5px 8px;font-size:10px}.rest-empty{color:var(--muted);font-size:12px}.rest-dialog{border:0;border-radius:14px;padding:0;width:min(520px,calc(100vw - 24px));box-shadow:0 18px 50px rgba(15,23,42,.28)}.rest-dialog::backdrop{background:rgba(15,23,42,.42)}.rest-dialog form{padding:18px;display:grid;gap:12px}.rest-dialog h3{margin:0;color:var(--navy)}.rest-dialog .dialog-actions{display:flex;justify-content:flex-end;gap:8px}.rest-dialog .field-hint{font-size:11px;color:var(--muted)}.rest-origin-dialog{width:min(680px,calc(100vw - 24px))}.rest-origin-list{display:grid;gap:8px;max-height:min(52vh,430px);overflow:auto;padding-right:2px}.rest-origin-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(160px,190px);gap:12px;align-items:center;border:1px solid #e2e8f0;border-radius:10px;padding:10px;background:#f8fafc}.rest-origin-row strong{display:block;color:var(--navy);font-size:13px;margin-bottom:2px}.rest-origin-row span{display:block;color:var(--muted);font-size:11px}.rest-origin-row input{width:100%;border:1px solid var(--border);border-radius:9px;padding:8px 9px;background:#fff;color:var(--navy);font:inherit}
    .async-toast{position:fixed;right:18px;bottom:18px;max-width:340px;background:#172033;color:#fff;border-radius:14px;padding:11px 13px;box-shadow:var(--shadow);font-size:13px;line-height:1.35;z-index:9999;opacity:0;transform:translateY(8px);transition:opacity .18s,transform .18s}.async-toast.show{opacity:1;transform:translateY(0)}
    .notify-block{border:2px solid var(--green);border-radius:14px;background:var(--green-soft);padding:14px;display:grid;gap:10px}.notify-block h3{color:var(--green);font-size:14px;margin:0}.notify-contact{font-size:13px;color:var(--navy);display:grid;gap:3px}.notify-contact span{color:var(--muted)}.notify-preview{background:#fff;border:1px solid var(--border);border-radius:10px;padding:12px;font-size:12px;color:var(--navy);white-space:pre-wrap;line-height:1.6;max-height:180px;overflow-y:auto}.notify-actions{display:flex;gap:8px;flex-wrap:wrap}.notify-actions a{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}.notify-managed-field{display:grid;gap:4px}.notify-managed-field label{font-size:12px;font-weight:800;color:var(--navy)}.notify-managed-field input{width:100%;border:1px solid var(--border);border-radius:8px;padding:7px 10px;font:inherit;font-size:13px;background:#fff;color:var(--navy)}.notify-managed-field .field-hint{font-size:11px;color:var(--muted)}.notify-managed-required{border-color:var(--red,#e53e3e)!important;background:#fff5f5!important}
    @media(max-width:1350px){.assignment-page{max-width:calc(100vw - 18px)}.board-layout{grid-template-columns:1fr;gap:12px}.worker-list{max-height:360px;grid-template-columns:repeat(auto-fill,minmax(245px,1fr))}.request-list{max-height:340px}.assigned-list{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}.assigned-card{grid-template-columns:minmax(0,1fr) auto}.assigned-actions{justify-content:flex-end}}
    @media(max-width:760px){.worker-toolbar{grid-template-columns:1fr}.worker-toolbar-actions{justify-content:stretch}.worker-toolbar .btn{width:100%;min-width:0}.date-toolbar{grid-template-columns:1fr}.date-toolbar .btn{width:100%}.worker-list{grid-template-columns:1fr}.filters-row{grid-template-columns:1fr}.assigned-list{grid-template-columns:repeat(auto-fill,minmax(180px,1fr))}.assigned-card{grid-template-columns:1fr}.assigned-actions{justify-content:flex-start}.rest-card{grid-template-columns:1fr}.rest-dialog .dialog-actions{flex-direction:column-reverse}.rest-dialog .btn{width:100%}.rest-origin-row{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %><span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>
  <% const activeCodes=['ASSIGNED','CONFIRMATION_PENDING','CONFIRMED']; %>
  <% const safeSameDaySet = typeof assignedWorkerIdsOnSelectedDate !== 'undefined' && assignedWorkerIdsOnSelectedDate ? assignedWorkerIdsOnSelectedDate : new Set(); %>
  <% const effectiveAvailableWorkers = typeof availableWorkers !== 'undefined' && availableWorkers ? availableWorkers : workers; %>
  <% const safeRestAssignments = typeof restAssignments !== 'undefined' && Array.isArray(restAssignments) ? restAssignments : []; %>
  <% const safeRestDate = typeof restDate !== 'undefined' && restDate ? restDate : ''; %>
  <% const safeRestReasons = typeof restReasons !== 'undefined' && Array.isArray(restReasons) ? restReasons : []; %>
  <% const requestLabel=(v)=>({PENDING_ASSIGNMENT:'Pendiente de asignación',ASSIGNMENT_PARTIAL:'Asignación parcial',PENDING_CONFIRMATION:'Pendiente de confirmación',ASSIGNMENT_COMPLETE:'Asignación completa',CANCELLED:'Cancelada'}[v]||v||'Pendiente'); %>
  <% const assignmentLabel=(v)=>({ASSIGNED:'Asignado',CONFIRMATION_PENDING:'Pendiente de confirmación',CONFIRMED:'Confirmado',NO_CONFIRMO:'No confirmó',CANCELLED:'Cancelado'}[v]||v||'Asignado'); %>
  <% const restLabel=(v)=>({VACACIONES:'Vacaciones',INCAPACIDAD_EPS:'Incapacidad EPS',SUSPENSION:'Suspensión',INCAPACIDAD_ARL:'Incapacidad ARL',NO_REMUNERADA:'No remunerada',REMUNERADO:'Remunerado'}[v]||v); %>
  <% const contractLabel=(v)=>v==='CONTRATISTA'?'Contratista':'Directo'; %>
  <% const cleanGroup=(value)=>String(value||'').replace(/\s*·\s*Grupo\s+GRP-[A-Z0-9-]+/i,'').trim(); %>
  <% const dateKey=(value)=>value?new Date(value).toISOString().slice(0,10):''; %>
  <% const scheduleLabel=(request)=>request.endTime ? `${request.startTime || '-'} - ${request.endTime}` : `${request.startTime || '-'}`; %>
  <% const selectedRequestDate=selectedServiceRequest?dateKey(selectedServiceRequest.serviceDate):''; %>
  <main class="page assignment-page">
    <section class="hero">
      <div><div class="eyebrow">Tablero de asignación</div><h1>Asignación operativa</h1><p>La solicitud solo se cierra cuando la cantidad de auxiliares confirmados cubre el total requerido.</p></div>
      <div class="actions"><a class="btn" href="/admin/operaciones">Volver a Operaciones</a><a class="btn" href="/admin/operaciones/solicitudes">Crear solicitud</a><a class="btn" href="/admin/operaciones/novedades">Novedades</a><a class="btn" href="/admin/operaciones/clientes">Clientes</a><a class="btn" href="/admin/operaciones/personal">Personal operativo</a><a class="btn btn-primary" href="/admin/operaciones/whatsapp">WhatsApp despacho</a></div>
    </section>
    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <section class="board-layout">
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Auxiliares disponibles</h2><p id="cityAutoFilterText">Selecciona una solicitud para aplicar filtro automático por ciudad.</p></div>
        <form class="filters" method="get" action="/admin/operaciones/asignaciones" autocomplete="off" id="workerFilterForm">
          <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
          <input type="hidden" name="fecha" value="" data-date-proxy="true" />
          <div class="field"><label>Buscar</label><input name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" /></div>
          <div class="filters-row"><div class="field"><label>Ciudad</label><select name="operationalCityId" onchange="this.form.submit()"><option value="">Todas</option><% cities.forEach((city)=>{ %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select></div><div class="field"><label>Localidad</label><select name="locality"><option value="">Todas</option><% localities.forEach((item)=>{ %><option value="<%= item %>" <%= filters.locality===item?'selected':'' %>><%= item %></option><% }) %></select></div></div>
          <div class="field"><label>Transporte</label><select name="transportMode"><option value="">Todos</option><% transportModes.forEach((item)=>{ %><option value="<%= item %>" <%= filters.transportMode===item?'selected':'' %>><%= item %></option><% }) %></select></div>
          <button class="btn btn-primary" type="submit">Filtrar auxiliares</button>
        </form>
        <div class="worker-toolbar">
          <strong><span id="selectedWorkersCount">0</span> seleccionados</strong>
          <div class="worker-toolbar-actions"><button class="btn" type="button" id="clearSelectedWorkers">Limpiar</button><button class="btn" type="button" id="restSelectedWorkers">Añadir a descanso</button><button class="btn btn-primary" type="button" id="assignSelectedWorkers">Asignar</button></div>
        </div>
        <div class="worker-list" id="workerList">
          <% if (!effectiveAvailableWorkers.length) { %><div class="empty"><strong>No hay auxiliares disponibles.</strong>Los asignados quedan bloqueados para esta solicitud.</div><% } %>
          <div id="autoFilterEmpty" class="empty" hidden><strong>No hay auxiliares para la ciudad de esta solicitud.</strong>Ajusta filtros o revisa ciudades/perfiles.</div>
          <% effectiveAvailableWorkers.forEach((worker)=>{ const workerCityNames=worker.cities.map((entry)=>entry.city.name).join('|'); const vacancyCityNames=worker.vacancies.map((entry)=>entry.vacancy.city||'').join('|'); const hasSameDayAssignment=safeSameDaySet.has(worker.id); %>
            <article class="worker-card<%= hasSameDayAssignment ? ' same-day-assignment' : '' %>" draggable="true" data-worker-id="<%= worker.id %>" data-worker-name="<%= worker.fullName %>" data-contract-type="<%= worker.contractType %>" data-same-day-assignment="<%= hasSameDayAssignment ? 'true' : 'false' %>" data-worker-cities="<%= workerCityNames %>" data-vacancy-cities="<%= vacancyCityNames %>">
              <input class="worker-select" type="checkbox" aria-label="Seleccionar <%= worker.fullName %>" />
              <div class="worker-main"><div class="worker-heading"><strong><%= worker.fullName %></strong><span class="contract-value" title="Tipo de contrato"><%= contractLabel(worker.contractType) %></span></div><div class="meta"><% if(worker.transportMode){ %><span>Transporte: <%= worker.transportMode %></span><% } %></div><div class="chips"><% if(hasSameDayAssignment){ %><span class="chip same-day-assignment" title="Ya tiene una asignación activa en otra solicitud de esta fecha. Puedes asignarlo de nuevo para un doble turno u horas extra.">⚠ Asignado hoy</span><% } %></div></div>
            </article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Solicitudes de servicio</h2><p>Filtra por fecha y elige la solicitud sobre la que vas a trabajar.</p></div>
        <div class="date-toolbar">
          <div class="field"><label for="assignmentDateFilter">Fecha operativa</label><input type="date" id="assignmentDateFilter" value="" /></div>
          <button class="btn" type="button" id="clearAssignmentDateFilter">Ver todas</button>
        </div>
        <div class="date-note" id="assignmentDateNote"><strong>Filtro activo:</strong> <span id="assignmentDateLabel">-</span></div>
        <div class="request-list" id="requestList">
          <% if (!serviceRequests.length) { %><div class="empty"><strong>No hay solicitudes.</strong>Crea clientes y comparte links públicos para recibir solicitudes.</div><% } %>
          <div id="requestDateEmpty" class="empty" hidden><strong>No hay solicitudes para esta fecha.</strong>Cambia la fecha operativa o selecciona “Ver todas”.</div>
          <% serviceRequests.forEach((request)=>{ const activeCount=request.assignments.filter((item)=>activeCodes.includes(item.status)).length; const confirmedCount=request.assignments.filter((item)=>item.status==='CONFIRMED').length; const complete=confirmedCount>=request.requiredWorkers; const waiting=!complete&&activeCount>=request.requiredWorkers; const requestDate=dateKey(request.serviceDate); %>
            <article class="request-card <%= selectedServiceRequestId===request.id?'active':'' %>" data-request-id="<%= request.id %>" data-request-date="<%= requestDate %>"><div class="top"><strong><%= request.clientName %></strong><span class="status-pill <%= complete?'complete':waiting?'pending-confirmation':'' %>"><%= requestLabel(request.status) %></span></div><div class="meta"><span><%= request.operationPointName || 'Sin punto' %> · <%= request.cityName || 'Sin ciudad' %></span><span>Servicio: <%= cleanGroup(request.serviceName || request.service?.name || 'Sin servicio') %></span><span><%= requestDate %> · <%= scheduleLabel(request) %></span><span>Asignados activos: <%= activeCount %> / <%= request.requiredWorkers %></span><span>Confirmados: <%= confirmedCount %> / <%= request.requiredWorkers %></span></div><div class="request-actions"><a class="btn select-request-link" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>&fecha=<%= requestDate %>">Seleccionar</a><a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a></div></article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel"><div class="board-panel-head"><h2>Asignación</h2><p>Primero asigna, luego confirma auxiliar por auxiliar.</p></div><div class="assignment-body">
        <% if (selectedServiceRequest) { const activeAssignments=selectedServiceRequest.assignments.filter((item)=>activeCodes.includes(item.status)); const selectedActiveCount=activeAssignments.length; const selectedConfirmedCount=selectedServiceRequest.assignments.filter((item)=>item.status==='CONFIRMED').length; const remainingWorkers=Math.max(selectedServiceRequest.requiredWorkers-selectedActiveCount,0); const coverageComplete=selectedActiveCount>=selectedServiceRequest.requiredWorkers; const selectedRequestComplete=selectedConfirmedCount>=selectedServiceRequest.requiredWorkers; %>
          <div class="selected-summary" id="selectedRequestSummary" data-service-request-id="<%= selectedServiceRequest.id %>" data-request-city="<%= selectedServiceRequest.cityName || '' %>" data-request-date="<%= selectedRequestDate %>"><strong><%= selectedServiceRequest.clientName %></strong><div class="meta"><span><%= selectedServiceRequest.operationPointName || 'Sin punto' %> · <%= selectedServiceRequest.cityName || 'Sin ciudad' %></span><span>Servicio: <%= cleanGroup(selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || 'Sin servicio') %></span><span>Fecha: <%= selectedRequestDate %> · Horario: <%= scheduleLabel(selectedServiceRequest) %></span><span>Requeridos: <%= selectedServiceRequest.requiredWorkers %> · Activos: <%= selectedActiveCount %> · Confirmados: <%= selectedConfirmedCount %></span><span><%= selectedRequestComplete?'Solicitud cerrada por confirmación completa.':coverageComplete?'Cobertura completa. Falta confirmar auxiliares.':`Faltan ${remainingWorkers} auxiliares por asignar.` %></span></div></div>
          <div id="assignmentDropZone" class="drop-zone <%= coverageComplete?'disabled':'' %>" data-disabled="<%= coverageComplete?'true':'false' %>"><%= coverageComplete?'Cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.':`Faltan ${remainingWorkers} auxiliares. Arrastra uno o varios auxiliares aquí.` %></div>
          <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign"><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><input type="hidden" id="assignWorkerId" name="workerId" /></form>
          <% if (coverageComplete && !selectedRequestComplete) { %><section class="template-card"><strong>WhatsApp oficial de despacho</strong><p class="muted">El contenido se envía con la plantilla Utility aprobada en Meta y se completa automáticamente con los datos reales de cada asignación.</p><div class="template-actions"><button type="button" class="btn btn-primary" id="sendAllWhatsapp">Enviar plantilla a todos</button></div></section><% } %>
          <div class="assigned-list"><% selectedServiceRequest.assignments.forEach((assignment)=>{ const assignmentActive=activeCodes.includes(assignment.status); const assignmentWaiting=assignmentActive&&assignment.status!=='CONFIRMED'; %><article class="assigned-card" data-assignment-id="<%= assignment.id %>" data-service-request-id="<%= selectedServiceRequest.id %>" data-worker-id="<%= assignment.worker.id %>" data-worker-name="<%= assignment.worker.fullName %>" data-worker-phone="<%= assignment.worker.phone || '' %>" data-client="<%= selectedServiceRequest.clientName || '' %>" data-operation="<%= selectedServiceRequest.operationPointName || '' %>" data-address="<%= selectedServiceRequest.address || '' %>" data-city="<%= selectedServiceRequest.cityName || '' %>" data-service="<%= cleanGroup(selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || '') %>" data-date="<%= selectedRequestDate %>" data-start="<%= selectedServiceRequest.startTime || '' %>"><div class="assigned-main"><div class="worker-heading"><strong><%= assignment.worker.fullName %></strong><span class="contract-value" title="Tipo de contrato"><%= contractLabel(assignment.worker.contractType) %></span></div><div class="meta"><span><%= assignment.worker.phone || 'Sin teléfono' %></span><span class="assignment-status-line">Estado: <%= assignmentLabel(assignment.status) %></span><% if (assignment.notes) { %><span>Nota: <%= assignment.notes %></span><% } %></div></div><div class="assigned-actions"><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><button type="button" class="icon-action icon-whatsapp whatsapp-link dispatch-wa-button" title="Enviar plantilla oficial de WhatsApp" aria-label="Enviar plantilla oficial de WhatsApp">WA</button><% } %><% if (assignmentWaiting) { %><form data-async-assignment-action="no-confirmado" method="post" action="/admin/operaciones/asignaciones/no-confirmado"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">No confirmó</button></form><% } %><form data-async-assignment-action="unassign" method="post" action="/admin/operaciones/asignaciones/unassign"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="icon-remove-btn" type="submit" title="Quitar asignación" aria-label="Quitar asignación">−</button></form></div></article><% }) %></div>
        <% } else { %><div class="empty"><strong>Selecciona una solicitud.</strong>Necesitas una solicitud activa antes de asignar auxiliares.</div><div id="assignmentDropZone" class="drop-zone">Selecciona una solicitud.</div><% } %>
      </div></aside>
    </section>

    <section class="rest-panel" id="workerRestPanel">
      <div class="rest-head"><div><h2>Descansos</h2><p>Selecciona o arrastra uno o varios auxiliares. Los Directos requieren motivo; los Contratistas solo requieren la fecha del descanso. El descanso no puede quedar en domingo ni festivo.</p></div><span class="rest-date-chip">Fecha mostrada: <%= safeRestDate || 'hoy' %></span></div>
      <div id="restDropZone" class="drop-zone rest-drop-zone">Arrastra uno o varios auxiliares para asignarles descanso.</div>
      <div class="rest-list">
        <% if (!safeRestAssignments.length) { %><div class="rest-empty">No hay descansos asignados para esta fecha.</div><% } %>
        <% safeRestAssignments.forEach((rest)=>{ const restWorker=workers.find((worker)=>worker.id===rest.workerId); %>
          <article class="rest-card"><div><strong><%= restWorker?.fullName || 'Auxiliar' %></strong><div class="meta"><span><%= rest.reason ? restLabel(rest.reason) : 'Sin justificación requerida' %></span><span><%= rest.restDate %><% if(rest.dayAdjustment===-1){ %> · Descuenta 1 día<% } %></span><% if(rest.originSundayDate){ %><span>Domingo asociado: <%= rest.originSundayDate %></span><% } %></div></div><form method="post" action="/admin/operaciones/asignaciones/descansos/cancelar" onsubmit="return confirm('¿Retirar este descanso?');"><input type="hidden" name="workerId" value="<%= rest.workerId %>" /><input type="hidden" name="restDate" value="<%= rest.restDate %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">Retirar</button></form></article>
        <% }) %>
      </div>
      <dialog class="rest-dialog" id="restConflictDialog">
        <form method="dialog" id="restConflictForm">
          <h3>Auxiliar ya asignado</h3>
          <p class="field-hint" id="restConflictMessage">Este auxiliar ya tiene una solicitud activa en la fecha mostrada.</p>
          <div class="dialog-actions"><button class="btn" type="button" id="cancelRestConflict">Cancelar</button><button class="btn btn-primary" type="button" id="confirmAssignedRest">Dar descanso</button></div>
        </form>
      </dialog>
      <dialog class="rest-dialog" id="restAssignmentDialog">
        <form method="post" action="/admin/operaciones/asignaciones/descansos" id="restAssignmentForm">
          <h3>Asignar descanso</h3>
          <div class="meta"><span id="restWorkerName">Auxiliar</span><span id="restContractRule">Selecciona uno o varios auxiliares.</span></div>
          <input type="hidden" name="workerId" id="restWorkerId" />
          <input type="hidden" name="allowAssignedRest" id="allowAssignedRestInput" value="false" />
          <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
          <div class="field"><label for="restDateValue">Fecha de descanso</label><input type="date" name="restDate" id="restDateValue" value="<%= safeRestDate %>" required /></div>
          <div class="field" id="restReasonField"><label for="restReasonInput">Motivo</label><select name="reason" id="restReasonInput"><option value="">Selecciona</option><% safeRestReasons.forEach((reason)=>{ %><option value="<%= reason %>"><%= restLabel(reason) %></option><% }) %></select></div>
          <div class="field" id="originSundayField" hidden><label for="originSundayDateInput">Domingo asociado al descanso remunerado</label><input type="date" name="originSundayDate" id="originSundayDateInput" /></div>
          <div class="dialog-actions"><button class="btn" type="button" id="cancelRestDialog">Cancelar</button><button class="btn btn-primary" type="submit">Asignar descanso</button></div>
        </form>
      </dialog>
      <dialog class="rest-dialog rest-origin-dialog" id="restOriginBatchDialog">
        <form id="restOriginBatchForm">
          <h3>Domingo que generó cada descanso</h3>
          <p class="field-hint">Asigna el domingo correspondiente a cada auxiliar Directo. Los Contratistas no requieren esta información.</p>
          <div class="rest-origin-list" id="restOriginBatchList"></div>
          <div class="dialog-actions"><button class="btn" type="button" id="cancelRestOriginBatch">Volver</button><button class="btn btn-primary" type="submit" id="confirmRestOriginBatch">Asignar descansos</button></div>
        </form>
      </dialog>
    </section>
  </main>
  <div class="async-toast" id="asyncToast" role="status" aria-live="polite"></div>
  <script src="/public/service-request-delete-confirm.js"></script>
  <script>
    (function(){
      const BOARD_POS_KEY='dispatchAssignmentBoardPosition';
      let selectedWorkerIds=new Set();
      let restBatchHasDirect=false;
      let restBatchWorkers=[];
      let suppressFilterSubmit=false;
      let autoSelectingRequest=false;
      const qs=(s,root=document)=>root.querySelector(s);
      const qsa=(s,root=document)=>Array.from(root.querySelectorAll(s));
      function showToast(message){const toast=qs('#asyncToast');if(!toast)return;toast.textContent=message;toast.classList.add('show');window.clearTimeout(showToast._t);showToast._t=window.setTimeout(()=>toast.classList.remove('show'),2600);}
      function encodeForm(form){const params=new URLSearchParams();new FormData(form).forEach((value,key)=>params.append(key,value));return params;}
      function saveBoardPosition(){try{sessionStorage.setItem(BOARD_POS_KEY,JSON.stringify({y:window.scrollY||0,worker:qs('#workerList')?.scrollTop||0,request:qs('#requestList')?.scrollTop||0,time:Date.now()}));}catch(error){}}
      function restoreBoardPosition(){try{const raw=sessionStorage.getItem(BOARD_POS_KEY);if(!raw)return;sessionStorage.removeItem(BOARD_POS_KEY);const pos=JSON.parse(raw);if(!pos||Date.now()-(pos.time||0)>30000)return;window.setTimeout(()=>{window.scrollTo(0,pos.y||0);const workerList=qs('#workerList');const requestList=qs('#requestList');if(workerList)workerList.scrollTop=pos.worker||0;if(requestList)requestList.scrollTop=pos.request||0;},40);}catch(error){}}
      function todayDateInColombia(){const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Bogota',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());const map=Object.fromEntries(parts.map((part)=>[part.type,part.value]));return `${map.year}-${map.month}-${map.day}`;}
      function urlDateValue(){const url=new URL(window.location.href);if(url.searchParams.has('allDates'))return '';if(url.searchParams.has('fecha'))return url.searchParams.get('fecha')||'';if(url.searchParams.has('date'))return url.searchParams.get('date')||'';return null;}
      function currentDateFilter(){const fromUrl=urlDateValue();if(fromUrl!==null)return fromUrl;return todayDateInColombia();}
      function syncDateProxy(){const value=currentDateFilter();qsa('[data-date-proxy="true"]').forEach((input)=>{input.value=value;});}
      function updateUrlDate(value){const url=new URL(window.location.href);url.searchParams.delete('date');if(value){url.searchParams.set('fecha',value);url.searchParams.delete('allDates');}else{url.searchParams.delete('fecha');url.searchParams.set('allDates','1');}history.replaceState(null,'',url.toString());syncDateProxy();}
      function normalizeCity(value){return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();}
      function compatibleCitiesForRequest(cityName){const n=normalizeCity(cityName);if(!n)return[];if(n==='siberia')return['siberia','bogota','bogota d.c.','bogota dc','madrid','funza','mosquera'];return[n];}
      function applyAutomaticCityFilter(){const city=qs('#selectedRequestSummary')?.dataset.requestCity||'';const allowed=compatibleCitiesForRequest(city);const cards=qsa('.worker-card');const empty=qs('#autoFilterEmpty');if(!allowed.length){if(empty)empty.hidden=true;return;}let count=0;cards.forEach((card)=>{const workerCities=String(card.dataset.workerCities||'').split('|').map(normalizeCity).filter(Boolean);const vacancyCities=String(card.dataset.vacancyCities||'').split('|').map(normalizeCity).filter(Boolean);const visible=workerCities.some((item)=>allowed.includes(item))||vacancyCities.some((item)=>allowed.includes(item));card.hidden=!visible;if(visible)count+=1;});const text=qs('#cityAutoFilterText');if(text)text.textContent=`Filtro automático aplicado por ciudad: ${city}.`;if(empty)empty.hidden=count>0;}
      function syncRestDateUi(){const value=currentDateFilter()||todayDateInColombia();const chip=qs('.rest-date-chip');if(chip)chip.textContent=`Fecha mostrada: ${value}`;}
      function applyDateFilter(){const input=qs('#assignmentDateFilter');const value=currentDateFilter();if(input&&input.value!==value)input.value=value;const label=qs('#assignmentDateLabel');if(label)label.textContent=value||'Todas las fechas';let visible=0;qsa('.request-card[data-request-date]').forEach((card)=>{const match=!value||card.dataset.requestDate===value;card.hidden=!match;if(match)visible+=1;});const empty=qs('#requestDateEmpty');if(empty)empty.hidden=visible>0;const summary=qs('#selectedRequestSummary');const drop=qs('#assignmentDropZone');const mismatch=Boolean(value&&summary?.dataset.requestDate&&summary.dataset.requestDate!==value);summary?.classList.toggle('out-of-date',mismatch);if(drop&&mismatch){drop.classList.add('disabled');drop.dataset.disabled='true';drop.textContent='Selecciona una solicitud de la fecha filtrada antes de asignar auxiliares.';}syncDateProxy();syncRestDateUi();}
      async function replaceBoardFromUrl(urlValue,pushUrl=true){saveBoardPosition();const response=await fetch(urlValue,{headers:{'X-Requested-With':'fetch'}});if(!response.ok)throw new Error('No fue posible actualizar el tablero.');const html=await response.text();const doc=new DOMParser().parseFromString(html,'text/html');const newBoard=doc.querySelector('.board-layout');const board=qs('.board-layout');const newRestPanel=doc.querySelector('#workerRestPanel');const restPanel=qs('#workerRestPanel');if(!newBoard||!board)throw new Error('No fue posible leer el tablero actualizado.');board.innerHTML=newBoard.innerHTML;if(newRestPanel&&restPanel)restPanel.innerHTML=newRestPanel.innerHTML;const oldNote=qs('.section-note');const newNote=doc.querySelector('.section-note');if(oldNote&&newNote)oldNote.textContent=newNote.textContent;else if(!oldNote&&newNote){document.querySelector('.hero')?.insertAdjacentElement('afterend',newNote.cloneNode(true));}if(pushUrl)history.replaceState(null,'',urlValue);selectedWorkerIds.clear();bindBoard();restoreBoardPosition();}
      async function maybeAutoSelectFirstVisibleRequest(force=false){if(autoSelectingRequest)return;const value=currentDateFilter();if(!value)return;const summary=qs('#selectedRequestSummary');if(!force&&summary?.dataset.requestDate===value)return;if(summary?.dataset.requestDate===value)return;const firstCard=qsa('.request-card[data-request-date]').find((card)=>!card.hidden&&card.dataset.requestDate===value);const link=firstCard?.querySelector('.select-request-link');if(!link)return;autoSelectingRequest=true;try{const url=new URL(link.href);url.searchParams.set('fecha',value);url.searchParams.delete('allDates');await replaceBoardFromUrl(url.toString(),true);}catch(error){console.error(error);showToast(error.message||'No fue posible seleccionar la fecha.');}finally{autoSelectingRequest=false;}}
      async function refreshCurrentBoard(message){const url=new URL(window.location.href);url.searchParams.delete('message');const value=currentDateFilter();if(value)url.searchParams.set('fecha',value);await replaceBoardFromUrl(url.toString(),false);if(message)showToast(message);}
      async function postFormWithoutRefresh(form,successMessage){const buttons=qsa('button,a',form.closest('.assigned-card')||form);buttons.forEach((button)=>{button.disabled=true;button.setAttribute('aria-disabled','true');});try{const response=await fetch(form.action,{method:'POST',body:encodeForm(form),redirect:'follow',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'fetch'}});if(!response.ok)throw new Error('No fue posible completar la acción.');await refreshCurrentBoard(successMessage);}finally{buttons.forEach((button)=>{button.disabled=false;button.removeAttribute('aria-disabled');});}}
      function getSelectedWorkerIds(){return Array.from(selectedWorkerIds).filter(Boolean);}
      function refreshSelectionUi(){qsa('.worker-card').forEach((card)=>{const selected=selectedWorkerIds.has(card.dataset.workerId);card.classList.toggle('selected',selected);const checkbox=card.querySelector('.worker-select');if(checkbox)checkbox.checked=selected;});const count=qs('#selectedWorkersCount');if(count)count.textContent=String(selectedWorkerIds.size);}
      function setWorkerSelection(workerId,selected){if(!workerId)return;if(selected)selectedWorkerIds.add(workerId);else selectedWorkerIds.delete(workerId);refreshSelectionUi();}
      function clearWorkerSelection(){selectedWorkerIds.clear();refreshSelectionUi();}
      async function assignWorkers(workerIds){const ids=[...new Set(workerIds)].filter(Boolean);if(!ids.length)return;const drop=qs('#assignmentDropZone');const form=qs('#assignForm');const serviceRequestId=form?.querySelector('input[name="serviceRequestId"]')?.value;if(drop?.dataset.disabled==='true'){showToast('La solicitud no está disponible para asignar en este momento.');return;}if(!serviceRequestId||!form){showToast('Selecciona una solicitud antes de asignar auxiliares.');return;}showToast(`Asignando ${ids.length} auxiliar${ids.length!==1?'es':''}...`);if(drop)drop.classList.add('disabled');for(const workerId of ids){const payload=new URLSearchParams();payload.set('serviceRequestId',serviceRequestId);payload.set('workerId',workerId);const response=await fetch(form.action,{method:'POST',body:payload,redirect:'follow',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'fetch'}});if(!response.ok){if(drop)drop.classList.remove('disabled');throw new Error('No fue posible asignar uno de los auxiliares.');}}clearWorkerSelection();await refreshCurrentBoard(`${ids.length} auxiliar${ids.length!==1?'es enviados':' enviado'} a asignación.`);}
      function normalizePhone(phone){const digits=String(phone||'').replace(/\D/g,'');if(!digits)return'';if(digits.startsWith('57'))return digits;if(digits.length===10)return`57${digits}`;return digits;}
      async function sendDispatchWhatsapp(button){const phone=button.dataset.waPhone;const card=button.closest('.assigned-card');const context={assignmentId:card?.dataset.assignmentId||'',serviceRequestId:card?.dataset.serviceRequestId||qs('#selectedRequestSummary')?.dataset.serviceRequestId||'',workerId:card?.dataset.workerId||'',recipientName:card?.dataset.workerName||'',messageType:'DISPATCH_ASSIGNMENT_CONFIRMATION_REQUEST'};if(!phone){showToast('No hay número de WhatsApp para este auxiliar.');return;}if(!context.assignmentId||!context.serviceRequestId||!context.workerId){showToast('No se pudo identificar la asignación. Recarga el tablero e intenta nuevamente.');return;}button.disabled=true;const originalText=button.innerHTML;button.innerHTML='...';try{const response=await fetch('/admin/operaciones/whatsapp/enviar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone,context})});const data=await response.json();if(response.status===503){showToast(data.message||'WhatsApp oficial de despacho no está configurado.');return;}if(!response.ok||!data.ok)throw new Error(data.message||'No se pudo enviar la plantilla oficial.');showToast('Plantilla oficial enviada correctamente.');}catch(error){showToast(error.message||'Error enviando WhatsApp.');}finally{button.disabled=false;button.innerHTML=originalText;}}
      function refreshLinks(){qsa('.assigned-card').forEach((card)=>{const link=card.querySelector('.whatsapp-link');if(!link)return;link.dataset.waPhone=normalizePhone(card.dataset.workerPhone);link.onclick=function(){sendDispatchWhatsapp(link);};});}
      function syncRestFields(){const direct=restBatchHasDirect;const directWorkers=restBatchWorkers.filter((worker)=>worker.contractType==='DIRECTO');const reasonField=qs('#restReasonField');const reasonInput=qs('#restReasonInput');const rule=qs('#restContractRule');if(reasonField)reasonField.hidden=!direct;if(reasonInput){reasonInput.disabled=!direct;reasonInput.required=direct;if(!direct)reasonInput.value='';}if(rule)rule.textContent=direct?'Incluye contrato Directo: selecciona el motivo del descanso.':'Solo Contratistas: el descanso requiere únicamente la fecha.';const remunerado=direct&&reasonInput?.value==='REMUNERADO';const bulkRemunerado=remunerado&&restBatchWorkers.length>1;const field=qs('#originSundayField');const origin=qs('#originSundayDateInput');if(field)field.hidden=!remunerado||bulkRemunerado;if(origin){origin.required=remunerado&&!bulkRemunerado;origin.disabled=!remunerado||bulkRemunerado;if(!remunerado||bulkRemunerado)origin.value='';}if(rule&&bulkRemunerado)rule.textContent=`${directWorkers.length} Directo${directWorkers.length!==1?'s':''}: al continuar asignarás el domingo correspondiente a cada uno.`;}
      function openRestDialog(workerIds){
        const ids=[...new Set(Array.isArray(workerIds)?workerIds:[workerIds])].filter(Boolean);
        const cards=ids.map((workerId)=>qsa('.worker-card').find((item)=>item.dataset.workerId===workerId)).filter(Boolean);
        if(!cards.length){showToast('Selecciona al menos un auxiliar para descanso.');return;}
        const dialog=qs('#restAssignmentDialog');
        const workerInput=qs('#restWorkerId');
        const workerName=qs('#restWorkerName');
        const reasonInput=qs('#restReasonInput');
        const originInput=qs('#originSundayDateInput');
        const restDate=qs('#restDateValue');
        const allowAssignedRestInput=qs('#allowAssignedRestInput');
        restBatchWorkers=cards.map((card)=>({workerId:card.dataset.workerId,workerName:card.dataset.workerName||'Auxiliar',contractType:card.dataset.contractType||'DIRECTO',sameDayAssignment:card.dataset.sameDayAssignment==='true'}));
        restBatchHasDirect=cards.some((card)=>card.dataset.contractType==='DIRECTO');
        if(workerInput)workerInput.value=cards.map((card)=>card.dataset.workerId).join(',');
        if(workerName){const names=restBatchWorkers.map((worker)=>worker.workerName);workerName.textContent=names.length===1?names[0]:`${names.length} auxiliares: ${names.slice(0,3).join(', ')}${names.length>3?'…':''}`;}
        if(reasonInput)reasonInput.value='';
        if(originInput)originInput.value='';
        if(restDate)restDate.value=currentDateFilter()||todayDateInColombia();
        if(allowAssignedRestInput)allowAssignedRestInput.value='false';
        syncRestFields();
        const assignedWorkers=restBatchWorkers.filter((worker)=>worker.sameDayAssignment);
        if(assignedWorkers.length){
          const conflictMessage=qs('#restConflictMessage');
          const names=assignedWorkers.map((worker)=>worker.workerName).join(', ');
          if(conflictMessage)conflictMessage.textContent=`${names} ${assignedWorkers.length===1?'ya está asignado a una solicitud activa':'ya están asignados a solicitudes activas'} en la fecha mostrada. Si deseas continuar, pulsa “Dar descanso”; después podrás elegir la fecha y el motivo cuando corresponda.`;
          qs('#restConflictDialog')?.showModal();
          return;
        }
        dialog?.showModal();
      }
      function renderRestOriginBatchDialog(){const directWorkers=restBatchWorkers.filter((worker)=>worker.contractType==='DIRECTO');const list=qs('#restOriginBatchList');if(!list||!directWorkers.length){showToast('No hay auxiliares Directos que requieran domingo asociado.');return;}list.innerHTML='';directWorkers.forEach((worker)=>{const row=document.createElement('label');row.className='rest-origin-row';const details=document.createElement('div');const name=document.createElement('strong');name.textContent=worker.workerName;const contract=document.createElement('span');contract.textContent='Contrato Directo · selecciona el domingo que generó este descanso';details.append(name,contract);const input=document.createElement('input');input.type='date';input.required=true;input.setAttribute('data-rest-origin-worker',worker.workerId);input.dataset.workerName=worker.workerName;row.append(details,input);list.append(row);});qs('#restAssignmentDialog')?.close();qs('#restOriginBatchDialog')?.showModal();}
      async function postRestWorker(worker,originSundayDate){const form=qs('#restAssignmentForm');if(!form)throw new Error('No se encontró el formulario de descanso.');const payload=new URLSearchParams();payload.set('workerId',worker.workerId);payload.set('restDate',qs('#restDateValue')?.value||'');if(qs('#allowAssignedRestInput')?.value==='true')payload.set('allowAssignedRest','true');const serviceRequestId=form.querySelector('input[name="serviceRequestId"]')?.value;if(serviceRequestId)payload.set('serviceRequestId',serviceRequestId);if(worker.contractType==='DIRECTO'){payload.set('reason',qs('#restReasonInput')?.value||'');if(originSundayDate)payload.set('originSundayDate',originSundayDate);}const response=await fetch(form.action,{method:'POST',body:payload,redirect:'follow',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'fetch'}});const html=await response.text();const doc=new DOMParser().parseFromString(html,'text/html');const message=doc.querySelector('.section-note')?.textContent?.trim()||'';if(!response.ok||/\bno guardad[oa]s?\b/i.test(message)||/No fue posible/i.test(message))throw new Error(message||'No fue posible guardar el descanso.');return message;}
      async function submitRestBatchWithOrigins(event){event.preventDefault();const list=qs('#restOriginBatchList');const inputs=qsa('[data-rest-origin-worker]',list);const originByWorker=new Map();for(const input of inputs){const origin=input.value;const originDate=/^\d{4}-\d{2}-\d{2}$/.test(String(origin||''))?new Date(`${origin}T12:00:00.000Z`):null;if(!originDate||originDate.getUTCDay()!==0){showToast(`Selecciona un domingo válido para ${input.dataset.workerName||'el auxiliar'}.`);input.focus();return;}originByWorker.set(input.getAttribute('data-rest-origin-worker'),origin);}const button=qs('#confirmRestOriginBatch');const cancelButton=qs('#cancelRestOriginBatch');if(button){button.disabled=true;button.textContent='Asignando...';}if(cancelButton)cancelButton.disabled=true;let saved=0;const failures=[];try{for(const worker of restBatchWorkers){try{const originSundayDate=worker.contractType==='DIRECTO'?(originByWorker.get(worker.workerId)||''):'';await postRestWorker(worker,originSundayDate);saved+=1;}catch(error){failures.push(`${worker.workerName}: ${error.message||'No fue posible guardar.'}`);}}qs('#restOriginBatchDialog')?.close();qs('#restAssignmentDialog')?.close();const parts=[];if(saved)parts.push(`${saved} descanso${saved!==1?'s asignados':' asignado'}`);if(failures.length)parts.push(`${failures.length} no guardado${failures.length!==1?'s':''}: ${failures.join(' · ')}`);await refreshCurrentBoard(parts.join('. ')||'No fue posible guardar los descansos.');}finally{if(button){button.disabled=false;button.textContent='Asignar descansos';}if(cancelButton)cancelButton.disabled=false;}}
      function bindRestPanel(){const restDrop=qs('#restDropZone');if(restDrop){restDrop.addEventListener('dragover',(event)=>{event.preventDefault();restDrop.classList.add('drag-over');});restDrop.addEventListener('dragleave',()=>restDrop.classList.remove('drag-over'));restDrop.addEventListener('drop',(event)=>{event.preventDefault();restDrop.classList.remove('drag-over');const ids=event.dataTransfer.getData('text/plain').split(',').map((item)=>item.trim()).filter(Boolean);openRestDialog(ids);});}qs('#restSelectedWorkers')?.addEventListener('click',()=>openRestDialog(getSelectedWorkerIds()));qs('#cancelRestConflict')?.addEventListener('click',()=>qs('#restConflictDialog')?.close());qs('#confirmAssignedRest')?.addEventListener('click',()=>{const conflictDialog=qs('#restConflictDialog');if(conflictDialog?.open)conflictDialog.close();const allowAssignedRestInput=qs('#allowAssignedRestInput');if(allowAssignedRestInput)allowAssignedRestInput.value='true';qs('#restAssignmentDialog')?.showModal();});qs('#restReasonInput')?.addEventListener('change',syncRestFields);qs('#cancelRestDialog')?.addEventListener('click',()=>qs('#restAssignmentDialog')?.close());qs('#cancelRestOriginBatch')?.addEventListener('click',()=>{qs('#restOriginBatchDialog')?.close();qs('#restAssignmentDialog')?.showModal();});qs('#restOriginBatchForm')?.addEventListener('submit',submitRestBatchWithOrigins);qs('#restAssignmentForm')?.addEventListener('submit',(event)=>{const restDateValue=qs('#restDateValue')?.value;const restDate=/^\d{4}-\d{2}-\d{2}$/.test(String(restDateValue||''))?new Date(`${restDateValue}T12:00:00.000Z`):null;if(!restDate||restDate.getUTCDay()===0){event.preventDefault();showToast('Selecciona una fecha de descanso válida que no sea domingo.');return;}const remunerado=restBatchHasDirect&&qs('#restReasonInput')?.value==='REMUNERADO';if(remunerado&&restBatchWorkers.length>1){event.preventDefault();renderRestOriginBatchDialog();return;}if(!remunerado)return;const origin=qs('#originSundayDateInput')?.value;const originDate=/^\d{4}-\d{2}-\d{2}$/.test(String(origin||''))?new Date(`${origin}T12:00:00.000Z`):null;if(!originDate||originDate.getUTCDay()!==0){event.preventDefault();showToast('Selecciona un domingo válido para asociar al descanso remunerado.');}});syncRestFields();}
      function bindBoard(){applyDateFilter();applyAutomaticCityFilter();refreshSelectionUi();refreshLinks();bindRestPanel();window.setTimeout(()=>maybeAutoSelectFirstVisibleRequest(false),0);qs('#assignmentDateFilter')?.addEventListener('change',(event)=>{updateUrlDate(event.target.value);applyDateFilter();maybeAutoSelectFirstVisibleRequest(true);});qs('#clearAssignmentDateFilter')?.addEventListener('click',()=>{const input=qs('#assignmentDateFilter');if(input)input.value='';updateUrlDate('');applyDateFilter();});qs('#workerFilterForm')?.addEventListener('submit',(event)=>{if(suppressFilterSubmit)return;syncDateProxy();});qsa('.select-request-link').forEach((link)=>link.addEventListener('click',(event)=>{event.preventDefault();const url=new URL(link.href);const date=currentDateFilter()||link.closest('.request-card')?.dataset.requestDate;if(date)url.searchParams.set('fecha',date);else url.searchParams.set('fecha',link.closest('.request-card')?.dataset.requestDate||'');url.searchParams.delete('allDates');replaceBoardFromUrl(url.toString(),true).catch((error)=>{console.error(error);showToast(error.message||'No fue posible seleccionar.');});}));qsa('.worker-card[draggable="true"]').forEach((card)=>{card.addEventListener('dragstart',(event)=>{const workerId=card.dataset.workerId;if(!selectedWorkerIds.has(workerId)){clearWorkerSelection();setWorkerSelection(workerId,true);}const ids=getSelectedWorkerIds();qsa('.worker-card.selected').forEach((selectedCard)=>selectedCard.classList.add('drag-batch'));event.dataTransfer.setData('text/plain',ids.join(','));event.dataTransfer.effectAllowed='move';});card.addEventListener('dragend',()=>qsa('.worker-card.drag-batch').forEach((item)=>item.classList.remove('drag-batch')));const checkbox=card.querySelector('.worker-select');checkbox?.addEventListener('change',()=>setWorkerSelection(card.dataset.workerId,checkbox.checked));card.addEventListener('click',(event)=>{if(event.target.closest('input,button,a,select,textarea'))return;setWorkerSelection(card.dataset.workerId,!selectedWorkerIds.has(card.dataset.workerId));});});qs('#clearSelectedWorkers')?.addEventListener('click',clearWorkerSelection);qs('#assignSelectedWorkers')?.addEventListener('click',()=>assignWorkers(getSelectedWorkerIds()).catch((error)=>{console.error(error);showToast(error.message||'No fue posible asignar.');}));const drop=qs('#assignmentDropZone');if(drop){drop.addEventListener('dragover',(event)=>{if(drop.dataset.disabled==='true')return;event.preventDefault();drop.classList.add('drag-over');});drop.addEventListener('dragleave',()=>drop.classList.remove('drag-over'));drop.addEventListener('drop',(event)=>{event.preventDefault();drop.classList.remove('drag-over');if(drop.dataset.disabled==='true'){showToast('No puedes asignar aquí en este momento.');return;}const ids=event.dataTransfer.getData('text/plain').split(',').map((item)=>item.trim()).filter(Boolean);assignWorkers(ids).catch((error)=>{console.error(error);showToast(error.message||'No fue posible asignar.');});});}qsa('form[data-async-assignment-action]').forEach((form)=>form.addEventListener('submit',(event)=>{event.preventDefault();const action=form.dataset.asyncAssignmentAction;if(action==='unassign'&&!confirm('¿Quitar este auxiliar de la solicitud?'))return;const message=action==='no-confirmado'?'Auxiliar marcado como no confirmado.':'Auxiliar retirado de la solicitud.';postFormWithoutRefresh(form,message).catch((error)=>{console.error(error);showToast(error.message||'No fue posible completar la acción.');});}));qs('#sendAllWhatsapp')?.addEventListener('click',async()=>{refreshLinks();const buttons=qsa('.whatsapp-link');if(!buttons.length){showToast('No hay asignaciones con WhatsApp disponibles para enviar.');return;}for(const button of buttons){await sendDispatchWhatsapp(button);} });}
      window.addEventListener('pageshow',(event)=>{if(event.persisted)window.location.reload();});
      bindBoard();
      restoreBoardPosition();
    })();
  </script>
