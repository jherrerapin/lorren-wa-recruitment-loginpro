<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Asignación operativa — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .assignment-page{max-width:min(2040px,calc(100vw - 32px));width:100%;}
    .board-layout{display:grid;grid-template-columns:minmax(420px,.78fr) minmax(480px,1fr) minmax(480px,.9fr);gap:14px;align-items:start}
    .board-panel{background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-sm);overflow:hidden;min-height:420px;min-width:0}
    .board-panel-head{padding:12px 14px;border-bottom:1px solid #edf2f7}.board-panel-head h2{color:var(--navy);font-size:15px;margin-bottom:3px}.board-panel-head p{color:var(--muted);font-size:12px}
    .filters{display:grid;gap:7px;padding:10px;border-bottom:1px solid #edf2f7;background:var(--surface-2)}.filters-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}
    .worker-toolbar{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px;align-items:center;padding:7px 9px;border-bottom:1px solid #edf2f7;background:#fff;position:relative;z-index:1}.worker-toolbar strong{font-size:12px;color:var(--navy);line-height:1.2;white-space:nowrap}.worker-toolbar-actions{display:flex;justify-content:flex-end;gap:6px;flex-wrap:wrap}.worker-toolbar .btn{width:auto;min-width:118px;justify-content:center;padding:6px 10px;font-size:11px;white-space:nowrap}
    .worker-list{max-height:calc(100vh - 380px);min-height:300px;overflow-y:auto;padding:6px;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:5px;align-content:start}.request-list{max-height:calc(100vh - 380px);min-height:330px;overflow-y:auto;padding:8px;display:grid;gap:7px;align-content:start}
    .worker-card,.request-card,.assigned-card,.template-card{border:1px solid var(--border);border-radius:10px;background:#fff;padding:9px;box-shadow:var(--shadow-sm)}
    .worker-card{cursor:grab;display:grid;grid-template-columns:18px minmax(0,1fr);gap:6px;align-items:start;padding:6px 7px;border-radius:9px;min-width:0}.worker-card.same-day-assignment{border:1px solid #f59e0b;background:#fffaf0;box-shadow:none}.worker-card.same-day-assignment strong{color:#92400e}.worker-card.selected{border-color:var(--teal);background:#f0fdfa;box-shadow:0 0 0 2px rgba(13,122,107,.12)}.worker-card.drag-batch{opacity:.82;transform:scale(.99)}.worker-card[hidden]{display:none}
    .worker-select{width:15px;height:15px;margin:2px 0 0 0;accent-color:var(--teal)}.worker-main{min-width:0}.worker-card strong,.request-card strong,.assigned-card strong{color:var(--navy);display:block;font-size:12.5px;margin-bottom:2px;line-height:1.12;overflow-wrap:anywhere}.worker-card .meta{font-size:10.5px;gap:2px 8px;display:flex;flex-wrap:wrap;line-height:1.25}.meta{color:var(--muted);font-size:12px;display:grid;gap:2px;min-width:0}.meta span{overflow-wrap:anywhere}.chips{display:flex;flex-wrap:wrap;gap:3px;margin-top:4px}.chip{display:inline-flex;align-items:center;border-radius:999px;padding:2px 6px;font-size:9px;font-weight:900;background:var(--blue-soft);color:var(--blue);max-width:100%;overflow:hidden;text-overflow:ellipsis;line-height:1.15}.chip.same-day-assignment{background:#f59e0b;color:#fff;font-size:9px;padding:2px 6px}
    .request-card:hover,.request-card.active{border-color:var(--teal);box-shadow:var(--shadow)}.request-card.active{background:#f0fdfa}.request-card .top{display:flex;justify-content:space-between;gap:10px}.status-pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900;background:var(--amber-soft);color:var(--amber);white-space:nowrap}.status-pill.complete{background:var(--green-soft);color:var(--green)}.status-pill.pending-confirmation{background:var(--blue-soft);color:var(--blue)}.request-actions,.assigned-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:7px;align-items:center}.request-actions form,.assigned-actions form{margin:0}.assignment-body{padding:12px;display:grid;gap:10px}.selected-summary{border:1px solid var(--border);background:var(--surface-2);border-radius:14px;padding:11px}.drop-zone{border:2px dashed #b6c2d2;border-radius:14px;padding:14px;min-height:80px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);background:#fbfdff;font-weight:800;font-size:13px}.drop-zone.drag-over{border-color:var(--teal);background:#f0fdfa;color:var(--teal)}.drop-zone.disabled{border-color:var(--green);background:var(--green-soft);color:var(--green);cursor:not-allowed}.assigned-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:6px;align-items:start}
    .assigned-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:start;padding:7px 8px;border-radius:10px;box-shadow:var(--shadow-sm);transition:opacity .15s,transform .15s}.assigned-card.is-updating{opacity:.55;pointer-events:none}.assigned-card.is-removed{opacity:0;transform:translateY(-4px)}.assigned-card strong{font-size:12px;margin-bottom:2px}.assigned-card .meta{font-size:10.5px;gap:1px}.assigned-card .assignment-message{grid-column:1 / -1;min-height:60px;font-size:12px;padding:7px}.assigned-main{min-width:0}.assigned-actions{justify-content:flex-end;margin-top:0}.assigned-actions .btn{padding:5px 8px;font-size:10.5px}.icon-remove-btn,.icon-action{width:28px;height:28px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-weight:900;line-height:1;cursor:pointer;padding:0}.icon-remove-btn{border:1px solid #fecaca;background:#fff5f5;color:#b91c1c;font-size:20px}.icon-remove-btn:hover{background:#fee2e2;border-color:#fca5a5}.icon-action{border:1px solid var(--border);font-size:15px}.icon-action:disabled{opacity:.65;cursor:not-allowed}.icon-action svg{width:15px;height:15px;display:block}.icon-whatsapp{background:#25d366;color:#fff;border-color:#25d366}.icon-email{background:var(--navy);color:#fff;border-color:var(--navy)}.template-card textarea,.assignment-message{width:100%;min-height:76px;border:1px solid var(--border);border-radius:10px;padding:9px;font:inherit;resize:vertical}.variable-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.variable-btn{border:1px solid var(--border);background:var(--surface-2);color:var(--navy);border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900;cursor:pointer}
    .async-toast{position:fixed;right:18px;bottom:18px;max-width:340px;background:#172033;color:#fff;border-radius:14px;padding:11px 13px;box-shadow:var(--shadow);font-size:13px;line-height:1.35;z-index:9999;opacity:0;transform:translateY(8px);transition:opacity .18s,transform .18s}.async-toast.show{opacity:1;transform:translateY(0)}
    .notify-block{border:2px solid var(--green);border-radius:14px;background:var(--green-soft);padding:14px;display:grid;gap:10px}.notify-block h3{color:var(--green);font-size:14px;margin:0}.notify-contact{font-size:13px;color:var(--navy);display:grid;gap:3px}.notify-contact span{color:var(--muted)}.notify-preview{background:#fff;border:1px solid var(--border);border-radius:10px;padding:12px;font-size:12px;color:var(--navy);white-space:pre-wrap;line-height:1.6;max-height:180px;overflow-y:auto}.notify-actions{display:flex;gap:8px;flex-wrap:wrap}.notify-actions a{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}.notify-managed-field{display:grid;gap:4px}.notify-managed-field label{font-size:12px;font-weight:800;color:var(--navy)}.notify-managed-field input{width:100%;border:1px solid var(--border);border-radius:8px;padding:7px 10px;font:inherit;font-size:13px;background:#fff;color:var(--navy)}.notify-managed-field .field-hint{font-size:11px;color:var(--muted)}.notify-managed-required{border-color:var(--red,#e53e3e)!important;background:#fff5f5!important}
    @media(max-width:1350px){.assignment-page{max-width:calc(100vw - 18px)}.board-layout{grid-template-columns:1fr;gap:12px}.worker-list{max-height:360px;grid-template-columns:repeat(auto-fill,minmax(245px,1fr))}.request-list{max-height:340px}.assigned-list{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}.assigned-card{grid-template-columns:minmax(0,1fr) auto}.assigned-actions{justify-content:flex-end}}
    @media(max-width:760px){.worker-toolbar{grid-template-columns:1fr}.worker-toolbar-actions{justify-content:stretch}.worker-toolbar .btn{width:100%;min-width:0}.worker-list{grid-template-columns:1fr}.filters-row{grid-template-columns:1fr}.assigned-list{grid-template-columns:repeat(auto-fill,minmax(180px,1fr))}.assigned-card{grid-template-columns:1fr}.assigned-actions{justify-content:flex-start}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %><span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>
  <% const activeCodes=['ASSIGNED','CONFIRMATION_PENDING','CONFIRMED']; %>
  <% const requestLabel=(v)=>({PENDING_ASSIGNMENT:'Pendiente de asignación',ASSIGNMENT_PARTIAL:'Asignación parcial',PENDING_CONFIRMATION:'Pendiente de confirmación',ASSIGNMENT_COMPLETE:'Asignación completa',CANCELLED:'Cancelada'}[v]||v||'Pendiente'); %>
  <% const assignmentLabel=(v)=>({ASSIGNED:'Asignado',CONFIRMATION_PENDING:'Pendiente de confirmación',CONFIRMED:'Confirmado',NO_CONFIRMO:'No confirmó',CANCELLED:'Cancelado'}[v]||v||'Asignado'); %>
  <% const cleanGroup=(value)=>String(value||'').replace(/\s*·\s*Grupo\s+GRP-[A-Z0-9-]+/i,'').trim(); %>
  <% const scheduleLabel=(request)=>request.endTime ? `${request.startTime || '-'} - ${request.endTime}` : `${request.startTime || '-'}`; %>
  <% const whatsappIcon = '<svg viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32 101.5 32 1.9 131.6 1.9 254c0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.6-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>'; %>
  <main class="page assignment-page">
    <section class="hero">
      <div><div class="eyebrow">Tablero de asignación</div><h1>Asignación operativa</h1><p>La solicitud solo se cierra cuando la cantidad de auxiliares confirmados cubre el total requerido.</p></div>
      <div class="actions"><a class="btn" href="/admin/operaciones">Volver a Operaciones</a><a class="btn" href="/admin/operaciones/solicitudes">Solicitudes de servicio</a><a class="btn" href="/admin/operaciones/novedades">Novedades</a><a class="btn" href="/admin/operaciones/clientes">Clientes</a><a class="btn" href="/admin/operaciones/personal">Personal operativo</a><a class="btn btn-primary" href="/admin/operaciones/whatsapp">WhatsApp despacho</a></div>
    </section>
    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <section class="board-layout">
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Auxiliares disponibles</h2><p id="cityAutoFilterText">Selecciona una solicitud para aplicar filtro automático por ciudad.</p></div>
        <form class="filters" method="get" action="/admin/operaciones/asignaciones" autocomplete="off">
          <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
          <div class="field"><label>Buscar</label><input name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" /></div>
          <div class="filters-row"><div class="field"><label>Ciudad</label><select name="operationalCityId" onchange="this.form.submit()"><option value="">Todas</option><% cities.forEach((city)=>{ %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select></div><div class="field"><label>Localidad</label><select name="locality"><option value="">Todas</option><% localities.forEach((item)=>{ %><option value="<%= item %>" <%= filters.locality===item?'selected':'' %>><%= item %></option><% }) %></select></div></div>
          <div class="field"><label>Transporte</label><select name="transportMode"><option value="">Todos</option><% transportModes.forEach((item)=>{ %><option value="<%= item %>" <%= filters.transportMode===item?'selected':'' %>><%= item %></option><% }) %></select></div>
          <button class="btn btn-primary" type="submit">Filtrar auxiliares</button>
        </form>
        <div class="worker-toolbar">
          <strong><span id="selectedWorkersCount">0</span> seleccionados</strong>
          <div class="worker-toolbar-actions"><button class="btn" type="button" id="clearSelectedWorkers">Limpiar</button><button class="btn btn-primary" type="button" id="assignSelectedWorkers">Asignar</button></div>
        </div>
        <div class="worker-list" id="workerList">
          <% if (!availableWorkers.length) { %><div class="empty"><strong>No hay auxiliares disponibles.</strong>Los asignados quedan bloqueados para esta solicitud.</div><% } %>
          <div id="autoFilterEmpty" class="empty" hidden><strong>No hay auxiliares para la ciudad de esta solicitud.</strong>Ajusta filtros o revisa ciudades/perfiles.</div>
          <% availableWorkers.forEach((worker)=>{ const workerCityNames=worker.cities.map((entry)=>entry.city.name).join('|'); const vacancyCityNames=worker.vacancies.map((entry)=>entry.vacancy.city||'').join('|'); const hasSameDayAssignment=assignedWorkerIdsOnSelectedDate.has(worker.id); const locationLabel=[worker.residenceCity,worker.residenceLocality].filter(Boolean).join(' · ') || '-'; %>
            <article class="worker-card<%= hasSameDayAssignment ? ' same-day-assignment' : '' %>" draggable="true" data-worker-id="<%= worker.id %>" data-worker-cities="<%= workerCityNames %>" data-vacancy-cities="<%= vacancyCityNames %>">
              <input class="worker-select" type="checkbox" aria-label="Seleccionar <%= worker.fullName %>" />
              <div class="worker-main"><strong><%= worker.fullName %></strong><div class="meta"><span>Tel: <%= worker.phone || '-' %></span><span><%= locationLabel %></span><% if(worker.transportMode){ %><span>Transporte: <%= worker.transportMode %></span><% } %></div><div class="chips"><% if(hasSameDayAssignment){ %><span class="chip same-day-assignment" title="Ya tiene una asignación activa en otra solicitud de esta fecha. Puedes asignarlo de nuevo para un doble turno u horas extra.">⚠ Asignado hoy</span><% } %><% worker.cities.slice(0,2).forEach((entry)=>{ %><span class="chip"><%= entry.city.name %></span><% }) %><% worker.vacancies.slice(0,1).forEach((entry)=>{ %><span class="chip"><%= entry.vacancy.title %><% if(entry.vacancy.city){ %> — <%= entry.vacancy.city %><% } %></span><% }) %></div></div>
            </article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Solicitudes de servicio</h2><p>Elige la solicitud sobre la que vas a trabajar.</p></div>
        <div class="request-list">
          <% serviceRequests.forEach((request)=>{ const activeCount=request.assignments.filter((item)=>activeCodes.includes(item.status)).length; const confirmedCount=request.assignments.filter((item)=>item.status==='CONFIRMED').length; const complete=confirmedCount>=request.requiredWorkers; const waiting=!complete&&activeCount>=request.requiredWorkers; %>
            <article class="request-card <%= selectedServiceRequestId===request.id?'active':'' %>"><div class="top"><strong><%= request.clientName %></strong><span class="status-pill <%= complete?'complete':waiting?'pending-confirmation':'' %>"><%= requestLabel(request.status) %></span></div><div class="meta"><span><%= request.operationPointName || 'Sin punto' %> · <%= request.cityName || 'Sin ciudad' %></span><span>Servicio: <%= cleanGroup(request.serviceName || request.service?.name || 'Sin servicio') %></span><span><%= new Date(request.serviceDate).toISOString().slice(0,10) %> · <%= scheduleLabel(request) %></span><span>Asignados activos: <%= activeCount %> / <%= request.requiredWorkers %></span><span>Confirmados: <%= confirmedCount %> / <%= request.requiredWorkers %></span></div><div class="request-actions"><a class="btn" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">Seleccionar</a><a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a></div></article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel"><div class="board-panel-head"><h2>Asignación</h2><p>Primero asigna, luego confirma auxiliar por auxiliar.</p></div><div class="assignment-body">
        <% if (selectedServiceRequest) { const activeAssignments=selectedServiceRequest.assignments.filter((item)=>activeCodes.includes(item.status)); const selectedActiveCount=activeAssignments.length; const selectedConfirmedCount=selectedServiceRequest.assignments.filter((item)=>item.status==='CONFIRMED').length; const remainingWorkers=Math.max(selectedServiceRequest.requiredWorkers-selectedActiveCount,0); const coverageComplete=selectedActiveCount>=selectedServiceRequest.requiredWorkers; const selectedRequestComplete=selectedConfirmedCount>=selectedServiceRequest.requiredWorkers; %>
          <div class="selected-summary" id="selectedRequestSummary" data-request-city="<%= selectedServiceRequest.cityName || '' %>"><strong><%= selectedServiceRequest.clientName %></strong><div class="meta"><span><%= selectedServiceRequest.operationPointName || 'Sin punto' %> · <%= selectedServiceRequest.cityName || 'Sin ciudad' %></span><span>Servicio: <%= cleanGroup(selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || 'Sin servicio') %></span><span>Fecha: <%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %> · Horario: <%= scheduleLabel(selectedServiceRequest) %></span><span>Requeridos: <%= selectedServiceRequest.requiredWorkers %> · Activos: <%= selectedActiveCount %> · Confirmados: <%= selectedConfirmedCount %></span><span><%= selectedRequestComplete?'Solicitud cerrada por confirmación completa.':coverageComplete?'Cobertura completa. Falta confirmar auxiliares.':`Faltan ${remainingWorkers} auxiliares por asignar.` %></span></div></div>
          <div id="assignmentDropZone" class="drop-zone <%= coverageComplete?'disabled':'' %>" data-disabled="<%= coverageComplete?'true':'false' %>"><%= coverageComplete?'Cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.':`Faltan ${remainingWorkers} auxiliares. Arrastra uno o varios auxiliares aquí.` %></div>
          <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign"><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><input type="hidden" id="assignWorkerId" name="workerId" /></form>
          <% if (coverageComplete && !selectedRequestComplete) { %><section class="template-card"><strong>Mensaje base para WhatsApp</strong><p class="muted">Envía el mensaje y luego marca confirmado o no confirmado. El cierre depende de confirmaciones, no solo de asignaciones.</p><textarea id="globalTemplate">Hola {{nombre}}, te confirmamos asignación para {{fecha}} en {{operacion}}. Dirección: {{direccion}}. Hora de inicio: {{horaInicio}}. Servicio: {{servicio}}. Cliente: {{cliente}}. Por favor confirma recibido.</textarea><div class="variable-row" data-target="globalTemplate"><button type="button" class="variable-btn" data-var="{{nombre}}">Nombre</button><button type="button" class="variable-btn" data-var="{{operacion}}">Operación</button><button type="button" class="variable-btn" data-var="{{direccion}}">Dirección</button><button type="button" class="variable-btn" data-var="{{fecha}}">Fecha</button><button type="button" class="variable-btn" data-var="{{horaInicio}}">Hora inicio</button><button type="button" class="variable-btn" data-var="{{servicio}}">Servicio</button></div></section><% } %>
          <% if (selectedRequestComplete) { const confirmedAssignments=selectedServiceRequest.assignments.filter((a)=>a.status==='CONFIRMED'); const reqName=selectedServiceRequest.requestedByName||''; const reqPhone=selectedServiceRequest.requestedByPhone||''; const reqEmail=selectedServiceRequest.requestedByEmail||''; const hasContact=!!(reqPhone||reqEmail); const serviceDate=new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10); const serviceName=cleanGroup(selectedServiceRequest.serviceName||(selectedServiceRequest.service&&selectedServiceRequest.service.name)||'Sin servicio'); const operationPoint=selectedServiceRequest.operationPointName||''; const city=selectedServiceRequest.cityName||''; const address=selectedServiceRequest.address||''; const startTime=selectedServiceRequest.startTime||''; const workerLines=confirmedAssignments.map((a,i)=>{ const docType=a.worker.documentType||''; const docNum=a.worker.documentNumber||''; const docStr=(docType&&docNum)?(docType+' '+docNum):(docNum||'Sin documento'); return (i+1)+'. '+a.worker.fullName+' — '+docStr; }).join('\n'); const emailSubject='Auxiliares confirmados — '+selectedServiceRequest.clientName+' ('+serviceDate+')'; const rawPhone=reqPhone.replace(/\D/g,''); const waPhone=rawPhone?(rawPhone.startsWith('57')?rawPhone:rawPhone.length===10?'57'+rawPhone:rawPhone):''; %>
          <section class="notify-block"><h3>&#x2705; Notificar al solicitante</h3><% if (reqName || reqPhone || reqEmail) { %><div class="notify-contact"><% if(reqName){ %><span><strong>Nombre:</strong> <%- reqName %></span><% } %><% if(reqPhone){ %><span><strong>Tel / WhatsApp:</strong> <%- reqPhone %></span><% } %><% if(reqEmail){ %><span><strong>Correo:</strong> <%- reqEmail %></span><% } %></div><% } else { %><p class="notify-no-contact">Esta solicitud no tiene datos de contacto del solicitante registrados.</p><% } %><div class="notify-managed-field"><label for="notifyManagedBy">Gestionado por <span style="color:var(--red,#e53e3e)">*</span></label><input type="text" id="notifyManagedBy" placeholder="Nombre de quien gestionó la asignación" autocomplete="off" maxlength="80" /><span class="field-hint">Requerido. Se incluirá al final del mensaje de correo y WhatsApp.</span></div><div class="notify-preview" id="notifyPreview"></div><% if (hasContact) { %><div class="notify-actions"><% if(reqEmail){ %><a id="notifyEmailLink" href="#" class="icon-action icon-email" target="_blank" rel="noopener" title="Enviar correo" aria-label="Enviar correo">✉</a><% } %><% if(waPhone || reqPhone){ %><button id="notifyWaLink" type="button" class="icon-action icon-whatsapp dispatch-wa-button" title="Enviar WhatsApp" aria-label="Enviar WhatsApp"><%- whatsappIcon %></button><% } %></div><% } %></section>
          <script>(function(){const managedInput=document.getElementById('notifyManagedBy'),preview=document.getElementById('notifyPreview'),emailLink=document.getElementById('notifyEmailLink'),waLink=document.getElementById('notifyWaLink');const reqName=<%- JSON.stringify(reqName) %>,reqEmail=<%- JSON.stringify(reqEmail) %>,waPhone=<%- JSON.stringify(waPhone) %>,reqPhone=<%- JSON.stringify(reqPhone) %>,workerLines=<%- JSON.stringify(workerLines) %>,serviceDate=<%- JSON.stringify(serviceDate) %>,startTime=<%- JSON.stringify(startTime) %>,serviceName=<%- JSON.stringify(serviceName) %>,operationPoint=<%- JSON.stringify(operationPoint) %>,city=<%- JSON.stringify(city) %>,address=<%- JSON.stringify(address) %>,emailSubject=<%- JSON.stringify(emailSubject) %>;function buildMsg(managedBy){const lines=[];lines.push('Estimado/a'+(reqName?' '+reqName:''), '', 'Le informamos que los auxiliares confirmados para su servicio son:', '', workerLines, '', 'Detalles del servicio:', '- Fecha: '+serviceDate, '- Hora de inicio: '+startTime, '- Servicio: '+serviceName);if(operationPoint)lines.push('- Punto de operación: '+operationPoint+(city?', '+city:''));if(address)lines.push('- Dirección: '+address);lines.push('', 'Quedamos atentos a cualquier inquietud.');if(managedBy&&managedBy.trim())lines.push('', 'Gestionado por: '+managedBy.trim());return lines.join('\n');}function refreshNotify(){const managedBy=managedInput?managedInput.value:'';const msg=buildMsg(managedBy);if(preview)preview.textContent=msg;const hasManagedBy=managedBy&&managedBy.trim().length>0;if(managedInput)managedInput.classList.toggle('notify-managed-required',!hasManagedBy);if(emailLink){if(!hasManagedBy){emailLink.href='#';emailLink.onclick=function(e){e.preventDefault();managedInput&&managedInput.focus();alert('Debes indicar quién gestionó la asignación antes de enviar.');return false;};}else{emailLink.onclick=null;emailLink.href=reqEmail?'mailto:'+reqEmail+'?subject='+encodeURIComponent(emailSubject)+'&body='+encodeURIComponent(msg):'#';}}if(waLink){waLink.dataset.waPhone=waPhone||reqPhone||'';waLink.dataset.waMessage=msg;if(!hasManagedBy){waLink.onclick=function(e){e.preventDefault();managedInput&&managedInput.focus();showToast('Debes indicar quién gestionó la asignación antes de enviar.');return false;};}else{waLink.onclick=function(e){e.preventDefault();sendDispatchWhatsapp(waLink);return false;};}}}managedInput&&managedInput.addEventListener('input',refreshNotify);refreshNotify();})();</script>
          <% } %>
          <div class="assigned-list"><% selectedServiceRequest.assignments.forEach((assignment)=>{ const assignmentActive=activeCodes.includes(assignment.status); const assignmentWaiting=assignmentActive&&assignment.status!=='CONFIRMED'; %><article class="assigned-card" data-assignment-id="<%= assignment.id %>" data-worker-name="<%= assignment.worker.fullName %>" data-worker-phone="<%= assignment.worker.phone || '' %>" data-client="<%= selectedServiceRequest.clientName || '' %>" data-operation="<%= selectedServiceRequest.operationPointName || '' %>" data-address="<%= selectedServiceRequest.address || '' %>" data-city="<%= selectedServiceRequest.cityName || '' %>" data-service="<%= cleanGroup(selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || '') %>" data-date="<%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %>" data-start="<%= selectedServiceRequest.startTime || '' %>"><div class="assigned-main"><strong><%= assignment.worker.fullName %></strong><div class="meta"><span><%= assignment.worker.phone || 'Sin teléfono' %></span><span class="assignment-status-line">Estado: <%= assignmentLabel(assignment.status) %></span><% if (assignment.notes) { %><span>Nota: <%= assignment.notes %></span><% } %></div></div><div class="assigned-actions"><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><button type="button" class="icon-action icon-whatsapp whatsapp-link dispatch-wa-button" title="Enviar WhatsApp" aria-label="Enviar WhatsApp"><%- whatsappIcon %></button><% } %><% if (assignmentWaiting) { %><form data-async-assignment-action="confirmar" method="post" action="/admin/operaciones/asignaciones/confirmar"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn btn-primary" type="submit">Confirmar</button></form><form data-async-assignment-action="no-confirmado" method="post" action="/admin/operaciones/asignaciones/no-confirmado"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">No confirmó</button></form><% } %><form data-async-assignment-action="unassign" method="post" action="/admin/operaciones/asignaciones/unassign"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="icon-remove-btn" type="submit" title="Quitar asignación" aria-label="Quitar asignación">−</button></form></div><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><textarea class="assignment-message"></textarea><% } %></article><% }) %></div>
        <% } else { %><div class="empty"><strong>Selecciona una solicitud.</strong>Necesitas una solicitud activa antes de asignar auxiliares.</div><div id="assignmentDropZone" class="drop-zone">Selecciona una solicitud.</div><% } %>
      </div></aside>
    </section>
  </main>
  <div class="async-toast" id="asyncToast" role="status" aria-live="polite"></div>
  <script src="/public/service-request-delete-confirm.js"></script>
  <script>
    const dropZone=document.getElementById('assignmentDropZone'),assignForm=document.getElementById('assignForm'),assignWorkerId=document.getElementById('assignWorkerId'),hasSelectedRequest=Boolean('<%= selectedServiceRequestId %>'),isDropZoneDisabled=dropZone?.dataset.disabled==='true',selectedRequestSummary=document.getElementById('selectedRequestSummary'),selectedRequestCity=selectedRequestSummary?.dataset.requestCity||'',cityAutoFilterText=document.getElementById('cityAutoFilterText'),autoFilterEmpty=document.getElementById('autoFilterEmpty'),asyncToast=document.getElementById('asyncToast');
    const BOARD_POS_KEY='dispatchAssignmentBoardPosition';
    window.addEventListener('pageshow',(event)=>{if(event.persisted)window.location.reload();});
    function showToast(message){if(!asyncToast)return;asyncToast.textContent=message;asyncToast.classList.add('show');window.clearTimeout(showToast._t);showToast._t=window.setTimeout(()=>asyncToast.classList.remove('show'),2600);}function encodeForm(form){const params=new URLSearchParams();new FormData(form).forEach((value,key)=>params.append(key,value));return params;}
    function saveBoardPosition(){try{sessionStorage.setItem(BOARD_POS_KEY,JSON.stringify({y:window.scrollY||0,worker:document.getElementById('workerList')?.scrollTop||0,request:document.querySelector('.request-list')?.scrollTop||0,time:Date.now()}));}catch(error){}}
    function restoreBoardPosition(){try{const raw=sessionStorage.getItem(BOARD_POS_KEY);if(!raw)return;sessionStorage.removeItem(BOARD_POS_KEY);const pos=JSON.parse(raw);if(!pos||Date.now()-(pos.time||0)>30000)return;window.setTimeout(()=>{window.scrollTo(0,pos.y||0);const workerList=document.getElementById('workerList');const requestList=document.querySelector('.request-list');if(workerList)workerList.scrollTop=pos.worker||0;if(requestList)requestList.scrollTop=pos.request||0;},40);}catch(error){}}
    function refreshBoardAfterAction(message){saveBoardPosition();const url=new URL(window.location.href);if(message)url.searchParams.set('message',message);window.setTimeout(()=>{window.location.href=url.toString();},650);}
    restoreBoardPosition();
    const normalizeCity=(value)=>String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();const compatibleCitiesForRequest=(cityName)=>{const n=normalizeCity(cityName);if(!n)return[];if(n==='siberia')return['siberia','bogota','bogota d.c.','bogota dc','madrid','funza','mosquera'];return[n];};
    function applyAutomaticCityFilter(){const allowed=compatibleCitiesForRequest(selectedRequestCity);const cards=Array.from(document.querySelectorAll('.worker-card'));if(!allowed.length){if(autoFilterEmpty)autoFilterEmpty.hidden=true;return;}let count=0;cards.forEach((card)=>{const workerCities=String(card.dataset.workerCities||'').split('|').map(normalizeCity).filter(Boolean);const vacancyCities=String(card.dataset.vacancyCities||'').split('|').map(normalizeCity).filter(Boolean);const visible=workerCities.some((city)=>allowed.includes(city))||vacancyCities.some((city)=>allowed.includes(city));card.hidden=!visible;if(visible)count+=1;});if(cityAutoFilterText)cityAutoFilterText.textContent=`Filtro automático aplicado por ciudad: ${selectedRequestCity}.`;if(autoFilterEmpty)autoFilterEmpty.hidden=count>0;}
    const selectedWorkerIds=new Set();const selectedWorkersCount=document.getElementById('selectedWorkersCount');function getSelectedWorkerIds(){return Array.from(selectedWorkerIds).filter(Boolean);}function refreshSelectionUi(){document.querySelectorAll('.worker-card').forEach((card)=>{const selected=selectedWorkerIds.has(card.dataset.workerId);card.classList.toggle('selected',selected);const checkbox=card.querySelector('.worker-select');if(checkbox)checkbox.checked=selected;});if(selectedWorkersCount)selectedWorkersCount.textContent=String(selectedWorkerIds.size);}function setWorkerSelection(workerId,selected){if(!workerId)return;if(selected)selectedWorkerIds.add(workerId);else selectedWorkerIds.delete(workerId);refreshSelectionUi();}function clearWorkerSelection(){selectedWorkerIds.clear();refreshSelectionUi();}
    document.querySelectorAll('.worker-card[draggable="true"]').forEach((card)=>card.addEventListener('dragstart',(event)=>{const workerId=card.dataset.workerId;if(!selectedWorkerIds.has(workerId)){clearWorkerSelection();setWorkerSelection(workerId,true);}const ids=getSelectedWorkerIds();document.querySelectorAll('.worker-card.selected').forEach((selectedCard)=>selectedCard.classList.add('drag-batch'));event.dataTransfer.setData('text/plain',ids.join(','));event.dataTransfer.effectAllowed='move';}));document.querySelectorAll('.worker-card[draggable="true"]').forEach((card)=>card.addEventListener('dragend',()=>document.querySelectorAll('.worker-card.drag-batch').forEach((item)=>item.classList.remove('drag-batch'))));applyAutomaticCityFilter();
    document.querySelectorAll('.worker-card').forEach((card)=>{const checkbox=card.querySelector('.worker-select');checkbox?.addEventListener('change',()=>setWorkerSelection(card.dataset.workerId,checkbox.checked));card.addEventListener('click',(event)=>{if(event.target.closest('input,button,a,select,textarea'))return;setWorkerSelection(card.dataset.workerId,!selectedWorkerIds.has(card.dataset.workerId));});});document.getElementById('clearSelectedWorkers')?.addEventListener('click',clearWorkerSelection);
    async function assignWorkers(workerIds){const uniqueIds=[...new Set(workerIds)].filter(Boolean);if(!uniqueIds.length)return;if(isDropZoneDisabled){alert('La solicitud ya tiene cobertura completa.');return;}if(!hasSelectedRequest||!assignForm){alert('Selecciona una solicitud antes de asignar auxiliares.');return;}showToast(`Asignando ${uniqueIds.length} auxiliar${uniqueIds.length!==1?'es':''}...`);dropZone?.classList.add('disabled');for(const workerId of uniqueIds){const payload=new URLSearchParams();payload.set('serviceRequestId','<%= selectedServiceRequestId %>');payload.set('workerId',workerId);const response=await fetch(assignForm.action,{method:'POST',body:payload,headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'fetch'},redirect:'follow'});if(!response.ok){dropZone?.classList.remove('disabled');throw new Error('No fue posible asignar uno de los auxiliares.');}}saveBoardPosition();window.location.href='/admin/operaciones/asignaciones?serviceRequestId=<%= selectedServiceRequestId %>&message='+encodeURIComponent(`${uniqueIds.length} auxiliar${uniqueIds.length!==1?'es enviados':' enviado'} a asignación.`);}document.getElementById('assignSelectedWorkers')?.addEventListener('click',()=>assignWorkers(getSelectedWorkerIds()).catch((error)=>{console.error(error);showToast(error.message||'No fue posible asignar.');}));
    if(dropZone){dropZone.addEventListener('dragover',(event)=>{if(isDropZoneDisabled)return;event.preventDefault();dropZone.classList.add('drag-over');});dropZone.addEventListener('dragleave',()=>dropZone.classList.remove('drag-over'));dropZone.addEventListener('drop',(event)=>{event.preventDefault();dropZone.classList.remove('drag-over');if(isDropZoneDisabled){alert('La solicitud ya tiene cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.');return;}const raw=event.dataTransfer.getData('text/plain');const ids=raw.split(',').map((item)=>item.trim()).filter(Boolean);assignWorkers(ids).catch((error)=>{console.error(error);showToast(error.message||'No fue posible asignar.');});});}
    async function submitAssignmentAction(form){const action=form.dataset.asyncAssignmentAction;const card=form.closest('.assigned-card');if(!card)return true;if(action==='unassign'&&!confirm('¿Quitar este auxiliar de la solicitud?'))return false;const buttons=Array.from(form.closest('.assigned-actions')?.querySelectorAll('button,a')||[]);card.classList.add('is-updating');buttons.forEach((button)=>{button.disabled=true;button.setAttribute('aria-disabled','true');});try{const response=await fetch(form.action,{method:'POST',body:encodeForm(form),redirect:'follow',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'fetch'}});if(!response.ok)throw new Error('No fue posible completar la acción.');if(action==='unassign'){card.classList.add('is-removed');window.setTimeout(()=>card.remove(),160);showToast('Auxiliar retirado de la solicitud.');refreshBoardAfterAction('Auxiliar retirado de la solicitud.');return false;}const statusLine=card.querySelector('.assignment-status-line');if(action==='confirmar'){if(statusLine)statusLine.textContent='Estado: Confirmado';form.closest('.assigned-actions')?.querySelectorAll('form[data-async-assignment-action="confirmar"],form[data-async-assignment-action="no-confirmado"]').forEach((item)=>item.remove());showToast('Confirmación registrada.');refreshBoardAfterAction('Confirmación registrada.');}else if(action==='no-confirmado'){if(statusLine)statusLine.textContent='Estado: No confirmó';form.closest('.assigned-actions')?.querySelectorAll('form[data-async-assignment-action="confirmar"],form[data-async-assignment-action="no-confirmado"]').forEach((item)=>item.remove());showToast('Auxiliar marcado como no confirmado.');refreshBoardAfterAction('Auxiliar marcado como no confirmado.');}}catch(error){console.error(error);showToast(error.message||'No fue posible completar la acción.');buttons.forEach((button)=>{button.disabled=false;button.removeAttribute('aria-disabled');});}finally{card.classList.remove('is-updating');}return false;}
    document.querySelectorAll('form[data-async-assignment-action]').forEach((form)=>form.addEventListener('submit',(event)=>{event.preventDefault();submitAssignmentAction(form);}));
    const globalTemplate=document.getElementById('globalTemplate');const cards=Array.from(document.querySelectorAll('.assigned-card'));function normalizePhone(phone){const digits=String(phone||'').replace(/\D/g,'');if(!digits)return'';if(digits.startsWith('57'))return digits;if(digits.length===10)return`57${digits}`;return digits;}function sanitizeAssignmentTemplate(template){return String(template||'').replace(/\s*-\s*\{\{\s*horaFin\s*\}\}/gi,'').replace(/\s*a\s*\{\{\s*horaFin\s*\}\}/gi,'').replace(/\{\{\s*horaFin\s*\}\}/gi,'').replace(/Horario:\s*\{\{\s*horaInicio\s*\}\}/gi,'Hora de inicio: {{horaInicio}}');}function renderMessage(template,card){const cleanTemplate=sanitizeAssignmentTemplate(template);const values={nombre:card.dataset.workerName||'',cliente:card.dataset.client||'',operacion:card.dataset.operation||'',direccion:card.dataset.address||'',ciudad:card.dataset.city||'',servicio:card.dataset.service||'',fecha:card.dataset.date||'',horaInicio:card.dataset.start||''};return cleanTemplate.replace(/{{\s*(nombre|cliente|operacion|direccion|ciudad|servicio|fecha|horaInicio)\s*}}/g,(_,key)=>values[key]||'');}async function sendDispatchWhatsapp(button){const phone=button.dataset.waPhone;const message=button.dataset.waMessage;if(!phone||!message){showToast('No hay número o mensaje para enviar.');return;}button.disabled=true;const originalText=button.innerHTML;button.innerHTML='Enviando...';try{const response=await fetch('/admin/operaciones/whatsapp/enviar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone,message})});const data=await response.json();if(response.status===503){showToast('WhatsApp no está conectado. Abre el módulo de WhatsApp y escanea el QR. Ver QR: /admin/operaciones/whatsapp');return;}if(!response.ok||!data.ok)throw new Error(data.message||'No se pudo enviar el mensaje.');showToast('Mensaje enviado correctamente.');}catch(error){showToast(error.message||'Error enviando WhatsApp.');}finally{button.disabled=false;button.innerHTML=originalText;}}function refreshLinks(){if(globalTemplate)globalTemplate.value=sanitizeAssignmentTemplate(globalTemplate.value);cards.forEach((card)=>{const textarea=card.querySelector('.assignment-message'),link=card.querySelector('.whatsapp-link');if(!textarea||!link)return;if(!textarea.value&&globalTemplate)textarea.value=globalTemplate.value;textarea.value=sanitizeAssignmentTemplate(textarea.value);const phone=normalizePhone(card.dataset.workerPhone);const text=renderMessage(textarea.value||globalTemplate?.value||'',card);link.dataset.waPhone=phone;link.dataset.waMessage=text;link.onclick=function(){sendDispatchWhatsapp(link);};});}globalTemplate?.addEventListener('input',refreshLinks);document.querySelectorAll('.assignment-message').forEach((textarea)=>textarea.addEventListener('input',refreshLinks));document.querySelectorAll('.variable-btn').forEach((button)=>button.addEventListener('click',()=>{const targetId=button.closest('.variable-row')?.dataset.target;const target=targetId?document.getElementById(targetId):button.closest('.assigned-card')?.querySelector('.assignment-message');if(!target)return;const start=target.selectionStart||target.value.length;const end=target.selectionEnd||target.value.length;target.value=`${target.value.slice(0,start)}${button.dataset.var}${target.value.slice(end)}`;target.focus();target.selectionStart=target.selectionEnd=start+button.dataset.var.length;refreshLinks();}));refreshLinks();refreshSelectionUi();
  </script>
</body>
</html>