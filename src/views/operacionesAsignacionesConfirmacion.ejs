<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Asignación operativa — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .assignment-page{max-width:min(1880px,calc(100vw - 36px));width:100%;}
    .board-layout{display:grid;grid-template-columns:minmax(420px,.78fr) minmax(440px,1fr) minmax(470px,.9fr);gap:16px;align-items:start}
    .board-panel{background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-sm);overflow:hidden;min-height:420px;min-width:0}
    .board-panel-head{padding:14px 16px;border-bottom:1px solid #edf2f7}.board-panel-head h2{color:var(--navy);font-size:16px;margin-bottom:4px}.board-panel-head p{color:var(--muted);font-size:13px}
    .filters{display:grid;gap:8px;padding:12px;border-bottom:1px solid #edf2f7;background:var(--surface-2)}.filters-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .worker-toolbar{display:grid;grid-template-columns:1fr;gap:8px;padding:10px 12px;border-bottom:1px solid #edf2f7;background:#fff;position:relative;z-index:1}.worker-toolbar strong{font-size:12px;color:var(--navy);line-height:1.2}.worker-toolbar-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.worker-toolbar .btn{width:100%;justify-content:center;padding:7px 10px;font-size:11px;white-space:nowrap}
    .worker-list,.request-list{max-height:calc(100vh - 390px);min-height:360px;overflow-y:auto;padding:9px;display:grid;gap:7px;align-content:start}.worker-card,.request-card,.assigned-card,.template-card{border:1px solid var(--border);border-radius:12px;background:#fff;padding:10px;box-shadow:var(--shadow-sm)}
    .worker-card{cursor:grab;display:grid;grid-template-columns:22px minmax(0,1fr);gap:8px;align-items:start;padding:8px 9px;border-radius:11px;min-width:0}.worker-card.same-day-assignment{border:2px solid #d97706;background:#fffbeb;box-shadow:0 0 0 2px rgba(245,158,11,.16),var(--shadow-sm)}.worker-card.same-day-assignment strong{color:#92400e}.worker-card.selected{border-color:var(--teal);background:#f0fdfa;box-shadow:0 0 0 2px rgba(13,122,107,.14),var(--shadow-sm)}.worker-card.drag-batch{opacity:.82;transform:scale(.99)}.worker-card[hidden]{display:none}
    .worker-select{width:16px;height:16px;margin:2px 0 0 0;accent-color:var(--teal)}.worker-main{min-width:0}.worker-card strong,.request-card strong,.assigned-card strong{color:var(--navy);display:block;font-size:13px;margin-bottom:3px;line-height:1.15;overflow-wrap:anywhere}.worker-card .meta{font-size:11px;gap:1px}.meta{color:var(--muted);font-size:12px;display:grid;gap:2px;min-width:0}.meta span{overflow-wrap:anywhere}.chips{display:flex;flex-wrap:wrap;gap:3px;margin-top:5px}.chip{display:inline-flex;align-items:center;border-radius:999px;padding:2px 6px;font-size:9.5px;font-weight:900;background:var(--blue-soft);color:var(--blue);max-width:100%;overflow:hidden;text-overflow:ellipsis}.chip.same-day-assignment{background:#f59e0b;color:#fff;font-size:10px;padding:3px 7px}
    .request-card:hover,.request-card.active{border-color:var(--teal);box-shadow:var(--shadow)}.request-card.active{background:#f0fdfa}.request-card .top{display:flex;justify-content:space-between;gap:10px}.status-pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900;background:var(--amber-soft);color:var(--amber);white-space:nowrap}.status-pill.complete{background:var(--green-soft);color:var(--green)}.status-pill.pending-confirmation{background:var(--blue-soft);color:var(--blue)}.request-actions,.assigned-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.request-actions form,.assigned-actions form{margin:0}.assignment-body{padding:16px;display:grid;gap:14px}.selected-summary{border:1px solid var(--border);background:var(--surface-2);border-radius:14px;padding:14px}.drop-zone{border:2px dashed #b6c2d2;border-radius:16px;padding:22px;min-height:118px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);background:#fbfdff;font-weight:800}.drop-zone.drag-over{border-color:var(--teal);background:#f0fdfa;color:var(--teal)}.drop-zone.disabled{border-color:var(--green);background:var(--green-soft);color:var(--green);cursor:not-allowed}.assigned-list{display:grid;gap:10px}.assigned-card{display:grid;gap:10px}.template-card textarea,.assignment-message{width:100%;min-height:84px;border:1px solid var(--border);border-radius:10px;padding:10px;font:inherit;resize:vertical}.variable-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.variable-btn{border:1px solid var(--border);background:var(--surface-2);color:var(--navy);border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900;cursor:pointer}
    .notify-block{border:2px solid var(--green);border-radius:14px;background:var(--green-soft);padding:16px;display:grid;gap:12px}.notify-block h3{color:var(--green);font-size:14px;margin:0}.notify-contact{font-size:13px;color:var(--navy);display:grid;gap:3px}.notify-contact span{color:var(--muted)}.notify-preview{background:#fff;border:1px solid var(--border);border-radius:10px;padding:12px;font-size:12px;color:var(--navy);white-space:pre-wrap;line-height:1.6;max-height:180px;overflow-y:auto}.notify-actions{display:flex;gap:10px;flex-wrap:wrap}.notify-actions a{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;font-size:13px;font-weight:800;text-decoration:none}.notify-email{background:var(--navy);color:#fff}.notify-whatsapp{background:#25d366;color:#fff}.notify-managed-field{display:grid;gap:4px}.notify-managed-field label{font-size:12px;font-weight:800;color:var(--navy)}.notify-managed-field input{width:100%;border:1px solid var(--border);border-radius:8px;padding:7px 10px;font:inherit;font-size:13px;background:#fff;color:var(--navy)}.notify-managed-field .field-hint{font-size:11px;color:var(--muted)}.notify-managed-required{border-color:var(--red,#e53e3e)!important;background:#fff5f5!important}
    @media(min-width:1600px){.assignment-page{max-width:min(2040px,calc(100vw - 48px));}.board-layout{grid-template-columns:minmax(460px,.8fr) minmax(520px,1fr) minmax(520px,.9fr);gap:18px}.worker-list,.request-list{max-height:calc(100vh - 400px)}}
    @media(max-width:1350px){.board-layout{grid-template-columns:minmax(360px,.85fr) minmax(380px,1fr) minmax(420px,.95fr)}.worker-toolbar-actions{grid-template-columns:1fr}}
    @media(max-width:1180px){.assignment-page{max-width:calc(100vw - 24px)}.board-layout{grid-template-columns:1fr}.worker-list,.request-list{max-height:480px}.worker-toolbar-actions{grid-template-columns:1fr 1fr}}
    @media(max-width:620px){.worker-toolbar-actions{grid-template-columns:1fr}.filters-row{grid-template-columns:1fr}.worker-card{grid-template-columns:20px minmax(0,1fr)}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %><span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>
  <% const activeCodes=['ASSIGNED','CONFIRMATION_PENDING','CONFIRMED']; %>
  <% const requestLabel=(v)=>({PENDING_ASSIGNMENT:'Pendiente de asignación',ASSIGNMENT_PARTIAL:'Asignación parcial',PENDING_CONFIRMATION:'Pendiente de confirmación',ASSIGNMENT_COMPLETE:'Asignación completa',CANCELLED:'Cancelada'}[v]||v||'Pendiente'); %>
  <% const assignmentLabel=(v)=>({ASSIGNED:'Asignado',CONFIRMATION_PENDING:'Pendiente de confirmación',CONFIRMED:'Confirmado',NO_CONFIRMO:'No confirmó',CANCELLED:'Cancelado'}[v]||v||'Asignado'); %>
  <% const cleanGroup=(value)=>String(value||'').replace(/\s*·\s*Grupo\s+GRP-[A-Z0-9-]+/i,'').trim(); %>
  <% const scheduleLabel=(request)=>request.endTime ? `${request.startTime || '-'} - ${request.endTime}` : `${request.startTime || '-'}`; %>
  <main class="page assignment-page">
    <section class="hero">
      <div><div class="eyebrow">Tablero de asignación</div><h1>Asignación operativa</h1><p>La solicitud solo se cierra cuando la cantidad de auxiliares confirmados cubre el total requerido.</p></div>
      <div class="actions"><a class="btn" href="/admin/operaciones">Volver a Operaciones</a><a class="btn" href="/admin/operaciones/solicitudes">Solicitudes de servicio</a><a class="btn" href="/admin/operaciones/novedades">Novedades</a><a class="btn" href="/admin/operaciones/clientes">Clientes</a><a class="btn" href="/admin/operaciones/personal">Personal operativo</a></div>
    </section>
    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <section class="board-layout">
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Auxiliares disponibles</h2><p id="cityAutoFilterText">Selecciona una solicitud para aplicar filtro automático por ciudad.</p></div>
        <form class="filters" method="get" action="/admin/operaciones/asignaciones" autocomplete="off">
          <input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" />
          <div class="field"><label>Buscar</label><input name="q" value="<%= filters.q %>" placeholder="Nombre, documento o teléfono" /></div>
          <div class="filters-row"><div class="field"><label>Ciudad</label><select name="operationalCityId" onchange="this.form.submit()"><option value="">Todas</option><% cities.forEach((city)=>{ %><option value="<%= city.id %>" <%= filters.operationalCityId===city.id?'selected':'' %>><%= city.name %></option><% }) %></select></div><div class="field"><label>Localidad</label><select name="locality"><option value="">Todas</option><% localities.forEach((item)=>{ %><option value="<%= item %>" <%= filters.locality===item?'selected':'' %>><%= item %></option><% }) %></select></div></div>
          <div class="field"><label>Transporte</label><select name="transportMode"><option value="">Todos</option><% transportModes.forEach((item)=>{ %><option value="<%= item %>" <%= filters.transportMode===item?'selected':'' %>><%= item %></option><% }) %></select></div>
          <button class="btn btn-primary" type="submit">Filtrar auxiliares</button>
        </form>
        <div class="worker-toolbar">
          <strong><span id="selectedWorkersCount">0</span> auxiliares seleccionados</strong>
          <div class="worker-toolbar-actions"><button class="btn" type="button" id="clearSelectedWorkers">Limpiar selección</button><button class="btn btn-primary" type="button" id="assignSelectedWorkers">Asignar seleccionados</button></div>
        </div>
        <div class="worker-list" id="workerList">
          <% if (!availableWorkers.length) { %><div class="empty"><strong>No hay auxiliares disponibles.</strong>Los asignados quedan bloqueados para esta solicitud.</div><% } %>
          <div id="autoFilterEmpty" class="empty" hidden><strong>No hay auxiliares para la ciudad de esta solicitud.</strong>Ajusta filtros o revisa ciudades/perfiles.</div>
          <% availableWorkers.forEach((worker)=>{ const workerCityNames=worker.cities.map((entry)=>entry.city.name).join('|'); const vacancyCityNames=worker.vacancies.map((entry)=>entry.vacancy.city||'').join('|'); const hasSameDayAssignment=assignedWorkerIdsOnSelectedDate.has(worker.id); %>
            <article class="worker-card<%= hasSameDayAssignment ? ' same-day-assignment' : '' %>" draggable="true" data-worker-id="<%= worker.id %>" data-worker-cities="<%= workerCityNames %>" data-vacancy-cities="<%= vacancyCityNames %>">
              <input class="worker-select" type="checkbox" aria-label="Seleccionar <%= worker.fullName %>" />
              <div class="worker-main"><strong><%= worker.fullName %></strong><div class="meta"><span>Tel: <%= worker.phone || '-' %></span><span><%= worker.residenceCity || '-' %> · <%= worker.residenceLocality || '-' %></span><span>Transporte: <%= worker.transportMode || '-' %></span></div><div class="chips"><% if(hasSameDayAssignment){ %><span class="chip same-day-assignment" title="Ya tiene una asignación activa en otra solicitud de esta fecha. Puedes asignarlo de nuevo para un doble turno u horas extra.">⚠ Ya asignado hoy</span><% } %><% worker.cities.slice(0,2).forEach((entry)=>{ %><span class="chip"><%= entry.city.name %></span><% }) %><% worker.vacancies.slice(0,1).forEach((entry)=>{ %><span class="chip"><%= entry.vacancy.title %><% if(entry.vacancy.city){ %> — <%= entry.vacancy.city %><% } %></span><% }) %></div></div>
            </article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel">
        <div class="board-panel-head"><h2>Solicitudes de servicio</h2><p>Elige la solicitud sobre la que vas a trabajar.</p></div>
        <div class="request-list">
          <% serviceRequests.forEach((request)=>{ const activeCount=request.assignments.filter((item)=>activeCodes.includes(item.status)).length; const confirmedCount=request.assignments.filter((item)=>item.status==='CONFIRMED').length; const complete=confirmedCount>=request.requiredWorkers; const waiting=!complete&&activeCount>=request.requiredWorkers; %>
            <article class="request-card <%= selectedServiceRequestId===request.id?'active':'' %>"><div class="top"><strong><%= request.clientName %></strong><span class="status-pill <%= complete?'complete':waiting?'pending-confirmation':'' %>"><%= requestLabel(request.status) %></span></div><div class="meta"><span><%= request.operationPointName || 'Sin punto' %> · <%= request.cityName || 'Sin ciudad' %></span><span>Servicio: <%= cleanGroup(request.serviceName || request.service?.name || 'Sin servicio') %></span><span><%= new Date(request.serviceDate).toISOString().slice(0,10) %> · <%= scheduleLabel(request) %></span><span>Asignados activos: <%= activeCount %> / <%= request.requiredWorkers %></span><span>Confirmados: <%= confirmedCount %> / <%= request.requiredWorkers %></span></div><div class="request-actions"><a class="btn" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">Seleccionar</a><a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a></div></article>
          <% }) %>
        </div>
      </aside>
      <aside class="board-panel"><div class="board-panel-head"><h2>Asignación</h2><p>Primero asigna, luego confirma auxiliar por auxiliar.</p></div><div class="assignment-body">
        <% if (selectedServiceRequest) { const activeAssignments=selectedServiceRequest.assignments.filter((item)=>activeCodes.includes(item.status)); const selectedActiveCount=activeAssignments.length; const selectedConfirmedCount=selectedServiceRequest.assignments.filter((item)=>item.status==='CONFIRMED').length; const remainingWorkers=Math.max(selectedServiceRequest.requiredWorkers-selectedActiveCount,0); const coverageComplete=selectedActiveCount>=selectedServiceRequest.requiredWorkers; const selectedRequestComplete=selectedConfirmedCount>=selectedServiceRequest.requiredWorkers; %>
          <div class="selected-summary" id="selectedRequestSummary" data-request-city="<%= selectedServiceRequest.cityName || '' %>"><strong><%= selectedServiceRequest.clientName %></strong><div class="meta"><span><%= selectedServiceRequest.operationPointName || 'Sin punto' %> · <%= selectedServiceRequest.cityName || 'Sin ciudad' %></span><span>Servicio: <%= cleanGroup(selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || 'Sin servicio') %></span><span>Fecha: <%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %> · Horario: <%= scheduleLabel(selectedServiceRequest) %></span><span>Requeridos: <%= selectedServiceRequest.requiredWorkers %> · Activos: <%= selectedActiveCount %> · Confirmados: <%= selectedConfirmedCount %></span><span><%= selectedRequestComplete?'Solicitud cerrada por confirmación completa.':coverageComplete?'Cobertura completa. Falta confirmar auxiliares.':`Faltan ${remainingWorkers} auxiliares por asignar.` %></span></div></div>
          <div id="assignmentDropZone" class="drop-zone <%= coverageComplete?'disabled':'' %>" data-disabled="<%= coverageComplete?'true':'false' %>"><%= coverageComplete?'Cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.':`Faltan ${remainingWorkers} auxiliares. Arrastra uno o varios auxiliares aquí.` %></div>
          <form id="assignForm" method="post" action="/admin/operaciones/asignaciones/assign"><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><input type="hidden" id="assignWorkerId" name="workerId" /></form>
          <% if (coverageComplete && !selectedRequestComplete) { %><section class="template-card"><strong>Mensaje base para WhatsApp</strong><p class="muted">Envía el mensaje y luego marca confirmado o no confirmado. El cierre depende de confirmaciones, no solo de asignaciones.</p><textarea id="globalTemplate">Hola {{nombre}}, te confirmamos asignación para {{fecha}} en {{operacion}}. Dirección: {{direccion}}. Hora de inicio: {{horaInicio}}. Servicio: {{servicio}}. Cliente: {{cliente}}. Por favor confirma recibido.</textarea><div class="variable-row" data-target="globalTemplate"><button type="button" class="variable-btn" data-var="{{nombre}}">Nombre</button><button type="button" class="variable-btn" data-var="{{operacion}}">Operación</button><button type="button" class="variable-btn" data-var="{{direccion}}">Dirección</button><button type="button" class="variable-btn" data-var="{{fecha}}">Fecha</button><button type="button" class="variable-btn" data-var="{{horaInicio}}">Hora inicio</button><button type="button" class="variable-btn" data-var="{{servicio}}">Servicio</button></div></section><% } %>
          <% if (selectedRequestComplete) { const confirmedAssignments=selectedServiceRequest.assignments.filter((a)=>a.status==='CONFIRMED'); const reqName=selectedServiceRequest.requestedByName||''; const reqPhone=selectedServiceRequest.requestedByPhone||''; const reqEmail=selectedServiceRequest.requestedByEmail||''; const hasContact=!!(reqPhone||reqEmail); const serviceDate=new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10); const serviceName=cleanGroup(selectedServiceRequest.serviceName||(selectedServiceRequest.service&&selectedServiceRequest.service.name)||'Sin servicio'); const operationPoint=selectedServiceRequest.operationPointName||''; const city=selectedServiceRequest.cityName||''; const address=selectedServiceRequest.address||''; const startTime=selectedServiceRequest.startTime||''; const workerLines=confirmedAssignments.map((a,i)=>{ const docType=a.worker.documentType||''; const docNum=a.worker.documentNumber||''; const docStr=(docType&&docNum)?(docType+' '+docNum):(docNum||'Sin documento'); return (i+1)+'. '+a.worker.fullName+' — '+docStr; }).join('\n'); const emailSubject='Auxiliares confirmados — '+selectedServiceRequest.clientName+' ('+serviceDate+')'; const rawPhone=reqPhone.replace(/\D/g,''); const waPhone=rawPhone?(rawPhone.startsWith('57')?rawPhone:rawPhone.length===10?'57'+rawPhone:rawPhone):''; %>
          <section class="notify-block"><h3>&#x2705; Notificar al solicitante</h3><% if (reqName || reqPhone || reqEmail) { %><div class="notify-contact"><% if(reqName){ %><span><strong>Nombre:</strong> <%- reqName %></span><% } %><% if(reqPhone){ %><span><strong>Tel / WhatsApp:</strong> <%- reqPhone %></span><% } %><% if(reqEmail){ %><span><strong>Correo:</strong> <%- reqEmail %></span><% } %></div><% } else { %><p class="notify-no-contact">Esta solicitud no tiene datos de contacto del solicitante registrados.</p><% } %><div class="notify-managed-field"><label for="notifyManagedBy">Gestionado por <span style="color:var(--red,#e53e3e)">*</span></label><input type="text" id="notifyManagedBy" placeholder="Nombre de quien gestionó la asignación" autocomplete="off" maxlength="80" /><span class="field-hint">Requerido. Se incluirá al final del mensaje de correo y WhatsApp.</span></div><div class="notify-preview" id="notifyPreview"></div><% if (hasContact) { %><div class="notify-actions"><% if(reqEmail){ %><a id="notifyEmailLink" href="#" class="notify-email" target="_blank" rel="noopener">Enviar por correo</a><% } %><% if(waPhone || reqPhone){ %><a id="notifyWaLink" href="#" class="notify-whatsapp" target="_blank" rel="noopener">Abrir WhatsApp</a><% } %></div><% } %></section>
          <script>(function(){const managedInput=document.getElementById('notifyManagedBy'),preview=document.getElementById('notifyPreview'),emailLink=document.getElementById('notifyEmailLink'),waLink=document.getElementById('notifyWaLink');const reqName=<%- JSON.stringify(reqName) %>,reqEmail=<%- JSON.stringify(reqEmail) %>,waPhone=<%- JSON.stringify(waPhone) %>,reqPhone=<%- JSON.stringify(reqPhone) %>,workerLines=<%- JSON.stringify(workerLines) %>,serviceDate=<%- JSON.stringify(serviceDate) %>,startTime=<%- JSON.stringify(startTime) %>,serviceName=<%- JSON.stringify(serviceName) %>,operationPoint=<%- JSON.stringify(operationPoint) %>,city=<%- JSON.stringify(city) %>,address=<%- JSON.stringify(address) %>,emailSubject=<%- JSON.stringify(emailSubject) %>;function buildMsg(managedBy){const lines=[];lines.push('Estimado/a'+(reqName?' '+reqName:''), '', 'Le informamos que los auxiliares confirmados para su servicio son:', '', workerLines, '', 'Detalles del servicio:', '- Fecha: '+serviceDate, '- Hora de inicio: '+startTime, '- Servicio: '+serviceName);if(operationPoint)lines.push('- Punto de operación: '+operationPoint+(city?', '+city:''));if(address)lines.push('- Dirección: '+address);lines.push('', 'Quedamos atentos a cualquier inquietud.');if(managedBy&&managedBy.trim())lines.push('', 'Gestionado por: '+managedBy.trim());return lines.join('\n');}function refreshNotify(){const managedBy=managedInput?managedInput.value:'';const msg=buildMsg(managedBy);if(preview)preview.textContent=msg;const hasManagedBy=managedBy&&managedBy.trim().length>0;if(managedInput)managedInput.classList.toggle('notify-managed-required',!hasManagedBy);if(emailLink){if(!hasManagedBy){emailLink.href='#';emailLink.onclick=function(e){e.preventDefault();managedInput&&managedInput.focus();alert('Debes indicar quién gestionó la asignación antes de enviar.');return false;};}else{emailLink.onclick=null;emailLink.href=reqEmail?'mailto:'+reqEmail+'?subject='+encodeURIComponent(emailSubject)+'&body='+encodeURIComponent(msg):'#';}}if(waLink){if(!hasManagedBy){waLink.href='#';waLink.onclick=function(e){e.preventDefault();managedInput&&managedInput.focus();alert('Debes indicar quién gestionó la asignación antes de enviar.');return false;};}else{waLink.onclick=null;waLink.href=waPhone?'https://wa.me/'+waPhone+'?text='+encodeURIComponent(msg):(reqPhone?'https://wa.me/?text='+encodeURIComponent(msg):'#');}}}managedInput&&managedInput.addEventListener('input',refreshNotify);refreshNotify();})();</script>
          <% } %>
          <div class="assigned-list"><% selectedServiceRequest.assignments.forEach((assignment)=>{ const assignmentActive=activeCodes.includes(assignment.status); const assignmentWaiting=assignmentActive&&assignment.status!=='CONFIRMED'; %><article class="assigned-card" data-worker-name="<%= assignment.worker.fullName %>" data-worker-phone="<%= assignment.worker.phone || '' %>" data-client="<%= selectedServiceRequest.clientName || '' %>" data-operation="<%= selectedServiceRequest.operationPointName || '' %>" data-address="<%= selectedServiceRequest.address || '' %>" data-city="<%= selectedServiceRequest.cityName || '' %>" data-service="<%= cleanGroup(selectedServiceRequest.serviceName || selectedServiceRequest.service?.name || '') %>" data-date="<%= new Date(selectedServiceRequest.serviceDate).toISOString().slice(0,10) %>" data-start="<%= selectedServiceRequest.startTime || '' %>"><div><strong><%= assignment.worker.fullName %></strong><div class="meta"><span><%= assignment.worker.phone || 'Sin teléfono' %></span><span>Estado: <%= assignmentLabel(assignment.status) %></span><% if (assignment.notes) { %><span>Nota: <%= assignment.notes %></span><% } %></div></div><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><textarea class="assignment-message"></textarea><% } %><div class="assigned-actions"><% if (coverageComplete && !selectedRequestComplete && assignmentActive) { %><a class="btn btn-primary whatsapp-link" target="_blank" rel="noopener">WhatsApp</a><% } %><% if (assignmentWaiting) { %><form method="post" action="/admin/operaciones/asignaciones/confirmar"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn btn-primary" type="submit">Marcar confirmado</button></form><form method="post" action="/admin/operaciones/asignaciones/no-confirmado"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">No confirmó</button></form><% } %><form method="post" action="/admin/operaciones/asignaciones/unassign"><input type="hidden" name="assignmentId" value="<%= assignment.id %>" /><input type="hidden" name="serviceRequestId" value="<%= selectedServiceRequestId %>" /><button class="btn" type="submit">Quitar</button></form></div></article><% }) %></div>
        <% } else { %><div class="empty"><strong>Selecciona una solicitud.</strong>Necesitas una solicitud activa antes de asignar auxiliares.</div><div id="assignmentDropZone" class="drop-zone">Selecciona una solicitud.</div><% } %>
      </div></aside>
    </section>
  </main>
  <script>
    const dropZone=document.getElementById('assignmentDropZone'),assignForm=document.getElementById('assignForm'),assignWorkerId=document.getElementById('assignWorkerId'),hasSelectedRequest=Boolean('<%= selectedServiceRequestId %>'),isDropZoneDisabled=dropZone?.dataset.disabled==='true',selectedRequestSummary=document.getElementById('selectedRequestSummary'),selectedRequestCity=selectedRequestSummary?.dataset.requestCity||'',cityAutoFilterText=document.getElementById('cityAutoFilterText'),autoFilterEmpty=document.getElementById('autoFilterEmpty');
    window.addEventListener('pageshow',(event)=>{if(event.persisted)window.location.reload();});
    const normalizeCity=(value)=>String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();const compatibleCitiesForRequest=(cityName)=>{const n=normalizeCity(cityName);if(!n)return[];if(n==='siberia')return['siberia','bogota','bogota d.c.','bogota dc','madrid','funza','mosquera'];return[n];};
    function applyAutomaticCityFilter(){const allowed=compatibleCitiesForRequest(selectedRequestCity);const cards=Array.from(document.querySelectorAll('.worker-card'));if(!allowed.length){if(autoFilterEmpty)autoFilterEmpty.hidden=true;return;}let count=0;cards.forEach((card)=>{const workerCities=String(card.dataset.workerCities||'').split('|').map(normalizeCity).filter(Boolean);const vacancyCities=String(card.dataset.vacancyCities||'').split('|').map(normalizeCity).filter(Boolean);const visible=workerCities.some((city)=>allowed.includes(city))||vacancyCities.some((city)=>allowed.includes(city));card.hidden=!visible;if(visible)count+=1;});if(cityAutoFilterText)cityAutoFilterText.textContent=`Filtro automático aplicado por ciudad: ${selectedRequestCity}.`;if(autoFilterEmpty)autoFilterEmpty.hidden=count>0;}
    document.querySelectorAll('.worker-card[draggable="true"]').forEach((card)=>card.addEventListener('dragstart',(event)=>{const workerId=card.dataset.workerId;if(!selectedWorkerIds.has(workerId)){clearWorkerSelection();setWorkerSelection(workerId,true);}const ids=getSelectedWorkerIds();document.querySelectorAll('.worker-card.selected').forEach((selectedCard)=>selectedCard.classList.add('drag-batch'));event.dataTransfer.setData('text/plain',ids.join(','));event.dataTransfer.effectAllowed='move';}));document.querySelectorAll('.worker-card[draggable="true"]').forEach((card)=>card.addEventListener('dragend',()=>document.querySelectorAll('.worker-card.drag-batch').forEach((item)=>item.classList.remove('drag-batch'))));applyAutomaticCityFilter();
    const selectedWorkerIds=new Set();const selectedWorkersCount=document.getElementById('selectedWorkersCount');function getSelectedWorkerIds(){return Array.from(selectedWorkerIds).filter(Boolean);}function refreshSelectionUi(){document.querySelectorAll('.worker-card').forEach((card)=>{const selected=selectedWorkerIds.has(card.dataset.workerId);card.classList.toggle('selected',selected);const checkbox=card.querySelector('.worker-select');if(checkbox)checkbox.checked=selected;});if(selectedWorkersCount)selectedWorkersCount.textContent=String(selectedWorkerIds.size);}function setWorkerSelection(workerId,selected){if(!workerId)return;if(selected)selectedWorkerIds.add(workerId);else selectedWorkerIds.delete(workerId);refreshSelectionUi();}function clearWorkerSelection(){selectedWorkerIds.clear();refreshSelectionUi();}document.querySelectorAll('.worker-card').forEach((card)=>{const checkbox=card.querySelector('.worker-select');checkbox?.addEventListener('change',()=>setWorkerSelection(card.dataset.workerId,checkbox.checked));card.addEventListener('click',(event)=>{if(event.target.closest('input,button,a,select,textarea'))return;setWorkerSelection(card.dataset.workerId,!selectedWorkerIds.has(card.dataset.workerId));});});document.getElementById('clearSelectedWorkers')?.addEventListener('click',clearWorkerSelection);
    async function assignWorkers(workerIds){const uniqueIds=[...new Set(workerIds)].filter(Boolean);if(!uniqueIds.length)return;if(isDropZoneDisabled){alert('La solicitud ya tiene cobertura completa.');return;}if(!hasSelectedRequest||!assignForm){alert('Selecciona una solicitud antes de asignar auxiliares.');return;}if(!confirm(`¿Asignar ${uniqueIds.length} auxiliar${uniqueIds.length!==1?'es':''} a esta solicitud?`))return;dropZone?.classList.add('disabled');for(const workerId of uniqueIds){const formData=new FormData();formData.set('serviceRequestId','<%= selectedServiceRequestId %>');formData.set('workerId',workerId);await fetch(assignForm.action,{method:'POST',body:formData,redirect:'follow'});}window.location.href='/admin/operaciones/asignaciones?serviceRequestId=<%= selectedServiceRequestId %>&message='+encodeURIComponent(`${uniqueIds.length} auxiliar${uniqueIds.length!==1?'es enviados':' enviado'} a asignación.`);}document.getElementById('assignSelectedWorkers')?.addEventListener('click',()=>assignWorkers(getSelectedWorkerIds()));
    if(dropZone){dropZone.addEventListener('dragover',(event)=>{if(isDropZoneDisabled)return;event.preventDefault();dropZone.classList.add('drag-over');});dropZone.addEventListener('dragleave',()=>dropZone.classList.remove('drag-over'));dropZone.addEventListener('drop',(event)=>{event.preventDefault();dropZone.classList.remove('drag-over');if(isDropZoneDisabled){alert('La solicitud ya tiene cobertura completa. Espera confirmación o marca no confirmado para liberar cupo.');return;}const raw=event.dataTransfer.getData('text/plain');const ids=raw.split(',').map((item)=>item.trim()).filter(Boolean);assignWorkers(ids);});}
    const globalTemplate=document.getElementById('globalTemplate');const cards=Array.from(document.querySelectorAll('.assigned-card'));function normalizePhone(phone){const digits=String(phone||'').replace(/\D/g,'');if(!digits)return'';if(digits.startsWith('57'))return digits;if(digits.length===10)return`57${digits}`;return digits;}function sanitizeAssignmentTemplate(template){return String(template||'').replace(/\s*-\s*\{\{\s*horaFin\s*\}\}/gi,'').replace(/\s*a\s*\{\{\s*horaFin\s*\}\}/gi,'').replace(/\{\{\s*horaFin\s*\}\}/gi,'').replace(/Horario:\s*\{\{\s*horaInicio\s*\}\}/gi,'Hora de inicio: {{horaInicio}}');}function renderMessage(template,card){const cleanTemplate=sanitizeAssignmentTemplate(template);const values={nombre:card.dataset.workerName||'',cliente:card.dataset.client||'',operacion:card.dataset.operation||'',direccion:card.dataset.address||'',ciudad:card.dataset.city||'',servicio:card.dataset.service||'',fecha:card.dataset.date||'',horaInicio:card.dataset.start||''};return cleanTemplate.replace(/{{\s*(nombre|cliente|operacion|direccion|ciudad|servicio|fecha|horaInicio)\s*}}/g,(_,key)=>values[key]||'');}function refreshLinks(){if(globalTemplate)globalTemplate.value=sanitizeAssignmentTemplate(globalTemplate.value);cards.forEach((card)=>{const textarea=card.querySelector('.assignment-message'),link=card.querySelector('.whatsapp-link');if(!textarea||!link)return;if(!textarea.value&&globalTemplate)textarea.value=globalTemplate.value;textarea.value=sanitizeAssignmentTemplate(textarea.value);const phone=normalizePhone(card.dataset.workerPhone);const text=renderMessage(textarea.value||globalTemplate?.value||'',card);link.href=phone?`https://wa.me/${phone}?text=${encodeURIComponent(text)}`:`https://wa.me/?text=${encodeURIComponent(text)}`;});}globalTemplate?.addEventListener('input',refreshLinks);document.querySelectorAll('.assignment-message').forEach((textarea)=>textarea.addEventListener('input',refreshLinks));document.querySelectorAll('.variable-btn').forEach((button)=>button.addEventListener('click',()=>{const targetId=button.closest('.variable-row')?.dataset.target;const target=targetId?document.getElementById(targetId):button.closest('.assigned-card')?.querySelector('.assignment-message');if(!target)return;const start=target.selectionStart||target.value.length;const end=target.selectionEnd||target.value.length;target.value=`${target.value.slice(0,start)}${button.dataset.var}${target.value.slice(end)}`;target.focus();target.selectionStart=target.selectionEnd=start+button.dataset.var.length;refreshLinks();}));refreshLinks();refreshSelectionUi();
  </script>
</body>
</html>