<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Operaciones de cliente — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <style>
    select.has-selection { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13, 122, 107, .12); background: #f0fdfa; }
    .attendance-map-field { gap: 10px; }
    .attendance-map { width: 100%; height: 320px; border: 1px solid #dfe4ea; border-radius: 14px; background: #eef2f5; overflow: hidden; }
    .attendance-map-actions { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: end; }
    .attendance-map-actions input { min-width: 0; }
    .attendance-map-status { padding: 10px 12px; border-radius: 10px; background: #f2f5f7; color: #44515e; font-size: 13px; line-height: 1.45; }
    .attendance-map-status.is-error { background: #fff2e8; color: #8b3a14; }
    .attendance-standards { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px; border: 1px solid #d8e8e4; border-radius: 12px; background: #f2fbf8; }
    .attendance-standard { display: inline-flex; align-items: center; min-height: 30px; padding: 5px 9px; border: 1px solid #b9ddd3; border-radius: 999px; background: #fff; color: #24594e; font-size: 12px; font-weight: 750; }
    .attendance-map .leaflet-control-attribution { font-size: 10px; }
    @media (max-width: 760px) {
      .attendance-map-actions { grid-template-columns: 1fr; }
      .attendance-map { height: 280px; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Operaciones por cliente</div>
        <h1><%= client.name %></h1>
        <p>Un cliente puede tener operaciones en varias ciudades. Cada operación guarda su propia ciudad, dirección y contacto operativo.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones/clientes">Volver a clientes</a>
        <a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ir a asignación</a>
      </div>
    </section>

    <% if (message) { %><div class="alert"><%= message %></div><% } %>

    <section class="grid-2">
      <article class="card">
        <div class="card-head"><h2>Crear operación / punto</h2><p>Selecciona la ciudad operativa del punto. Luego las solicitudes usarán esa ciudad y dirección automáticamente.</p></div>
        <div class="card-body">
          <form method="post" action="/admin/operaciones/clientes/<%= client.id %>/operaciones" autocomplete="off">
            <div class="form-grid">
              <div class="field full"><label for="name">Nombre de la operación</label><input id="name" name="name" required placeholder="Ej: Bodega Siberia" /></div>
              <div class="field"><label for="cityName">Ciudad</label><select id="cityName" name="cityName" class="city-select" required><option value="">Cargando ciudades...</option></select></div>
              <div class="field"><label for="address">Dirección</label><input id="address" name="address" placeholder="Dirección del punto" /></div>
              <div class="field"><label for="contactName">Contacto operativo</label><input id="contactName" name="contactName" placeholder="Nombre del encargado" /></div>
              <div class="field"><label for="contactPhone">Teléfono</label><input id="contactPhone" name="contactPhone" placeholder="Número de contacto" /></div>
              <div class="field"><label for="isActive">Estado</label><select id="isActive" name="isActive"><option value="true">Activo</option><option value="false">Inactivo</option></select></div>
              <div class="field full"><label for="notes">Notas</label><textarea id="notes" name="notes" placeholder="Condiciones de ingreso, horarios, requisitos o indicaciones"></textarea></div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Crear operación</button></div>
          </form>
        </div>
      </article>

      <article class="card">
        <div class="card-head"><h2>Operaciones registradas</h2><p>El link público del cliente es único. En ese formulario se elige la operación y el servicio.</p></div>
        <div class="card-body">
          <% const clientLink = baseUrl + '/operaciones/cliente/' + client.publicToken; %>
          <div class="copy-row" style="margin-bottom:16px;">
            <input class="copy-input" readonly value="<%= clientLink %>" />
            <a class="btn" href="/operaciones/cliente/<%= client.publicToken %>" target="_blank" rel="noopener">Abrir link del cliente</a>
            <button class="btn btn-primary copy-client-link" type="button" data-copy-value="<%= clientLink %>">Copiar link del cliente</button>
          </div>
          <% if (!client.operationPoints.length) { %><div class="empty"><strong>No hay operaciones registradas.</strong>Crea el primer punto de servicio para este cliente.</div><% } else { %>
            <div class="list">
              <% client.operationPoints.forEach((op)=>{ const legacyLink = baseUrl + '/operaciones/solicitud/' + op.publicToken; const suggestedAddress = [op.address, op.cityName, 'Colombia'].filter(Boolean).join(', '); %>
                <article class="item-card">
                  <h3><%= op.name %></h3>
                  <div class="item-meta">
                    <span><strong>Ciudad:</strong> <%= op.cityName || '—' %></span>
                    <span><strong>Dirección:</strong> <%= op.address || '—' %></span>
                    <span><strong>Contacto:</strong> <%= op.contactName || '—' %> · <%= op.contactPhone || 'Sin teléfono' %></span>
                    <span><strong>Estado:</strong> <span class="pill <%= op.isActive ? 'pill-green' : 'pill-amber' %>"><%= op.isActive ? 'Activo' : 'Inactivo' %></span></span>
                  </div>
                  <details class="crud-details"><summary>Editar operación</summary>
                    <form method="post" action="/admin/operaciones/clientes/<%= client.id %>/operaciones/<%= op.id %>/editar" class="form-grid compact-form" autocomplete="off">
                      <div class="field full"><label>Nombre</label><input name="name" required value="<%= op.name %>" /></div>
                      <div class="field"><label>Ciudad</label><select name="cityName" class="city-select" data-selected-city="<%= op.cityName || '' %>"><option value="">Cargando ciudades...</option></select></div>
                      <div class="field"><label>Dirección</label><input name="address" value="<%= op.address || '' %>" /></div>
                      <div class="field"><label>Contacto</label><input name="contactName" value="<%= op.contactName || '' %>" /></div>
                      <div class="field"><label>Teléfono</label><input name="contactPhone" value="<%= op.contactPhone || '' %>" /></div>
                      <div class="field"><label>Estado</label><select name="isActive"><option value="true" <%= op.isActive ? 'selected' : '' %>>Activo</option><option value="false" <%= !op.isActive ? 'selected' : '' %>>Inactivo</option></select></div>
                      <div class="field full"><label>Notas</label><textarea name="notes"><%= op.notes || '' %></textarea></div>
                      <div class="form-actions full"><button class="btn btn-primary" type="submit">Guardar operación</button></div>
                    </form>
                  </details>
                  <details class="crud-details attendance-config">
                    <summary>Configurar asistencia</summary>
                    <div class="item-meta" style="margin:10px 0 14px;">
                      <span><strong>Asistencia:</strong> <span class="pill <%= op.attendanceEnabled ? 'pill-green' : 'pill-amber' %>"><%= op.attendanceEnabled ? 'Habilitada' : 'Deshabilitada' %></span></span>
                      <span><strong>Zona horaria:</strong> <%= op.attendanceTimezone || 'America/Bogota' %></span>
                      <span><strong>Fotografía:</strong> <%= op.attendancePhotoPolicy === 'ALWAYS' ? 'Siempre' : op.attendancePhotoPolicy === 'NEVER' ? 'Nunca' : 'Solo ante riesgo' %></span>
                    </div>
                    <form
                      method="post"
                      action="/admin/operaciones/clientes/<%= client.id %>/operaciones/<%= op.id %>/asistencia"
                      class="form-grid compact-form attendance-map-form"
                      autocomplete="off"
                    >
                      <input type="hidden" name="attendanceEnabledFallback" value="false" />
                      <input type="hidden" name="manualAttendanceAllowedFallback" value="false" />
                      <input type="hidden" name="attendanceLatitude" value="<%= op.attendanceLatitude == null ? '' : op.attendanceLatitude %>" />
                      <input type="hidden" name="attendanceLongitude" value="<%= op.attendanceLongitude == null ? '' : op.attendanceLongitude %>" />
                      <div class="field full">
                        <label><input type="checkbox" name="attendanceEnabled" value="true" <%= op.attendanceEnabled || op.attendanceLatitude == null || op.attendanceLongitude == null ? 'checked' : '' %> /> Habilitar control de asistencia al guardar</label>
                        <small class="muted">Selecciona el punto exacto en el mapa. Lórren aplicará automáticamente una geocerca de 100 metros y exigirá una precisión GPS de 50 metros o mejor.</small>
                      </div>
                      <div class="field full attendance-map-field">
                        <label for="attendance-search-<%= op.id %>">Ubicación exacta de la operación</label>
                        <div class="attendance-map-actions">
                          <input id="attendance-search-<%= op.id %>" class="attendance-address-search" type="search" value="<%= suggestedAddress %>" placeholder="Dirección, barrio o nombre del lugar" />
                          <button class="btn attendance-search-button" type="button">Buscar dirección</button>
                          <button class="btn btn-primary attendance-current-location" type="button">Usar mi ubicación</button>
                        </div>
                        <small class="muted">También puedes tocar el mapa o arrastrar el marcador hasta la entrada real del punto.</small>
                        <div id="attendance-map-<%= op.id %>" class="attendance-map" role="application" aria-label="Mapa para seleccionar el punto de asistencia"></div>
                        <div class="attendance-map-status" role="status" aria-live="polite"><%= op.attendanceLatitude != null && op.attendanceLongitude != null ? 'Ubicación guardada. Puedes ajustarla en el mapa.' : 'Busca la dirección, usa tu ubicación o toca el mapa para seleccionar el punto.' %></div>
                      </div>
                      <div class="field full">
                        <div class="attendance-standards" data-attendance-open-entry-policy="true">
                          <span class="attendance-standard">Radio permitido: 100 m</span>
                          <span class="attendance-standard">Precisión GPS: 50 m o mejor</span>
                          <span class="attendance-standard">Entrada sin ventana configurable</span>
                          <span class="attendance-standard">Las llegadas tarde se registran y no se bloquean</span>
                          <span class="muted">La hora real siempre queda guardada. Si el auxiliar llega antes, el conteo inicia a la hora programada salvo reconocimiento auditado del coordinador.</span>
                        </div>
                      </div>
                      <div class="field"><label>Zona horaria</label><select name="attendanceTimezone" required><option value="America/Bogota" selected>America/Bogota</option></select></div>
                      <div class="field"><label>Política de fotografía</label><select name="attendancePhotoPolicy" required><option value="NEVER" <%= op.attendancePhotoPolicy === 'NEVER' ? 'selected' : '' %>>Nunca</option><option value="RISK_ONLY" <%= op.attendancePhotoPolicy === 'RISK_ONLY' ? 'selected' : '' %>>Solo ante riesgo</option><option value="ALWAYS" <%= op.attendancePhotoPolicy === 'ALWAYS' ? 'selected' : '' %>>Siempre</option></select></div>
                      <div class="field"><label><input type="checkbox" name="manualAttendanceAllowed" value="true" <%= op.manualAttendanceAllowed ? 'checked' : '' %> /> Permitir corrección o registro manual auditado</label></div>
                      <div class="form-actions full"><button class="btn btn-primary" type="submit"><%= op.attendanceEnabled ? 'Guardar asistencia' : 'Guardar y habilitar asistencia' %></button></div>
                    </form>
                  </details>
                  <div class="actions stack-actions">
                    <form method="post" action="/admin/operaciones/clientes/<%= client.id %>/operaciones/<%= op.id %>/toggle"><button class="btn" type="submit"><%= op.isActive ? 'Desactivar' : 'Reactivar' %></button></form>
                    <form method="post" action="/operaciones/admin-delete/clientes/<%= client.id %>/operaciones/<%= op.id %>"><button class="btn" type="submit">Eliminar</button></form>
                  </div>
                  <div class="muted" style="margin-top:12px;">Link antiguo por operación compatible temporalmente: <%= legacyLink %></div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </div>
      </article>
    </section>

    <section class="grid-2" style="margin-top:18px;">
      <article class="card">
        <div class="card-head"><h2>Crear servicio</h2><p>Define los servicios disponibles para este cliente y sus solicitudes operativas.</p></div>
        <div class="card-body">
          <form method="post" action="/admin/operaciones/clientes/<%= client.id %>/servicios">
            <div class="form-grid">
              <div class="field full"><label for="serviceName">Nombre del servicio</label><input id="serviceName" name="name" required placeholder="Ej: Cargue y descargue" /></div>
              <div class="field"><label for="serviceActive">Estado</label><select id="serviceActive" name="isActive"><option value="true">Activo</option><option value="false">Inactivo</option></select></div>
              <div class="field full"><label for="serviceDescription">Descripción</label><textarea id="serviceDescription" name="description" placeholder="Detalles, alcance o condiciones del servicio"></textarea></div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Crear servicio</button></div>
          </form>
        </div>
      </article>

      <article class="card">
        <div class="card-head"><h2>Servicios registrados</h2><p>Estos servicios aparecerán como opciones seleccionables al crear solicitudes.</p></div>
        <div class="card-body">
          <% if (!client.services.length) { %><div class="empty"><strong>No hay servicios registrados.</strong>Crea al menos un servicio para que el cliente lo seleccione en el formulario público.</div><% } else { %>
            <div class="list">
              <% client.services.forEach((service)=>{ %>
                <article class="item-card">
                  <h3><%= service.name %></h3>
                  <div class="item-meta">
                    <span><strong>Descripción:</strong> <%= service.description || '—' %></span>
                    <span><strong>Estado:</strong> <span class="pill <%= service.isActive ? 'pill-green' : 'pill-amber' %>"><%= service.isActive ? 'Activo' : 'Inactivo' %></span></span>
                  </div>
                  <details class="crud-details"><summary>Editar servicio</summary>
                    <form method="post" action="/admin/operaciones/clientes/<%= client.id %>/servicios/<%= service.id %>/editar" class="form-grid compact-form">
                      <div class="field full"><label>Nombre</label><input name="name" required value="<%= service.name %>" /></div>
                      <div class="field"><label>Estado</label><select name="isActive"><option value="true" <%= service.isActive ? 'selected' : '' %>>Activo</option><option value="false" <%= !service.isActive ? 'selected' : '' %>>Inactivo</option></select></div>
                      <div class="field full"><label>Descripción</label><textarea name="description"><%= service.description || '' %></textarea></div>
                      <div class="form-actions full"><button class="btn btn-primary" type="submit">Guardar servicio</button></div>
                    </form>
                  </details>
                  <div class="actions stack-actions">
                    <form method="post" action="/admin/operaciones/clientes/<%= client.id %>/servicios/<%= service.id %>/toggle"><button class="btn" type="submit"><%= service.isActive ? 'Desactivar' : 'Reactivar' %></button></form>
                    <form method="post" action="/operaciones/admin-delete/clientes/<%= client.id %>/servicios/<%= service.id %>"><button class="btn" type="submit">Eliminar</button></form>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </div>
      </article>
    </section>
  </main>

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9coqIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script>
    const ATTENDANCE_GEOFENCE_RADIUS_METERS = 100;
    const DEFAULT_ATTENDANCE_MAP_CENTER = [4.570868, -74.297333];
    const attendanceMaps = new WeakMap();
    let nextNominatimSearchAt = 0;

    function refreshSelectState(select) { select.classList.toggle('has-selection', Boolean(select.value)); }

    async function loadCityOptions() {
      const selects = Array.from(document.querySelectorAll('.city-select'));
      if (!selects.length) return;
      try {
        const response = await fetch(`/operaciones/api/ciudades?t=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) return;
        const data = await response.json();
        selects.forEach((select) => {
          const selectedCity = select.dataset.selectedCity || select.value || '';
          select.innerHTML = '<option value="">Selecciona una ciudad</option>';
          data.cities.forEach((city) => {
            const option = document.createElement('option');
            option.value = city.name;
            option.textContent = `${city.name}${city.usedForRecruitment && city.usedForDispatch ? ' — Bot y Despacho' : city.usedForDispatch ? ' — Despacho' : ' — Bot'}`;
            select.appendChild(option);
          });
          if (selectedCity) {
            const exists = Array.from(select.options).some((option) => option.value === selectedCity);
            if (!exists) {
              const option = document.createElement('option');
              option.value = selectedCity;
              option.textContent = `${selectedCity} — no configurada`;
              select.appendChild(option);
            }
            select.value = selectedCity;
          }
          refreshSelectState(select);
          select.addEventListener('change', () => refreshSelectState(select));
        });
      } catch (error) {
        console.error('No fue posible cargar ciudades', error);
      }
    }

    function setAttendanceMapStatus(form, message, isError = false) {
      const status = form.querySelector('.attendance-map-status');
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', isError);
    }

    function finiteCoordinate(value, min, max) {
      const number = Number(value);
      return Number.isFinite(number) && number >= min && number <= max ? number : null;
    }

    function setAttendancePoint(form, state, latitude, longitude, message, options = {}) {
      const lat = finiteCoordinate(latitude, -90, 90);
      const lng = finiteCoordinate(longitude, -180, 180);
      if (lat === null || lng === null) {
        setAttendanceMapStatus(form, 'La ubicación seleccionada no es válida.', true);
        return;
      }

      form.querySelector('[name="attendanceLatitude"]').value = lat.toFixed(7);
      form.querySelector('[name="attendanceLongitude"]').value = lng.toFixed(7);
      const point = [lat, lng];

      if (!state.marker) {
        state.marker = window.L.marker(point, { draggable: true }).addTo(state.map);
        state.marker.on('dragend', () => {
          const moved = state.marker.getLatLng();
          setAttendancePoint(form, state, moved.lat, moved.lng, 'Punto ajustado manualmente. Guarda para aplicar el cambio.', { recenter: false });
        });
      } else {
        state.marker.setLatLng(point);
      }

      if (!state.circle) {
        state.circle = window.L.circle(point, { radius: ATTENDANCE_GEOFENCE_RADIUS_METERS }).addTo(state.map);
      } else {
        state.circle.setLatLng(point).setRadius(ATTENDANCE_GEOFENCE_RADIUS_METERS);
      }

      if (options.recenter !== false) state.map.setView(point, 18);
      setAttendanceMapStatus(form, message || 'Punto seleccionado. Guarda la configuración para habilitar la marcación.');
    }

    async function reserveNominatimSearchSlot() {
      const now = Date.now();
      const scheduledAt = Math.max(now, nextNominatimSearchAt);
      nextNominatimSearchAt = scheduledAt + 1100;
      const waitMs = scheduledAt - now;
      if (waitMs > 0) await new Promise((resolve) => window.setTimeout(resolve, waitMs));
    }

    function initializeAttendanceMap(form) {
      if (!form) return;
      const existingState = attendanceMaps.get(form);
      if (existingState) {
        window.setTimeout(() => existingState.map.invalidateSize(), 0);
        return;
      }
      if (!window.L) {
        setAttendanceMapStatus(form, 'No fue posible cargar el mapa. Recarga la página e inténtalo nuevamente.', true);
        return;
      }

      const mapContainer = form.querySelector('.attendance-map');
      const latitudeInput = form.querySelector('[name="attendanceLatitude"]');
      const longitudeInput = form.querySelector('[name="attendanceLongitude"]');
      const savedLatitude = finiteCoordinate(latitudeInput?.value, -90, 90);
      const savedLongitude = finiteCoordinate(longitudeInput?.value, -180, 180);
      const hasSavedPoint = savedLatitude !== null && savedLongitude !== null;
      const initialCenter = hasSavedPoint ? [savedLatitude, savedLongitude] : DEFAULT_ATTENDANCE_MAP_CENTER;
      const map = window.L.map(mapContainer, { scrollWheelZoom: false }).setView(initialCenter, hasSavedPoint ? 18 : 6);
      const state = { map, marker: null, circle: null };
      attendanceMaps.set(form, state);

      window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);

      map.on('click', (event) => {
        setAttendancePoint(form, state, event.latlng.lat, event.latlng.lng, 'Punto seleccionado en el mapa. Guarda para habilitar la marcación.');
      });

      if (hasSavedPoint) {
        setAttendancePoint(form, state, savedLatitude, savedLongitude, 'Ubicación guardada. Puedes tocar el mapa o arrastrar el marcador para ajustarla.');
      }

      form.querySelector('.attendance-search-button')?.addEventListener('click', async () => {
        const searchInput = form.querySelector('.attendance-address-search');
        const query = String(searchInput?.value || '').trim();
        if (query.length < 4) {
          setAttendanceMapStatus(form, 'Escribe una dirección o nombre de lugar más específico.', true);
          searchInput?.focus();
          return;
        }

        const button = form.querySelector('.attendance-search-button');
        button.disabled = true;
        setAttendanceMapStatus(form, 'Buscando la dirección…');
        try {
          await reserveNominatimSearchSlot();
          const params = new URLSearchParams({
            q: query,
            format: 'jsonv2',
            limit: '1',
            countrycodes: 'co',
            'accept-language': 'es'
          });
          const controller = new AbortController();
          const timeoutId = window.setTimeout(() => controller.abort(), 8000);
          let response;
          try {
            response = await fetch(`https://nominatim.openstreetmap.org/search?${params.toString()}`, {
              headers: { Accept: 'application/json' },
              signal: controller.signal
            });
          } finally {
            window.clearTimeout(timeoutId);
          }
          if (!response.ok) throw new Error('geocoding_unavailable');
          const results = await response.json();
          const first = Array.isArray(results) ? results[0] : null;
          if (!first) {
            setAttendanceMapStatus(form, 'No encontramos esa dirección. Prueba con barrio, ciudad o selecciona el punto directamente en el mapa.', true);
            return;
          }
          setAttendancePoint(form, state, first.lat, first.lon, 'Dirección encontrada. Ajusta el marcador si la entrada real está en otro lugar.');
        } catch (_error) {
          setAttendanceMapStatus(form, 'La búsqueda de direcciones no está disponible. Usa tu ubicación o selecciona el punto directamente en el mapa.', true);
        } finally {
          button.disabled = false;
        }
      });

      form.querySelector('.attendance-current-location')?.addEventListener('click', () => {
        if (!navigator.geolocation) {
          setAttendanceMapStatus(form, 'Este navegador no permite obtener la ubicación. Selecciona el punto directamente en el mapa.', true);
          return;
        }
        const button = form.querySelector('.attendance-current-location');
        button.disabled = true;
        setAttendanceMapStatus(form, 'Obteniendo tu ubicación actual…');
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const accuracy = Math.round(position.coords.accuracy || 0);
            setAttendancePoint(
              form,
              state,
              position.coords.latitude,
              position.coords.longitude,
              accuracy > 50
                ? `Ubicación obtenida con una precisión aproximada de ${accuracy} m. Ajusta el marcador hasta la entrada exacta.`
                : `Ubicación actual seleccionada con una precisión aproximada de ${accuracy} m.`
            );
            button.disabled = false;
          },
          () => {
            setAttendanceMapStatus(form, 'No fue posible obtener tu ubicación. Revisa el permiso del navegador o selecciona el punto en el mapa.', true);
            button.disabled = false;
          },
          { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
        );
      });

      form.addEventListener('submit', (event) => {
        const enabled = form.querySelector('[name="attendanceEnabled"]')?.checked === true;
        const hasCoordinates = Boolean(latitudeInput?.value && longitudeInput?.value);
        if (enabled && !hasCoordinates) {
          event.preventDefault();
          setAttendanceMapStatus(form, 'Selecciona primero la ubicación exacta del punto.', true);
          mapContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });

      window.setTimeout(() => map.invalidateSize(), 0);
    }

    document.querySelectorAll('details.attendance-config').forEach((details) => {
      details.addEventListener('toggle', () => {
        if (details.open) initializeAttendanceMap(details.querySelector('.attendance-map-form'));
      });
      if (details.open) initializeAttendanceMap(details.querySelector('.attendance-map-form'));
    });

    document.querySelectorAll('.copy-client-link').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.dataset.copyValue || '';
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(value);
          } else {
            const input = button.parentElement?.querySelector('.copy-input');
            input?.select();
            document.execCommand('copy');
          }
          button.textContent = 'Link copiado';
          window.setTimeout(() => { button.textContent = 'Copiar link del cliente'; }, 1800);
        } catch (_error) {
          window.prompt('Copia el link del cliente:', value);
        }
      });
    });

    window.addEventListener('pageshow', (event) => { if (event.persisted) window.location.reload(); });
    loadCityOptions();
  </script>
</body>
</html>