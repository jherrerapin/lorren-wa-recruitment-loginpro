<!doctype html><html><head><meta charset='utf-8'><title>Editar solicitud</title></head><body>
<h1>Editar solicitud</h1>
<form method='post' action='/admin/operaciones/asignaciones/solicitudes/<%= serviceRequest.id %>/editar'>
<input name='clientName' value='<%= serviceRequest.clientName %>'><input name='operationPointName' value='<%= serviceRequest.operationPointName||"" %>'><input name='cityName' value='<%= serviceRequest.cityName||"" %>'><input name='address' value='<%= serviceRequest.address||"" %>'><input type='date' name='serviceDate' value='<%= new Date(serviceRequest.serviceDate).toISOString().slice(0,10) %>'><input name='startTime' value='<%= serviceRequest.startTime||"" %>'><input name='endTime' value='<%= serviceRequest.endTime||"" %>'><input type='number' name='requiredWorkers' min='1' value='<%= serviceRequest.requiredWorkers %>'><textarea name='notes'><%= serviceRequest.notes||"" %></textarea><input name='status' value='<%= serviceRequest.status %>'><button>Guardar</button></form></body></html>
