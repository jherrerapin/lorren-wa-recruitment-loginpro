<!DOCTYPE html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg"/>
  <link rel="stylesheet" href="/public/operaciones-gestion-tiempo.css"/>
  <style>
    .payroll-filter-panel{width:100%;max-width:none}.payroll-filter-stack{display:grid;grid-template-columns:repeat(3,minmax(220px,320px));justify-content:start;gap:10px}.payroll-filter-row{display:contents}.payroll-filter-actions{display:flex;justify-content:flex-start;grid-column:1/-1}.payroll-filter-actions .btn{min-width:220px}.payroll-periods{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(300px,520px));gap:12px}.payroll-period-card{border:1px solid var(--border);border-radius:10px;padding:12px;background:#fff;display:grid;gap:10px}.payroll-period-card-title{font-size:12px;font-weight:900;color:var(--navy);text-transform:uppercase;letter-spacing:.03em}.payroll-period-top{display:grid;grid-template-columns:minmax(150px,190px) minmax(0,1fr);gap:9px;align-items:end}.payroll-period-top.no-month{grid-template-columns:1fr}.payroll-period-segments{display:flex;gap:6px;flex-wrap:wrap}.payroll-period-segment{appearance:none;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--navy);padding:8px 10px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}.payroll-period-segment.is-active{border-color:var(--teal);background:var(--teal2);color:var(--teal)}.payroll-range-button{width:100%;min-height:39px;border:1px solid var(--border);border-radius:8px;background:var(--soft);color:var(--navy);padding:9px 11px;text-align:left;font:inherit;font-size:12px;font-weight:800;cursor:pointer}.payroll-range-button[hidden]{display:none}.payroll-range-dialog{border:0;border-radius:14px;padding:0;width:min(390px,calc(100vw - 24px));box-shadow:0 18px 50px rgba(15,23,42,.28)}.payroll-range-dialog::backdrop{background:rgba(15,23,42,.42)}.payroll-calendar{padding:14px;display:grid;gap:10px}.payroll-calendar-head{display:grid;grid-template-columns:36px 1fr 36px;gap:8px;align-items:center}.payroll-calendar-head strong{text-align:center;color:var(--navy);font-size:13px;text-transform:capitalize}.payroll-calendar-nav{width:36px;height:34px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--navy);font-size:20px;cursor:pointer}.payroll-calendar-weekdays,.payroll-calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.payroll-calendar-weekdays span{text-align:center;color:var(--muted);font-size:9px;font-weight:900}.payroll-calendar-day{aspect-ratio:1;border:1px solid transparent;border-radius:8px;background:#fff;color:var(--navy);font:inherit;font-size:11px;cursor:pointer}.payroll-calendar-day.outside{color:#94a3b8}.payroll-calendar-day.in-range{background:#e6f4f1}.payroll-calendar-day.is-edge{background:var(--teal);color:#fff;font-weight:900}.payroll-calendar-actions{display:flex;justify-content:flex-end;gap:8px;padding-top:4px}.worker-picker{position:relative;margin-top:0}.worker-picker>summary{list-style:none;min-height:37px;border:1px solid var(--border);border-radius:8px;padding:9px 34px 9px 10px;background:#fff;color:var(--text);font-size:13px;font-weight:500;cursor:pointer;position:relative}.worker-picker>summary::-webkit-details-marker{display:none}.worker-picker>summary::after{content:'▾';position:absolute;right:11px;color:var(--muted)}.worker-picker[open]>summary::after{content:'▴'}.worker-picker-menu{position:absolute;z-index:45;top:calc(100% + 5px);left:0;width:min(420px,calc(100vw - 48px));max-height:280px;overflow:auto;border:1px solid var(--border);border-radius:9px;padding:8px;background:#fff;box-shadow:0 10px 28px rgba(15,23,42,.16)}.worker-picker-help{padding:5px 7px 8px;color:var(--muted);font-size:10px;line-height:1.35}.worker-check{display:flex;align-items:center;gap:8px;padding:7px;border-radius:6px;cursor:pointer;font-size:12px}.worker-check:hover{background:var(--soft)}.worker-check input{width:auto;margin:0;flex:0 0 auto}.worker-check span{min-width:0}.manual-correction-note{margin-top:5px;padding:5px 7px;border-left:3px solid var(--teal);background:var(--teal2);border-radius:4px;color:#14574f;font-size:10px;line-height:1.4;white-space:normal}.manual-correction-note strong{display:inline}.manual-correction-note+.manual-correction-note{margin-top:3px}
    .payroll-import-panel[hidden]{display:none}.payroll-import-panel{border:1px solid #dce7e4}.payroll-import-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.payroll-import-head h2{margin:0 0 5px}.payroll-import-head p{margin:0;color:var(--muted);font-size:12px;line-height:1.45;max-width:760px}.payroll-import-controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap}.payroll-import-controls .field{min-width:min(420px,100%);flex:1}.payroll-import-controls input[type=file]{width:100%}.payroll-import-status{margin-top:12px;padding:10px 12px;border-radius:8px;background:var(--soft);font-size:12px;line-height:1.45}.payroll-import-status:empty{display:none}.payroll-import-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:8px;margin-top:12px}.payroll-import-metric{border:1px solid var(--border);border-radius:8px;padding:9px;background:#fff}.payroll-import-metric strong{display:block;font-size:18px}.payroll-import-metric small{color:var(--muted)}.payroll-import-mapping{margin-top:12px;padding:12px;border:1px solid #f1d5a7;border-radius:9px;background:#fffbeb}.payroll-import-mapping h3{margin:0 0 8px;font-size:14px}.payroll-import-mapping-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px}.payroll-import-mapping label{display:grid;gap:4px;font-size:11px;font-weight:700}.payroll-import-exceptions{margin-top:12px;overflow:auto;max-height:280px;border:1px solid var(--border);border-radius:8px}.payroll-import-exceptions table,.payroll-import-history table{width:100%;border-collapse:collapse;font-size:12px}.payroll-import-exceptions th,.payroll-import-exceptions td,.payroll-import-history th,.payroll-import-history td{padding:8px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.payroll-import-exceptions th,.payroll-import-history th{background:var(--soft);position:sticky;top:0}.payroll-import-history{margin-top:14px;overflow:auto}.payroll-import-badge{display:inline-flex;padding:3px 7px;border-radius:999px;background:var(--soft);font-size:10px;font-weight:800}.payroll-import-badge[data-status="REVERSED"]{background:#eef2f7}.payroll-import-badge[data-status="PARTIAL"]{background:#fef3c7;color:#92400e}.payroll-import-badge[data-status="ACTIVE"]{background:#dcfce7;color:#166534}.payroll-import-actions{display:flex;gap:8px;flex-wrap:wrap}.btn-danger-soft{border-color:#fecdd3;color:#9f1239;background:#fff1f2}
    @media(max-width:1050px){.payroll-filter-stack{grid-template-columns:repeat(2,minmax(220px,320px));}.payroll-periods{grid-template-columns:1fr}}@media(max-width:760px){.payroll-filter-stack{grid-template-columns:minmax(0,1fr);justify-content:stretch}.payroll-filter-actions .btn{width:100%;min-width:0}.payroll-period-top{grid-template-columns:1fr}.worker-picker-menu{position:fixed;left:12px;right:12px;top:20%;width:auto;max-height:60vh}.payroll-import-head{display:grid}.payroll-import-controls{display:grid}.payroll-import-controls .field{min-width:0}}
  </style>
</head>
<body>
<nav class="navbar"><a href="/admin" class="brand"><img src="/public/loginpro.png" alt="LoginPro"/></a><a href="/admin">Panel</a><a href="/admin/operaciones">Operaciones / Despacho</a><a href="/admin/operaciones/asistencia">Asistencia</a><a href="/admin/operaciones/asistencia/gestion-tiempo" class="active">Gestión de Tiempo</a><span class="spacer"></span><a href="/logout">Cerrar sesión</a></nav>
<main class="page">
  <% const selectedWorkerIds=String(report.filters.workerId||'').split(',').map((value)=>value.trim()).filter(Boolean); const payrollImports=Array.isArray(recentImports)?recentImports:[]; const overtimePeriod=report.overtimePeriod||report.period; const generalMonth=(report.period.from||'').slice(0,7); const generalMode=report.period.periodType==='CUSTOM'||report.period.periodType==='WEEKLY'?'CUSTOM':((report.period.from||'').endsWith('-01')?'FIRST':'SECOND'); const overtimeMode=overtimePeriod.periodType==='WEEKLY'?'WEEKLY':'CUSTOM'; const monthParts=generalMonth.split('-').map(Number); const generalMonthEnd=monthParts.length===2&&monthParts.every(Number.isFinite)?new Date(Date.UTC(monthParts[0],monthParts[1],0)).getUTCDate():31; const exportParams=new URLSearchParams({...report.filters,periodType:generalMode==='CUSTOM'?'CUSTOM':'BIWEEKLY',from:report.period.from,to:report.period.to,anchor:report.period.anchor,extraPeriodType:overtimeMode,extraFrom:overtimePeriod.from,extraTo:overtimePeriod.to,extraAnchor:overtimePeriod.anchor||overtimePeriod.from}); %>
  <header class="header">
    <div><h1><%= pageTitle %></h1><p class="sub">General <%= report.period.from||'—' %> a <%= report.period.to||'—' %> · Extras <%= overtimePeriod.from||'—' %> a <%= overtimePeriod.to||'—' %></p></div>
    <div class="actions"><a class="btn" href="/admin/operaciones/asistencia">Asistencia</a><button class="btn" type="button" id="open-payroll-import">Importar marcaciones</button><a class="btn btn-primary" href="/admin/operaciones/asistencia/gestion-tiempo/export.xlsx?<%= exportParams.toString() %>">Excel</a></div>
  </header>
  <% if(success){ %><div class="alert alert-success"><%= success %></div><% } %>
  <% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>
  <% if(role==='dev'&&report.filters.includeTest){ %><div class="test-mode"><span>Modo DEV activo: este cálculo incluye jornadas y sujetos de prueba.</span><div class="actions"><a class="btn" href="/admin/operaciones/pruebas">Volver al entorno de pruebas</a><a class="btn" href="/admin/operaciones/asistencia/gestion-tiempo">Salir del modo de pruebas</a></div></div><% } %>

  <section class="panel payroll-import-panel" id="payroll-import-panel" hidden>
    <div class="payroll-import-head">
      <div><h2>Importar marcaciones de GeoVictoria</h2><p>Admite Excel (.xlsx) y CSV. Lórren detecta las fechas del archivo sin restringir si son pasadas, actuales o futuras. Primero se analiza y concilia; nada se escribe hasta que confirmes la importación.</p></div>
      <button class="btn" type="button" id="close-payroll-import">Cerrar</button>
    </div>
    <div class="payroll-import-controls">
      <div class="field"><label for="payroll-import-file">Archivo de marcaciones</label><input id="payroll-import-file" type="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"/></div>
      <button class="btn btn-primary" type="button" id="payroll-import-preview">Analizar archivo</button>
      <button class="btn" type="button" id="payroll-import-commit" hidden>Confirmar importación</button>
    </div>
    <div class="payroll-import-status" id="payroll-import-status" role="status" aria-live="polite"></div>
    <div class="payroll-import-summary" id="payroll-import-summary"></div>
    <div class="payroll-import-mapping" id="payroll-import-mapping" hidden><h3>Ajustar correspondencia de columnas</h3><p id="payroll-import-mapping-help" style="margin:0 0 9px;font-size:11px;color:#7c5b16">Lórren mostrará únicamente los datos que corresponden al formato detectado en el archivo.</p><div class="payroll-import-mapping-grid" id="payroll-import-mapping-grid"></div></div>
    <div class="payroll-import-exceptions" id="payroll-import-exceptions" hidden><table><thead><tr><th>Fila</th><th>Identidad</th><th>Fecha</th><th>Estado</th><th>Detalle</th></tr></thead><tbody id="payroll-import-exceptions-body"></tbody></table></div>

    <div class="payroll-import-history">
      <h3 style="margin:18px 0 8px">Últimas importaciones</h3>
      <% if(!payrollImports.length){ %><p class="sub">Todavía no hay importaciones de marcaciones registradas.</p><% } else { %>
      <table><thead><tr><th>Fecha del archivo</th><th>Formato</th><th>Jornadas</th><th>Marcaciones</th><th>Estado</th><th></th></tr></thead><tbody>
        <% for(const item of payrollImports){ %><tr>
          <td><%= item.dateFrom||'—' %><%= item.dateTo&&item.dateTo!==item.dateFrom?` a ${item.dateTo}`:'' %></td><td><%= item.format %></td><td><%= item.importedWorkdays %></td><td><%= item.importedMarks %></td><td><span class="payroll-import-badge" data-status="<%= item.status %>"><%= item.status==='REVERSED'?'Reversada':(item.status==='PARTIAL'?'Parcial':'Activa') %></span></td>
          <td><% if(item.canReverse){ %><form method="post" action="/admin/operaciones/asistencia/gestion-tiempo/imports/<%= item.batchId %>/reverse" data-payroll-import-reverse><input type="hidden" name="periodType" value="<%= generalMode==='CUSTOM'?'CUSTOM':'BIWEEKLY' %>"/><input type="hidden" name="from" value="<%= report.period.from %>"/><input type="hidden" name="to" value="<%= report.period.to %>"/><input type="hidden" name="anchor" value="<%= report.period.anchor %>"/><input type="hidden" name="extraPeriodType" value="<%= overtimeMode %>"/><input type="hidden" name="extraFrom" value="<%= overtimePeriod.from %>"/><input type="hidden" name="extraTo" value="<%= overtimePeriod.to %>"/><input type="hidden" name="extraAnchor" value="<%= overtimePeriod.anchor||overtimePeriod.from %>"/><input type="hidden" name="clientId" value="<%= report.filters.clientId %>"/><input type="hidden" name="operationPointId" value="<%= report.filters.operationPointId %>"/><input type="hidden" name="search" value="<%= report.filters.search %>"/><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %><button class="btn btn-danger-soft" type="submit">Reversar importación</button></form><% } %></td>
        </tr><% } %>
      </tbody></table><% } %>
    </div>
  </section>

  <section class="panel payroll-filter-panel"><form method="get" action="/admin/operaciones/asistencia/gestion-tiempo" class="payroll-filter-stack" id="payroll-filters" data-initial-general-mode="<%= generalMode %>" data-initial-overtime-mode="<%= overtimeMode %>"><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %>
    <input type="hidden" id="periodType" name="periodType" value="<%= generalMode==='CUSTOM'?'CUSTOM':'BIWEEKLY' %>"/><input type="hidden" id="payrollFrom" name="from" value="<%= report.period.from %>"/><input type="hidden" id="payrollTo" name="to" value="<%= report.period.to %>"/><input type="hidden" id="payrollAnchor" name="anchor" value="<%= report.period.anchor||report.period.from %>"/>
    <input type="hidden" id="extraPeriodType" name="extraPeriodType" value="<%= overtimeMode %>"/><input type="hidden" id="extraFrom" name="extraFrom" value="<%= overtimePeriod.from %>"/><input type="hidden" id="extraTo" name="extraTo" value="<%= overtimePeriod.to %>"/><input type="hidden" id="extraAnchor" name="extraAnchor" value="<%= overtimePeriod.anchor||overtimePeriod.from %>"/>
    <div class="payroll-periods">
      <section class="payroll-period-card">
        <div class="payroll-period-card-title">Periodo general</div>
        <div class="payroll-period-top"><div class="field"><label for="generalPayrollMonth">Mes</label><input id="generalPayrollMonth" type="month" value="<%= generalMonth %>"/></div><div class="payroll-period-segments"><button class="payroll-period-segment" type="button" data-general-mode="FIRST">1–15</button><button class="payroll-period-segment" type="button" data-general-mode="SECOND">16–<span id="generalSecondEnd"><%= generalMonthEnd %></span></button><button class="payroll-period-segment" type="button" data-general-mode="CUSTOM">Personalizado</button></div></div>
        <button class="payroll-range-button" type="button" id="generalRangeButton" data-range-picker="general"><%= report.period.from===report.period.to?report.period.from:`${report.period.from} – ${report.period.to}` %></button>
      </section>
      <section class="payroll-period-card">
        <div class="payroll-period-card-title">Horas extras</div>
        <div class="payroll-period-top no-month"><div class="payroll-period-segments"><button class="payroll-period-segment" type="button" data-overtime-mode="WEEKLY">Semanal</button><button class="payroll-period-segment" type="button" data-overtime-mode="CUSTOM">Personalizado</button></div></div>
        <button class="payroll-range-button" type="button" id="overtimeRangeButton" data-range-picker="overtime"><%= overtimePeriod.from===overtimePeriod.to?overtimePeriod.from:`${overtimePeriod.from} – ${overtimePeriod.to}` %></button>
      </section>
    </div>
    <div class="payroll-filter-row"><div class="field"><label for="clientId">Cliente</label><select id="clientId" name="clientId"><option value="">Todos</option><% for(const client of report.clients){ %><option value="<%= client.id %>" <%= report.filters.clientId===client.id?'selected':'' %>><%= client.name %></option><% } %></select></div><div class="field"><label for="operationPointId">Operación</label><select id="operationPointId" name="operationPointId"><option value="">Todas</option><% for(const client of report.clients){for(const point of client.operationPoints||[]){ %><option data-client="<%= client.id %>" value="<%= point.id %>" <%= report.filters.operationPointId===point.id?'selected':'' %>><%= client.name %> · <%= point.name %></option><% }} %></select></div></div>
    <div class="payroll-filter-row"><div class="field"><label>Auxiliares</label><details class="worker-picker"><summary><%= selectedWorkerIds.length?`${selectedWorkerIds.length} auxiliar(es) seleccionado(s)`:'Todos los auxiliares' %></summary><div class="worker-picker-menu"><div class="worker-picker-help">Marca uno o varios auxiliares. Si no marcas ninguno, se analizan todos los que tienen información en este corte.</div><% for(const worker of report.workers){ %><label class="worker-check"><input type="checkbox" name="workerId" value="<%= worker.id %>" <%= selectedWorkerIds.includes(worker.id)?'checked':'' %>/><span><%= worker.fullName %><%= worker.documentNumber?` · ${worker.documentNumber}`:'' %></span></label><% } %></div></details></div><div class="field"><label for="search">Buscar</label><input id="search" name="search" value="<%= report.filters.search %>" placeholder="Nombre, documento o teléfono"/></div></div>
    <div class="payroll-filter-actions"><button class="btn btn-primary" type="submit">Calcular</button></div>
  </form></section>

  <dialog class="payroll-range-dialog" id="payrollRangeDialog">
    <div class="payroll-calendar">
      <div class="payroll-calendar-head"><button class="payroll-calendar-nav" type="button" id="payrollCalendarPrev" aria-label="Mes anterior">‹</button><strong id="payrollCalendarMonth"></strong><button class="payroll-calendar-nav" type="button" id="payrollCalendarNext" aria-label="Mes siguiente">›</button></div>
      <div class="payroll-calendar-weekdays"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
      <div class="payroll-calendar-grid" id="payrollCalendarGrid"></div>
      <div class="payroll-calendar-actions"><button class="btn" type="button" id="payrollCalendarCancel">Cancelar</button><button class="btn btn-primary" type="button" id="payrollCalendarApply">Aplicar</button></div>
    </div>
  </dialog>

  <%- include('partials/operacionesGestionTiempoTabla') %>
  <section class="panel"><h2 style="margin-bottom:10px">Conceptos generados</h2><% const labels={HEDO:'Extra diurna ordinaria',HENO:'Extra nocturna ordinaria',HEDD:'Extra diurna dominical',HEND:'Extra nocturna dominical',HEDF:'Extra diurna festiva',HENF:'Extra nocturna festiva',RNO:'Recargo nocturno ordinario',RDD:'Recargo diurno dominical no compensado',RND:'Recargo nocturno dominical no compensado',RDF:'Recargo diurno festivo',RNF:'Recargo nocturno festivo',RDDC:'Recargo diurno dominical compensado',RNDC:'Recargo nocturno dominical compensado'}; %><div class="codes"><% for(const code of conceptCodes){ %><div class="code"><strong><%= code %></strong><small><%= labels[code] %></small></div><% } %></div></section>
</main>
<script src="/public/lorren-dialog.js"></script>
<script>
(()=>{
  const filterForm=document.getElementById('payroll-filters'),client=document.getElementById('clientId'),operation=document.getElementById('operationPointId'),workerPicker=document.querySelector('.worker-picker');
  const periodType=document.getElementById('periodType'),payrollFrom=document.getElementById('payrollFrom'),payrollTo=document.getElementById('payrollTo'),payrollAnchor=document.getElementById('payrollAnchor'),extraPeriodType=document.getElementById('extraPeriodType'),extraFrom=document.getElementById('extraFrom'),extraTo=document.getElementById('extraTo'),extraAnchor=document.getElementById('extraAnchor'),generalMonth=document.getElementById('generalPayrollMonth'),generalRangeButton=document.getElementById('generalRangeButton'),overtimeRangeButton=document.getElementById('overtimeRangeButton'),generalSecondEnd=document.getElementById('generalSecondEnd');
  const rangeDialog=document.getElementById('payrollRangeDialog'),calendarGrid=document.getElementById('payrollCalendarGrid'),calendarMonthLabel=document.getElementById('payrollCalendarMonth'),calendarPrev=document.getElementById('payrollCalendarPrev'),calendarNext=document.getElementById('payrollCalendarNext'),calendarCancel=document.getElementById('payrollCalendarCancel'),calendarApply=document.getElementById('payrollCalendarApply');
  let generalMode=filterForm?.dataset.initialGeneralMode||'FIRST',overtimeMode=filterForm?.dataset.initialOvertimeMode||'CUSTOM';
  let generalRange={from:payrollFrom?.value||'',to:payrollTo?.value||payrollFrom?.value||''},overtimeRange={from:extraFrom?.value||'',to:extraTo?.value||extraFrom?.value||''};
  let activePicker=null,pendingRange=null,calendarCursor=null,calendarClickPhase=0;
  const validDateKey=(value)=>/^\d{4}-\d{2}-\d{2}$/.test(String(value||''));
  const dateFromKey=(value)=>validDateKey(value)?new Date(`${value}T12:00:00.000Z`):null;
  const keyFromDate=(date)=>date instanceof Date&&!Number.isNaN(date.getTime())?date.toISOString().slice(0,10):'';
  const addDays=(value,days)=>{const date=dateFromKey(value);if(!date)return value;date.setUTCDate(date.getUTCDate()+days);return keyFromDate(date)};
  const mondayFor=(value)=>{const date=dateFromKey(value);if(!date)return value;const day=date.getUTCDay();date.setUTCDate(date.getUTCDate()-((day+6)%7));return keyFromDate(date)};
  const weekFor=(value)=>{const from=mondayFor(value);return{from,to:addDays(from,6)}};
  const monthEnd=(monthValue)=>{const parts=String(monthValue||'').split('-').map(Number);if(parts.length!==2||!parts.every(Number.isFinite))return 31;return new Date(Date.UTC(parts[0],parts[1],0)).getUTCDate()};
  const formatDate=(value)=>{const parts=String(value||'').split('-');return parts.length===3?`${parts[2]}/${parts[1]}/${parts[0]}`:value||'—'};
  const formatRange=(range)=>!range?.from?'—':range.from===range.to?formatDate(range.from):`${formatDate(range.from)} – ${formatDate(range.to)}`;
  const syncOperation=()=>{if(!client||!operation)return;[...operation.options].forEach((option,index)=>{if(index)option.hidden=Boolean(client.value&&option.dataset.client!==client.value)});if(operation.selectedOptions[0]?.hidden)operation.value=''};
  const syncGeneralUi=()=>{document.querySelectorAll('[data-general-mode]').forEach((button)=>button.classList.toggle('is-active',button.dataset.generalMode===generalMode));if(generalRangeButton){generalRangeButton.hidden=generalMode!=='CUSTOM';generalRangeButton.textContent=formatRange(generalRange)};if(generalSecondEnd)generalSecondEnd.textContent=String(monthEnd(generalMonth?.value));if(!periodType)return;if(generalMode==='CUSTOM'){periodType.value='CUSTOM';payrollFrom.value=generalRange.from;payrollTo.value=generalRange.to;payrollAnchor.value=generalRange.from;return}periodType.value='BIWEEKLY';const month=generalMonth?.value||String(generalRange.from||'').slice(0,7);const anchor=`${month}-${generalMode==='FIRST'?'01':'16'}`;payrollAnchor.value=anchor;payrollFrom.value='';payrollTo.value=''};
  const syncOvertimeUi=()=>{document.querySelectorAll('[data-overtime-mode]').forEach((button)=>button.classList.toggle('is-active',button.dataset.overtimeMode===overtimeMode));if(overtimeMode==='WEEKLY')overtimeRange=weekFor(overtimeRange.from||extraAnchor?.value||payrollAnchor?.value);if(overtimeRangeButton)overtimeRangeButton.textContent=formatRange(overtimeRange);if(!extraPeriodType)return;extraPeriodType.value=overtimeMode;if(overtimeMode==='WEEKLY'){extraAnchor.value=overtimeRange.from;extraFrom.value='';extraTo.value=''}else{extraAnchor.value=overtimeRange.from;extraFrom.value=overtimeRange.from;extraTo.value=overtimeRange.to}};
  const renderCalendar=()=>{if(!calendarGrid||!calendarCursor||!pendingRange)return;const year=calendarCursor.getUTCFullYear(),month=calendarCursor.getUTCMonth();calendarMonthLabel.textContent=new Intl.DateTimeFormat('es-CO',{month:'long',year:'numeric',timeZone:'UTC'}).format(calendarCursor);calendarGrid.replaceChildren();const first=new Date(Date.UTC(year,month,1,12));const offset=(first.getUTCDay()+6)%7;const gridStart=new Date(first);gridStart.setUTCDate(first.getUTCDate()-offset);for(let index=0;index<42;index+=1){const date=new Date(gridStart);date.setUTCDate(gridStart.getUTCDate()+index);const key=keyFromDate(date);const button=document.createElement('button');button.type='button';button.className='payroll-calendar-day';button.textContent=String(date.getUTCDate());button.dataset.date=key;if(date.getUTCMonth()!==month)button.classList.add('outside');if(key>=pendingRange.from&&key<=pendingRange.to)button.classList.add('in-range');if(key===pendingRange.from||key===pendingRange.to)button.classList.add('is-edge');button.addEventListener('click',()=>{if(activePicker==='overtime'&&overtimeMode==='WEEKLY'){pendingRange=weekFor(key);calendarClickPhase=0}else if(calendarClickPhase===0){pendingRange={from:key,to:key};calendarClickPhase=1}else{pendingRange=key<pendingRange.from?{from:key,to:pendingRange.from}:{from:pendingRange.from,to:key};calendarClickPhase=0}renderCalendar()});calendarGrid.append(button)}};
  const openRangePicker=(picker)=>{activePicker=picker;const source=picker==='general'?generalRange:overtimeRange;pendingRange={from:source.from,to:source.to};if(!validDateKey(pendingRange.from)){const fallback=payrollAnchor?.value||new Date().toISOString().slice(0,10);pendingRange={from:fallback,to:fallback}}calendarClickPhase=0;const date=dateFromKey(pendingRange.from);calendarCursor=new Date(Date.UTC(date.getUTCFullYear(),date.getUTCMonth(),1,12));renderCalendar();rangeDialog?.showModal()};
  document.querySelectorAll('[data-general-mode]').forEach((button)=>button.addEventListener('click',()=>{generalMode=button.dataset.generalMode;if(generalMode==='CUSTOM'&&!validDateKey(generalRange.from)){const month=generalMonth?.value;generalRange={from:`${month}-01`,to:`${month}-15`}}syncGeneralUi()}));
  document.querySelectorAll('[data-overtime-mode]').forEach((button)=>button.addEventListener('click',()=>{overtimeMode=button.dataset.overtimeMode;syncOvertimeUi()}));
  document.querySelectorAll('[data-range-picker]').forEach((button)=>button.addEventListener('click',()=>openRangePicker(button.dataset.rangePicker)));
  generalMonth?.addEventListener('change',()=>syncGeneralUi());
  calendarPrev?.addEventListener('click',()=>{calendarCursor.setUTCMonth(calendarCursor.getUTCMonth()-1);renderCalendar()});calendarNext?.addEventListener('click',()=>{calendarCursor.setUTCMonth(calendarCursor.getUTCMonth()+1);renderCalendar()});calendarCancel?.addEventListener('click',()=>rangeDialog?.close());calendarApply?.addEventListener('click',()=>{if(!pendingRange)return;if(activePicker==='general'){generalRange={...pendingRange};generalMode='CUSTOM';syncGeneralUi()}else{overtimeRange={...pendingRange};syncOvertimeUi()}rangeDialog?.close()});
  filterForm?.addEventListener('submit',()=>{syncGeneralUi();syncOvertimeUi()});client?.addEventListener('change',syncOperation);document.addEventListener('click',(event)=>{if(workerPicker?.open&&!workerPicker.contains(event.target))workerPicker.open=false});syncGeneralUi();syncOvertimeUi();syncOperation();

  const panel=document.getElementById('payroll-import-panel'),openButton=document.getElementById('open-payroll-import'),closeButton=document.getElementById('close-payroll-import'),fileInput=document.getElementById('payroll-import-file'),previewButton=document.getElementById('payroll-import-preview'),commitButton=document.getElementById('payroll-import-commit'),status=document.getElementById('payroll-import-status'),summary=document.getElementById('payroll-import-summary'),mappingBox=document.getElementById('payroll-import-mapping'),mappingHelp=document.getElementById('payroll-import-mapping-help'),mappingGrid=document.getElementById('payroll-import-mapping-grid'),exceptions=document.getElementById('payroll-import-exceptions'),exceptionsBody=document.getElementById('payroll-import-exceptions-body');
  const mappingLabels={document:'Documento/identificación',name:'Nombre',date:'Fecha de la jornada',datetime:'Fecha y hora de la marcación',time:'Hora de la marcación',event:'Tipo de marcación',operation:'Operación',arrival:'Entrada de jornada',breakStart:'Salida a almuerzo',breakEnd:'Regreso de almuerzo',departure:'Salida de jornada'};
  const includeTest=<%- JSON.stringify(Boolean(role==='dev'&&report.filters.includeTest)) %>;
  let lastPreview=null;
  const text=(value)=>String(value??'');
  const setStatus=(message,isError=false)=>{status.textContent=message||'';status.style.color=isError?'#9f1239':''};
  const currentMapping=()=>Object.fromEntries([...mappingGrid.querySelectorAll('select[data-map-field]')].map((select)=>[select.dataset.mapField,select.value]).filter(([,value])=>value));
  const buildFormData=(includePreview=false)=>{const file=fileInput?.files?.[0];if(!file)throw new Error('Selecciona un archivo Excel o CSV.');const data=new FormData();data.append('file',file);const mapping=currentMapping();if(Object.keys(mapping).length)data.append('mapping',JSON.stringify(mapping));if(includeTest)data.append('includeTest','true');if(includePreview&&lastPreview?.previewFingerprint)data.append('previewFingerprint',lastPreview.previewFingerprint);return data};
  const metric=(label,value)=>{const item=document.createElement('div');item.className='payroll-import-metric';const strong=document.createElement('strong');strong.textContent=text(value);const small=document.createElement('small');small.textContent=label;item.append(strong,small);return item};
  const exceptionStatusLabel=(value)=>({DUPLICATE:'Ya registrada',UNRESOLVED:'Sin conciliar',INVALID:'Inválida'}[value]||value||'—');
  const renderSummary=(data)=>{summary.replaceChildren();const values=data.summary||{};if(data.dateFrom||data.dateTo)summary.append(metric('Fechas detectadas',data.dateFrom===data.dateTo?data.dateFrom:`${data.dateFrom||'—'} → ${data.dateTo||'—'}`));summary.append(metric('Jornadas detectadas',values.parsedWorkdays||0),metric('Listas para importar',values.ready||0),metric('A reemplazar',values.replacements||0),metric('Marcaciones nuevas',values.marksReady||0),metric('Ya registradas',values.duplicates||0),metric('Sin conciliar',values.unresolved||0),metric('Inválidas',values.invalid||0));};
  const renderMapping=(data)=>{mappingGrid.replaceChildren();const headers=Array.isArray(data.headers)?data.headers:[];const fields=Array.isArray(data.mappingFields)&&data.mappingFields.length?data.mappingFields:Object.keys(mappingLabels);if(mappingHelp)mappingHelp.textContent=data.mappingMode==='DAILY'?'Este archivo tiene una fila por jornada. Relaciona únicamente la identificación, la fecha y las marcaciones de entrada, almuerzo y salida.':'Este archivo tiene una fila por marcación. Relaciona únicamente identidad, fecha/hora y tipo de marcación.';fields.forEach((field)=>{const wrap=document.createElement('label');wrap.textContent=mappingLabels[field]||field;const select=document.createElement('select');select.dataset.mapField=field;const empty=document.createElement('option');empty.value='';empty.textContent='— Sin asignar —';select.append(empty);headers.forEach((header,index)=>{const headerText=text(header).trim();if(!headerText)return;const option=document.createElement('option');option.value=`@column:${index}`;option.textContent=`${headerText} · columna ${index+1}`;if(Number.isInteger(data.columns?.[field])&&data.columns[field]===index)option.selected=true;select.append(option)});wrap.append(select);mappingGrid.append(wrap)});mappingBox.hidden=false};
  const renderExceptions=(rows)=>{exceptionsBody.replaceChildren();const source=Array.isArray(rows)?rows:[];exceptions.hidden=!source.length;source.forEach((row)=>{const tr=document.createElement('tr');[row.rowNumber||'—',row.identity||'—',row.dateKey||'—',exceptionStatusLabel(row.status),row.message||'—'].forEach((value)=>{const td=document.createElement('td');td.textContent=text(value);tr.append(td)});exceptionsBody.append(tr)});};
  const preview=async()=>{try{previewButton.disabled=true;commitButton.hidden=true;setStatus('Analizando archivo y conciliando jornadas…');const response=await fetch('/admin/operaciones/asistencia/gestion-tiempo/imports/preview',{method:'POST',body:buildFormData(),headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No fue posible analizar el archivo.');lastPreview=data;renderSummary(data);renderExceptions(data.rows);if(data.needsMapping){renderMapping(data);setStatus(data.message||'Ajusta las columnas y vuelve a analizar.');previewButton.textContent='Volver a analizar';return}mappingBox.hidden=true;commitButton.hidden=!(Number(data.summary?.ready||0)>0);setStatus(`Archivo ${data.format}${data.sheetName?` · hoja ${data.sheetName}`:''} analizado. Revisa el resumen antes de confirmar.`)}catch(error){setStatus(error.message||'No fue posible analizar el archivo.',true)}finally{previewButton.disabled=false}};
  const commit=async()=>{if(!lastPreview||Number(lastPreview.summary?.ready||0)<1)return;const replacements=Number(lastPreview.summary?.replacements||0);const replacementText=replacements?` Se reemplazarán ${replacements} jornada(s) existente(s) con los valores de este archivo.`:'';const approved=await window.LorrenDialog.confirm({title:'Confirmar importación',text:`Se registrarán ${lastPreview.summary.ready} jornada(s) y ${lastPreview.summary.marksReady||0} marcación(es).${replacementText} Las jornadas ya registradas sin cambios y los casos sin conciliar no se tocarán.`,confirmLabel:'Sí, importar',cancelLabel:'Revisar',tone:'warning'});if(!approved)return;try{commitButton.disabled=true;previewButton.disabled=true;setStatus('Importando marcaciones…');const response=await fetch('/admin/operaciones/asistencia/gestion-tiempo/imports/commit',{method:'POST',body:buildFormData(true),headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No fue posible importar.');const replaced=Number(data.summary?.replacedWorkdays||0);setStatus(`Importación registrada: ${data.summary.importedWorkdays} jornada(s), ${data.summary.importedMarks} marcación(es)${replaced?`, ${replaced} reemplazada(s)`:''}.`);window.setTimeout(()=>window.location.reload(),600)}catch(error){setStatus(error.message||'No fue posible importar.',true);commitButton.disabled=false;previewButton.disabled=false}};
  openButton?.addEventListener('click',()=>{panel.hidden=false;panel.scrollIntoView({behavior:'smooth',block:'start'})});closeButton?.addEventListener('click',()=>{panel.hidden=true});previewButton?.addEventListener('click',preview);commitButton?.addEventListener('click',commit);fileInput?.addEventListener('change',()=>{lastPreview=null;commitButton.hidden=true;mappingBox.hidden=true;mappingGrid.replaceChildren();summary.replaceChildren();renderExceptions([]);previewButton.textContent='Analizar archivo';setStatus('')});
  document.querySelectorAll('[data-payroll-import-reverse]').forEach((form)=>form.addEventListener('submit',async(event)=>{event.preventDefault();const approved=await window.LorrenDialog.confirm({title:'Reversar importación',text:'Se eliminarán únicamente las marcaciones que sigan intactas y pertenezcan a este lote. Si una jornada fue modificada después, quedará protegida y no se borrará.',confirmLabel:'Sí, reversar',cancelLabel:'Cancelar',tone:'danger'});if(approved)form.submit()}));
})();
