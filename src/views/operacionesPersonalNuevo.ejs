<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= mode === 'edit' ? 'Editar auxiliar' : 'Crear auxiliar manual' %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .async-toast{position:fixed;right:18px;bottom:18px;max-width:360px;background:#172033;color:#fff;border-radius:14px;padding:11px 13px;box-shadow:var(--shadow);font-size:13px;line-height:1.35;z-index:9999;opacity:0;transform:translateY(8px);transition:opacity .18s,transform .18s;pointer-events:none}.async-toast.show{opacity:1;transform:translateY(0)}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/locations">Sucursales</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Personal operativo</div>
        <h1><%= mode === 'edit' ? 'Editar auxiliar' : 'Crear auxiliar manual' %></h1>
        <p><%= mode === 'edit' ? 'Actualiza los datos operativos y las sucursales habilitadas para este auxiliar.' : 'Registra personal operativo y asígnalo directamente a una o varias sucursales.' %></p>
      </div>
      <div class="actions"><a class="btn" href="/admin/operaciones/personal">Volver a personal</a></div>
    </section>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>

    <section class="card">
      <div class="card-head"><h2>Datos del auxiliar</h2><p>La disponibilidad operativa se define por sucursal. Ya no se asignan vacantes o perfiles al auxiliar.</p></div>
      <div class="card-body">
        <%
          const w = worker || {};
          const botProfile = w.candidate || {};
          const selectedCityIds = new Set((w.cities || []).map((entry) => entry.cityId));
          const normalizedTransportMode = w.transportMode || '';
          const residenceCityNames = new Set(cities.map((city) => city.name));
        %>
        <form id="workerForm" method="post" action="<%= formAction %>" enctype="multipart/form-data">
          <div class="form-grid">
            <div class="field full"><label for="fullName">Nombre completo <span class="muted">* obligatorio</span></label><input id="fullName" name="fullName" required value="<%= w.fullName || '' %>" placeholder="Nombre y apellido" /></div>
            <div class="field"><label for="phone">Teléfono <span class="muted">* obligatorio</span></label><input id="phone" name="phone" required value="<%= w.phone || '' %>" placeholder="Celular" /></div>
            <div class="field"><label for="documentType">Tipo documento <span class="muted">* obligatorio</span></label><input id="documentType" name="documentType" required value="<%= w.documentType || '' %>" placeholder="CC, PPT..." /></div>
            <div class="field"><label for="documentNumber">Número documento <span class="muted">* obligatorio</span></label><input id="documentNumber" name="documentNumber" required value="<%= w.documentNumber || '' %>" /></div>
            <div class="field">
              <label for="residenceCity">Ciudad residencia <span class="muted">* obligatorio</span></label>
              <select id="residenceCity" name="residenceCity" required>
                <option value="" <%= !w.residenceCity ? 'selected' : '' %>>Selecciona una ciudad</option>
                <% if (w.residenceCity && !residenceCityNames.has(w.residenceCity)) { %><option value="<%= w.residenceCity %>" selected><%= w.residenceCity %> (valor actual)</option><% } %>
                <% cities.forEach((city) => { %><option value="<%= city.name %>" <%= w.residenceCity === city.name ? 'selected' : '' %>><%= city.name %></option><% }) %>
              </select>
            </div>
            <div class="field"><label for="residenceLocality">Localidad / barrio <span class="muted">* obligatorio</span></label><input id="residenceLocality" name="residenceLocality" required value="<%= w.residenceLocality || '' %>" /></div>
            <div class="field"><label for="transportMode">Medio de transporte <span class="muted">* opcional</span></label><select id="transportMode" name="transportMode"><option value="" <%= !normalizedTransportMode ? 'selected' : '' %>>Sin dato</option><option value="Publico" <%= normalizedTransportMode === 'Publico' ? 'selected' : '' %>>Publico</option><option value="Moto" <%= normalizedTransportMode === 'Moto' ? 'selected' : '' %>>Moto</option><option value="Bicicleta" <%= normalizedTransportMode === 'Bicicleta' ? 'selected' : '' %>>Bicicleta</option><option value="Carro" <%= normalizedTransportMode === 'Carro' ? 'selected' : '' %>>Carro</option></select><small class="muted">Bus, TransMilenio, SITP y colectivo se agrupan como Publico.</small></div>
            <div class="field"><label for="contractType">Tipo de contrato <span class="muted">* obligatorio</span></label><select id="contractType" name="contractType" required><option value="DIRECTO" <%= !w.contractType || w.contractType === 'DIRECTO' ? 'selected' : '' %>>Directo</option><option value="CONTRATISTA" <%= w.contractType === 'CONTRATISTA' ? 'selected' : '' %>>Contratista</option></select></div>
            <div class="field"><label for="operationalStatus">Estado operativo <span class="muted">* obligatorio</span></label><select id="operationalStatus" name="operationalStatus" required><option value="CONTRATADO" <%= !w.operationalStatus || w.operationalStatus === 'CONTRATADO' || w.operationalStatus === 'ACTIVE' ? 'selected' : '' %>>Contratado / disponible</option><option value="INACTIVE" <%= w.operationalStatus === 'INACTIVE' ? 'selected' : '' %>>Inactivo</option></select></div>
            <div class="field full">
              <label for="cvFile">Hoja de vida <span class="muted">* opcional</span></label>
              <input id="cvFile" name="cvFile" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
              <small class="muted">Formatos permitidos: PDF, DOC o DOCX. Tamaño máximo: 5 MB.</small>
              <% if (w.cvOriginalName) { %><small class="muted">Hoja de vida actual: <strong><%= w.cvOriginalName %></strong>. Si adjuntas otra, se reemplaza.</small><% } %>
            </div>
            <% if (w.candidateId) { %>
              <div class="field full"><div class="section-note"><strong>Datos del panel del bot</strong><br />Estos campos son informativos y se conservan asociados al candidato.</div></div>
              <div class="field"><label for="age">Edad</label><input id="age" name="age" type="number" min="0" value="<%= botProfile.age ?? '' %>" /></div>
              <div class="field"><label for="gender">Género</label><select id="gender" name="gender"><option value="UNKNOWN" <%= !botProfile.gender || botProfile.gender === 'UNKNOWN' ? 'selected' : '' %>>Sin definir</option><option value="FEMALE" <%= botProfile.gender === 'FEMALE' ? 'selected' : '' %>>Mujer</option><option value="MALE" <%= botProfile.gender === 'MALE' ? 'selected' : '' %>>Hombre</option><option value="OTHER" <%= botProfile.gender === 'OTHER' ? 'selected' : '' %>>Otro</option></select></div>
              <div class="field full"><label for="medicalRestrictions">Restricciones médicas</label><input id="medicalRestrictions" name="medicalRestrictions" value="<%= botProfile.medicalRestrictions || '' %>" /></div>
              <div class="field"><label for="experienceInfo">Experiencia</label><select id="experienceInfo" name="experienceInfo"><option value="" <%= !botProfile.experienceInfo ? 'selected' : '' %>>Sin definir</option><option value="Sí" <%= botProfile.experienceInfo === 'Sí' ? 'selected' : '' %>>Sí</option><option value="No" <%= botProfile.experienceInfo === 'No' ? 'selected' : '' %>>No</option></select></div>
              <div class="field"><label for="experienceTime">Tiempo de experiencia</label><input id="experienceTime" name="experienceTime" value="<%= botProfile.experienceTime || '' %>" /></div>
              <div class="field full"><label for="experienceSummary">Contexto de experiencia</label><textarea id="experienceSummary" name="experienceSummary"><%= botProfile.experienceSummary || '' %></textarea></div>
            <% } %>
            <div class="field full"><label for="notes">Notas operativas <span class="muted">* opcional</span></label><textarea id="notes" name="notes" placeholder="Disponibilidad, restricciones o comentarios"><%= w.notes || '' %></textarea></div>
            <div class="field full">
              <label for="cityIds">Sucursales habilitadas <span class="muted">* obligatorio</span></label>
              <select id="cityIds" name="cityIds" multiple size="7" required>
                <% cities.forEach((c)=>{ %><option value="<%= c.id %>" <%= selectedCityIds.has(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
              </select>
              <small class="muted">Selecciona únicamente las sucursales donde el auxiliar puede ser despachado. Siberia se gestiona dentro de Bogotá.</small>
            </div>
          </div>
          <div class="section-note" style="margin-top:14px;"><strong>Autoridad operativa:</strong> la sucursal es la única asignación territorial del auxiliar. Las vacantes pertenecen al flujo de reclutamiento y no se eligen aquí.</div>
          <div class="form-actions"><button class="btn btn-primary" type="submit"><%= mode === 'edit' ? 'Guardar auxiliar' : 'Crear auxiliar' %></button><a class="btn" href="/admin/operaciones/personal">Cancelar</a></div>
        </form>
      </div>
    </section>
  </main>

  <div id="asyncToast" class="async-toast" role="status" aria-live="polite"></div>
  <% if (mode === 'create') { %>
    <script>
      (() => {
        const form = document.getElementById('workerForm');
        const documentInput = document.getElementById('documentNumber');
        const submitButton = form?.querySelector('button[type="submit"]');
        const toast = document.getElementById('asyncToast');
        if (!form || !documentInput || !toast) return;

        let checkSequence = 0;
        let toastTimer = null;

        function showToast(message) {
          toast.textContent = message;
          toast.classList.add('show');
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3200);
        }

        async function checkDocument({ announce = false } = {}) {
          const documentNumber = documentInput.value.trim();
          if (!documentNumber) return false;
          const sequence = ++checkSequence;
          const body = new URLSearchParams({ documentNumber });
          const response = await fetch('/operaciones/admin-worker/documento-existe', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
              'X-Requested-With': 'fetch'
            },
            body
          });
          if (!response.ok) throw new Error('document_check_failed');
          const result = await response.json();
          if (sequence !== checkSequence) return false;
          const exists = Boolean(result?.exists);
          if (exists) {
            documentInput.setAttribute('aria-invalid', 'true');
            if (announce) showToast('Este número de documento ya está registrado.');
          } else {
            documentInput.removeAttribute('aria-invalid');
          }
          return exists;
        }

        documentInput.addEventListener('input', () => {
          checkSequence += 1;
          documentInput.removeAttribute('aria-invalid');
        });

        documentInput.addEventListener('blur', () => {
          void checkDocument({ announce: true }).catch(() => {});
        });

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (submitButton) submitButton.disabled = true;
          try {
            const exists = await checkDocument({ announce: true });
            if (exists) {
              documentInput.focus();
              return;
            }
            HTMLFormElement.prototype.submit.call(form);
          } catch (_error) {
            HTMLFormElement.prototype.submit.call(form);
          } finally {
            if (submitButton) submitButton.disabled = false;
          }
        });
      })();
    </script>
  <% } %>
</body>
</html>