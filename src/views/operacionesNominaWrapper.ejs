<!DOCTYPE html>
<html lang="es-CO"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title><%= pageTitle %> — LoginPro</title><link rel="icon" type="image/png" href="/public/favicon-loginpro.svg"/><link rel="stylesheet" href="/public/operaciones-nomina.css"/></head><body>
<nav class="navbar"><a href="/admin" class="brand"><img src="/public/loginpro.png" alt="LoginPro"/></a><a href="/admin">Panel</a><a href="/admin/operaciones">Operaciones / Despacho</a><a href="/admin/operaciones/asistencia">Asistencia</a><a href="/admin/operaciones/asistencia/nomina" class="active">Nómina</a><span class="spacer"></span><a href="/logout">Cerrar sesión</a></nav>
<main class="page"><% const selectedWorkerIds=String(report.filters.workerId||'').split(',').map(v=>v.trim()).filter(Boolean); %>
<header class="header"><div><h1><%= pageTitle %></h1><p class="sub">Corte <%= report.period.from||'—' %> a <%= report.period.to||'—' %></p></div><div class="actions"><a class="btn" href="/admin/operaciones/asistencia">Asistencia</a><a class="btn btn-blue" href="/admin/operaciones/asistencia/nomina/export.csv?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">CSV</a><a class="btn btn-primary" href="/admin/operaciones/asistencia/nomina/export.xlsx?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">Excel</a></div></header>
<% if(success){ %><div class="alert alert-success"><%= success %></div><% } %><% if(error){ %><div class="alert alert-error"><%= error %></div><% } %><% if(role==='dev'&&report.filters.includeTest){ %><div class="test-mode"><span>Modo DEV activo: este cálculo incluye jornadas y sujetos de prueba.</span><div class="actions"><a class="btn" href="/admin/operaciones/pruebas">Volver al entorno de pruebas</a><a class="btn" href="/admin/operaciones/asistencia/nomina">Salir del modo de pruebas</a></div></div><% } %>
<section class="panel"><form method="get" action="/admin/operaciones/asistencia/nomina" class="filters" id="payroll-filters"><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %><div class="field"><label for="periodType">Tipo de corte</label><select id="periodType" name="periodType"><option value="WEEKLY" <%= report.period.periodType==='WEEKLY'?'selected':'' %>>Semanal</option><option value="BIWEEKLY" <%= report.period.periodType==='BIWEEKLY'?'selected':'' %>>Quincenal</option><option value="CUSTOM" <%= report.period.periodType==='CUSTOM'?'selected':'' %>>Personalizado</option></select></div>
<% const picker=(name,label,value,extra='')=>{ %><div class="field date-picker <%= extra %>" <%= name==='anchor'?'id="anchorDateField"':'' %> data-payroll-date-picker><label><%= label %></label><input id="<%= name %>" name="<%= name %>" type="hidden" value="<%= value||'' %>" data-date-value/><button class="date-picker-trigger" type="button" data-date-trigger aria-expanded="false"></button><div class="date-popover" data-date-popover><div class="date-calendar-head"><button class="date-nav" type="button" data-date-prev>‹</button><strong data-date-title></strong><button class="date-nav" type="button" data-date-next>›</button></div><div class="date-weekdays"><span class="date-weekday">Lun</span><span class="date-weekday">Mar</span><span class="date-weekday">Mié</span><span class="date-weekday">Jue</span><span class="date-weekday">Vie</span><span class="date-weekday">Sáb</span><span class="date-weekday">Dom</span></div><div class="date-days" data-date-days></div></div></div><% }; picker('anchor','Fecha de referencia',report.period.anchor||report.period.from);picker('from','Desde',report.period.from,'custom-date');picker('to','Hasta',report.period.to,'custom-date'); %>
<div class="field"><label for="clientId">Cliente</label><select id="clientId" name="clientId"><option value="">Todos</option><% for(const client of report.clients){ %><option value="<%= client.id %>" <%= report.filters.clientId===client.id?'selected':'' %>><%= client.name %></option><% } %></select></div><div class="field"><label for="operationPointId">Operación</label><select id="operationPointId" name="operationPointId"><option value="">Todas</option><% for(const client of report.clients){for(const point of client.operationPoints||[]){ %><option data-client="<%= client.id %>" value="<%= point.id %>" <%= report.filters.operationPointId===point.id?'selected':'' %>><%= client.name %> · <%= point.name %></option><% }} %></select></div><div class="field"><label for="workerId">Auxiliares</label><select id="workerId" name="workerId" multiple size="3"><% for(const worker of report.workers){ %><option value="<%= worker.id %>" <%= selectedWorkerIds.includes(worker.id)?'selected':'' %>><%= worker.fullName %><%= worker.documentNumber?` · ${worker.documentNumber}`:'' %></option><% } %></select><div class="field-hint">Solo aparecen auxiliares con información en este corte. Puedes seleccionar varios; sin selección se analizan todos.</div></div><div class="field"><label for="search">Buscar</label><input id="search" name="search" value="<%= report.filters.search %>" placeholder="Nombre, documento o teléfono"/></div><div class="field"><button class="btn btn-primary">Calcular periodo</button></div></form></section>
<section class="metrics"><article class="metric"><small>Auxiliares</small><strong><%= report.totals.workers %></strong></article><article class="metric"><small>Días trabajados</small><strong><%= report.totals.workedDays||0 %></strong></article><article class="metric deduction"><small>Días descontados</small><strong><%= report.totals.deductedDays||0 %></strong></article><article class="metric"><small>Días laborados netos</small><strong><%= report.totals.netWorkedDays||0 %></strong></article><article class="metric"><small>Total trabajado</small><strong><%= formatPayrollMinutes(report.totals.totalMinutes) %></strong></article><article class="metric"><small>Horas ordinarias</small><strong><%= report.totals.ordinaryHours||0 %></strong></article><article class="metric"><small>Horas extra</small><strong><%= report.totals.overtimeHours||0 %></strong></article><article class="metric <%= report.totals.workersWithNovelties?'warn':'' %>"><small>Con novedades</small><strong><%= report.totals.workersWithNovelties %></strong></article></section>
<% if(role==='dev'){ %><section class="panel"><div class="policy-head"><div><h2>Política de jornada</h2><p class="sub">Máximo ordinario: 42 h semanales y 7 h diarias. La configuración queda auditada por cliente.</p></div></div><form method="post" action="/admin/operaciones/asistencia/nomina/policy"><input type="hidden" name="periodType" value="<%= report.period.periodType %>"/><input type="hidden" name="from" value="<%= report.period.from %>"/><input type="hidden" name="to" value="<%= report.period.to %>"/><input type="hidden" name="anchor" value="<%= report.period.anchor %>"/><input type="hidden" name="filterWorkerId" value="<%= report.filters.workerId||'' %>"/><% if(report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %><div class="policy-grid"><div class="field"><label>Cliente</label><select name="clientId" required><option value="">Selecciona</option><% for(const client of report.clients){ %><option value="<%= client.id %>" <%= report.filters.clientId===client.id?'selected':'' %>><%= client.name %></option><% } %></select></div><div class="field"><label>Horas ordinarias semanales</label><input name="weeklyOrdinaryHours" type="number" min="1" max="42" step=".25" value="<%= selectedPolicy.weeklyOrdinaryMinutes/60 %>" required/></div><div class="field"><label>Horas ordinarias diarias</label><input name="dailyOrdinaryHours" type="number" min="1" max="7" step=".25" value="<%= selectedPolicy.dailyOrdinaryMinutes/60 %>" required/></div><div class="field"><label>Máximo extra diario</label><input name="maxDailyOvertimeHours" type="number" min="0" max="12" step=".25" value="<%= selectedPolicy.maxDailyOvertimeMinutes/60 %>" required/></div><div class="field"><label>Máximo extra semanal</label><input name="maxWeeklyOvertimeHours" type="number" min="0" max="168" step=".25" value="<%= selectedPolicy.maxWeeklyOvertimeMinutes/60 %>" required/></div><div class="field"><label>Inicio nocturno</label><select name="nightStartHour"><% for(let h=0;h<24;h++){ %><option value="<%= h %>" <%= selectedPolicy.nightStartMinute===h*60?'selected':'' %>><%= String(h).padStart(2,'0') %>:00</option><% } %></select></div><div class="field"><label>Fin nocturno</label><select name="nightEndHour"><% for(let h=0;h<24;h++){ %><option value="<%= h %>" <%= selectedPolicy.nightEndMinute===h*60?'selected':'' %>><%= String(h).padStart(2,'0') %>:00</option><% } %></select></div><div class="field"><label>Día de descanso</label><select name="restDay"><% ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'].forEach((d,i)=>{ %><option value="<%= i %>" <%= selectedPolicy.restDay===i?'selected':'' %>><%= d %></option><% }) %></select></div><div class="field"><label>Descuento almuerzo abierto</label><input name="incompleteBreakPenaltyMinutes" type="number" min="0" max="480" value="<%= selectedPolicy.incompleteBreakPenaltyMinutes %>" required/></div><div class="field"><label>Reconocer llegada anticipada</label><select name="recognizeEarlyArrival"><option value="false" <%= !selectedPolicy.recognizeEarlyArrival?'selected':'' %>>No</option><option value="true" <%= selectedPolicy.recognizeEarlyArrival?'selected':'' %>>Sí</option></select></div><div class="field"><button class="btn btn-primary">Guardar política</button></div></div></form></section><% } %>
<%- include('partials/operacionesNominaTabla') %>
<section class="panel"><h2 style="margin-bottom:10px">Conceptos generados</h2><% const labels={HEDO:'Extra diurna ordinaria',HENO:'Extra nocturna ordinaria',HEDD:'Extra diurna dominical',HEND:'Extra nocturna dominical',HEDF:'Extra diurna festiva',HENF:'Extra nocturna festiva',RNO:'Recargo nocturno ordinario',RDD:'Recargo diurno dominical no compensado',RND:'Recargo nocturno dominical no compensado',RDF:'Recargo diurno festivo',RNF:'Recargo nocturno festivo',RDDC:'Recargo diurno dominical compensado',RNDC:'Recargo nocturno dominical compensado'}; %><div class="codes"><% for(const code of conceptCodes){ %><div class="code"><strong><%= code %></strong><small><%= labels[code] %></small></div><% } %></div></section></main>
<script src="/public/operaciones-nomina.js"></script></body></html>