<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Solicitud de servicio — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .shift-list{display:grid;gap:10px}.shift-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr auto;gap:10px;align-items:end;border:1px solid var(--border);border-radius:12px;padding:12px;background:var(--surface-2)}.shift-remove{border:1px solid var(--border);background:#fff;border-radius:999px;padding:9px 12px;font-weight:900;cursor:pointer}.shift-summary{font-size:12px;color:var(--muted);margin-top:8px}.field-tag{font-size:11px;font-weight:900;margin-left:5px}.field-tag.required{color:var(--red,#dc2626)}.field-tag.optional{color:var(--muted)}.week-repeat{grid-column:1/-1;border:1px dashed var(--border);border-radius:12px;background:#fff;padding:10px}.week-repeat-toggle{display:flex;align-items:center;gap:8px;color:var(--navy);font-size:13px;font-weight:900}.week-repeat-toggle input{width:16px;height:16px;accent-color:var(--teal)}.week-days{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.week-day-option{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);background:var(--surface-2);border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;color:var(--navy)}.week-day-option input{width:14px;height:14px;accent-color:var(--teal)}.week-day-option.is-disabled{opacity:.45;cursor:not-allowed}.week-repeat-help{color:var(--muted);font-size:12px;margin-top:7px;line-height:1.45}.success-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.success-note{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.5}.history-section{margin-top:20px;border-top:1px solid var(--border);padding-top:18px}.history-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:12px}.history-head h2{color:var(--navy);font-size:18px;margin:0}.history-head p{color:var(--muted);font-size:13px;margin:3px 0 0}.history-list{display:grid;gap:10px}.history-card{border:1px solid var(--border);background:#fff;border-radius:14px;padding:13px;box-shadow:var(--shadow-sm)}.history-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.history-card strong{color:var(--navy);font-size:14px}.history-meta{display:grid;gap:3px;color:var(--muted);font-size:12px;margin-top:5px}.history-schedules{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.history-chip{border-radius:999px;background:var(--surface-2);border:1px solid var(--border);padding:4px 8px;font-size:11px;color:var(--navy);font-weight:800}.history-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.history-status{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900;background:var(--blue-soft);color:var(--blue);white-space:nowrap}.history-status.locked{background:#fffbeb;color:#92400e}.empty-history{border:1px dashed var(--border);border-radius:14px;padding:16px;color:var(--muted);font-size:13px;background:var(--surface-2)}@media(max-width:720px){.shift-row{grid-template-columns:1fr}.success-actions .btn,.history-actions .btn{width:100%;justify-content:center}.history-head,.history-top{display:grid}}
  </style>
</head>
<body>
  <% const requestHistorySafe = Array.isArray(typeof requestHistory !== 'undefined' ? requestHistory : []) ? requestHistory : []; %>
  <% const formatDate = (value) => value ? new Date(value).toISOString().slice(0,10) : '-'; %>
  <% const formatDateTime = (value) => value ? new Intl.DateTimeFormat('es-CO', { timeZone: 'America/Bogota', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date(value)) : '-'; %>
  <% const schedule = (item) => `${formatDate(item.serviceDate)} · ${item.endTime ? `${item.startTime || '-'} - ${item.endTime}` : `${item.startTime || '-'}`}`; %>
  <main class="public-shell">
    <section class="public-card">
      <div class="public-head">
        <img src="/public/logo-loginpro.svg" alt="LoginPro" />
        <% if (success) { %>
          <h1>Solicitud registrada</h1>
          <p>Tu solicitud fue enviada correctamente al equipo de Operaciones / Despacho.</p>
        <% } else { %>
          <h1>Solicitud de servicio</h1>
          <p>Completa los datos y revisa el historial de solicitudes realizadas.</p>
        <% } %>
      </div>

      <div class="public-body">
        <% if (success) { %>
          <div class="success-box">Solicitud registrada correctamente para <strong><%= operationPoint.name %></strong><% if (service) { %> en el servicio <strong><%= service.name %></strong><% } %>. <%= typeof createdSummary !== 'undefined' && createdSummary ? createdSummary + '. ' : '' %>El equipo operativo revisará la asignación.</div>
          <% if (typeof requestViewUrl !== 'undefined' && requestViewUrl) { %>
            <div class="success-actions">
              <a class="btn btn-primary" href="<%= requestViewUrl %>">Ver solicitud</a>
              <a class="btn" href="<%= requestViewUrl %>/editar">Editar solicitud</a>
              <button class="btn" type="button" onclick="window.print()">Guardar / imprimir comprobante</button>
            </div>
            <p class="success-note">Podrás editarla solo mientras Operaciones no haya iniciado la asignación y mientras no haya pasado la fecha y hora de inicio del servicio.</p>
          <% } %>
          <div class="success-actions"><a class="btn" href="/operaciones/cliente/<%= client.publicToken %>">Crear otra solicitud</a></div>
        <% } else { %>
          <div class="card" style="box-shadow:none;margin-bottom:18px;">
            <div class="card-body">
              <div class="eyebrow">Cliente</div>
              <h2 style="color:var(--navy);margin-bottom:6px;"><%= client.name %></h2>
              <p class="muted">Selecciona la operación y el servicio donde se requiere el personal.</p>
            </div>
          </div>

          <% if (!operationPoints.length || !services.length) { %>
            <div class="section-note">Este cliente debe tener operaciones y servicios activos configurados antes de crear solicitudes.</div>
          <% } %>

          <form method="post" id="publicServiceRequestForm">
            <div class="form-grid">
              <div class="field full">
                <label for="operationPointId">Operación / punto de servicio <span class="field-tag required">* campo obligatorio</span></label>
                <select id="operationPointId" name="operationPointId" required <%= operationPoints.length ? '' : 'disabled' %>>
                  <option value="">Selecciona una operación</option>
                  <% operationPoints.forEach((op)=>{ %>
                    <option value="<%= op.id %>" <%= operationPoints.length === 1 ? 'selected' : '' %>><%= op.name %><% if (op.cityName) { %> — <%= op.cityName %><% } %><% if (op.address) { %> · <%= op.address %><% } %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field full">
                <label for="serviceId">Servicio solicitado <span class="field-tag required">* campo obligatorio</span></label>
                <select id="serviceId" name="serviceId" required <%= services.length ? '' : 'disabled' %>>
                  <option value=""><%= services.length ? 'Selecciona un servicio' : 'Sin servicios configurados para este cliente' %></option>
                  <% services.forEach((item)=>{ %>
                    <option value="<%= item.id %>" <%= services.length === 1 ? 'selected' : '' %>><%= item.name %><% if (item.description) { %> — <%= item.description %><% } %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field full"><label for="requestedByName">Nombre de quien solicita <span class="field-tag required">* campo obligatorio</span></label><input id="requestedByName" name="requestedByName" required placeholder="Nombre completo" /></div>
              <div class="field"><label for="requestedByPhone">Teléfono <span class="field-tag required">* campo obligatorio</span></label><input id="requestedByPhone" name="requestedByPhone" required placeholder="Número de contacto" /></div>
              <div class="field"><label for="requestedByEmail">Correo <span class="field-tag required">* campo obligatorio</span></label><input id="requestedByEmail" name="requestedByEmail" type="email" required placeholder="correo@empresa.com" /></div>
              <div class="field full">
                <label>Días, horarios y auxiliares requeridos</label>
                <div class="shift-list" id="shiftList">
                  <div class="shift-row">
                    <div class="field"><label>Fecha base <span class="field-tag required">* campo obligatorio</span></label><input type="date" name="serviceDateBlock" required /></div>
                    <div class="field"><label>Cantidad <span class="field-tag required">* campo obligatorio</span></label><input type="number" min="1" name="requiredWorkers" required value="1" /></div>
                    <div class="field"><label>Hora inicio <span class="field-tag required">* campo obligatorio</span></label><input id="startTime" type="time" name="startTime" required /></div>
                    <div class="field"><label>Hora fin <span class="field-tag optional">* campo opcional</span></label><input id="endTime" type="time" name="endTime" /></div>
                    <button class="shift-remove" type="button" hidden>Quitar</button>
                    <div class="week-repeat">
                      <label class="week-repeat-toggle"><input type="checkbox" data-week-repeat-toggle /> Repetir este mismo horario en otros días de esta semana</label>
                      <div class="week-days" data-week-repeat-days hidden></div>
                      <p class="week-repeat-help">Selecciona días adicionales de la semana actual. Se usará la misma cantidad de auxiliares y el mismo horario de este bloque.</p>
                    </div>
                  </div>
                </div>
                <p class="shift-summary">Primero define la fecha base, cantidad y horario. Si aplica también a otros días de esta misma semana, marca el check y selecciona los días. Para horarios diferentes usa el botón normal de agregar otro horario.</p>
                <button class="btn" type="button" id="addShiftBtn">Agregar otro horario</button>
              </div>
              <div class="field full"><label for="notes">Observaciones <span class="field-tag optional">* campo opcional</span></label><textarea id="notes" name="notes" placeholder="Describe condiciones, requisitos de ingreso o detalles del servicio"></textarea></div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit" <%= operationPoints.length && services.length ? '' : 'disabled' %>>Enviar solicitud</button></div>
          </form>
        <% } %>

        <section class="history-section">
          <div class="history-head">
            <div><h2>Historial de solicitudes</h2><p>Consulta o edita solicitudes anteriores, siempre que todavía no tengan asignación y no haya iniciado el servicio.</p></div>
            <span class="history-status"><%= requestHistorySafe.length %> registradas</span>
          </div>
          <% if (!requestHistorySafe.length) { %>
            <div class="empty-history">Aún no hay solicitudes registradas para este cliente.</div>
          <% } else { %>
            <div class="history-list">
              <% requestHistorySafe.forEach((item) => { %>
                <article class="history-card">
                  <div class="history-top">
                    <div>
                      <strong><%= item.operationPointName %><% if (item.isGrouped) { %> · Solicitud agrupada<% } %></strong>
                      <div class="history-meta">
                        <span>Servicio: <%= item.serviceName %></span>
                        <span>Total auxiliares: <%= item.totalRequired %></span>
                        <span>Asignados activos: <%= item.activeCount %> · Confirmados: <%= item.confirmedCount %></span>
                        <span>Creada: <%= formatDateTime(item.createdAt || item.primary.createdAt) %></span>
                      </div>
                    </div>
                    <span class="history-status <%= item.editable ? '' : 'locked' %>"><%= item.editable ? 'Editable' : 'Solo lectura' %></span>
                  </div>
                  <div class="history-schedules">
                    <% item.requests.forEach((request) => { %><span class="history-chip"><%= schedule(request) %> · <%= request.requiredWorkers %> aux.</span><% }) %>
                  </div>
                  <div class="history-actions">
                    <a class="btn btn-primary" href="<%= item.viewUrl %>">Ver</a>
                    <% if (item.editable) { %><a class="btn" href="<%= item.editUrl %>">Editar</a><% } %>
                    <button class="btn" type="button" onclick="window.open('<%= item.viewUrl %>', '_blank')">Abrir aparte</button>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </div>
    </section>
  </main>
  <script>
    const shiftList = document.getElementById('shiftList');
    const addShiftBtn = document.getElementById('addShiftBtn');
    function refreshRemoveButtons(){
      const rows = Array.from(shiftList?.querySelectorAll('.shift-row') || []);
      rows.forEach((row) => { const button = row.querySelector('.shift-remove'); if (button) button.hidden = rows.length === 1; });
    }
    addShiftBtn?.addEventListener('click', () => {
      const first = shiftList.querySelector('.shift-row');
      const clone = first.cloneNode(true);
      clone.querySelectorAll('input').forEach((input) => { input.value = input.type === 'number' ? '1' : ''; if (input.type === 'checkbox') input.checked = false; });
      const box = clone.querySelector('[data-week-repeat-days]');
      if (box) { box.hidden = true; box.innerHTML = ''; }
      clone.querySelector('.shift-remove')?.addEventListener('click', () => { clone.remove(); refreshRemoveButtons(); });
      shiftList.appendChild(clone);
      refreshRemoveButtons();
    });
    shiftList?.querySelector('.shift-remove')?.addEventListener('click', (event) => { event.currentTarget.closest('.shift-row')?.remove(); refreshRemoveButtons(); });
    refreshRemoveButtons();
  </script>
  <script src="/public/public-request-week-repeat.js"></script>
</body>
</html>