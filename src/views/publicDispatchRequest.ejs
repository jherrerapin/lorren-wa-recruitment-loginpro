<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Solicitud de servicio — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .shift-list{display:grid;gap:10px}.shift-row{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end;border:1px solid var(--border);border-radius:12px;padding:12px;background:var(--surface-2)}.shift-remove{border:1px solid var(--border);background:#fff;border-radius:999px;padding:9px 12px;font-weight:900;cursor:pointer}.shift-summary{font-size:12px;color:var(--muted);margin-top:8px}.field-tag{font-size:11px;font-weight:900;margin-left:5px}.field-tag.required{color:var(--red,#dc2626)}.field-tag.optional{color:var(--muted)}.success-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.success-note{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.5}@media(max-width:720px){.shift-row{grid-template-columns:1fr}.success-actions .btn{width:100%;justify-content:center}}
  </style>
</head>
<body>
  <main class="public-shell">
    <section class="public-card">
      <div class="public-head">
        <img src="/public/logo-loginpro.svg" alt="LoginPro" />
        <% if (success) { %>
          <h1>Solicitud registrada</h1>
          <p>Tu solicitud fue enviada correctamente al equipo de Operaciones / Despacho.</p>
        <% } else { %>
          <h1>Solicitud de servicio</h1>
          <p>Completa los datos y selecciona la operación para solicitar personal operativo.</p>
        <% } %>
      </div>

      <div class="public-body">
        <% if (success) { %>
          <div class="success-box">Solicitud registrada correctamente para <strong><%= operationPoint.name %></strong><% if (service) { %> en el servicio <strong><%= service.name %></strong><% } %>. <%= typeof createdSummary !== 'undefined' && createdSummary ? createdSummary + '. ' : '' %>El equipo operativo revisará la asignación.</div>
          <% if (typeof requestViewUrl !== 'undefined' && requestViewUrl) { %>
            <div class="success-actions">
              <a class="btn btn-primary" href="<%= requestViewUrl %>">Ver solicitud</a>
              <a class="btn" href="<%= requestViewUrl %>/editar">Editar solicitud</a>
              <button class="btn" type="button" onclick="window.print()">Guardar / imprimir comprobante</button>
            </div>
            <p class="success-note">Podrás editarla solo mientras Operaciones no haya iniciado la asignación y mientras no haya pasado la fecha y hora de inicio del servicio.</p>
          <% } %>
        <% } else { %>
          <div class="card" style="box-shadow:none;margin-bottom:18px;">
            <div class="card-body">
              <div class="eyebrow">Cliente</div>
              <h2 style="color:var(--navy);margin-bottom:6px;"><%= client.name %></h2>
              <p class="muted">Selecciona la operación y el servicio donde se requiere el personal.</p>
            </div>
          </div>

          <% if (!operationPoints.length || !services.length) { %>
            <div class="section-note">Este cliente debe tener operaciones y servicios activos configurados antes de crear solicitudes.</div>
          <% } %>

          <form method="post">
            <div class="form-grid">
              <div class="field full">
                <label for="operationPointId">Operación / punto de servicio <span class="field-tag required">* campo obligatorio</span></label>
                <select id="operationPointId" name="operationPointId" required <%= operationPoints.length ? '' : 'disabled' %>>
                  <option value="">Selecciona una operación</option>
                  <% operationPoints.forEach((op)=>{ %>
                    <option value="<%= op.id %>" <%= operationPoints.length === 1 ? 'selected' : '' %>><%= op.name %><% if (op.cityName) { %> — <%= op.cityName %><% } %><% if (op.address) { %> · <%= op.address %><% } %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field full">
                <label for="serviceId">Servicio solicitado <span class="field-tag required">* campo obligatorio</span></label>
                <select id="serviceId" name="serviceId" required <%= services.length ? '' : 'disabled' %>>
                  <option value=""><%= services.length ? 'Selecciona un servicio' : 'Sin servicios configurados para este cliente' %></option>
                  <% services.forEach((item)=>{ %>
                    <option value="<%= item.id %>" <%= services.length === 1 ? 'selected' : '' %>><%= item.name %><% if (item.description) { %> — <%= item.description %><% } %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field full"><label for="requestedByName">Nombre de quien solicita <span class="field-tag required">* campo obligatorio</span></label><input id="requestedByName" name="requestedByName" required placeholder="Nombre completo" /></div>
              <div class="field"><label for="requestedByPhone">Teléfono <span class="field-tag required">* campo obligatorio</span></label><input id="requestedByPhone" name="requestedByPhone" required placeholder="Número de contacto" /></div>
              <div class="field"><label for="requestedByEmail">Correo <span class="field-tag required">* campo obligatorio</span></label><input id="requestedByEmail" name="requestedByEmail" type="email" required placeholder="correo@empresa.com" /></div>
              <div class="field"><label for="serviceDate">Fecha del servicio <span class="field-tag required">* campo obligatorio</span></label><input id="serviceDate" type="date" name="serviceDate" required /></div>
              <div class="field full">
                <label>Horarios y auxiliares requeridos</label>
                <div class="shift-list" id="shiftList">
                  <div class="shift-row">
                    <div class="field"><label>Cantidad <span class="field-tag required">* campo obligatorio</span></label><input type="number" min="1" name="requiredWorkers" required value="1" /></div>
                    <div class="field"><label>Hora inicio <span class="field-tag required">* campo obligatorio</span></label><input type="time" name="startTime" required /></div>
                    <div class="field"><label>Hora fin <span class="field-tag optional">* campo opcional</span></label><input type="time" name="endTime" /></div>
                    <button class="shift-remove" type="button" hidden>Quitar</button>
                  </div>
                </div>
                <p class="shift-summary">Si el mismo día necesitas personal en horarios distintos, agrega un bloque por cada horario. Ejemplo: 3 auxiliares desde las 6:00 y 2 auxiliares desde las 14:00. La hora de finalización es opcional y no se enviará en los mensajes de asignación.</p>
                <button class="btn" type="button" id="addShiftBtn">Agregar otro horario</button>
              </div>
              <div class="field full"><label for="notes">Observaciones <span class="field-tag optional">* campo opcional</span></label><textarea id="notes" name="notes" placeholder="Describe condiciones, requisitos de ingreso o detalles del servicio"></textarea></div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit" <%= operationPoints.length && services.length ? '' : 'disabled' %>>Enviar solicitud</button></div>
          </form>
        <% } %>
      </div>
    </section>
  </main>
  <script>
    const shiftList = document.getElementById('shiftList');
    const addShiftBtn = document.getElementById('addShiftBtn');
    function refreshRemoveButtons(){
      const rows = Array.from(shiftList?.querySelectorAll('.shift-row') || []);
      rows.forEach((row) => { const button = row.querySelector('.shift-remove'); if (button) button.hidden = rows.length === 1; });
    }
    addShiftBtn?.addEventListener('click', () => {
      const first = shiftList.querySelector('.shift-row');
      const clone = first.cloneNode(true);
      clone.querySelectorAll('input').forEach((input) => { input.value = input.type === 'number' ? '1' : ''; });
      clone.querySelector('.shift-remove')?.addEventListener('click', () => { clone.remove(); refreshRemoveButtons(); });
      shiftList.appendChild(clone);
      refreshRemoveButtons();
    });
    shiftList?.querySelector('.shift-remove')?.addEventListener('click', (event) => { event.currentTarget.closest('.shift-row')?.remove(); refreshRemoveButtons(); });
    refreshRemoveButtons();
  </script>
</body>
</html>