<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Clientes — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    select.has-selection { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13, 122, 107, .12); background: #f0fdfa; }
    .inline-list { display:flex; flex-direction:column; gap:10px; }
    .inline-list-row { display:flex; gap:10px; align-items:center; }
    .inline-list-row input { flex:1; }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Gestión comercial operativa</div>
        <h1>Clientes</h1>
        <p>Gestiona clientes, operaciones, estadísticas y links públicos de solicitud. La ciudad principal del cliente se toma del catálogo central.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones">Volver a Operaciones</a>
        <a class="btn" href="/admin/locations">Configurar ciudades</a>
        <a class="btn btn-primary" href="/admin/operaciones/solicitudes">Solicitudes de servicio</a>
      </div>
    </section>

    <% if (message) { %><div class="alert"><%= message %></div><% } %>
    <% const safeEditClient = typeof editClient !== 'undefined' ? editClient : null; const formClient = safeEditClient || {}; const isEditingClient = Boolean(safeEditClient); %>

    <section class="card">
      <div class="card-head"><h2><%= isEditingClient ? 'Editar cliente' : 'Crear cliente' %></h2><p><%= isEditingClient ? 'Actualiza ciudad, datos comerciales, contacto y estado del cliente.' : 'Registra la empresa que solicitará servicios operativos.' %></p></div>
      <div class="card-body">
        <div class="section-note" style="margin-bottom:14px;">Este módulo no crea ciudades. Si falta una ciudad, créala o habilítala desde <a href="/admin/locations">Ciudades</a>. Una misma ciudad puede servir para Bot / Reclutamiento, Despacho o ambos usos.</div>
        <form method="post" action="<%= isEditingClient ? '/operaciones/admin-clientes/' + safeEditClient.id + '/editar' : '/operaciones/admin-clientes' %>" autocomplete="off">
          <div class="form-grid">
            <div class="field full"><label for="name">Nombre del cliente</label><input id="name" name="name" required value="<%= formClient.name || '' %>" placeholder="Ej: Opera Logística" /></div>
            <div class="field"><label for="cityName">Ciudad principal</label><select id="cityName" name="cityName" required data-selected-city="<%= formClient.cityName || '' %>"><option value="">Cargando ciudades...</option></select><small class="muted">Ciudad administrativa del cliente. Las operaciones pueden tener ciudades diferentes.</small></div>
            <div class="field"><label for="nit">NIT</label><input id="nit" name="nit" value="<%= formClient.nit || '' %>" placeholder="Opcional" /></div>
            <div class="field"><label for="contactName">Contacto</label><input id="contactName" name="contactName" value="<%= formClient.contactName || '' %>" placeholder="Nombre del contacto" /></div>
            <div class="field"><label for="contactPhone">Teléfono</label><input id="contactPhone" name="contactPhone" value="<%= formClient.contactPhone || '' %>" placeholder="Celular o fijo" /></div>
            <div class="field"><label for="contactEmail">Correo</label><input id="contactEmail" name="contactEmail" type="email" value="<%= formClient.contactEmail || '' %>" placeholder="correo@cliente.com" /></div>
            <div class="field"><label for="isActive">Estado</label><select id="isActive" name="isActive"><option value="true" <%= formClient.isActive !== false ? 'selected' : '' %>>Activo</option><option value="false" <%= formClient.isActive === false ? 'selected' : '' %>>Inactivo</option></select></div>
            <div class="field full"><label for="notes">Notas</label><textarea id="notes" name="notes" placeholder="Condiciones, observaciones o información relevante"><%= formClient.notes || '' %></textarea></div>
            <% if (!isEditingClient) { %>
              <div class="field full">
                <label>Servicios del cliente</label>
                <div id="servicesList" class="inline-list">
                  <div class="inline-list-row">
                    <input name="services[]" placeholder="Ej: Cargue y descargue" />
                  </div>
                </div>
                <button class="btn" type="button" id="addServiceBtn" style="margin-top:10px;">+ Agregar servicio</button>
                <small class="muted">Estos servicios quedarán asociados al cliente y luego se podrán administrar en Operaciones y servicios.</small>
              </div>
            <% } %>
          </div>
          <div class="form-actions"><button class="btn btn-primary" type="submit"><%= isEditingClient ? 'Guardar cliente' : 'Crear cliente' %></button><% if (isEditingClient) { %><a class="btn" href="/admin/operaciones/clientes">Cancelar</a><% } %></div>
        </form>
      </div>
    </section>

    <section class="card">
      <div class="card-head"><h2>Clientes registrados</h2><p>El link público pertenece al cliente; en el formulario público el cliente selecciona operación y servicio.</p></div>
      <div class="table-wrap">
        <% if (!clients.length) { %><div class="empty"><strong>No hay clientes registrados.</strong>Crea el primer cliente para iniciar el flujo.</div><% } else { %>
          <table class="table"><thead><tr><th>Cliente</th><th>Ciudad</th><th>Contacto</th><th>Link público del cliente</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
            <% clients.forEach((c)=>{ const clientLink = baseUrl + '/operaciones/cliente/' + c.publicToken; %><tr>
              <td><strong><%= c.name %></strong><div class="muted">NIT: <%= c.nit || '—' %></div></td>
              <td><span class="pill pill-blue"><%= c.cityName || 'Sin ciudad' %></span></td>
              <td><%= c.contactName || '—' %><div class="muted"><%= c.contactPhone || 'Sin teléfono' %> · <%= c.contactEmail || 'Sin correo' %></div></td>
              <td><div class="copy-row"><input class="copy-input" readonly value="<%= clientLink %>" /><a class="btn" href="/operaciones/cliente/<%= c.publicToken %>" target="_blank" rel="noopener">Abrir</a></div></td>
              <td><span class="pill <%= c.isActive ? 'pill-green' : 'pill-amber' %>"><%= c.isActive ? 'Activo' : 'Inactivo' %></span></td>
              <td>
                <div class="actions stack-actions">
                  <a class="btn" href="/admin/operaciones/clientes/<%= c.id %>/operaciones">Operaciones y servicios</a>
                  <a class="btn" href="/admin/operaciones/clientes/<%= c.id %>/estadisticas">Estadísticas</a>
                  <a class="btn" href="/admin/operaciones/clientes/<%= c.id %>/estadisticas/exportar">Descargar Excel</a>
                  <a class="btn" href="/admin/operaciones/clientes/<%= c.id %>/editar">Editar</a>
                  <form method="post" action="/admin/operaciones/clientes/<%= c.id %>/toggle"><button class="btn" type="submit"><%= c.isActive ? 'Desactivar' : 'Reactivar' %></button></form>
                  <form method="post" action="/admin/operaciones/clientes/<%= c.id %>/regenerar-link" onsubmit="return confirm('Esto invalida el link público anterior de este cliente. ¿Deseas continuar?')"><button class="btn" type="submit">Regenerar link</button></form>
                  <form method="post" action="/operaciones/admin-delete/clientes/<%= c.id %>" onsubmit="return confirm('¿Eliminar este cliente? Si tiene dependencias operativas, el sistema no lo eliminará y mostrará un mensaje.')"><button class="btn" type="submit">Eliminar</button></form>
                </div>
                <div class="muted"><%= c._count?.operationPoints || 0 %> operaciones · <%= c._count?.services || 0 %> servicios</div>
              </td>
            </tr><% }) %>
          </tbody></table>
        <% } %>
      </div>
    </section>
  </main>

  <script>
    function refreshSelectState(select) { select.classList.toggle('has-selection', Boolean(select.value)); }
    async function loadCityOptions() {
      const citySelect = document.getElementById('cityName');
      if (!citySelect) return;
      const selectedCity = citySelect.dataset.selectedCity || '';
      citySelect.innerHTML = '<option value="">Selecciona una ciudad</option>';
      try {
        const response = await fetch(`/operaciones/api/ciudades?t=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) return;
        const data = await response.json();
        data.cities.forEach((city) => {
          const option = document.createElement('option');
          option.value = city.name;
          option.textContent = `${city.name}${city.usedForRecruitment && city.usedForDispatch ? ' — Bot y Despacho' : city.usedForDispatch ? ' — Despacho' : ' — Bot'}`;
          citySelect.appendChild(option);
        });
        if (selectedCity) {
          const exists = Array.from(citySelect.options).some((option) => option.value === selectedCity);
          if (!exists) {
            const option = document.createElement('option');
            option.value = selectedCity;
            option.textContent = `${selectedCity} — no configurada`;
            citySelect.appendChild(option);
          }
          citySelect.value = selectedCity;
        }
        refreshSelectState(citySelect);
      } catch (error) {
        console.error('No fue posible cargar ciudades', error);
      }
    }
    document.getElementById('addServiceBtn')?.addEventListener('click', () => {
      const servicesList = document.getElementById('servicesList');
      if (!servicesList) return;
      const row = document.createElement('div');
      row.className = 'inline-list-row';
      const input = document.createElement('input');
      input.name = 'services[]';
      input.placeholder = 'Ej: Inventario o Picking / packing';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn';
      remove.textContent = 'Quitar';
      remove.addEventListener('click', () => row.remove());
      row.appendChild(input);
      row.appendChild(remove);
      servicesList.appendChild(row);
      input.focus();
    });
    window.addEventListener('pageshow', (event) => { if (event.persisted) window.location.reload(); });
    document.getElementById('cityName')?.addEventListener('change', (event) => refreshSelectState(event.target));
    loadCityOptions();
  </script>
</body>
</html>
