<!DOCTYPE html><html lang="es-CO"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title><%= pageTitle %> — LoginPro</title><link rel="icon" type="image/png" href="/public/favicon-loginpro.svg"/><link rel="stylesheet" href="/public/operaciones-nomina.css"/><style>
.payroll-filter-panel{max-width:980px}.payroll-filter-stack{display:grid;gap:10px}.payroll-filter-row{display:grid;grid-template-columns:repeat(2,minmax(220px,1fr));gap:10px;align-items:end}.payroll-filter-actions{display:flex;justify-content:flex-start}.payroll-filter-actions .btn{min-width:220px}.worker-picker{position:relative}.worker-picker>summary{list-style:none;min-height:37px;border:1px solid var(--border);border-radius:8px;padding:9px 34px 9px 10px;background:#fff;color:var(--text);font-size:13px;font-weight:500;cursor:pointer;position:relative}.worker-picker>summary::-webkit-details-marker{display:none}.worker-picker>summary::after{content:'▾';position:absolute;right:11px;color:var(--muted)}.worker-picker[open]>summary::after{content:'▴'}.worker-picker-menu{position:absolute;z-index:45;top:calc(100% + 5px);left:0;width:min(420px,calc(100vw - 48px));max-height:280px;overflow:auto;border:1px solid var(--border);border-radius:9px;padding:8px;background:#fff;box-shadow:0 10px 28px rgba(15,23,42,.16)}.worker-picker-help{padding:5px 7px 8px;color:var(--muted);font-size:10px;line-height:1.35}.worker-check{display:flex;align-items:center;gap:8px;padding:7px;border-radius:6px;cursor:pointer;font-size:12px}.worker-check:hover{background:var(--soft)}.worker-check input{width:auto;margin:0;flex:0 0 auto}.worker-check span{min-width:0}.manual-correction-note{margin-top:5px;padding:5px 7px;border-left:3px solid var(--teal);background:var(--teal2);border-radius:4px;color:#14574f;font-size:10px;line-height:1.4;white-space:normal}.manual-correction-note strong{display:inline}.manual-correction-note+.manual-correction-note{margin-top:3px}@media(max-width:760px){.payroll-filter-panel{max-width:none}.payroll-filter-row{grid-template-columns:1fr}.payroll-filter-actions .btn{width:100%;min-width:0}.worker-picker-menu{position:fixed;left:12px;right:12px;top:20%;width:auto;max-height:60vh}}
</style></head><body>
<nav class="navbar"><a href="/admin" class="brand"><img src="/public/loginpro.png" alt="LoginPro"/></a><a href="/admin">Panel</a><a href="/admin/operaciones">Operaciones / Despacho</a><a href="/admin/operaciones/asistencia">Asistencia</a><a href="/admin/operaciones/asistencia/nomina" class="active">Nómina</a><span class="spacer"></span><a href="/logout">Cerrar sesión</a></nav>
<main class="page"><% const selectedWorkerIds=String(report.filters.workerId||'').split(',').map((value)=>value.trim()).filter(Boolean); %>
<header class="header"><div><h1><%= pageTitle %></h1><p class="sub">Corte <%= report.period.from||'—' %> a <%= report.period.to||'—' %></p></div><div class="actions"><a class="btn" href="/admin/operaciones/asistencia">Asistencia</a><a class="btn btn-blue" href="/admin/operaciones/asistencia/nomina/export.csv?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">CSV</a><a class="btn btn-primary" href="/admin/operaciones/asistencia/nomina/export.xlsx?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">Excel</a></div></header>
<% if(success){ %><div class="alert alert-success"><%= success %></div><% } %><% if(error){ %><div class="alert alert-error"><%= error %></div><% } %><% if(role==='dev'&&report.filters.includeTest){ %><div class="test-mode"><span>Modo DEV activo: este cálculo incluye jornadas y sujetos de prueba.</span><div class="actions"><a class="btn" href="/admin/operaciones/pruebas">Volver al entorno de pruebas</a><a class="btn" href="/admin/operaciones/asistencia/nomina">Salir del modo de pruebas</a></div></div><% } %>
<section class="panel payroll-filter-panel"><form method="get" action="/admin/operaciones/asistencia/nomina" class="payroll-filter-stack" id="payroll-filters"><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %>
<div class="payroll-filter-row"><div class="field"><label for="periodType">Tipo de corte</label><select id="periodType" name="periodType"><option value="WEEKLY" <%= report.period.periodType==='WEEKLY'?'selected':'' %>>Semanal</option><option value="BIWEEKLY" <%= report.period.periodType==='BIWEEKLY'?'selected':'' %>>Quincenal</option><option value="CUSTOM" <%= report.period.periodType==='CUSTOM'?'selected':'' %>>Personalizado</option></select></div><div class="field reference-date"><label>Fecha de referencia</label><input name="anchor" type="date" value="<%= report.period.anchor||report.period.from %>"/></div><div class="field custom-date"><label>Desde</label><input name="from" type="date" value="<%= report.period.from %>"/></div><div class="field custom-date"><label>Hasta</label><input name="to" type="date" value="<%= report.period.to %>"/></div></div>
<div class="payroll-filter-row"><div class="field"><label for="clientId">Cliente</label><select id="clientId" name="clientId"><option value="">Todos</option><% for(const client of report.clients){ %><option value="<%= client.id %>" <%= report.filters.clientId===client.id?'selected':'' %>><%= client.name %></option><% } %></select></div><div class="field"><label for="operationPointId">Operación</label><select id="operationPointId" name="operationPointId"><option value="">Todas</option><% for(const client of report.clients){for(const point of client.operationPoints||[]){ %><option data-client="<%= client.id %>" value="<%= point.id %>" <%= report.filters.operationPointId===point.id?'selected':'' %>><%= client.name %> · <%= point.name %></option><% }} %></select></div></div>
<div class="payroll-filter-row"><div class="field"><label>Auxiliares</label><details class="worker-picker"><summary><%= selectedWorkerIds.length?`${selectedWorkerIds.length} auxiliar(es) seleccionado(s)`:'Todos los auxiliares' %></summary><div class="worker-picker-menu"><div class="worker-picker-help">Marca uno o varios auxiliares. Si no marcas ninguno, se analizan todos los que tienen información en este corte.</div><% for(const worker of report.workers){ %><label class="worker-check"><input type="checkbox" name="workerId" value="<%= worker.id %>" <%= selectedWorkerIds.includes(worker.id)?'checked':'' %>/><span><%= worker.fullName %><%= worker.documentNumber?` · ${worker.documentNumber}`:'' %></span></label><% } %></div></details></div><div class="field"><label for="search">Buscar</label><input id="search" name="search" value="<%= report.filters.search %>" placeholder="Nombre, documento o teléfono"/></div></div>
<div class="payroll-filter-actions"><button class="btn btn-primary" type="submit">Calcular periodo</button></div></form></section>
<%- include('partials/operacionesNominaTabla') %>
<section class="panel"><h2 style="margin-bottom:10px">Conceptos generados</h2><% const labels={HEDO:'Extra diurna ordinaria',HENO:'Extra nocturna ordinaria',HEDD:'Extra diurna dominical',HEND:'Extra nocturna dominical',HEDF:'Extra diurna festiva',HENF:'Extra nocturna festiva',RNO:'Recargo nocturno ordinario',RDD:'Recargo diurno dominical no compensado',RND:'Recargo nocturno dominical no compensado',RDF:'Recargo diurno festivo',RNF:'Recargo nocturno festivo',RDDC:'Recargo diurno dominical compensado',RNDC:'Recargo nocturno dominical compensado'}; %><div class="codes"><% for(const code of conceptCodes){ %><div class="code"><strong><%= code %></strong><small><%= labels[code] %></small></div><% } %></div></section></main>
<script>(()=>{const period=document.getElementById('periodType'),custom=document.querySelectorAll('.custom-date'),reference=document.querySelector('.reference-date'),client=document.getElementById('clientId'),operation=document.getElementById('operationPointId'),workerPicker=document.querySelector('.worker-picker');const syncPeriod=()=>{const isCustom=period?.value==='CUSTOM';custom.forEach((item)=>{item.style.display=isCustom?'flex':'none'});if(reference)reference.style.display=isCustom?'none':'flex'};const syncOperation=()=>{if(!client||!operation)return;[...operation.options].forEach((option,index)=>{if(index)option.hidden=Boolean(client.value&&option.dataset.client!==client.value)});if(operation.selectedOptions[0]?.hidden)operation.value=''};period?.addEventListener('change',syncPeriod);client?.addEventListener('change',syncOperation);document.addEventListener('click',(event)=>{if(workerPicker?.open&&!workerPicker.contains(event.target))workerPicker.open=false});syncPeriod();syncOperation()})()</script></body></html>