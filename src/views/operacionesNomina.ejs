<!DOCTYPE html>
<html lang="es-CO">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg"/>
  <link rel="stylesheet" href="/public/operaciones-nomina.css"/>
  <style>
    .payroll-filter-panel{width:100%;max-width:none}.payroll-filter-stack{display:grid;grid-template-columns:repeat(3,minmax(220px,320px));justify-content:start;gap:10px}.payroll-filter-row{display:contents}.payroll-filter-actions{display:flex;justify-content:flex-start;grid-column:1/-1}.payroll-filter-actions .btn{min-width:220px}.worker-picker{position:relative;margin-top:0}.worker-picker>summary{list-style:none;min-height:37px;border:1px solid var(--border);border-radius:8px;padding:9px 34px 9px 10px;background:#fff;color:var(--text);font-size:13px;font-weight:500;cursor:pointer;position:relative}.worker-picker>summary::-webkit-details-marker{display:none}.worker-picker>summary::after{content:'▾';position:absolute;right:11px;color:var(--muted)}.worker-picker[open]>summary::after{content:'▴'}.worker-picker-menu{position:absolute;z-index:45;top:calc(100% + 5px);left:0;width:min(420px,calc(100vw - 48px));max-height:280px;overflow:auto;border:1px solid var(--border);border-radius:9px;padding:8px;background:#fff;box-shadow:0 10px 28px rgba(15,23,42,.16)}.worker-picker-help{padding:5px 7px 8px;color:var(--muted);font-size:10px;line-height:1.35}.worker-check{display:flex;align-items:center;gap:8px;padding:7px;border-radius:6px;cursor:pointer;font-size:12px}.worker-check:hover{background:var(--soft)}.worker-check input{width:auto;margin:0;flex:0 0 auto}.worker-check span{min-width:0}.manual-correction-note{margin-top:5px;padding:5px 7px;border-left:3px solid var(--teal);background:var(--teal2);border-radius:4px;color:#14574f;font-size:10px;line-height:1.4;white-space:normal}.manual-correction-note strong{display:inline}.manual-correction-note+.manual-correction-note{margin-top:3px}
    .payroll-import-panel[hidden]{display:none}.payroll-import-panel{border:1px solid #dce7e4}.payroll-import-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.payroll-import-head h2{margin:0 0 5px}.payroll-import-head p{margin:0;color:var(--muted);font-size:12px;line-height:1.45;max-width:760px}.payroll-import-controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap}.payroll-import-controls .field{min-width:min(420px,100%);flex:1}.payroll-import-controls input[type=file]{width:100%}.payroll-import-status{margin-top:12px;padding:10px 12px;border-radius:8px;background:var(--soft);font-size:12px;line-height:1.45}.payroll-import-status:empty{display:none}.payroll-import-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:8px;margin-top:12px}.payroll-import-metric{border:1px solid var(--border);border-radius:8px;padding:9px;background:#fff}.payroll-import-metric strong{display:block;font-size:18px}.payroll-import-metric small{color:var(--muted)}.payroll-import-mapping{margin-top:12px;padding:12px;border:1px solid #f1d5a7;border-radius:9px;background:#fffbeb}.payroll-import-mapping h3{margin:0 0 8px;font-size:14px}.payroll-import-mapping-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px}.payroll-import-mapping label{display:grid;gap:4px;font-size:11px;font-weight:700}.payroll-import-exceptions{margin-top:12px;overflow:auto;max-height:280px;border:1px solid var(--border);border-radius:8px}.payroll-import-exceptions table,.payroll-import-history table{width:100%;border-collapse:collapse;font-size:12px}.payroll-import-exceptions th,.payroll-import-exceptions td,.payroll-import-history th,.payroll-import-history td{padding:8px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.payroll-import-exceptions th,.payroll-import-history th{background:var(--soft);position:sticky;top:0}.payroll-import-history{margin-top:14px;overflow:auto}.payroll-import-badge{display:inline-flex;padding:3px 7px;border-radius:999px;background:var(--soft);font-size:10px;font-weight:800}.payroll-import-badge[data-status="REVERSED"]{background:#eef2f7}.payroll-import-badge[data-status="PARTIAL"]{background:#fef3c7;color:#92400e}.payroll-import-badge[data-status="ACTIVE"]{background:#dcfce7;color:#166534}.payroll-import-actions{display:flex;gap:8px;flex-wrap:wrap}.btn-danger-soft{border-color:#fecdd3;color:#9f1239;background:#fff1f2}
    @media(max-width:1050px){.payroll-filter-stack{grid-template-columns:repeat(2,minmax(220px,320px))}}@media(max-width:760px){.payroll-filter-stack{grid-template-columns:minmax(0,1fr);justify-content:stretch}.payroll-filter-actions .btn{width:100%;min-width:0}.worker-picker-menu{position:fixed;left:12px;right:12px;top:20%;width:auto;max-height:60vh}.payroll-import-head{display:grid}.payroll-import-controls{display:grid}.payroll-import-controls .field{min-width:0}}
  </style>
</head>
<body>
<nav class="navbar"><a href="/admin" class="brand"><img src="/public/loginpro.png" alt="LoginPro"/></a><a href="/admin">Panel</a><a href="/admin/operaciones">Operaciones / Despacho</a><a href="/admin/operaciones/asistencia">Asistencia</a><a href="/admin/operaciones/asistencia/nomina" class="active">Nómina</a><span class="spacer"></span><a href="/logout">Cerrar sesión</a></nav>
<main class="page">
  <% const selectedWorkerIds=String(report.filters.workerId||'').split(',').map((value)=>value.trim()).filter(Boolean); const payrollImports=Array.isArray(recentImports)?recentImports:[]; %>
  <header class="header">
    <div><h1><%= pageTitle %></h1><p class="sub">Corte <%= report.period.from||'—' %> a <%= report.period.to||'—' %></p></div>
    <div class="actions"><a class="btn" href="/admin/operaciones/asistencia">Asistencia</a><button class="btn" type="button" id="open-payroll-import">Importar marcaciones</button><a class="btn btn-primary" href="/admin/operaciones/asistencia/nomina/export.xlsx?<%= new URLSearchParams({...report.filters,periodType:report.period.periodType,from:report.period.from,to:report.period.to,anchor:report.period.anchor}).toString() %>">Excel</a></div>
  </header>
  <% if(success){ %><div class="alert alert-success"><%= success %></div><% } %>
  <% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>
  <% if(role==='dev'&&report.filters.includeTest){ %><div class="test-mode"><span>Modo DEV activo: este cálculo incluye jornadas y sujetos de prueba.</span><div class="actions"><a class="btn" href="/admin/operaciones/pruebas">Volver al entorno de pruebas</a><a class="btn" href="/admin/operaciones/asistencia/nomina">Salir del modo de pruebas</a></div></div><% } %>

  <section class="panel payroll-import-panel" id="payroll-import-panel" hidden>
    <div class="payroll-import-head">
      <div><h2>Importar marcaciones de GeoVictoria</h2><p>Admite Excel (.xlsx) y CSV. Lórren detecta las fechas del archivo sin restringir si son pasadas, actuales o futuras. Primero se analiza y concilia; nada se escribe hasta que confirmes la importación.</p></div>
      <button class="btn" type="button" id="close-payroll-import">Cerrar</button>
    </div>
    <div class="payroll-import-controls">
      <div class="field"><label for="payroll-import-file">Archivo de marcaciones</label><input id="payroll-import-file" type="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv"/></div>
      <button class="btn btn-primary" type="button" id="payroll-import-preview">Analizar archivo</button>
      <button class="btn" type="button" id="payroll-import-commit" hidden>Confirmar importación</button>
    </div>
    <div class="payroll-import-status" id="payroll-import-status" role="status" aria-live="polite"></div>
    <div class="payroll-import-summary" id="payroll-import-summary"></div>
    <div class="payroll-import-mapping" id="payroll-import-mapping" hidden><h3>Ajustar correspondencia de columnas</h3><p style="margin:0 0 9px;font-size:11px;color:#7c5b16">No necesitas modificar el archivo. Selecciona aquí qué columna corresponde a cada dato y vuelve a analizar.</p><div class="payroll-import-mapping-grid" id="payroll-import-mapping-grid"></div></div>
    <div class="payroll-import-exceptions" id="payroll-import-exceptions" hidden><table><thead><tr><th>Fila</th><th>Identidad</th><th>Fecha</th><th>Estado</th><th>Detalle</th></tr></thead><tbody id="payroll-import-exceptions-body"></tbody></table></div>

    <div class="payroll-import-history">
      <h3 style="margin:18px 0 8px">Últimas importaciones</h3>
      <% if(!payrollImports.length){ %><p class="sub">Todavía no hay importaciones de marcaciones registradas.</p><% } else { %>
      <table><thead><tr><th>Fecha del archivo</th><th>Formato</th><th>Jornadas</th><th>Marcaciones</th><th>Estado</th><th></th></tr></thead><tbody>
        <% for(const item of payrollImports){ %><tr>
          <td><%= item.dateFrom||'—' %><%= item.dateTo&&item.dateTo!==item.dateFrom?` a ${item.dateTo}`:'' %></td><td><%= item.format %></td><td><%= item.importedWorkdays %></td><td><%= item.importedMarks %></td><td><span class="payroll-import-badge" data-status="<%= item.status %>"><%= item.status==='REVERSED'?'Reversada':(item.status==='PARTIAL'?'Parcial':'Activa') %></span></td>
          <td><% if(item.canReverse){ %><form method="post" action="/admin/operaciones/asistencia/nomina/imports/<%= item.batchId %>/reverse" data-payroll-import-reverse><input type="hidden" name="periodType" value="<%= report.period.periodType %>"/><input type="hidden" name="from" value="<%= report.period.from %>"/><input type="hidden" name="to" value="<%= report.period.to %>"/><input type="hidden" name="anchor" value="<%= report.period.anchor %>"/><input type="hidden" name="clientId" value="<%= report.filters.clientId %>"/><input type="hidden" name="operationPointId" value="<%= report.filters.operationPointId %>"/><input type="hidden" name="search" value="<%= report.filters.search %>"/><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %><button class="btn btn-danger-soft" type="submit">Reversar importación</button></form><% } %></td>
        </tr><% } %>
      </tbody></table><% } %>
    </div>
  </section>

  <section class="panel payroll-filter-panel"><form method="get" action="/admin/operaciones/asistencia/nomina" class="payroll-filter-stack" id="payroll-filters"><% if(role==='dev'&&report.filters.includeTest){ %><input type="hidden" name="includeTest" value="true"/><% } %>
    <div class="payroll-filter-row"><div class="field"><label for="periodType">Tipo de corte</label><select id="periodType" name="periodType"><option value="WEEKLY" <%= report.period.periodType==='WEEKLY'?'selected':'' %>>Semanal</option><option value="BIWEEKLY" <%= report.period.periodType==='BIWEEKLY'?'selected':'' %>>Quincenal</option><option value="CUSTOM" <%= report.period.periodType==='CUSTOM'?'selected':'' %>>Personalizado</option></select></div><div class="field reference-date"><label>Fecha de referencia</label><input name="anchor" type="date" value="<%= report.period.anchor||report.period.from %>"/></div><div class="field custom-date"><label>Desde</label><input name="from" type="date" value="<%= report.period.from %>"/></div><div class="field custom-date"><label>Hasta</label><input name="to" type="date" value="<%= report.period.to %>"/></div></div>
    <div class="payroll-filter-row"><div class="field"><label for="clientId">Cliente</label><select id="clientId" name="clientId"><option value="">Todos</option><% for(const client of report.clients){ %><option value="<%= client.id %>" <%= report.filters.clientId===client.id?'selected':'' %>><%= client.name %></option><% } %></select></div><div class="field"><label for="operationPointId">Operación</label><select id="operationPointId" name="operationPointId"><option value="">Todas</option><% for(const client of report.clients){for(const point of client.operationPoints||[]){ %><option data-client="<%= client.id %>" value="<%= point.id %>" <%= report.filters.operationPointId===point.id?'selected':'' %>><%= client.name %> · <%= point.name %></option><% }} %></select></div></div>
    <div class="payroll-filter-row"><div class="field"><label>Auxiliares</label><details class="worker-picker"><summary><%= selectedWorkerIds.length?`${selectedWorkerIds.length} auxiliar(es) seleccionado(s)`:'Todos los auxiliares' %></summary><div class="worker-picker-menu"><div class="worker-picker-help">Marca uno o varios auxiliares. Si no marcas ninguno, se analizan todos los que tienen información en este corte.</div><% for(const worker of report.workers){ %><label class="worker-check"><input type="checkbox" name="workerId" value="<%= worker.id %>" <%= selectedWorkerIds.includes(worker.id)?'checked':'' %>/><span><%= worker.fullName %><%= worker.documentNumber?` · ${worker.documentNumber}`:'' %></span></label><% } %></div></details></div><div class="field"><label for="search">Buscar</label><input id="search" name="search" value="<%= report.filters.search %>" placeholder="Nombre, documento o teléfono"/></div></div>
    <div class="payroll-filter-actions"><button class="btn btn-primary" type="submit">Calcular periodo</button></div>
  </form></section>

  <%- include('partials/operacionesNominaTabla') %>
  <section class="panel"><h2 style="margin-bottom:10px">Conceptos generados</h2><% const labels={HEDO:'Extra diurna ordinaria',HENO:'Extra nocturna ordinaria',HEDD:'Extra diurna dominical',HEND:'Extra nocturna dominical',HEDF:'Extra diurna festiva',HENF:'Extra nocturna festiva',RNO:'Recargo nocturno ordinario',RDD:'Recargo diurno dominical no compensado',RND:'Recargo nocturno dominical no compensado',RDF:'Recargo diurno festivo',RNF:'Recargo nocturno festivo',RDDC:'Recargo diurno dominical compensado',RNDC:'Recargo nocturno dominical compensado'}; %><div class="codes"><% for(const code of conceptCodes){ %><div class="code"><strong><%= code %></strong><small><%= labels[code] %></small></div><% } %></div></section>
</main>
<script src="/public/lorren-dialog.js"></script>
<script>
(()=>{
  const period=document.getElementById('periodType'),custom=document.querySelectorAll('.custom-date'),reference=document.querySelector('.reference-date'),client=document.getElementById('clientId'),operation=document.getElementById('operationPointId'),workerPicker=document.querySelector('.worker-picker');
  const syncPeriod=()=>{const isCustom=period?.value==='CUSTOM';custom.forEach((item)=>{item.style.display=isCustom?'flex':'none'});if(reference)reference.style.display=isCustom?'none':'flex'};
  const syncOperation=()=>{if(!client||!operation)return;[...operation.options].forEach((option,index)=>{if(index)option.hidden=Boolean(client.value&&option.dataset.client!==client.value)});if(operation.selectedOptions[0]?.hidden)operation.value=''};
  period?.addEventListener('change',syncPeriod);client?.addEventListener('change',syncOperation);document.addEventListener('click',(event)=>{if(workerPicker?.open&&!workerPicker.contains(event.target))workerPicker.open=false});syncPeriod();syncOperation();

  const panel=document.getElementById('payroll-import-panel'),openButton=document.getElementById('open-payroll-import'),closeButton=document.getElementById('close-payroll-import'),fileInput=document.getElementById('payroll-import-file'),previewButton=document.getElementById('payroll-import-preview'),commitButton=document.getElementById('payroll-import-commit'),status=document.getElementById('payroll-import-status'),summary=document.getElementById('payroll-import-summary'),mappingBox=document.getElementById('payroll-import-mapping'),mappingGrid=document.getElementById('payroll-import-mapping-grid'),exceptions=document.getElementById('payroll-import-exceptions'),exceptionsBody=document.getElementById('payroll-import-exceptions-body');
  const mappingFields=[['document','Documento/identificación'],['name','Nombre'],['date','Fecha'],['datetime','Fecha y hora'],['time','Hora'],['event','Tipo de evento'],['operation','Operación'],['arrival','Entrada'],['breakStart','Inicio almuerzo'],['breakEnd','Fin almuerzo'],['departure','Salida']];
  const includeTest=<%- JSON.stringify(Boolean(role==='dev'&&report.filters.includeTest)) %>;
  let lastPreview=null;
  const text=(value)=>String(value??'');
  const setStatus=(message,isError=false)=>{status.textContent=message||'';status.style.color=isError?'#9f1239':''};
  const currentMapping=()=>Object.fromEntries([...mappingGrid.querySelectorAll('select[data-map-field]')].map((select)=>[select.dataset.mapField,select.value]).filter(([,value])=>value));
  const buildFormData=(includePreview=false)=>{const file=fileInput?.files?.[0];if(!file)throw new Error('Selecciona un archivo Excel o CSV.');const data=new FormData();data.append('file',file);const mapping=currentMapping();if(Object.keys(mapping).length)data.append('mapping',JSON.stringify(mapping));if(includeTest)data.append('includeTest','true');if(includePreview&&lastPreview?.previewFingerprint)data.append('previewFingerprint',lastPreview.previewFingerprint);return data};
  const metric=(label,value)=>{const item=document.createElement('div');item.className='payroll-import-metric';const strong=document.createElement('strong');strong.textContent=text(value);const small=document.createElement('small');small.textContent=label;item.append(strong,small);return item};
  const renderSummary=(data)=>{summary.replaceChildren();const values=data.summary||{};if(data.dateFrom||data.dateTo)summary.append(metric('Fechas detectadas',data.dateFrom===data.dateTo?data.dateFrom:`${data.dateFrom||'—'} → ${data.dateTo||'—'}`));summary.append(metric('Jornadas detectadas',values.parsedWorkdays||0),metric('Listas para importar',values.ready||0),metric('Marcaciones nuevas',values.marksReady||0),metric('Duplicadas',values.duplicates||0),metric('Sin conciliar',values.unresolved||0),metric('Inválidas',values.invalid||0));};
  const renderMapping=(data)=>{mappingGrid.replaceChildren();const headers=Array.isArray(data.headers)?data.headers.filter(Boolean):[];mappingFields.forEach(([field,label])=>{const wrap=document.createElement('label');wrap.textContent=label;const select=document.createElement('select');select.dataset.mapField=field;const empty=document.createElement('option');empty.value='';empty.textContent='— Sin asignar —';select.append(empty);headers.forEach((header)=>{const option=document.createElement('option');option.value=header;option.textContent=header;if(Number.isInteger(data.columns?.[field])&&data.headers[data.columns[field]]===header)option.selected=true;select.append(option)});wrap.append(select);mappingGrid.append(wrap)});mappingBox.hidden=false};
  const renderExceptions=(rows)=>{exceptionsBody.replaceChildren();const source=Array.isArray(rows)?rows:[];exceptions.hidden=!source.length;source.forEach((row)=>{const tr=document.createElement('tr');[row.rowNumber||'—',row.identity||'—',row.dateKey||'—',row.status||'—',row.message||'—'].forEach((value)=>{const td=document.createElement('td');td.textContent=text(value);tr.append(td)});exceptionsBody.append(tr)});};
  const preview=async()=>{try{previewButton.disabled=true;commitButton.hidden=true;setStatus('Analizando archivo y conciliando jornadas…');const response=await fetch('/admin/operaciones/asistencia/nomina/imports/preview',{method:'POST',body:buildFormData(),headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No fue posible analizar el archivo.');lastPreview=data;renderSummary(data);renderExceptions(data.rows);if(data.needsMapping){renderMapping(data);setStatus(data.message||'Ajusta las columnas y vuelve a analizar.');previewButton.textContent='Volver a analizar';return}mappingBox.hidden=true;commitButton.hidden=!(Number(data.summary?.ready||0)>0);setStatus(`Archivo ${data.format}${data.sheetName?` · hoja ${data.sheetName}`:''} analizado. Revisa el resumen antes de confirmar.`)}catch(error){setStatus(error.message||'No fue posible analizar el archivo.',true)}finally{previewButton.disabled=false}};
  const commit=async()=>{if(!lastPreview||Number(lastPreview.summary?.ready||0)<1)return;const approved=await window.LorrenDialog.confirm({title:'Confirmar importación',text:`Se registrarán ${lastPreview.summary.ready} jornada(s) y ${lastPreview.summary.marksReady||0} marcación(es). Los duplicados y casos sin conciliar no se tocarán.`,confirmLabel:'Sí, importar',cancelLabel:'Revisar',tone:'warning'});if(!approved)return;try{commitButton.disabled=true;previewButton.disabled=true;setStatus('Importando marcaciones…');const response=await fetch('/admin/operaciones/asistencia/nomina/imports/commit',{method:'POST',body:buildFormData(true),headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No fue posible importar.');setStatus(`Importación registrada: ${data.summary.importedWorkdays} jornada(s), ${data.summary.importedMarks} marcación(es).`);window.setTimeout(()=>window.location.reload(),600)}catch(error){setStatus(error.message||'No fue posible importar.',true);commitButton.disabled=false;previewButton.disabled=false}};
  openButton?.addEventListener('click',()=>{panel.hidden=false;panel.scrollIntoView({behavior:'smooth',block:'start'})});closeButton?.addEventListener('click',()=>{panel.hidden=true});previewButton?.addEventListener('click',preview);commitButton?.addEventListener('click',commit);fileInput?.addEventListener('change',()=>{lastPreview=null;commitButton.hidden=true;mappingBox.hidden=true;mappingGrid.replaceChildren();summary.replaceChildren();renderExceptions([]);previewButton.textContent='Analizar archivo';setStatus('')});
  document.querySelectorAll('[data-payroll-import-reverse]').forEach((form)=>form.addEventListener('submit',async(event)=>{event.preventDefault();const approved=await window.LorrenDialog.confirm({title:'Reversar importación',text:'Se eliminarán únicamente las marcaciones que sigan intactas y pertenezcan a este lote. Si una jornada fue modificada después, quedará protegida y no se borrará.',confirmLabel:'Sí, reversar',cancelLabel:'Cancelar',tone:'danger'});if(approved)form.submit()}));
})();
</script>
</body>
</html>
