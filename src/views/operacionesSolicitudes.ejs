<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Solicitudes de servicio — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .readonly-field { background: #f8fafc; color: var(--muted); cursor: not-allowed; }
    .select-hint { color: var(--muted); font-size: 12px; margin-top: 4px; }
    select.has-selection { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(13, 122, 107, .12); background: #f0fdfa; }
    .shift-list { display: grid; gap: 10px; }
    .shift-row { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 10px; align-items: end; border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: var(--surface-2); }
    .shift-remove { border: 1px solid var(--border); background: #fff; border-radius: 999px; padding: 9px 12px; font-weight: 900; cursor: pointer; }
    .shift-summary { font-size: 12px; color: var(--muted); margin-top: 8px; }
    .service-list-note { background: #f0fdfa; border: 1px solid rgba(13,122,107,.25); color: var(--navy); border-radius: 16px; padding: 14px 16px; line-height: 1.45; }
    .service-list-note strong { color: var(--teal); }
    @media(max-width:720px){.shift-row{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Solicitudes operativas</div>
        <h1>Crear solicitud de servicio</h1>
        <p>Registra solicitudes internas para que luego sean gestionadas desde el inicio del módulo de Operaciones / Despacho.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones">Volver a Operaciones</a>
        <a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ir a asignación</a>
        <a class="btn" href="/admin/operaciones/clientes">Clientes</a>
      </div>
    </section>

    <% if (message) { %><div class="section-note"><%= message %></div><% } %>

    <section class="service-list-note">
      <strong>Consulta de solicitudes:</strong> el listado por día se revisa desde el inicio de Operaciones / Despacho usando las tarjetas de estadísticas y el filtro de fecha. Esta pantalla queda enfocada solo en crear solicitudes nuevas.
    </section>

    <details class="card" open>
      <summary style="cursor:pointer;font-weight:900;color:var(--navy);padding:18px;">Crear solicitud de servicio</summary>
      <div class="card-body">
        <form method="post" action="/admin/operaciones/solicitudes">
          <div class="form-grid">
            <div class="field">
              <label for="clientId">Cliente</label>
              <select id="clientId" name="clientId" required>
                <option value="">Selecciona un cliente</option>
                <% clients.forEach((client)=>{ %><option value="<%= client.id %>"><%= client.name %></option><% }) %>
              </select>
              <p class="select-hint">Solo aparecen clientes activos registrados en Operaciones.</p>
            </div>
            <div class="field">
              <label for="operationPointId">Operación / punto</label>
              <select id="operationPointId" name="operationPointId" required disabled>
                <option value="">Selecciona primero un cliente</option>
              </select>
            </div>
            <div class="field">
              <label for="serviceId">Servicio del cliente</label>
              <select id="serviceId" name="serviceId" disabled>
                <option value="">Selecciona primero un cliente</option>
              </select>
            </div>
            <div class="field"><label for="cityNameDisplay">Ciudad</label><input id="cityNameDisplay" class="readonly-field" readonly placeholder="Se carga desde la operación" /></div>
            <div class="field"><label for="addressDisplay">Dirección de la operación</label><input id="addressDisplay" class="readonly-field" readonly placeholder="Se carga desde la operación" /></div>
            <input type="hidden" id="address" name="address" />
            <div class="field full">
              <label>Días, horarios y auxiliares requeridos</label>
              <div class="shift-list" id="shiftList">
                <div class="shift-row">
                  <div class="field"><label>Fecha servicio</label><input type="date" name="serviceDateBlock" value="<%= today %>" required /></div>
                  <div class="field"><label>Auxiliares</label><input type="number" name="requiredWorkers" min="1" value="1" required /></div>
                  <div class="field"><label>Hora inicio</label><input type="time" name="startTime" required /></div>
                  <div class="field"><label>Hora fin</label><input type="time" name="endTime" /></div>
                  <button class="shift-remove" type="button" hidden>Quitar</button>
                </div>
              </div>
              <p class="shift-summary">Para solicitudes de varios días en la semana, agrega un bloque por cada fecha y horario. Ejemplo: lunes 6:00 con 3 auxiliares y miércoles 14:00 con 2 auxiliares.</p>
              <button class="btn" type="button" id="addShiftBtn">Agregar otro día / horario</button>
            </div>
            <div class="field full"><label>Notas</label><textarea name="notes" placeholder="Observaciones de la solicitud"></textarea></div>
          </div>
          <div class="form-actions"><button class="btn btn-primary" type="submit">Crear solicitud</button></div>
        </form>
      </div>
    </details>
  </main>

  <script type="application/json" id="clients-data"><%- JSON.stringify(clients.map((client) => ({ id: client.id, name: client.name, cityName: client.cityName, operationPoints: client.operationPoints || [], services: client.services || [] }))) %></script>
  <script>
    const clientsData = JSON.parse(document.getElementById('clients-data').textContent || '[]');
    const clientSelect = document.getElementById('clientId');
    const operationSelect = document.getElementById('operationPointId');
    const serviceSelect = document.getElementById('serviceId');
    const cityDisplay = document.getElementById('cityNameDisplay');
    const addressDisplay = document.getElementById('addressDisplay');
    const addressInput = document.getElementById('address');
    function setSelectState(select) { select.classList.toggle('has-selection', Boolean(select.value)); }
    function fillOperationOptions(client) {
      operationSelect.innerHTML = '';
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = client ? 'Selecciona un punto de operación' : 'Selecciona primero un cliente';
      operationSelect.appendChild(placeholder);
      (client?.operationPoints || []).forEach((operation) => {
        const option = document.createElement('option');
        option.value = operation.id;
        option.textContent = `${operation.name}${operation.cityName ? ' — ' + operation.cityName : ''}`;
        option.dataset.city = operation.cityName || client.cityName || '';
        option.dataset.address = operation.address || '';
        operationSelect.appendChild(option);
      });
      operationSelect.disabled = !client || !(client.operationPoints || []).length;
    }
    function fillServiceOptions(client) {
      serviceSelect.innerHTML = '';
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = client ? ((client.services || []).length ? 'Selecciona un servicio' : 'Cliente sin servicios configurados') : 'Selecciona primero un cliente';
      serviceSelect.appendChild(placeholder);
      (client?.services || []).forEach((service) => {
        const option = document.createElement('option');
        option.value = service.id;
        option.textContent = service.name;
        serviceSelect.appendChild(option);
      });
      serviceSelect.disabled = !client || !(client.services || []).length;
      serviceSelect.required = Boolean(client && (client.services || []).length);
    }
    clientSelect?.addEventListener('change', () => {
      const client = clientsData.find((item) => item.id === clientSelect.value) || null;
      fillOperationOptions(client);
      fillServiceOptions(client);
      cityDisplay.value = '';
      addressDisplay.value = '';
      addressInput.value = '';
      [clientSelect, operationSelect, serviceSelect].forEach(setSelectState);
    });
    operationSelect?.addEventListener('change', () => {
      const option = operationSelect.selectedOptions[0];
      cityDisplay.value = option?.dataset.city || '';
      addressDisplay.value = option?.dataset.address || '';
      addressInput.value = option?.dataset.address || '';
      setSelectState(operationSelect);
    });
    serviceSelect?.addEventListener('change', () => setSelectState(serviceSelect));
    [clientSelect, operationSelect, serviceSelect].forEach((select) => select && setSelectState(select));

    const shiftList = document.getElementById('shiftList');
    const addShiftBtn = document.getElementById('addShiftBtn');
    function refreshRemoveButtons(){
      const rows = Array.from(shiftList?.querySelectorAll('.shift-row') || []);
      rows.forEach((row) => { const button = row.querySelector('.shift-remove'); if (button) button.hidden = rows.length === 1; });
    }
    addShiftBtn?.addEventListener('click', () => {
      const first = shiftList.querySelector('.shift-row');
      const clone = first.cloneNode(true);
      clone.querySelectorAll('input').forEach((input) => { input.value = input.type === 'number' ? '1' : ''; });
      clone.querySelector('.shift-remove')?.addEventListener('click', () => { clone.remove(); refreshRemoveButtons(); });
      shiftList.appendChild(clone);
      refreshRemoveButtons();
    });
    shiftList?.querySelector('.shift-remove')?.addEventListener('click', (event) => { event.currentTarget.closest('.shift-row')?.remove(); refreshRemoveButtons(); });
    refreshRemoveButtons();
  </script>
</body>
</html>
