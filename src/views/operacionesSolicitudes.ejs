<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Crear solicitud — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .readonly-field{background:#f8fafc;color:var(--muted);cursor:not-allowed}.select-hint,.shift-summary{color:var(--muted);font-size:12px;margin-top:4px}.shift-list{display:grid;gap:14px}.shift-group{overflow:hidden;border:1px solid #b7dcd6;border-radius:14px;background:#f8fbfa}.shift-group-heading{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:11px 14px;background:#e8f5f2;color:#126b60;font-size:12px}.shift-group-heading strong{font-size:13px}.shift-schedule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:14px}.shift-schedule .field,.shift-service-row .field{min-width:0}.shift-services{border-top:1px solid #d8eae6;padding:12px 14px 4px}.shift-services-title{margin:0 0 10px;color:#126b60;font-size:12px;font-weight:800}.shift-service-row{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(120px,.7fr) auto;gap:12px;align-items:end;margin-bottom:9px;padding:11px 12px;border:1px solid #d8eae6;border-left:4px solid var(--teal);border-radius:10px;background:#fff}.shift-group-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;padding:0 14px 14px}.shift-group-actions .btn{box-shadow:none}.shift-remove-service,.shift-remove-group{border:1px solid var(--border);background:#fff;border-radius:11px;padding:9px 12px;font-weight:800;cursor:pointer}.shift-controls{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}.section-note strong{color:var(--teal)}.test-request-option{display:flex;align-items:flex-start;gap:10px;border:1px solid #c4b5fd;background:#f5f3ff;border-radius:12px;padding:13px;color:#5b21b6;cursor:pointer}.test-request-option input{width:18px;height:18px;margin-top:2px;accent-color:#7c3aed}.test-request-option strong,.test-request-option small{display:block}.test-request-option small{margin-top:3px;line-height:1.4;color:#6d28d9}@media(max-width:900px){.shift-group-actions .btn,.shift-controls .btn{width:auto}}@media(max-width:700px){.shift-schedule{grid-template-columns:1fr}.shift-service-row{grid-template-columns:repeat(2,minmax(0,1fr))}.shift-remove-service{grid-column:1/-1;justify-self:end}}@media(max-width:520px){.shift-service-row{grid-template-columns:1fr}.shift-remove-service{grid-column:1;width:100%}.shift-group-actions .btn,.shift-remove-group,.shift-controls .btn{width:100%}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %><span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>
  <main class="page">
    <section class="hero">
      <div><div class="eyebrow">Solicitudes operativas</div><h1>Crear solicitud de servicio</h1><p>Esta pantalla queda enfocada solo en crear solicitudes nuevas.</p></div>
      <div class="actions"><a class="btn" href="/admin/operaciones">Volver a Operaciones</a><a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ir a asignación</a><a class="btn" href="/admin/operaciones/clientes">Clientes</a><% if (role === 'dev') { %><a class="btn" href="/admin/operaciones/pruebas">Entorno de pruebas</a><% } %></div>
    </section>
    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <div class="section-note"><strong>Consulta y edición:</strong> el listado con acciones aparece desde las tarjetas del panel operativo: Solicitudes del día, Pendientes, Asignación completa o Novedades abiertas.</div>
    <section class="card">
      <div class="card-body">
        <form method="post" action="/admin/operaciones/solicitudes" id="serviceRequestForm">
          <div class="form-grid">
            <div class="field"><label for="clientId">Cliente</label><select id="clientId" name="clientId" required><option value="">Selecciona un cliente</option><% clients.forEach((client)=>{ %><option value="<%= client.id %>"><%= client.name %></option><% }) %></select><p class="select-hint">Solo aparecen clientes activos registrados en Operaciones.</p></div>
            <div class="field"><label for="operationPointId">Operación / punto</label><select id="operationPointId" name="operationPointId" required disabled><option value="">Selecciona primero un cliente</option></select></div>

            <div class="field"><label for="cityNameDisplay">Ciudad</label><input id="cityNameDisplay" class="readonly-field" readonly placeholder="Se carga desde la operación" /></div>
            <div class="field"><label for="addressDisplay">Dirección de la operación</label><input id="addressDisplay" class="readonly-field" readonly placeholder="Se carga desde la operación" /></div>
            <input type="hidden" id="address" name="address" />
            <div class="field full"><label>Horarios y servicios requeridos</label><div class="shift-list" id="shiftList"><div class="shift-group"><div class="shift-group-heading"><strong>Horario 1</strong><span>Los servicios de este bloque comparten fecha y horas.</span></div><div class="shift-schedule"><div class="field"><label>Fecha servicio</label><input type="date" data-schedule="date" value="<%= today %>" required /></div><div class="field"><label>Hora inicio</label><input type="time" data-schedule="start" required /></div><div class="field"><label>Hora fin</label><input type="time" data-schedule="end" /></div></div><div class="shift-services"><p class="shift-services-title">Servicios en este horario</p><div class="shift-service-row"><div class="field"><label>Servicio</label><select name="serviceId" required disabled><option value="">Selecciona primero un cliente</option></select></div><div class="field"><label>Auxiliares</label><input type="number" name="requiredWorkers" min="1" value="1" required /></div><input type="hidden" name="serviceDateBlock" /><input type="hidden" name="startTime" /><input type="hidden" name="endTime" /><button class="shift-remove-service" type="button" hidden>Quitar servicio</button></div></div><div class="shift-group-actions"><button class="btn shift-add-service" type="button">+ Agregar servicio a este horario</button><button class="shift-remove-group" type="button" hidden>Quitar horario</button></div></div></div><p class="shift-summary">Cada servicio tiene su propia cantidad de auxiliares. La fecha y las horas se comparten dentro de cada bloque.</p><div class="shift-controls"><button class="btn" type="button" id="addShiftBtn">+ Otro día u horario</button></div></div>
            <% if (role === 'dev') { %><label class="field full test-request-option"><input id="isDevTestRequest" type="checkbox" checked /><span><strong>Solicitud de prueba</strong><small>No ejecuta autoasignación ni notificaciones. Solo permitirá asignar auxiliares marcados como sujetos de prueba y después registrar la jornada manual.</small></span></label><% } %>
            <div class="field full"><label>Notas</label><textarea name="notes" placeholder="Observaciones de la solicitud"></textarea></div>
          </div>
          <div class="form-actions"><button class="btn btn-primary" type="submit">Crear solicitud</button></div>
        </form>
      </div>
    </section>
  </main>
  <script type="application/json" id="clients-data"><%- JSON.stringify(clients.map((client) => ({ id: client.id, name: client.name, cityName: client.cityName, operationPoints: client.operationPoints || [], services: client.services || [] }))) %></script>
  <script>
    const clientsData=JSON.parse(document.getElementById('clients-data').textContent||'[]');const clientSelect=document.getElementById('clientId'),operationSelect=document.getElementById('operationPointId'),cityDisplay=document.getElementById('cityNameDisplay'),addressDisplay=document.getElementById('addressDisplay'),addressInput=document.getElementById('address');
    function fillOperationOptions(client){operationSelect.innerHTML='<option value="">'+(client?'Selecciona un punto de operación':'Selecciona primero un cliente')+'</option>';(client?.operationPoints||[]).forEach((operation)=>{const option=document.createElement('option');option.value=operation.id;option.textContent=`${operation.name}${operation.cityName?' — '+operation.cityName:''}`;option.dataset.city=operation.cityName||client.cityName||'';option.dataset.address=operation.address||'';operationSelect.appendChild(option);});operationSelect.disabled=!client||!(client.operationPoints||[]).length;}
    function fillServiceOptions(client){document.querySelectorAll('.shift-service-row select[name="serviceId"]').forEach((select)=>{select.innerHTML='<option value="">'+(client?((client.services||[]).length?'Selecciona un servicio':'Cliente sin servicios configurados'):'Selecciona primero un cliente')+'</option>'; (client?.services||[]).forEach((service)=>{const option=document.createElement('option');option.value=service.id;option.textContent=service.name;select.appendChild(option);});select.disabled=!client||!(client.services||[]).length;});}

    clientSelect?.addEventListener('change',()=>{const client=clientsData.find((item)=>item.id===clientSelect.value)||null;fillOperationOptions(client);fillServiceOptions(client);cityDisplay.value='';addressDisplay.value='';addressInput.value='';});
    operationSelect?.addEventListener('change',()=>{const option=operationSelect.selectedOptions[0];cityDisplay.value=option?.dataset.city||'';addressDisplay.value=option?.dataset.address||'';addressInput.value=option?.dataset.address||'';});
    const shiftList=document.getElementById('shiftList'),addShiftBtn=document.getElementById('addShiftBtn');
    function syncGroupSchedule(group){const date=group.querySelector('[data-schedule="date"]').value,start=group.querySelector('[data-schedule="start"]').value,end=group.querySelector('[data-schedule="end"]').value;group.querySelectorAll('.shift-service-row').forEach((row)=>{row.querySelector('[name="serviceDateBlock"]').value=date;row.querySelector('[name="startTime"]').value=start;row.querySelector('[name="endTime"]').value=end;});}
    function refreshShiftControls(){const groups=Array.from(shiftList.querySelectorAll('.shift-group'));groups.forEach((group,index)=>{group.querySelector('.shift-group-heading strong').textContent=`Horario ${index+1}`;group.querySelector('.shift-remove-group').hidden=groups.length===1;const rows=Array.from(group.querySelectorAll('.shift-service-row'));rows.forEach((row)=>{row.querySelector('.shift-remove-service').hidden=rows.length===1;});});}
    function addService(group){const rows=group.querySelector('.shift-services'),clone=rows.querySelector('.shift-service-row:last-child').cloneNode(true);clone.querySelector('[name="serviceId"]').value='';clone.querySelector('[name="requiredWorkers"]').value='1';rows.appendChild(clone);syncGroupSchedule(group);refreshShiftControls();}
    function addShift(){const source=shiftList.querySelector('.shift-group:last-child');if(!source)return;const clone=source.cloneNode(true),rows=clone.querySelectorAll('.shift-service-row');rows.forEach((row,index)=>{if(index)row.remove();});clone.querySelectorAll('[data-schedule]').forEach((input)=>{input.value='';});clone.querySelector('[name="serviceId"]').value='';clone.querySelector('[name="requiredWorkers"]').value='1';shiftList.appendChild(clone);syncGroupSchedule(clone);refreshShiftControls();}
    addShiftBtn?.addEventListener('click',addShift);shiftList?.addEventListener('click',(event)=>{const group=event.target.closest('.shift-group');if(!group)return;if(event.target.closest('.shift-add-service'))addService(group);else if(event.target.closest('.shift-remove-service')){event.target.closest('.shift-service-row').remove();refreshShiftControls();}else if(event.target.closest('.shift-remove-group')){group.remove();refreshShiftControls();}});shiftList?.addEventListener('input',(event)=>{const group=event.target.closest('.shift-group');if(group&&event.target.matches('[data-schedule]'))syncGroupSchedule(group);});shiftList?.addEventListener('change',(event)=>{const group=event.target.closest('.shift-group');if(group&&event.target.matches('[data-schedule]'))syncGroupSchedule(group);});shiftList?.querySelectorAll('.shift-group').forEach(syncGroupSchedule);refreshShiftControls();

    const requestForm=document.getElementById('serviceRequestForm'),testRequest=document.getElementById('isDevTestRequest');requestForm?.addEventListener('submit',()=>shiftList.querySelectorAll('.shift-group').forEach(syncGroupSchedule));function syncRequestAction(){if(!requestForm||!testRequest)return;requestForm.action=testRequest.checked?'/admin/operaciones/pruebas/solicitudes':'/admin/operaciones/solicitudes';}testRequest?.addEventListener('change',syncRequestAction);syncRequestAction();
  </script>
</body>
</html>
