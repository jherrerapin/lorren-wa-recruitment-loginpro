<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Solicitudes de servicio — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Solicitudes operativas</div>
        <h1>Solicitudes de servicio</h1>
        <p>Consulta solicitudes creadas desde links públicos de clientes o solicitudes internas de prueba.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones">Volver a Operaciones</a>
        <a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ir a asignación</a>
        <a class="btn" href="/admin/operaciones/clientes">Clientes</a>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Listado de solicitudes</h2>
        <p>Selecciona una solicitud para asignar auxiliares o editar sus datos.</p>
      </div>
      <div class="table-wrap">
        <% if (!serviceRequests.length) { %>
          <div class="empty"><strong>No hay solicitudes registradas.</strong>Crea un cliente, una operación y comparte el link público para recibir solicitudes.</div>
        <% } else { %>
          <table class="table">
            <thead><tr><th>Cliente / operación</th><th>Fecha</th><th>Horario</th><th>Requeridos</th><th>Asignados</th><th>Origen</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
              <% serviceRequests.forEach((request) => { %>
                <tr>
                  <td><strong><%= request.clientName %></strong><div class="muted"><%= request.operationPointName || 'Sin punto' %> · <%= request.cityName || 'Sin ciudad' %></div></td>
                  <td><%= new Date(request.serviceDate).toISOString().slice(0,10) %></td>
                  <td><%= request.startTime || '-' %> - <%= request.endTime || '-' %></td>
                  <td><%= request.requiredWorkers %></td>
                  <td><%= request.assignments.length %></td>
                  <td><span class="pill pill-amber"><%= request.source || 'INTERNAL' %></span></td>
                  <td><span class="pill <%= request.status === 'ASSIGNMENT_COMPLETE' ? 'pill-green' : 'pill-amber' %>"><%= request.status %></span></td>
                  <td>
                    <div class="actions">
                      <a class="btn" href="/admin/operaciones/asignaciones?serviceRequestId=<%= request.id %>">Asignar</a>
                      <a class="btn" href="/admin/operaciones/asignaciones/solicitudes/<%= request.id %>/editar">Editar</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
