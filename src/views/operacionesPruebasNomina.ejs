<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .test-page{max-width:1500px}.test-layout{display:grid;grid-template-columns:minmax(300px,.65fr) minmax(0,1.35fr);gap:16px;align-items:start}.test-badge{display:inline-flex;padding:4px 9px;border-radius:999px;background:#ede9fe;color:#6d28d9;font-size:11px;font-weight:900}.request-list{display:grid;gap:8px;max-height:70vh;overflow:auto}.request-card{display:block;text-decoration:none;color:inherit;border:1px solid var(--border);border-radius:12px;padding:11px;background:#fff}.request-card.active{border-color:#7c3aed;background:#f5f3ff}.request-card strong{display:block;color:var(--navy);margin-bottom:4px}.request-card small{display:block;color:var(--muted);line-height:1.45}.assignment-grid{display:grid;gap:14px}.assignment-card{border:1px solid var(--border);border-radius:14px;padding:14px;background:#fff}.assignment-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}.manual-grid{display:grid;grid-template-columns:repeat(2,minmax(180px,1fr));gap:10px;margin-top:12px}.manual-grid .full{grid-column:1/-1}.field small{color:var(--muted);font-size:11px;line-height:1.4}.test-note{border:1px solid #c4b5fd;background:#f5f3ff;color:#5b21b6;border-radius:10px;padding:11px 13px;line-height:1.5}.empty-test{padding:24px;text-align:center;color:var(--muted)}.assign-row{display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:10px;align-items:end}.danger-btn{border-color:#fecaca!important;color:#b91c1c!important;background:#fff5f5!important}.payroll-link{background:#1d4ed8!important;border-color:#1d4ed8!important;color:#fff!important}.wa-link{background:#15803d!important;border-color:#15803d!important;color:#fff!important}.wa-test{display:grid;gap:10px;margin-top:14px;padding:13px;border:1px solid #bbf7d0;border-radius:12px;background:#f0fdf4}.wa-test-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap}.wa-test textarea{width:100%;min-height:96px;resize:vertical;border:1px solid var(--border);border-radius:10px;padding:10px;font:inherit;background:#fff}.wa-result{min-height:18px;font-size:12px;font-weight:800;color:#166534}.wa-result.error{color:#b91c1c}.status-confirmed{color:#166534;font-weight:900}@media(max-width:900px){.test-layout{grid-template-columns:1fr}.request-list{max-height:none}.manual-grid,.assign-row{grid-template-columns:1fr}.manual-grid .full{grid-column:1}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <a href="/admin/operaciones/asistencia/nomina">Nómina</a>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page test-page">
    <section class="hero">
      <div>
        <div class="eyebrow">Exclusivo DEV</div>
        <h1>Pruebas de asistencia, nómina y WhatsApp</h1>
        <p>Crea solicitudes aisladas, asigna únicamente sujetos de prueba, registra horarios manuales y valida envíos con una cuenta secundaria.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones/solicitudes">Crear otra solicitud</a>
        <a class="btn wa-link" href="/admin/operaciones/pruebas/whatsapp">Vincular WhatsApp de pruebas</a>
        <a class="btn payroll-link" href="/admin/operaciones/asistencia/nomina?includeTest=true">Abrir Nómina con pruebas</a>
      </div>
    </section>

    <% if (message) { %><div class="section-note"><%= message %></div><% } %>
    <% if (error) { %><div class="section-note" style="border-color:#fecaca;background:#fff5f5;color:#b91c1c"><%= error %></div><% } %>
    <div class="test-note"><strong>Aislamiento aplicado:</strong> estas solicitudes usan <code><%= testRequestSource %></code>, no autoasignan personal real y no aparecen en Nómina normal. Los mensajes se envían manualmente desde una segunda sesión de <code>whatsapp-web.js</code>; nunca utilizan ni cierran la cuenta operativa.</div>

    <section class="test-layout">
      <aside class="card">
        <div class="card-body">
          <div class="section-head"><div><h2>Solicitudes de prueba</h2><p>Últimas 100 solicitudes creadas desde DEV.</p></div></div>
          <div class="request-list">
            <% if (!workspace.requests.length) { %><div class="empty-test">Todavía no hay solicitudes de prueba.</div><% } %>
            <% for (const request of workspace.requests) {
              const dateKey = request.serviceDate ? new Date(request.serviceDate).toISOString().slice(0,10) : '';
            %>
              <a class="request-card <%= workspace.selectedRequest?.id === request.id ? 'active' : '' %>" href="/admin/operaciones/pruebas?serviceRequestId=<%= request.id %>">
                <span class="test-badge">PRUEBA</span>
                <strong><%= request.clientName %> · <%= request.operationPointName || 'Sin operación' %></strong>
                <small><%= dateKey %> · <%= request.startTime || '—' %><%= request.endTime ? ` - ${request.endTime}` : '' %></small>
                <small><%= request.assignments.length %> asignación(es) · <%= request.requiredWorkers %> requeridos</small>
              </a>
            <% } %>
          </div>
        </div>
      </aside>

      <section class="assignment-grid">
        <% const selected = workspace.selectedRequest; %>
        <% if (!selected) { %>
          <div class="card"><div class="empty-test">Crea una solicitud con el check de prueba o selecciona una existente.</div></div>
        <% } else {
          const selectedDate = selected.serviceDate ? new Date(selected.serviceDate).toISOString().slice(0,10) : '';
        %>
          <section class="card">
            <div class="card-body">
              <div class="assignment-head">
                <div><span class="test-badge">SOLICITUD AISLADA</span><h2 style="margin-top:8px"><%= selected.clientName %> · <%= selected.operationPointName || 'Sin operación' %></h2><p class="muted"><%= selectedDate %> · <%= selected.startTime || '—' %><%= selected.endTime ? ` - ${selected.endTime}` : '' %> · <%= selected.requiredWorkers %> auxiliar(es)</p></div>
                <a class="btn payroll-link" href="/admin/operaciones/asistencia/nomina?periodType=CUSTOM&from=<%= selectedDate %>&to=<%= selectedDate %>&clientId=<%= selected.operationPoint?.clientId || '' %>&includeTest=true">Calcular esta fecha</a>
              </div>

              <form class="assign-row" method="post" action="/admin/operaciones/pruebas/solicitudes/<%= selected.id %>/asignar" style="margin-top:14px">
                <div class="field"><label>Sujeto de prueba</label><select name="workerId" required><option value="">Selecciona</option><% for (const worker of workspace.availableWorkers) { %><option value="<%= worker.id %>"><%= worker.fullName %><%= worker.documentNumber ? ` · ${worker.documentNumber}` : '' %></option><% } %></select><small>Solo aparecen auxiliares con <code>isTestProfile=true</code>.</small></div>
                <button class="btn btn-primary" type="submit" <%= workspace.availableWorkers.length ? '' : 'disabled' %>>Asignar y confirmar</button>
              </form>
            </div>
          </section>

          <% if (!selected.assignments.length) { %><div class="card"><div class="empty-test">Asigna un sujeto de prueba para registrar la jornada manual.</div></div><% } %>
          <% for (const assignment of selected.assignments) {
            const session = assignment.attendanceSession;
            const mark = (type) => (session?.marks || []).filter((item) => item.markType === type).slice(-1)[0] || null;
            const defaults = defaultDevTestTimes(selected);
            const arrivalValue = formatBogotaDateTimeLocal(session?.arrivalReportedAt) || defaults.arrivalAt;
            const breakStartValue = formatBogotaDateTimeLocal(mark('BREAK_START')?.clientCapturedAt || mark('BREAK_START')?.serverReceivedAt);
            const breakEndValue = formatBogotaDateTimeLocal(mark('BREAK_END')?.clientCapturedAt || mark('BREAK_END')?.serverReceivedAt);
            const departureValue = formatBogotaDateTimeLocal(session?.departureReportedAt) || defaults.departureAt;
          %>
            <article class="assignment-card">
              <div class="assignment-head">
                <div><h2><%= assignment.worker.fullName %></h2><p class="muted"><%= assignment.worker.documentNumber || 'Sin documento' %> · Estado <span class="<%= assignment.status === 'DEV_TEST_CONFIRMED' ? 'status-confirmed' : '' %>"><%= assignment.status %></span></p></div>
                <div class="actions">
                  <a class="btn payroll-link" href="/admin/operaciones/asistencia/nomina?periodType=CUSTOM&from=<%= selectedDate %>&to=<%= selectedDate %>&clientId=<%= selected.operationPoint?.clientId || '' %>&workerId=<%= assignment.worker.id %>&includeTest=true">Ver resultado</a>
                  <form method="post" action="/admin/operaciones/pruebas/asignaciones/<%= assignment.id %>/quitar"><input type="hidden" name="serviceRequestId" value="<%= selected.id %>" /><button class="btn danger-btn" type="submit">Quitar</button></form>
                </div>
              </div>

              <section class="wa-test" data-wa-test data-phone="<%= assignment.worker.phone || '' %>" data-assignment-id="<%= assignment.id %>" data-service-request-id="<%= selected.id %>" data-worker-id="<%= assignment.worker.id %>" data-recipient-name="<%= assignment.worker.fullName %>" data-client="<%= selected.clientName || '' %>" data-operation="<%= selected.operationPointName || '' %>" data-address="<%= selected.address || selected.operationPoint?.address || '' %>" data-city="<%= selected.cityName || selected.operationPoint?.cityName || '' %>" data-service="<%= selected.serviceName || selected.service?.name || '' %>" data-date="<%= selectedDate %>" data-start="<%= selected.startTime || '' %>">
                <div class="wa-test-head">
                  <div><strong>Prueba de mensaje y confirmación</strong><p class="muted"><%= assignment.worker.phone ? `Destino: ${assignment.worker.phone}` : 'Este sujeto no tiene teléfono registrado.' %></p></div>
                  <a class="btn" href="/admin/operaciones/pruebas/whatsapp">Estado de la cuenta secundaria</a>
                </div>
                <textarea data-wa-message <%= assignment.worker.phone ? '' : 'disabled' %>></textarea>
                <div class="actions">
                  <button class="btn wa-link" type="button" data-wa-send <%= assignment.worker.phone ? '' : 'disabled' %>>Enviar desde WhatsApp de pruebas</button>
                </div>
                <div class="wa-result" data-wa-result role="status" aria-live="polite"></div>
              </section>

              <form method="post" action="/admin/operaciones/pruebas/asignaciones/<%= assignment.id %>/jornada">
                <input type="hidden" name="serviceRequestId" value="<%= selected.id %>" />
                <div class="manual-grid">
                  <div class="field"><label>Entrada</label><input type="datetime-local" name="arrivalAt" value="<%= arrivalValue %>" required /></div>
                  <div class="field"><label>Inicio de almuerzo (opcional)</label><input type="datetime-local" name="breakStartAt" value="<%= breakStartValue %>" /><small>Déjalo vacío si el auxiliar no tomó almuerzo; no se descontará tiempo.</small></div>
                  <div class="field"><label>Regreso de almuerzo (opcional)</label><input type="datetime-local" name="breakEndAt" value="<%= breakEndValue %>" /><small>Solo diligéncialo si registraste el inicio; se descontará únicamente el tiempo realmente tomado.</small></div>
                  <div class="field"><label>Salida de turno</label><input type="datetime-local" name="departureAt" value="<%= departureValue %>" required /></div>
                  <div class="field full"><label>Nota de la prueba</label><input name="notes" placeholder="Ejemplo: validar HENO y recargo dominical" /></div>
                </div>
                <div class="form-actions"><button class="btn btn-primary" type="submit">Guardar jornada y calcular</button></div>
              </form>
            </article>
          <% } %>
        <% } %>
      </section>
    </section>
  </main>

  <script>
    const currentProductionAssignmentTemplate = 'Hola {{nombre}}, te confirmamos asignación para {{fecha}} en {{operacion}}. Dirección: {{direccion}}. Hora de inicio: {{horaInicio}}. Servicio: {{servicio}}. Cliente: {{cliente}}. Por favor confirma recibido.';
    const testWhatsappPanels = Array.from(document.querySelectorAll('[data-wa-test]'));

    function renderAssignmentMessage(template, panel) {
      const values = {
        nombre: panel.dataset.recipientName || '',
        cliente: panel.dataset.client || '',
        operacion: panel.dataset.operation || '',
        direccion: panel.dataset.address || '',
        ciudad: panel.dataset.city || '',
        servicio: panel.dataset.service || '',
        fecha: panel.dataset.date || '',
        horaInicio: panel.dataset.start || ''
      };
      return String(template || '').replace(/\{\{\s*(nombre|cliente|operacion|direccion|ciudad|servicio|fecha|horaInicio)\s*\}\}/g, (_match, key) => values[key] || '');
    }

    testWhatsappPanels.forEach((panel) => {
      const button = panel.querySelector('[data-wa-send]');
      const messageInput = panel.querySelector('[data-wa-message]');
      const result = panel.querySelector('[data-wa-result]');
      if (messageInput) messageInput.value = renderAssignmentMessage(currentProductionAssignmentTemplate, panel);
      if (result) result.textContent = 'Mensaje vigente del tablero operativo cargado.';

      button?.addEventListener('click', async () => {
        const message = messageInput?.value?.trim() || '';
        result.classList.remove('error');
        if (!message) {
          result.textContent = 'Escribe el mensaje que deseas probar.';
          result.classList.add('error');
          return;
        }
        button.disabled = true;
        result.textContent = 'Enviando desde la cuenta secundaria...';
        try {
          const response = await fetch('/admin/operaciones/pruebas/whatsapp/enviar', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              phone: panel.dataset.phone,
              message,
              context: {
                assignmentId: panel.dataset.assignmentId,
                serviceRequestId: panel.dataset.serviceRequestId,
                workerId: panel.dataset.workerId,
                recipientName: panel.dataset.recipientName
              }
            })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.message || `No fue posible enviar el mensaje (${response.status}).`);
          result.textContent = `Mensaje enviado a ${data.phone}. Esperando que el sujeto responda CONFIRMADO, Sí, Ok o una variante válida.`;
        } catch (error) {
          result.textContent = error.message || 'No fue posible enviar el WhatsApp de prueba.';
          result.classList.add('error');
        } finally {
          button.disabled = !panel.dataset.phone;
        }
      });
    });
  </script>
</body>
</html>
