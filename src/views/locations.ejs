<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sucursales — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <style>
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    :root {
      --bg:#f4f5f7; --surface:#fff; --surface-2:#f9fafb; --border:#e1e4e8;
      --text:#1a1d23; --muted:#6b7280; --navy:#1e2d3d; --teal:#0d7a6b;
      --teal-hover:#0a5f53; --teal-light:#e6f4f1; --red:#dc2626; --red-light:#fee2e2;
      --green:#16a34a; --green-light:#dcfce7; --amber:#b45309; --amber-light:#fef3c7;
      --blue:#1d4ed8; --blue-light:#dbeafe; --shadow:0 1px 3px rgba(0,0,0,.08);
      --radius:10px; --font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    }
    body { font-family:var(--font); background:var(--bg); color:var(--text); font-size:14px; line-height:1.5; }
    .navbar { background:var(--navy); padding:0 24px; display:flex; align-items:center; gap:20px; min-height:52px; position:sticky; top:0; z-index:100; }
    .navbar a { color:#cbd5e0; text-decoration:none; font-size:13px; font-weight:600; padding:4px 2px; border-bottom:2px solid transparent; }
    .navbar a:hover,.navbar a.nav-active { color:#fff; border-bottom-color:#4fd1c5; }
    .navbar .brand img { height:28px; display:block; }
    .navbar .spacer { flex:1; }
    .btn-logout { background:transparent; border:1px solid rgba(255,255,255,.25); color:#cbd5e0; padding:6px 12px; border-radius:7px; cursor:pointer; }
    .page { max-width:1180px; margin:0 auto; padding:28px 20px 60px; }
    .page-header { margin-bottom:22px; }
    .page-header h1 { color:var(--navy); font-size:24px; margin-bottom:4px; }
    .page-header p { color:var(--muted); font-size:13px; max-width:900px; }
    .alert { padding:10px 14px; border-radius:var(--radius); margin-bottom:16px; font-weight:700; }
    .alert-success { background:var(--green-light); color:var(--green); }
    .alert-error { background:var(--red-light); color:var(--red); }
    .branch-list { display:grid; gap:18px; }
    .branch-card { background:var(--surface); border:1px solid var(--border); border-radius:16px; box-shadow:var(--shadow); overflow:hidden; }
    .branch-header { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px 18px; background:var(--surface-2); border-bottom:1px solid var(--border); }
    .branch-title { display:flex; align-items:center; gap:9px; flex-wrap:wrap; }
    .branch-name { color:var(--navy); font-size:17px; font-weight:850; }
    .count,.pill { display:inline-flex; align-items:center; border-radius:999px; padding:3px 9px; font-size:11px; font-weight:800; }
    .count { background:var(--teal-light); color:var(--teal); }
    .pill-open { background:var(--green-light); color:var(--green); }
    .pill-paused { background:var(--amber-light); color:var(--amber); }
    .pill-closed { background:var(--red-light); color:var(--red); }
    .pill-info { background:var(--blue-light); color:var(--blue); }
    .actions,.inline-form,.toggle-row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .actions form { display:inline-flex; margin:0; }
    .btn { display:inline-flex; align-items:center; justify-content:center; border:0; border-radius:8px; padding:8px 12px; font-size:12px; font-weight:750; cursor:pointer; text-decoration:none; }
    .btn-primary { background:var(--teal); color:#fff; }
    .btn-primary:hover { background:var(--teal-hover); }
    .btn-secondary { background:#fff; color:var(--navy); border:1px solid var(--border); }
    .btn-danger { background:var(--red-light); color:var(--red); border:1px solid #fecaca; }
    .btn-sm { padding:5px 9px; font-size:11px; }
    .edit-panel { display:none; padding:12px 18px; background:var(--teal-light); border-bottom:1px solid var(--border); }
    input,select,textarea { width:100%; border:1px solid var(--border); border-radius:8px; padding:9px 10px; font:inherit; background:#fff; color:var(--text); }
    textarea { min-height:88px; resize:vertical; }
    input:focus,select:focus,textarea:focus { outline:none; border-color:var(--teal); box-shadow:0 0 0 3px rgba(13,122,107,.12); }
    .operations { padding:14px 18px; display:grid; gap:12px; }
    .operation-card { border:1px solid #e7eaee; border-radius:12px; background:var(--surface-2); overflow:hidden; }
    .operation-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 14px; }
    .operation-name { font-weight:800; color:var(--navy); font-size:14px; }
    .operation-body { padding:0 14px 14px; display:grid; gap:10px; }
    .config-card { border:1px solid var(--border); border-radius:10px; background:#fff; overflow:hidden; }
    .config-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:11px 12px; border-bottom:1px solid #eef0f3; }
    .config-title { font-weight:800; color:var(--navy); }
    .config-sub { color:var(--muted); font-size:11px; margin-top:2px; }
    .config-editor { display:none; padding:14px; }
    .config-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    .field { display:grid; gap:5px; }
    .field.full { grid-column:1 / -1; }
    .field label { font-size:11px; color:var(--muted); font-weight:800; text-transform:uppercase; letter-spacing:.03em; }
    .checkbox { display:inline-flex; align-items:center; gap:7px; font-size:12px; font-weight:700; color:var(--navy); text-transform:none!important; letter-spacing:0!important; }
    .checkbox input { width:16px; height:16px; margin:0; accent-color:var(--teal); }
    .config-note { padding:10px 12px; border-radius:8px; background:#fff7ed; color:#9a3412; font-size:11px; }
    .schedule-summary { margin-top:8px; color:var(--muted); font-size:11px; }
    details.create-operation { margin:4px 18px 16px; border:1px dashed #9bb9b4; border-radius:10px; background:#f8fffd; }
    details.create-operation summary { cursor:pointer; padding:11px 13px; color:var(--teal); font-weight:800; }
    .create-operation-body { padding:4px 13px 14px; }
    .new-branch { margin-top:20px; padding:18px; border:2px dashed var(--border); border-radius:14px; background:var(--surface); }
    .new-branch h2 { font-size:14px; color:var(--navy); margin-bottom:10px; }
    .empty { color:var(--muted); font-size:12px; padding:5px 0; }
    .help { color:var(--muted); font-size:11px; }
    .saving { opacity:.62; pointer-events:none; }
    [hidden] { display:none !important; }
    @media(max-width:760px){
      .navbar{flex-wrap:wrap;padding:10px 14px;gap:10px 14px}.navbar .spacer{display:none}.navbar form{width:100%}.btn-logout{width:100%}
      .page{padding:20px 12px 40px}.branch-header,.operation-head,.config-head{align-items:flex-start;flex-direction:column}.actions{width:100%}.inline-form{align-items:stretch;flex-direction:column}.inline-form .btn{width:100%}.config-grid{grid-template-columns:1fr}.field.full{grid-column:1}
    }
  </style>
</head>
<body>
<nav class="navbar">
  <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
  <a href="/admin">Panel</a>
  <a href="/admin/locations" class="nav-active">Sucursales</a>
  <% if (role === 'dev' || (typeof canAccessDispatch !== 'undefined' && canAccessDispatch)) { %><a href="/admin/operaciones">Operaciones / Despacho</a><% } %>
  <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
  <span class="spacer"></span>
  <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
</nav>

<main class="page">
  <header class="page-header">
    <h1>Sucursales</h1>
    <p>Administra las sucursales disponibles.</p>
  </header>

  <% if (successMsg) { %><div class="alert alert-success"><%= successMsg %></div><% } %>
  <% if (errorMsg) { %><div class="alert alert-error"><%= errorMsg %></div><% } %>

  <section class="branch-list">
    <% if (!cities.length) { %><div class="empty">No hay sucursales registradas.</div><% } %>
    <% for (const city of cities) { %>
      <article class="branch-card">
        <div class="branch-header">
          <div class="branch-title">
            <span class="branch-name"><%= city.name %></span>
            <span class="count"><%= city.operations.length %> operación<%= city.operations.length === 1 ? '' : 'es' %></span>
          </div>
          <div class="actions">
            <button type="button" class="btn btn-secondary btn-sm" data-toggle-target="edit-branch-<%= city.id %>">Editar sucursal</button>
            <% if (city.operations.length === 0) { %>
              <form method="post" action="/admin/locations/cities/<%= city.id %>/delete" data-confirm-title="Eliminar sucursal" data-confirm-text="Se eliminará la sucursal <%= city.name %>. Esta acción solo está disponible si no tiene operaciones.">
                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
              </form>
            <% } %>
          </div>
        </div>

        <div class="edit-panel" id="edit-branch-<%= city.id %>">
          <form method="post" action="/admin/locations/cities/<%= city.id %>/edit" class="inline-form">
            <input type="text" name="name" value="<%= city.name %>" required placeholder="Nombre de la sucursal" />
            <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
            <button type="button" class="btn btn-secondary btn-sm" data-toggle-target="edit-branch-<%= city.id %>">Cancelar</button>
          </form>
          <% if (city.operations.length) { %><div class="help" style="margin-top:8px;">Por seguridad de referencias históricas, una sucursal con operaciones no se renombra directamente.</div><% } %>
        </div>

        <div class="operations">
          <% if (!city.operations.length) { %><div class="empty">Sin operaciones configuradas.</div><% } %>
          <% for (const op of city.operations) { %>
            <section class="operation-card">
              <div class="operation-head">
                <div class="operation-name"><%= op.name %></div>
                <div class="actions">
                  <button type="button" class="btn btn-secondary btn-sm" data-toggle-target="edit-op-<%= op.id %>">Renombrar</button>
                  <% if (op.vacancies.length === 0) { %>
                    <form method="post" action="/admin/locations/operations/<%= op.id %>/delete" data-confirm-title="Eliminar operación" data-confirm-text="Se eliminará la operación <%= op.name %>.">
                      <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                  <% } %>
                </div>
              </div>

              <div class="edit-panel" id="edit-op-<%= op.id %>">
                <form method="post" action="/admin/locations/operations/<%= op.id %>/edit" class="inline-form">
                  <input type="text" name="name" value="<%= op.name %>" required placeholder="Nombre de la operación" />
                  <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                  <button type="button" class="btn btn-secondary btn-sm" data-toggle-target="edit-op-<%= op.id %>">Cancelar</button>
                </form>
              </div>

              <div class="operation-body">
                <% if (op.vacancies.length === 0) { %>
                  <div class="config-note">Esta operación todavía no tiene una vacante configurada para Lórren.</div>
                  <form method="post" action="/admin/vacancies/create" class="config-grid" data-vacancy-config-form>
                    <%- include('partials/locationOperationConfigFields', { prefix: 'legacy-' + op.id, config: null, defaultTitle: op.name, operationId: op.id }) %>
                    <div class="field full"><button type="submit" class="btn btn-primary">Guardar y activar vacante</button></div>
                  </form>
                <% } %>

                <% for (const config of op.vacancies) { %>
                  <% const isOpen = Boolean(config.isActive && config.acceptingApplications); %>
                  <% const isPaused = Boolean(config.isActive && !config.acceptingApplications); %>
                  <% const statusClass = !config.isActive ? 'pill-closed' : (isOpen ? 'pill-open' : 'pill-paused'); %>
                  <% const statusLabel = !config.isActive ? 'Inactiva' : (isOpen ? 'Activa' : 'Pausada'); %>
                  <% const toggleLabel = isOpen ? 'Pausar' : (isPaused ? 'Reabrir' : 'Activar'); %>
                  <% const reviewLabel = config.dashboardReviewEnabled ? 'Fin de revisión HV' : 'Revisar hojas de vida'; %>
                  <article class="config-card">
                    <div class="config-head">
                      <div>
                        <div class="config-title"><%= config.title %></div>
                        <div class="config-sub"><%= config.role %> · <%= config.operationAddress %></div>
                        <div class="schedule-summary">
                          <%= config._count?.candidates || 0 %> candidato<%= (config._count?.candidates || 0) === 1 ? '' : 's' %>
                          <% if (config.schedulingEnabled) { %> · <%= config.interviewSlots?.length || 0 %> horario<%= (config.interviewSlots?.length || 0) === 1 ? '' : 's' %> de entrevista<% } else { %> · Solo postulación<% } %>
                        </div>
                      </div>
                      <div class="actions">
                        <span class="pill <%= statusClass %>"><%= statusLabel %></span>
                        <% if (config.dashboardReviewEnabled && isPaused) { %><span class="pill pill-info">Revisión HV en panel</span><% } %>
                        <% if (config.schedulingEnabled) { %><span class="pill pill-info">Con entrevistas</span><% } %>
                        <form method="post" action="/admin/vacancies/<%= config.id %>/toggle" data-vacancy-action-form data-success="Estado de la vacante actualizado.">
                          <button type="submit" class="btn <%= isOpen ? 'btn-danger' : 'btn-secondary' %> btn-sm"><%= toggleLabel %></button>
                        </form>
                        <% if (isPaused) { %>
                          <form method="post" action="/admin/vacancies/<%= config.id %>/toggle-review" data-vacancy-action-form data-success="Revisión de hojas de vida actualizada.">
                            <button type="submit" class="btn <%= config.dashboardReviewEnabled ? 'btn-danger' : 'btn-secondary' %> btn-sm"><%= reviewLabel %></button>
                          </form>
                        <% } %>
                        <button type="button" class="btn btn-secondary btn-sm" data-toggle-target="config-<%= config.id %>">Editar información</button>
                      </div>
                    </div>
                    <div class="config-editor" id="config-<%= config.id %>">
                      <form method="post" action="/admin/vacancies/<%= config.id %>/edit" class="config-grid" data-vacancy-config-form>
                        <%- include('partials/locationOperationConfigFields', { prefix: config.id, config, defaultTitle: op.name, operationId: op.id }) %>
                        <div class="field full"><div class="help">Identificador técnico: <strong><%= config.key %></strong>. Se conserva para campañas, candidatos y referencias existentes.</div></div>
                        <div class="field full"><button type="submit" class="btn btn-primary">Guardar información</button></div>
                      </form>
                    </div>
                  </article>
                <% } %>
              </div>
            </section>
          <% } %>
        </div>

        <details class="create-operation">
          <summary>+ Crear operación en <%= city.name %></summary>
          <div class="create-operation-body">
            <form method="post" action="/admin/locations/cities/<%= city.id %>/operations" class="config-grid" data-create-operation-form>
              <div class="field full">
                <label for="op-name-<%= city.id %>">Nombre de la operación</label>
                <input id="op-name-<%= city.id %>" type="text" name="name" required placeholder="Ej: Siberia, Montevideo, Zona industrial" />
              </div>
              <%- include('partials/locationOperationConfigFields', { prefix: 'new-' + city.id, config: null, defaultTitle: '', operationId: '' }) %>
              <div class="field full"><button type="submit" class="btn btn-primary">Crear operación y activar vacante</button></div>
            </form>
          </div>
        </details>
      </article>
    <% } %>
  </section>

  <section class="new-branch">
    <h2>Nueva sucursal</h2>
    <form method="post" action="/admin/locations/cities" class="inline-form">
      <input type="text" name="name" required placeholder="Ej: Bogotá, Cali, Barranquilla" />
      <button type="submit" class="btn btn-primary">Crear sucursal</button>
    </form>
  </section>
</main>
<script src="/public/lorren-dialog.js"></script>
<script>
  document.querySelectorAll('[data-toggle-target]').forEach((button) => {
    button.addEventListener('click', () => {
      const target = document.getElementById(button.dataset.toggleTarget);
      if (!target) return;
      const isOpen = target.style.display === 'block';
      target.style.display = isOpen ? 'none' : 'block';
    });
  });

  document.querySelectorAll('form[data-confirm-title]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      if (form.dataset.confirmed === 'true') return;
      event.preventDefault();
      const accepted = await window.LorrenDialog.confirm({
        title: form.dataset.confirmTitle || 'Confirmar acción',
        text: form.dataset.confirmText || '¿Deseas continuar?',
        tone: 'danger',
        confirmLabel: 'Sí, eliminar'
      });
      if (!accepted) return;
      form.dataset.confirmed = 'true';
      form.requestSubmit();
    });
  });

  function syncInterviewFields(toggle) {
    const form = toggle.closest('form');
    if (!form) return;
    form.querySelectorAll('[data-interview-field]').forEach((field) => {
      field.hidden = !toggle.checked;
    });
  }

  document.querySelectorAll('[data-scheduling-toggle]').forEach((toggle) => {
    syncInterviewFields(toggle);
    toggle.addEventListener('change', () => syncInterviewFields(toggle));
  });

  function formParams(form) {
    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form).entries()) params.append(key, value);
    return params;
  }

  function locationsUrlFromAdminResponse(response, fallbackSuccess) {
    const finalUrl = new URL(response.url || '/admin/vacancies', window.location.origin);
    const params = new URLSearchParams();
    const error = finalUrl.searchParams.get('error');
    const success = finalUrl.searchParams.get('success');
    if (error) params.set('error', error);
    else params.set('success', success || fallbackSuccess);
    return `/admin/locations?${params.toString()}`;
  }

  async function postCanonicalVacancy(action, params, fallbackSuccess) {
    const response = await fetch(action, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
      body: params,
      credentials: 'same-origin',
      redirect: 'follow'
    });
    if (!response.ok && !response.redirected) {
      return `/admin/locations?error=${encodeURIComponent('No fue posible guardar la configuración de la vacante.')}`;
    }
    return locationsUrlFromAdminResponse(response, fallbackSuccess);
  }

  document.querySelectorAll('form[data-vacancy-action-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.classList.contains('saving')) return;
      form.classList.add('saving');
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          credentials: 'same-origin',
          redirect: 'follow'
        });
        if (!response.ok && !response.redirected) {
          window.location.assign('/admin/locations?error=' + encodeURIComponent('No fue posible actualizar el estado de la vacante.'));
          return;
        }
        window.location.assign(locationsUrlFromAdminResponse(response, form.dataset.success || 'Estado de la vacante actualizado.'));
      } catch (_error) {
        window.location.assign('/admin/locations?error=' + encodeURIComponent('No fue posible actualizar el estado de la vacante.'));
      }
    });
  });

  document.querySelectorAll('form[data-vacancy-config-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.classList.contains('saving')) return;
      form.classList.add('saving');
      try {
        const nextUrl = await postCanonicalVacancy(form.action, formParams(form), 'Configuración de la vacante guardada.');
        window.location.assign(nextUrl);
      } catch (_error) {
        window.location.assign('/admin/locations?error=' + encodeURIComponent('No fue posible guardar la configuración de la vacante.'));
      }
    });
  });

  document.querySelectorAll('form[data-create-operation-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.classList.contains('saving')) return;
      form.classList.add('saving');
      try {
        const allParams = formParams(form);
        const operationParams = new URLSearchParams();
        operationParams.set('name', allParams.get('name') || '');
        operationParams.set('returnJson', 'true');
        const operationResponse = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'Accept': 'application/json'
          },
          body: operationParams,
          credentials: 'same-origin'
        });
        const operationPayload = await operationResponse.json().catch(() => ({}));
        if (!operationResponse.ok || !operationPayload?.operation?.id) {
          const message = operationPayload?.error || 'No fue posible crear la operación.';
          window.location.assign('/admin/locations?error=' + encodeURIComponent(message));
          return;
        }

        allParams.delete('name');
        allParams.set('operationId', operationPayload.operation.id);
        const nextUrl = await postCanonicalVacancy('/admin/vacancies/create', allParams, `Operación "${operationPayload.operation.name}" creada y vacante activada.`);
        window.location.assign(nextUrl);
      } catch (_error) {
        window.location.assign('/admin/locations?error=' + encodeURIComponent('La operación no pudo completarse. Si la operación quedó creada, puedes abrirla y completar su configuración.'));
      }
    });
  });

  setTimeout(() => document.querySelectorAll('.alert').forEach((item) => item.remove()), 5000);
</script>
</body>
</html>