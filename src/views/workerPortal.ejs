<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#176c36">
  <title>Portal del Auxiliar · Lórren</title>
  <link rel="manifest" href="/operaciones/portal/manifest.webmanifest">
  <link rel="icon" href="/operaciones/portal/icon.svg" type="image/svg+xml">
  <style>
    :root { color-scheme: light; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; padding: max(20px, env(safe-area-inset-top)) 18px max(28px, env(safe-area-inset-bottom)); background: #f4f6f8; color: #17212b; }
    main { width: min(100%, 580px); margin: 0 auto; }
    .shell, .assignment-card { background: #fff; border: 1px solid #dfe4ea; border-radius: 20px; box-shadow: 0 12px 36px rgba(23, 33, 43, .08); }
    .shell { padding: 26px; }
    .brand { margin: 0 0 10px; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #4d5b69; }
    h1 { margin: 0 0 10px; font-size: clamp(27px, 8vw, 36px); line-height: 1.08; }
    h2 { margin: 0; font-size: 20px; line-height: 1.2; }
    p { margin: 0; color: #4d5b69; line-height: 1.55; }
    button { font: inherit; }
    .status { margin-top: 18px; padding: 15px; border-radius: 12px; background: #f2f5f7; font-weight: 650; color: #263645; }
    .ok { background: #eaf8ef; color: #176c36; }
    .warning { background: #fff6df; color: #76520b; }
    .danger { background: #fdecec; color: #8f2525; }
    .portal-header { display: flex; gap: 14px; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
    .session-chip { flex: 0 0 auto; padding: 8px 10px; border-radius: 999px; background: #eaf8ef; color: #176c36; font-size: 12px; font-weight: 800; }
    .connectivity-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding: 12px 14px; border: 1px solid #dfe4ea; border-radius: 14px; background: #fff; font-size: 13px; }
    .connectivity-dot { width: 10px; height: 10px; border-radius: 999px; background: #176c36; box-shadow: 0 0 0 4px #eaf8ef; flex: 0 0 auto; }
    .connectivity-bar.offline { background: #fff9e9; border-color: #efd89a; }
    .connectivity-bar.offline .connectivity-dot { background: #a66d00; box-shadow: 0 0 0 4px #fff0bd; }
    .assignment-list { display: grid; gap: 14px; }
    .assignment-card { padding: 18px; }
    .assignment-card.completed { border-color: #9dd4af; background: #fbfffc; }
    .assignment-date { margin-bottom: 8px; color: #176c36; font-size: 13px; font-weight: 800; text-transform: capitalize; }
    .assignment-time { margin-top: 5px; color: #263645; font-weight: 750; }
    .assignment-details { display: grid; gap: 7px; margin: 16px 0; font-size: 14px; }
    .detail-row { display: grid; grid-template-columns: 105px 1fr; gap: 10px; }
    .detail-label { color: #72808e; }
    .detail-value { color: #263645; font-weight: 600; overflow-wrap: anywhere; }
    .action-grid { display: grid; gap: 9px; }
    .mark-button, .primary-button, .secondary-button { width: 100%; min-height: 52px; border: 0; border-radius: 12px; padding: 14px 16px; font-weight: 800; cursor: pointer; }
    .mark-button, .primary-button { background: #176c36; color: #fff; }
    .mark-button.break { background: #a16610; }
    .mark-button.departure { background: #1f5b8f; }
    .secondary-button { background: #edf1f4; color: #263645; }
    button:disabled { cursor: not-allowed; opacity: .55; }
    .empty-state { padding: 24px; border: 1px dashed #cfd7df; border-radius: 16px; text-align: center; background: #fff; }

    dialog { width: min(calc(100% - 24px), 520px); max-height: calc(100vh - 28px); border: 0; border-radius: 20px; padding: 0; box-shadow: 0 24px 70px rgba(23, 33, 43, .28); }
    dialog::backdrop { background: rgba(12, 21, 29, .72); }
    .dialog-body { padding: 22px; overflow-y: auto; max-height: calc(100vh - 28px); }
    .dialog-head { display: flex; justify-content: space-between; gap: 16px; align-items: center; margin-bottom: 14px; }
    .icon-button { width: 52px; min-width: 52px; height: 52px; border: 0; border-radius: 999px; background: #edf1f4; color: #263645; font-size: 30px; line-height: 1; cursor: pointer; }
    .step { margin-top: 12px; padding: 14px; border-radius: 14px; background: #f5f7f9; }
    .step-title { margin-bottom: 6px; font-weight: 800; color: #263645; }
    .step-copy { font-size: 14px; }
    .face-stage { position: relative; overflow: hidden; margin-top: 10px; border-radius: 14px; background: #05090c; aspect-ratio: 3 / 4; }
    .face-stage video, .face-stage .photo-preview { display: block; width: 100%; height: 100%; margin: 0; object-fit: contain; background: #05090c; }
    .face-stage video { transform: scaleX(-1); }
    .face-stage .photo-preview[hidden], .face-stage video[hidden] { display: none; }
    .face-frame { position: absolute; left: 50%; top: 50%; width: 84%; height: 88%; transform: translate(-50%, -50%); border: 3px solid rgba(255,255,255,.92); border-radius: 24px; box-shadow: 0 0 0 999px rgba(0,0,0,.14); pointer-events: none; }
    .camera-only { margin-top: 8px; font-size: 12px; font-weight: 750; color: #176c36; }
    .consent { display: flex; gap: 14px; align-items: center; margin: 0; padding: 15px; border: 2px solid #176c36; border-radius: 14px; background: #f1faf4; color: #17212b; font-size: 18px; line-height: 1.35; font-weight: 700; }
    .consent input { width: 32px; min-width: 32px; height: 32px; margin: 0; flex: 0 0 auto; accent-color: #176c36; }
    .mark-status { margin: 0; min-height: 62px; display: flex; align-items: center; font-size: clamp(18px, 4.8vw, 23px); line-height: 1.3; font-weight: 800; border: 2px solid #cbd6de; }
    #biometric-instruction { margin-top: 0; font-size: clamp(18px, 4.8vw, 23px); line-height: 1.3; font-weight: 800; color: #102a1b; }
    #retry-biometric { width: 100%; min-height: 58px; margin-top: 10px; border: 0; border-radius: 14px; background: #176c36; color: #fff; font-size: 18px; font-weight: 850; cursor: pointer; }
    .dialog-actions { display: grid; gap: 10px; margin-top: 14px; }
    #submit-mark { min-height: 60px; font-size: 19px; }
    #cancel-mark { min-height: 50px; }

    @media (max-width: 760px) {
      body:has(#mark-dialog[open]), body:has(#enrollment-dialog[open]) { overflow: hidden; }
      #mark-dialog, #enrollment-dialog { inset: 0; width: 100vw; max-width: none; height: 100dvh; max-height: 100dvh; margin: 0; border-radius: 0; }
      #mark-dialog .dialog-body {
        display: grid;
        grid-template-rows: auto auto auto minmax(0, 1fr) auto auto;
        gap: 10px;
        width: 100%;
        height: 100dvh;
        max-height: 100dvh;
        padding: max(8px, env(safe-area-inset-top)) 12px max(8px, env(safe-area-inset-bottom));
        overflow: hidden;
      }
      #mark-dialog .dialog-head { margin: 0; min-height: 56px; }
      #photo-consent-wrap { grid-row: 2; }
      #mark-result { grid-row: 3; }
      #camera-step {
        grid-row: 4;
        min-height: 0;
        margin: 0;
        padding: 6px;
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr) auto;
        overflow: hidden;
      }
      #camera-step[hidden] { display: none; }
      #camera-step .face-stage { width: 100%; max-width: none; min-height: 0; height: 100%; margin: 8px auto 0; aspect-ratio: auto; }
      #location-step { grid-row: 5; margin: 0; padding: 9px 12px; }
      #location-step .step-title { display: inline; margin-right: 6px; }
      #location-step .step-copy { display: inline; }
      #mark-dialog .dialog-actions { grid-row: 6; margin: 0; padding-top: 8px; background: #fff; }
      #mark-dialog[data-flow-state="waiting-consent"] #camera-step { opacity: .55; }
      #enrollment-dialog .dialog-body { min-height: 100dvh; max-height: 100dvh; padding: max(12px, env(safe-area-inset-top)) 14px max(12px, env(safe-area-inset-bottom)); }
      #enrollment-dialog .face-stage { width: 100%; max-width: none; }
    }

    @media (max-width: 420px) {
      body { padding-left: 12px; padding-right: 12px; }
      .detail-row { grid-template-columns: 86px 1fr; }
      .consent { font-size: 17px; padding: 13px; }
      .mark-status, #biometric-instruction { font-size: 19px; }
    }
  </style>
</head>
<body>
  <main>
    <% if (mode === 'activation') { %>
      <section class="shell">
        <p class="brand">Lórren · Operaciones</p>
        <h1>Activando este dispositivo</h1>
        <div id="activation-status" class="status" role="status" aria-live="polite">Validando acceso…</div>
        <script nonce="<%= nonce %>">
          (() => {
            const status = document.getElementById('activation-status');
            const queryParams = new URLSearchParams(window.location.search);
            const fragment = window.location.hash.startsWith('#') ? window.location.hash.slice(1) : '';
            const fragmentParams = new URLSearchParams(fragment);
            const activationToken = queryParams.get('token') || fragmentParams.get('token') || (fragment.includes('=') ? '' : fragment);
            window.history.replaceState(null, document.title, window.location.pathname);
            if (!/^[A-Za-z0-9_-]{43}$/.test(activationToken || '')) {
              status.textContent = 'El enlace no es válido o está incompleto.';
              status.classList.add('warning');
              return;
            }
            fetch('/operaciones/portal/activar', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'worker-portal' },
              body: JSON.stringify({ activationToken })
            }).then(async (response) => {
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.ok) throw new Error('activation_rejected');
              status.textContent = 'Dispositivo activado.';
              status.classList.add('ok');
              window.location.replace(payload.redirectTo || '/operaciones/portal');
            }).catch(() => {
              status.textContent = 'El enlace venció o ya fue utilizado.';
              status.classList.add('warning');
            });
          })();
        </script>
      </section>
    <% } else if (mode === 'active') { %>
      <% const portalAssignments = Array.isArray(assignments) ? assignments : []; %>
      <header class="portal-header">
        <div><p class="brand">Lórren · Portal del Auxiliar</p><h1>Mi jornada</h1></div>
        <span class="session-chip">Dispositivo verificado</span>
      </header>
      <section id="portal-connectivity" class="connectivity-bar" aria-live="polite">
        <span class="connectivity-dot" aria-hidden="true"></span>
        <strong id="connectivity-title">Con conexión</strong>
      </section>

      <% if (portalAssignments.length) { %>
        <section class="assignment-list" aria-label="Asignaciones activas">
          <% portalAssignments.forEach((assignment) => { %>
            <article class="assignment-card <%= assignment.departureReported ? 'completed' : '' %>" data-assignment-card="<%= assignment.id %>">
              <p class="assignment-date"><%= assignment.dateLabel %></p>
              <h2><%= assignment.clientName %></h2>
              <p class="assignment-time"><%= assignment.timeLabel %></p>
              <div class="assignment-details">
                <div class="detail-row"><span class="detail-label">Operación</span><span class="detail-value"><%= assignment.operationPointName %></span></div>
                <div class="detail-row"><span class="detail-label">Ciudad</span><span class="detail-value"><%= assignment.cityName %></span></div>
                <div class="detail-row"><span class="detail-label">Dirección</span><span class="detail-value"><%= assignment.address %></span></div>
              </div>
              <div class="action-grid">
                <% if (!assignment.arrivalReported && !assignment.departureReported) { %>
                  <button type="button" class="mark-button" data-assignment-id="<%= assignment.id %>" data-mark-type="ARRIVAL" <%= assignment.canRegisterArrival ? '' : 'disabled' %>>Registrar llegada</button>
                <% } else if (!assignment.departureReported) { %>
                  <% if (assignment.breakActionType) { %>
                    <button type="button" class="mark-button break" data-assignment-id="<%= assignment.id %>" data-mark-type="<%= assignment.breakActionType %>"><%= assignment.breakActionType === 'BREAK_START' ? 'Iniciar almuerzo' : 'Finalizar almuerzo' %></button>
                  <% } %>
                  <button type="button" class="mark-button departure" data-assignment-id="<%= assignment.id %>" data-mark-type="DEPARTURE" <%= assignment.canRegisterDeparture ? '' : 'disabled' %>>Registrar salida</button>
                <% } else { %>
                  <button type="button" class="mark-button" disabled>Jornada finalizada</button>
                <% } %>
              </div>
            </article>
          <% }); %>
        </section>
      <% } else { %>
        <section class="empty-state"><h2>No tienes asignaciones activas</h2></section>
      <% } %>

      <dialog id="enrollment-dialog" aria-labelledby="enrollment-title">
        <div class="dialog-body">
          <div class="dialog-head"><div><p class="brand">Primer acceso</p><h2 id="enrollment-title">Registro facial inicial</h2></div></div>
          <label class="consent"><input type="checkbox" id="enrollment-consent"><span>Autorizo el registro facial para validar mi identidad en las marcaciones.</span></label>
          <p id="enrollment-status" class="status" role="status" aria-live="assertive">Autoriza el uso del rostro para comenzar.</p>
          <p class="camera-only">Solo cámara en vivo. No se aceptan archivos ni fotos guardadas.</p>
          <div class="face-stage">
            <video id="enrollment-video" playsinline autoplay muted hidden></video>
            <div class="face-frame" aria-hidden="true"></div>
          </div>
          <div class="dialog-actions"><button type="button" class="primary-button" id="start-enrollment">Registrar mi rostro</button></div>
        </div>
      </dialog>

      <dialog id="mark-dialog" aria-labelledby="mark-title" data-flow-state="idle">
        <div class="dialog-body">
          <div class="dialog-head">
            <div><p class="brand">Registro seguro</p><h2 id="mark-title">Confirmar marcación</h2></div>
            <button type="button" class="icon-button" id="close-mark" aria-label="Cerrar">×</button>
          </div>

          <label class="consent" id="photo-consent-wrap" hidden>
            <input type="checkbox" id="photo-consent">
            <span>Autorizo esta captura para validar mi identidad y asistencia.</span>
          </label>

          <div id="mark-result" class="status mark-status" role="status" aria-live="assertive" aria-atomic="true">Preparando marcación…</div>

          <div class="step" id="camera-step" hidden>
            <p class="step-title">Verificación facial</p>
            <p id="biometric-instruction" class="step-copy" role="status" aria-live="assertive" aria-atomic="true">Mira de frente.</p>
            <div class="face-stage">
              <video id="camera-video" playsinline autoplay muted hidden></video>
              <img id="photo-preview" class="photo-preview" alt="Captura verificada" hidden>
              <div class="face-frame" aria-hidden="true"></div>
            </div>
            <button type="button" id="retry-biometric" hidden>Intentar nuevamente</button>
          </div>

          <div class="step" id="location-step">
            <p class="step-title">Ubicación</p>
            <p id="location-status" class="step-copy" role="status">Preparando GPS…</p>
          </div>

          <div class="dialog-actions">
            <button type="button" class="primary-button" id="submit-mark" disabled>Registrar</button>
            <button type="button" class="secondary-button" id="cancel-mark">Cancelar</button>
          </div>
        </div>
      </dialog>

      <script src="/public/worker-biometric.js?v=20260730-mobile-camera-v3"></script>
    <% } else if (mode === 'unavailable') { %>
      <section class="shell"><p class="brand">Lórren · Operaciones</p><h1>Portal temporalmente no disponible</h1><div class="status warning">Intenta nuevamente en unos minutos</div></section>
    <% } else { %>
      <section class="shell"><p class="brand">Lórren · Operaciones</p><h1>Acceso no activo</h1><div class="status warning">Se requiere activación</div></section>
    <% } %>
  </main>
</body>
</html>
