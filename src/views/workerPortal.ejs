<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#176c36">
  <title>Portal del Auxiliar · Lórren</title>
  <link rel="manifest" href="/operaciones/portal/manifest.webmanifest">
  <link rel="icon" href="/operaciones/portal/icon.svg" type="image/svg+xml">
  <style>
    :root { color-scheme: light; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; padding: max(20px, env(safe-area-inset-top)) 18px max(28px, env(safe-area-inset-bottom)); background: #f4f6f8; color: #17212b; }
    main { width: min(100%, 560px); margin: 0 auto; }
    .shell { background: #fff; border: 1px solid #dfe4ea; border-radius: 20px; padding: 26px; box-shadow: 0 16px 44px rgba(23, 33, 43, .09); }
    .brand { margin: 0 0 18px; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #4d5b69; }
    h1 { margin: 0 0 10px; font-size: clamp(27px, 8vw, 36px); line-height: 1.08; }
    h2 { margin: 0; font-size: 20px; line-height: 1.2; }
    p { margin: 0; color: #4d5b69; line-height: 1.55; }
    button { font: inherit; }
    .status { margin-top: 18px; padding: 15px; border-radius: 12px; background: #f2f5f7; font-weight: 650; color: #263645; }
    .ok { background: #eaf8ef; color: #176c36; }
    .warning { background: #fff6df; color: #76520b; }
    .danger { background: #fdecec; color: #8f2525; }
    .meta { margin-top: 16px; font-size: 13px; color: #72808e; }
    .portal-header { display: flex; gap: 14px; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
    .session-chip { flex: 0 0 auto; padding: 8px 10px; border-radius: 999px; background: #eaf8ef; color: #176c36; font-size: 12px; font-weight: 800; }
    .connectivity-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding: 12px 14px; border: 1px solid #dfe4ea; border-radius: 14px; background: #fff; font-size: 13px; }
    .connectivity-bar strong { color: #263645; }
    .connectivity-copy { color: #5f6e7c; }
    .connectivity-dot { width: 10px; height: 10px; border-radius: 999px; background: #176c36; box-shadow: 0 0 0 4px #eaf8ef; flex: 0 0 auto; }
    .connectivity-bar.offline { background: #fff9e9; border-color: #efd89a; }
    .connectivity-bar.offline .connectivity-dot { background: #a66d00; box-shadow: 0 0 0 4px #fff0bd; }
    .connectivity-bar.syncing .connectivity-dot { background: #2c6faa; box-shadow: 0 0 0 4px #dbeeff; }
    .assignment-list { display: grid; gap: 14px; }
    .assignment-card { background: #fff; border: 1px solid #dfe4ea; border-radius: 18px; padding: 18px; box-shadow: 0 8px 26px rgba(23, 33, 43, .06); }
    .assignment-card.has-pending { border-color: #e7c765; background: #fffdf6; }
    .assignment-card.completed { border-color: #9dd4af; background: #fbfffc; }
    .assignment-date { margin-bottom: 8px; color: #176c36; font-size: 13px; font-weight: 800; text-transform: capitalize; }
    .assignment-time { margin-top: 5px; color: #263645; font-weight: 750; }
    .assignment-details { display: grid; gap: 7px; margin: 16px 0; font-size: 14px; }
    .detail-row { display: grid; grid-template-columns: 105px 1fr; gap: 10px; }
    .detail-label { color: #72808e; }
    .detail-value { color: #263645; font-weight: 600; overflow-wrap: anywhere; }
    .work-summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin: 12px 0; }
    .work-chip { padding: 10px; border-radius: 11px; background: #f3f6f8; color: #4d5b69; font-size: 12px; }
    .work-chip strong { display: block; margin-top: 3px; color: #263645; font-size: 13px; }
    .assignment-local-status { display: none; margin: 0 0 12px; padding: 10px 12px; border-radius: 11px; background: #fff4ce; color: #76520b; font-size: 13px; font-weight: 750; }
    .assignment-card.has-pending .assignment-local-status { display: block; }
    .arrival-button, .primary-button, .secondary-button { width: 100%; border: 0; border-radius: 12px; padding: 14px 16px; font-weight: 800; cursor: pointer; }
    .arrival-button, .primary-button { background: #176c36; color: #fff; }
    .arrival-button.departure { background: #1f5b8f; }
    .arrival-button.queued { background: #a66d00; }
    .secondary-button { background: #edf1f4; color: #263645; }
    button:disabled { cursor: not-allowed; opacity: .55; }
    .empty-state { padding: 24px; border: 1px dashed #cfd7df; border-radius: 16px; text-align: center; background: #fff; }
    dialog { width: min(calc(100% - 24px), 520px); max-height: calc(100vh - 28px); border: 0; border-radius: 20px; padding: 0; box-shadow: 0 24px 70px rgba(23, 33, 43, .28); }
    dialog::backdrop { background: rgba(12, 21, 29, .62); }
    .dialog-body { padding: 22px; overflow-y: auto; max-height: calc(100vh - 28px); }
    .dialog-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 18px; }
    .icon-button { width: 38px; height: 38px; border: 0; border-radius: 999px; background: #edf1f4; color: #263645; font-size: 22px; cursor: pointer; }
    .step { margin-top: 16px; padding: 15px; border-radius: 14px; background: #f5f7f9; }
    .step-title { margin-bottom: 6px; font-weight: 800; color: #263645; }
    .step-copy { font-size: 14px; }
    video, .photo-preview { display: block; width: 100%; margin-top: 12px; border-radius: 14px; background: #101820; aspect-ratio: 3 / 4; object-fit: cover; }
    .photo-preview[hidden], video[hidden] { display: none; }
    .camera-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .camera-actions button { padding: 12px; border: 0; border-radius: 10px; font-weight: 750; cursor: pointer; }
    .file-fallback { margin-top: 12px; font-size: 14px; }
    .consent { display: flex; gap: 10px; align-items: flex-start; margin: 16px 0; font-size: 13px; color: #4d5b69; }
    .consent input { width: 20px; height: 20px; margin: 0; flex: 0 0 auto; }
    .dialog-actions { display: grid; gap: 10px; margin-top: 16px; }
    .fine-print { margin-top: 14px; font-size: 12px; color: #72808e; }
    @media (max-width: 420px) { body { padding-left: 12px; padding-right: 12px; } .detail-row { grid-template-columns: 86px 1fr; } .work-summary { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main>
    <% if (mode === 'activation') { %>
      <section class="shell">
        <p class="brand">Lórren · Operaciones</p>
        <h1>Activando este dispositivo</h1>
        <p>Estamos validando el enlace seguro. No cierres esta pantalla.</p>
        <div id="activation-status" class="status" role="status" aria-live="polite">Validando acceso…</div>
        <script nonce="<%= nonce %>">
          (() => {
            const status = document.getElementById('activation-status');
            const queryParams = new URLSearchParams(window.location.search);
            const fragment = window.location.hash.startsWith('#') ? window.location.hash.slice(1) : '';
            const fragmentParams = new URLSearchParams(fragment);
            const activationToken = queryParams.get('token') || fragmentParams.get('token') || (fragment.includes('=') ? '' : fragment);
            window.history.replaceState(null, document.title, window.location.pathname);
            if (!/^[A-Za-z0-9_-]{43}$/.test(activationToken || '')) {
              status.textContent = 'El enlace no es válido o está incompleto. Solicita uno nuevo.';
              status.classList.add('warning');
              return;
            }
            fetch('/operaciones/portal/activar', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'worker-portal' },
              body: JSON.stringify({ activationToken })
            }).then(async (response) => {
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.ok) throw new Error('activation_rejected');
              status.textContent = 'Dispositivo activado. Abriendo tu portal…';
              status.classList.add('ok');
              window.location.replace(payload.redirectTo || '/operaciones/portal');
            }).catch(() => {
              status.textContent = 'No fue posible activar este dispositivo. El enlace puede haber vencido o ya fue utilizado.';
              status.classList.add('warning');
            });
          })();
        </script>
      </section>
    <% } else if (mode === 'active') { %>
      <% const portalAssignments = Array.isArray(assignments) ? assignments : []; %>
      <header class="portal-header"><div><p class="brand">Lórren · Portal del Auxiliar</p><h1>Mi jornada</h1><p>Registra tu llegada y tu salida desde este celular.</p></div><span class="session-chip">Dispositivo verificado</span></header>
      <section id="portal-connectivity" class="connectivity-bar" aria-live="polite"><span class="connectivity-dot" aria-hidden="true"></span><div><strong id="connectivity-title">Con conexión</strong><div id="connectivity-copy" class="connectivity-copy">Las marcaciones se enviarán inmediatamente.</div></div></section>
      <% if (portalAssignments.length) { %>
        <section class="assignment-list" aria-label="Asignaciones activas">
          <% portalAssignments.forEach((assignment) => { %>
            <article class="assignment-card <%= assignment.departureReported ? 'completed' : '' %>" data-assignment-card="<%= assignment.id %>">
              <p class="assignment-date"><%= assignment.dateLabel %></p><h2><%= assignment.clientName %></h2><p class="assignment-time"><%= assignment.timeLabel %></p>
              <div class="assignment-details">
                <div class="detail-row"><span class="detail-label">Operación</span><span class="detail-value"><%= assignment.operationPointName %></span></div>
                <div class="detail-row"><span class="detail-label">Ciudad</span><span class="detail-value"><%= assignment.cityName %></span></div>
                <div class="detail-row"><span class="detail-label">Dirección</span><span class="detail-value"><%= assignment.address %></span></div>
                <div class="detail-row"><span class="detail-label">Descanso</span><span class="detail-value"><%= assignment.breakLabel %></span></div>
              </div>
              <% if (assignment.arrivalReported || assignment.departureReported) { %>
                <div class="work-summary">
                  <div class="work-chip">Llegada<strong><%= assignment.arrivalReportedLabel || 'Registrada' %></strong></div>
                  <div class="work-chip">Salida<strong><%= assignment.departureReportedLabel || 'Pendiente' %></strong></div>
                  <% if (assignment.workedLabel) { %><div class="work-chip">Tiempo neto<strong><%= assignment.workedLabel %></strong></div><% } %>
                  <% if (assignment.arrivalStatusLabel) { %><div class="work-chip">Estado<strong><%= assignment.arrivalStatusLabel %></strong></div><% } %>
                </div>
              <% } %>
              <div class="assignment-local-status" data-local-status="<%= assignment.id %>"></div>
              <button type="button" class="arrival-button <%= assignment.actionType === 'DEPARTURE' ? 'departure' : '' %>" data-assignment-id="<%= assignment.id %>" data-mark-type="<%= assignment.actionType %>" data-photo-required="<%= assignment.photoRequired ? 'true' : 'false' %>" data-attendance-enabled="<%= assignment.attendanceEnabled ? 'true' : 'false' %>" data-arrival-reported="<%= assignment.arrivalReported ? 'true' : 'false' %>" data-departure-reported="<%= assignment.departureReported ? 'true' : 'false' %>" data-server-action-label="<%= assignment.actionLabel %>" data-window-opens-at="<%= assignment.arrivalWindowOpensAt || '' %>" data-window-closes-at="<%= assignment.arrivalWindowClosesAt || '' %>" <%= assignment.canRegisterArrival || assignment.canRegisterDeparture ? '' : 'disabled' %>><%= assignment.actionLabel %></button>
            </article>
          <% }); %>
        </section>
      <% } else { %><section class="empty-state"><h2>No tienes asignaciones activas</h2><p class="meta">Cuando Operaciones te programe un servicio, aparecerá aquí automáticamente.</p></section><% } %>
      <% if (expiresAt) { %><p class="meta">Tu sesión permanece en este dispositivo y puede revocarse desde Lórren.</p><% } %>

      <dialog id="mark-dialog" aria-labelledby="mark-title"><div class="dialog-body"><div class="dialog-head"><div><p class="brand">Registro seguro</p><h2 id="mark-title">Confirmar marcación</h2></div><button type="button" class="icon-button" id="close-mark" aria-label="Cerrar">×</button></div>
        <div class="step"><p class="step-title">1. Ubicación actual</p><p id="location-status" class="step-copy" role="status">Preparando el GPS…</p></div>
        <div class="step" id="camera-step" hidden><p class="step-title">2. Selfie de evidencia</p><p class="step-copy">Toma una foto en este momento. No realizamos reconocimiento facial automático.</p><video id="camera-video" playsinline muted hidden></video><img id="photo-preview" class="photo-preview" alt="Vista previa de la selfie" hidden><canvas id="camera-canvas" hidden></canvas><div class="camera-actions"><button type="button" id="capture-photo" disabled>Tomar foto</button><button type="button" id="retry-photo" disabled>Repetir</button></div><label class="file-fallback" id="file-fallback" hidden>Cámara no disponible. Selecciona una foto tomada ahora:<input type="file" id="fallback-photo" accept="image/jpeg,image/png,image/webp" capture="user"></label></div>
        <label class="consent" id="photo-consent-wrap" hidden><input type="checkbox" id="photo-consent"><span>Autorizo el uso de esta fotografía únicamente como evidencia de la marcación y para revisión de asistencia.</span></label>
        <div id="mark-result" class="status" role="status" aria-live="polite" hidden></div><div class="dialog-actions"><button type="button" class="primary-button" id="submit-mark" disabled>Registrar</button><button type="button" class="secondary-button" id="cancel-mark">Cancelar</button></div><p class="fine-print">Con internet, Lórren usa la hora recibida por el servidor. Sin internet, la marca queda guardada en este dispositivo y se sincroniza después para revisión.</p></div></dialog>

      <script src="/operaciones/portal/offline.js"></script>
      <script nonce="<%= nonce %>">
        (() => {
          const dialog = document.getElementById('mark-dialog'); const title = document.getElementById('mark-title'); const locationStatus = document.getElementById('location-status'); const cameraStep = document.getElementById('camera-step'); const cameraVideo = document.getElementById('camera-video'); const cameraCanvas = document.getElementById('camera-canvas'); const photoPreview = document.getElementById('photo-preview'); const capturePhotoButton = document.getElementById('capture-photo'); const retryPhotoButton = document.getElementById('retry-photo'); const fileFallback = document.getElementById('file-fallback'); const fallbackPhoto = document.getElementById('fallback-photo'); const photoConsentWrap = document.getElementById('photo-consent-wrap'); const photoConsent = document.getElementById('photo-consent'); const submitButton = document.getElementById('submit-mark'); const resultBox = document.getElementById('mark-result'); const connectivityBar = document.getElementById('portal-connectivity'); const connectivityTitle = document.getElementById('connectivity-title'); const connectivityCopy = document.getElementById('connectivity-copy'); const offlineApi = window.LorrenWorkerPortalOffline || null;
          let assignmentId = null; let markType = 'ARRIVAL'; let photoRequired = false; let locationEvidence = null; let photoBlob = null; let photoUrl = null; let cameraStream = null; let idempotencyKey = null; let offlineState = { queue: [], receipts: [], online: navigator.onLine };
          const markWord = () => markType === 'DEPARTURE' ? 'salida' : 'llegada';
          function newIdempotencyKey() { if (window.crypto?.randomUUID) return window.crypto.randomUUID(); return `${markType.toLowerCase()}_${Date.now()}_${Math.random().toString(36).slice(2, 14)}`; }
          function stopCamera() { if (cameraStream) cameraStream.getTracks().forEach((track) => track.stop()); cameraStream = null; cameraVideo.srcObject = null; }
          function clearPhotoUrl() { if (photoUrl) URL.revokeObjectURL(photoUrl); photoUrl = null; }
          function updateSubmitState() { submitButton.disabled = !locationEvidence || (photoRequired && !photoBlob) || (photoBlob && !photoConsent.checked); }
          function showResult(message, className) { resultBox.hidden = false; resultBox.className = `status ${className || ''}`.trim(); resultBox.textContent = message; }
          function resetDialog() { stopCamera(); clearPhotoUrl(); locationEvidence = null; photoBlob = null; photoConsent.checked = false; resultBox.hidden = true; locationStatus.textContent = 'Solicitando permiso de ubicación…'; cameraStep.hidden = !photoRequired; photoConsentWrap.hidden = !photoRequired; cameraVideo.hidden = true; photoPreview.hidden = true; capturePhotoButton.disabled = true; retryPhotoButton.disabled = true; fileFallback.hidden = true; fallbackPhoto.value = ''; submitButton.disabled = true; title.textContent = markType === 'DEPARTURE' ? 'Confirmar mi salida' : 'Confirmar mi llegada'; submitButton.textContent = navigator.onLine ? `Registrar ${markWord()}` : `Guardar ${markWord()} sin internet`; }
          function requestLocation() { if (!navigator.geolocation) { showResult('Este navegador no permite obtener la ubicación.', 'warning'); return; } navigator.geolocation.getCurrentPosition((position) => { locationEvidence = { latitude: position.coords.latitude, longitude: position.coords.longitude, accuracyMeters: position.coords.accuracy, clientCapturedAt: new Date(position.timestamp || Date.now()).toISOString() }; locationStatus.textContent = `Ubicación obtenida con precisión aproximada de ${Math.round(position.coords.accuracy)} metros.`; updateSubmitState(); }, (error) => { locationStatus.textContent = error?.code === 1 ? 'Permiso de ubicación rechazado.' : 'No fue posible obtener una ubicación confiable.'; showResult('Activa la ubicación y concede el permiso para continuar.', 'warning'); }, { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 }); }
          async function startCamera() { if (!photoRequired) return; if (!navigator.mediaDevices?.getUserMedia) { fileFallback.hidden = false; return; } try { cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 960 } }, audio: false }); cameraVideo.srcObject = cameraStream; cameraVideo.hidden = false; await cameraVideo.play(); capturePhotoButton.disabled = false; } catch { fileFallback.hidden = false; showResult('No se pudo abrir la cámara. Usa la opción de foto disponible.', 'warning'); } }
          function setPhoto(blob) { clearPhotoUrl(); photoBlob = blob; photoUrl = URL.createObjectURL(blob); photoPreview.src = photoUrl; photoPreview.hidden = false; cameraVideo.hidden = true; capturePhotoButton.disabled = true; retryPhotoButton.disabled = false; stopCamera(); updateSubmitState(); }
          capturePhotoButton.addEventListener('click', () => { const scale = Math.min(1, 720 / (cameraVideo.videoWidth || 720)); cameraCanvas.width = Math.round((cameraVideo.videoWidth || 720) * scale); cameraCanvas.height = Math.round((cameraVideo.videoHeight || 960) * scale); cameraCanvas.getContext('2d').drawImage(cameraVideo, 0, 0, cameraCanvas.width, cameraCanvas.height); cameraCanvas.toBlob((blob) => blob ? setPhoto(blob) : showResult('No fue posible tomar la fotografía.', 'warning'), 'image/jpeg', .82); });
          retryPhotoButton.addEventListener('click', async () => { clearPhotoUrl(); photoBlob = null; photoPreview.hidden = true; retryPhotoButton.disabled = true; updateSubmitState(); await startCamera(); });
          fallbackPhoto.addEventListener('change', () => { const file = fallbackPhoto.files?.[0]; if (!file) return; if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) { fallbackPhoto.value = ''; showResult('La fotografía debe ser JPG, PNG o WEBP y pesar máximo 3 MB.', 'warning'); return; } setPhoto(file); });
          photoConsent.addEventListener('change', updateSubmitState);
          function queuedFor(id, type) { return offlineState.queue.find((record) => record.assignmentId === id && record.markType === type) || null; }
          function receiptFor(id, type) { return offlineState.receipts.find((record) => record.assignmentId === id && record.markType === type) || null; }
          function formatOpenTime(value) { const date = new Date(value); if (Number.isNaN(date.getTime())) return null; return new Intl.DateTimeFormat('es-CO', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/Bogota' }).format(date); }
          function evaluateButton(button) { const id = button.dataset.assignmentId; const type = button.dataset.markType; const card = document.querySelector(`[data-assignment-card="${CSS.escape(id)}"]`); const localStatus = document.querySelector(`[data-local-status="${CSS.escape(id)}"]`); const queued = queuedFor(id, type); const receipt = receiptFor(id, type); button.classList.remove('queued'); card?.classList.remove('has-pending'); if (queued) { button.disabled = true; button.classList.add('queued'); button.textContent = queued.state === 'SYNCING' ? 'Sincronizando marcación…' : queued.state === 'SESSION_REQUIRED' ? 'Activa nuevamente para sincronizar' : 'Marcación guardada offline'; if (localStatus) localStatus.textContent = 'La marcación está guardada en este celular y se eliminará solo cuando Lórren confirme la sincronización.'; card?.classList.add('has-pending'); return; } if (receipt && ['SYNCED', 'REVIEW_REQUIRED', 'ALREADY_RECORDED'].includes(receipt.state)) { button.disabled = true; button.textContent = receipt.state === 'REVIEW_REQUIRED' ? 'Marcación sincronizada · en revisión' : 'Marcación sincronizada'; return; } if (type === 'DONE' || button.dataset.departureReported === 'true') { button.disabled = true; button.textContent = button.dataset.serverActionLabel || 'Jornada finalizada'; return; } if (button.dataset.attendanceEnabled !== 'true') { button.disabled = true; button.textContent = 'Marcación no habilitada'; return; } if (type === 'DEPARTURE') { button.disabled = false; button.textContent = navigator.onLine ? 'Registrar salida' : 'Guardar salida sin internet'; return; } const now = Date.now(); const opensAt = new Date(button.dataset.windowOpensAt || '').getTime(); const closesAt = new Date(button.dataset.windowClosesAt || '').getTime(); if (!Number.isFinite(opensAt) || !Number.isFinite(closesAt)) { button.disabled = true; button.textContent = button.dataset.serverActionLabel || 'Horario pendiente'; return; } if (now < opensAt) { button.disabled = true; button.textContent = `Disponible desde ${formatOpenTime(opensAt) || ''}`.trim(); return; } if (now > closesAt) { button.disabled = true; button.textContent = 'Jornada vencida'; return; } button.disabled = false; button.textContent = navigator.onLine ? 'Registrar llegada' : 'Guardar llegada sin internet'; }
          function refreshButtons() { document.querySelectorAll('.arrival-button').forEach(evaluateButton); }
          function renderConnectivity() { const pending = offlineState.queue.length; const syncing = offlineState.queue.some((record) => record.state === 'SYNCING'); connectivityBar.classList.toggle('offline', !offlineState.online); connectivityBar.classList.toggle('syncing', syncing); if (!offlineState.online) { connectivityTitle.textContent = 'Sin conexión'; connectivityCopy.textContent = pending ? `${pending} marcación(es) guardada(s) en este celular.` : 'Puedes registrar llegada o salida y se enviará cuando vuelva internet.'; } else if (syncing) { connectivityTitle.textContent = 'Sincronizando'; connectivityCopy.textContent = 'Lórren está enviando las marcaciones guardadas.'; } else { connectivityTitle.textContent = 'Con conexión'; connectivityCopy.textContent = pending ? `${pending} marcación(es) esperan sincronización automática.` : 'Las marcaciones se enviarán inmediatamente.'; } }
          function handleOfflineState(state) { offlineState = state || offlineState; renderConnectivity(); refreshButtons(); }
          async function queueCurrentMark() { if (!offlineApi) throw new Error('El almacenamiento offline no está disponible.'); await offlineApi.queueMark({ markType, assignmentId, idempotencyKey, latitude: locationEvidence.latitude, longitude: locationEvidence.longitude, accuracyMeters: locationEvidence.accuracyMeters, clientCapturedAt: locationEvidence.clientCapturedAt, photoConsent: Boolean(photoBlob && photoConsent.checked), selfie: photoBlob || null }); showResult(`${markType === 'DEPARTURE' ? 'Salida' : 'Llegada'} guardada en este celular. Se sincronizará automáticamente y quedará pendiente de revisión.`, 'warning'); stopCamera(); submitButton.disabled = true; submitButton.textContent = 'Guardada sin conexión'; }
          document.querySelectorAll('.arrival-button').forEach((button) => button.addEventListener('click', () => { if (button.disabled) return; assignmentId = button.dataset.assignmentId; markType = button.dataset.markType === 'DEPARTURE' ? 'DEPARTURE' : 'ARRIVAL'; photoRequired = button.dataset.photoRequired === 'true'; idempotencyKey = newIdempotencyKey(); resetDialog(); if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', ''); requestLocation(); startCamera(); }));
          async function submitMark() { if (!assignmentId || !locationEvidence || (photoRequired && !photoBlob)) return; submitButton.disabled = true; submitButton.textContent = navigator.onLine ? 'Registrando…' : 'Guardando en este celular…'; resultBox.hidden = true; if (!navigator.onLine) { try { await queueCurrentMark(); } catch (error) { showResult(error?.message || 'No fue posible guardar sin internet.', 'danger'); submitButton.disabled = false; } return; } const form = new FormData(); form.set('idempotencyKey', idempotencyKey); form.set('latitude', String(locationEvidence.latitude)); form.set('longitude', String(locationEvidence.longitude)); form.set('accuracyMeters', String(locationEvidence.accuracyMeters)); form.set('clientCapturedAt', locationEvidence.clientCapturedAt); form.set('captureMode', 'ONLINE_WEB'); form.set('photoConsent', photoBlob && photoConsent.checked ? 'true' : 'false'); if (photoBlob) form.set('selfie', photoBlob, `selfie-${markWord()}.jpg`); try { const endpoint = markType === 'DEPARTURE' ? 'salida' : 'llegada'; const response = await fetch(`/operaciones/portal/asignaciones/${encodeURIComponent(assignmentId)}/${endpoint}`, { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'worker-portal' }, body: form }); const payload = await response.json().catch(() => ({})); if (!response.ok || !payload.ok) { if (response.status >= 500 && offlineApi) { await queueCurrentMark(); return; } const messages = { arrival_window_not_open: 'La ventana de llegada todavía no está abierta o ya terminó.', arrival_already_registered: 'La llegada ya había sido registrada.', departure_arrival_required: 'Debes registrar la llegada antes de la salida.', departure_already_registered: 'La salida ya había sido registrada.', departure_before_arrival: 'La salida no puede ser anterior a la llegada.', attendance_not_enabled: 'La marcación no está habilitada para esta operación.', selfie_required: 'Debes tomar la selfie de evidencia.', photo_consent_required: 'Debes aceptar el uso de la fotografía.', portal_session_required: 'Tu sesión venció. Solicita una nueva activación.', offline_capture_expired: 'La marcación guardada superó el tiempo máximo para sincronizar.' }; throw new Error(messages[payload.error] || 'No fue posible registrar la marcación.'); } showResult(payload.message || 'Marcación registrada correctamente.', payload.requiresReview ? 'warning' : 'ok'); stopCamera(); setTimeout(() => window.location.reload(), 1400); } catch (error) { if (offlineApi && (error instanceof TypeError || !navigator.onLine)) { try { await queueCurrentMark(); return; } catch (queueError) { showResult(queueError?.message || 'No fue posible guardar sin conexión.', 'danger'); } } else showResult(error?.message || 'No fue posible registrar.', 'danger'); submitButton.disabled = false; submitButton.textContent = navigator.onLine ? `Registrar ${markWord()}` : `Guardar ${markWord()} sin internet`; } }
          submitButton.addEventListener('click', submitMark); function closeDialog() { stopCamera(); clearPhotoUrl(); if (typeof dialog.close === 'function') dialog.close(); else dialog.removeAttribute('open'); } document.getElementById('close-mark').addEventListener('click', closeDialog); document.getElementById('cancel-mark').addEventListener('click', closeDialog); dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeDialog(); }); window.addEventListener('online', () => { offlineState.online = true; renderConnectivity(); refreshButtons(); }); window.addEventListener('offline', () => { offlineState.online = false; renderConnectivity(); refreshButtons(); }); offlineApi?.init({ onStateChange: handleOfflineState }).catch(() => {}); renderConnectivity(); refreshButtons(); window.setInterval(refreshButtons, 30000);
        })();
      </script>
    <% } else if (mode === 'unavailable') { %><section class="shell"><p class="brand">Lórren · Operaciones</p><h1>Portal temporalmente no disponible</h1><p>No pudimos validar la sesión en este momento. Tu dispositivo no fue desactivado.</p><div class="status warning">Intenta nuevamente en unos minutos</div></section>
    <% } else { %><section class="shell"><p class="brand">Lórren · Operaciones</p><h1>Acceso no activo</h1><p>Este dispositivo no tiene una sesión vigente. Abre el enlace seguro enviado por Lórren o solicita uno nuevo.</p><div class="status warning">Se requiere activación</div></section><% } %>
  </main>
</body>
</html>
