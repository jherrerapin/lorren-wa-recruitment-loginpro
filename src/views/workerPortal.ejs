<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#176c36">
  <title>Portal del Auxiliar · Lórren</title>
  <link rel="manifest" href="/operaciones/portal/manifest.webmanifest">
  <link rel="icon" href="/operaciones/portal/icon.svg" type="image/svg+xml">
  <style>
    :root { color-scheme: light; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; padding: max(20px, env(safe-area-inset-top)) 18px max(28px, env(safe-area-inset-bottom)); background: #f4f6f8; color: #17212b; }
    main { width: min(100%, 540px); margin: 0 auto; }
    .shell { background: #fff; border: 1px solid #dfe4ea; border-radius: 20px; padding: 26px; box-shadow: 0 16px 44px rgba(23, 33, 43, .09); }
    .brand { margin: 0 0 18px; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #4d5b69; }
    h1 { margin: 0 0 10px; font-size: clamp(27px, 8vw, 36px); line-height: 1.08; }
    h2 { margin: 0; font-size: 20px; line-height: 1.2; }
    p { margin: 0; color: #4d5b69; line-height: 1.55; }
    button { font: inherit; }
    .status { margin-top: 18px; padding: 15px; border-radius: 12px; background: #f2f5f7; font-weight: 650; color: #263645; }
    .ok { background: #eaf8ef; color: #176c36; }
    .warning { background: #fff6df; color: #76520b; }
    .danger { background: #fdecec; color: #8f2525; }
    .meta { margin-top: 16px; font-size: 13px; color: #72808e; }
    .portal-header { display: flex; gap: 14px; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
    .session-chip { flex: 0 0 auto; padding: 8px 10px; border-radius: 999px; background: #eaf8ef; color: #176c36; font-size: 12px; font-weight: 800; }
    .connectivity-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; padding: 12px 14px; border: 1px solid #dfe4ea; border-radius: 14px; background: #fff; font-size: 13px; }
    .connectivity-bar strong { color: #263645; }
    .connectivity-copy { color: #5f6e7c; }
    .connectivity-dot { width: 10px; height: 10px; border-radius: 999px; background: #176c36; box-shadow: 0 0 0 4px #eaf8ef; flex: 0 0 auto; }
    .connectivity-bar.offline { background: #fff9e9; border-color: #efd89a; }
    .connectivity-bar.offline .connectivity-dot { background: #a66d00; box-shadow: 0 0 0 4px #fff0bd; }
    .connectivity-bar.syncing .connectivity-dot { background: #2c6faa; box-shadow: 0 0 0 4px #dbeeff; }
    .assignment-list { display: grid; gap: 14px; }
    .assignment-card { background: #fff; border: 1px solid #dfe4ea; border-radius: 18px; padding: 18px; box-shadow: 0 8px 26px rgba(23, 33, 43, .06); }
    .assignment-card.has-pending { border-color: #e7c765; background: #fffdf6; }
    .assignment-date { margin-bottom: 8px; color: #176c36; font-size: 13px; font-weight: 800; text-transform: capitalize; }
    .assignment-time { margin-top: 5px; color: #263645; font-weight: 750; }
    .assignment-details { display: grid; gap: 7px; margin: 16px 0; font-size: 14px; }
    .detail-row { display: grid; grid-template-columns: 92px 1fr; gap: 10px; }
    .detail-label { color: #72808e; }
    .detail-value { color: #263645; font-weight: 600; overflow-wrap: anywhere; }
    .assignment-local-status { display: none; margin: 0 0 12px; padding: 10px 12px; border-radius: 11px; background: #fff4ce; color: #76520b; font-size: 13px; font-weight: 750; }
    .assignment-card.has-pending .assignment-local-status { display: block; }
    .arrival-button, .primary-button, .secondary-button { width: 100%; border: 0; border-radius: 12px; padding: 14px 16px; font-weight: 800; cursor: pointer; }
    .arrival-button, .primary-button { background: #176c36; color: #fff; }
    .arrival-button.queued { background: #a66d00; }
    .secondary-button { background: #edf1f4; color: #263645; }
    button:disabled { cursor: not-allowed; opacity: .55; }
    .empty-state { padding: 24px; border: 1px dashed #cfd7df; border-radius: 16px; text-align: center; background: #fff; }
    dialog { width: min(calc(100% - 24px), 520px); max-height: calc(100vh - 28px); border: 0; border-radius: 20px; padding: 0; box-shadow: 0 24px 70px rgba(23, 33, 43, .28); }
    dialog::backdrop { background: rgba(12, 21, 29, .62); }
    .dialog-body { padding: 22px; overflow-y: auto; max-height: calc(100vh - 28px); }
    .dialog-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 18px; }
    .icon-button { width: 38px; height: 38px; border: 0; border-radius: 999px; background: #edf1f4; color: #263645; font-size: 22px; cursor: pointer; }
    .step { margin-top: 16px; padding: 15px; border-radius: 14px; background: #f5f7f9; }
    .step-title { margin-bottom: 6px; font-weight: 800; color: #263645; }
    .step-copy { font-size: 14px; }
    video, .photo-preview { display: block; width: 100%; margin-top: 12px; border-radius: 14px; background: #101820; aspect-ratio: 3 / 4; object-fit: cover; }
    .photo-preview[hidden], video[hidden] { display: none; }
    .camera-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .camera-actions button { padding: 12px; border: 0; border-radius: 10px; font-weight: 750; cursor: pointer; }
    .file-fallback { margin-top: 12px; font-size: 14px; }
    .consent { display: flex; gap: 10px; align-items: flex-start; margin: 16px 0; font-size: 13px; color: #4d5b69; }
    .consent input { width: 20px; height: 20px; margin: 0; flex: 0 0 auto; }
    .dialog-actions { display: grid; gap: 10px; margin-top: 16px; }
    .fine-print { margin-top: 14px; font-size: 12px; color: #72808e; }
    @media (max-width: 420px) {
      body { padding-left: 12px; padding-right: 12px; }
      .shell { padding: 22px 19px; }
      .portal-header { display: block; }
      .session-chip { display: inline-block; margin-top: 12px; }
      .detail-row { grid-template-columns: 78px 1fr; }
    }
  </style>
</head>
<body>
  <main>
    <% if (mode === 'activation') { %>
      <section class="shell">
        <p class="brand">Lórren · Operaciones</p>
        <h1>Activando este dispositivo</h1>
        <p>Estamos validando el enlace seguro. No cierres esta pantalla.</p>
        <div id="activation-status" class="status" role="status" aria-live="polite">Validando acceso…</div>
        <script nonce="<%= nonce %>">
          (() => {
            const status = document.getElementById('activation-status');
            const queryParams = new URLSearchParams(window.location.search);
            const fragment = window.location.hash.startsWith('#') ? window.location.hash.slice(1) : '';
            const fragmentParams = new URLSearchParams(fragment);
            const activationToken = queryParams.get('token')
              || fragmentParams.get('token')
              || (fragment.includes('=') ? '' : fragment);

            window.history.replaceState(null, document.title, window.location.pathname);

            if (!/^[A-Za-z0-9_-]{43}$/.test(activationToken || '')) {
              status.textContent = 'El enlace no es válido o está incompleto. Solicita uno nuevo.';
              status.classList.add('warning');
              return;
            }

            fetch('/operaciones/portal/activar', {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'worker-portal'
              },
              body: JSON.stringify({ activationToken })
            })
              .then(async (response) => {
                const payload = await response.json().catch(() => ({}));
                if (!response.ok || !payload.ok) throw new Error('activation_rejected');
                status.textContent = 'Dispositivo activado. Abriendo tu portal…';
                status.classList.add('ok');
                window.location.replace(payload.redirectTo || '/operaciones/portal');
              })
              .catch(() => {
                status.textContent = 'No fue posible activar este dispositivo. El enlace puede haber vencido o ya fue utilizado.';
                status.classList.add('warning');
              });
          })();
        </script>
      </section>
    <% } else if (mode === 'active') { %>
      <% const portalAssignments = Array.isArray(assignments) ? assignments : []; %>
      <header class="portal-header">
        <div>
          <p class="brand">Lórren · Portal del Auxiliar</p>
          <h1>Mi jornada</h1>
          <p>Consulta tu programación y registra tu llegada desde este celular.</p>
        </div>
        <span class="session-chip">Dispositivo verificado</span>
      </header>

      <section id="portal-connectivity" class="connectivity-bar" aria-live="polite">
        <span class="connectivity-dot" aria-hidden="true"></span>
        <div>
          <strong id="connectivity-title">Con conexión</strong>
          <div id="connectivity-copy" class="connectivity-copy">Las marcaciones se enviarán inmediatamente.</div>
        </div>
      </section>

      <% if (portalAssignments.length) { %>
        <section class="assignment-list" aria-label="Asignaciones activas">
          <% portalAssignments.forEach((assignment) => { %>
            <article class="assignment-card" data-assignment-card="<%= assignment.id %>">
              <p class="assignment-date"><%= assignment.dateLabel %></p>
              <h2><%= assignment.clientName %></h2>
              <p class="assignment-time"><%= assignment.timeLabel %></p>
              <div class="assignment-details">
                <div class="detail-row"><span class="detail-label">Operación</span><span class="detail-value"><%= assignment.operationPointName %></span></div>
                <div class="detail-row"><span class="detail-label">Ciudad</span><span class="detail-value"><%= assignment.cityName %></span></div>
                <div class="detail-row"><span class="detail-label">Dirección</span><span class="detail-value"><%= assignment.address %></span></div>
              </div>
              <div class="assignment-local-status" data-local-status="<%= assignment.id %>"></div>
              <button
                type="button"
                class="arrival-button"
                data-assignment-id="<%= assignment.id %>"
                data-photo-required="<%= assignment.photoRequired ? 'true' : 'false' %>"
                data-attendance-enabled="<%= assignment.attendanceEnabled ? 'true' : 'false' %>"
                data-arrival-reported="<%= assignment.arrivalReported ? 'true' : 'false' %>"
                data-server-action-label="<%= assignment.actionLabel %>"
                data-window-opens-at="<%= assignment.arrivalWindowOpensAt || '' %>"
                data-window-closes-at="<%= assignment.arrivalWindowClosesAt || '' %>"
                <%= assignment.canRegisterArrival ? '' : 'disabled' %>
              ><%= assignment.actionLabel %></button>
            </article>
          <% }); %>
        </section>
      <% } else { %>
        <section class="empty-state">
          <h2>No tienes asignaciones activas</h2>
          <p class="meta">Cuando Operaciones te programe un servicio, aparecerá aquí automáticamente.</p>
        </section>
      <% } %>
      <% if (expiresAt) { %>
        <p class="meta">Tu sesión permanece en este dispositivo y puede revocarse desde Lórren.</p>
      <% } %>

      <dialog id="arrival-dialog" aria-labelledby="arrival-title">
        <div class="dialog-body">
          <div class="dialog-head">
            <div>
              <p class="brand">Registro seguro</p>
              <h2 id="arrival-title">Confirmar mi llegada</h2>
            </div>
            <button type="button" class="icon-button" id="close-arrival" aria-label="Cerrar">×</button>
          </div>

          <div class="step">
            <p class="step-title">1. Ubicación actual</p>
            <p id="location-status" class="step-copy" role="status">Preparando el GPS…</p>
          </div>

          <div class="step" id="camera-step" hidden>
            <p class="step-title">2. Selfie de evidencia</p>
            <p class="step-copy">Toma una foto en este momento. No realizamos reconocimiento facial automático.</p>
            <video id="camera-video" playsinline muted hidden></video>
            <img id="photo-preview" class="photo-preview" alt="Vista previa de la selfie" hidden>
            <canvas id="camera-canvas" hidden></canvas>
            <div class="camera-actions">
              <button type="button" id="capture-photo" disabled>Tomar foto</button>
              <button type="button" id="retry-photo" disabled>Repetir</button>
            </div>
            <label class="file-fallback" id="file-fallback" hidden>
              Cámara no disponible. Selecciona una foto tomada ahora:
              <input type="file" id="fallback-photo" accept="image/jpeg,image/png,image/webp" capture="user">
            </label>
          </div>

          <label class="consent" id="photo-consent-wrap" hidden>
            <input type="checkbox" id="photo-consent">
            <span>Autorizo el uso de esta fotografía únicamente como evidencia de la marcación y para revisión de asistencia.</span>
          </label>

          <div id="arrival-result" class="status" role="status" aria-live="polite" hidden></div>
          <div class="dialog-actions">
            <button type="button" class="primary-button" id="submit-arrival" disabled>Registrar llegada</button>
            <button type="button" class="secondary-button" id="cancel-arrival">Cancelar</button>
          </div>
          <p class="fine-print">Con internet, Lórren usa la hora recibida por el servidor. Sin internet, la marca queda guardada en este dispositivo y se sincroniza después para revisión.</p>
        </div>
      </dialog>

      <script src="/operaciones/portal/offline.js"></script>
      <script nonce="<%= nonce %>">
        (() => {
          const dialog = document.getElementById('arrival-dialog');
          const locationStatus = document.getElementById('location-status');
          const cameraStep = document.getElementById('camera-step');
          const cameraVideo = document.getElementById('camera-video');
          const cameraCanvas = document.getElementById('camera-canvas');
          const photoPreview = document.getElementById('photo-preview');
          const capturePhotoButton = document.getElementById('capture-photo');
          const retryPhotoButton = document.getElementById('retry-photo');
          const fileFallback = document.getElementById('file-fallback');
          const fallbackPhoto = document.getElementById('fallback-photo');
          const photoConsentWrap = document.getElementById('photo-consent-wrap');
          const photoConsent = document.getElementById('photo-consent');
          const submitButton = document.getElementById('submit-arrival');
          const resultBox = document.getElementById('arrival-result');
          const closeButton = document.getElementById('close-arrival');
          const cancelButton = document.getElementById('cancel-arrival');
          const connectivityBar = document.getElementById('portal-connectivity');
          const connectivityTitle = document.getElementById('connectivity-title');
          const connectivityCopy = document.getElementById('connectivity-copy');
          const offlineApi = window.LorrenWorkerPortalOffline || null;

          let assignmentId = null;
          let photoRequired = false;
          let locationEvidence = null;
          let photoBlob = null;
          let photoUrl = null;
          let cameraStream = null;
          let idempotencyKey = null;
          let offlineState = { queue: [], receipts: [], online: navigator.onLine };

          function newIdempotencyKey() {
            if (window.crypto?.randomUUID) return window.crypto.randomUUID();
            return `arrival_${Date.now()}_${Math.random().toString(36).slice(2, 14)}`;
          }

          function stopCamera() {
            if (cameraStream) cameraStream.getTracks().forEach((track) => track.stop());
            cameraStream = null;
            cameraVideo.srcObject = null;
          }

          function clearPhotoUrl() {
            if (photoUrl) URL.revokeObjectURL(photoUrl);
            photoUrl = null;
          }

          function updateSubmitState() {
            const hasPhoto = !photoRequired || Boolean(photoBlob);
            const hasConsent = !photoBlob || photoConsent.checked;
            submitButton.disabled = !locationEvidence || !hasPhoto || !hasConsent;
          }

          function showResult(message, className) {
            resultBox.hidden = false;
            resultBox.className = `status ${className || ''}`.trim();
            resultBox.textContent = message;
          }

          function resetDialog() {
            stopCamera();
            clearPhotoUrl();
            locationEvidence = null;
            photoBlob = null;
            photoConsent.checked = false;
            resultBox.hidden = true;
            resultBox.textContent = '';
            locationStatus.textContent = 'Solicitando permiso de ubicación…';
            cameraStep.hidden = !photoRequired;
            photoConsentWrap.hidden = !photoRequired;
            cameraVideo.hidden = true;
            photoPreview.hidden = true;
            capturePhotoButton.disabled = true;
            retryPhotoButton.disabled = true;
            fileFallback.hidden = true;
            fallbackPhoto.value = '';
            submitButton.disabled = true;
            submitButton.textContent = navigator.onLine ? 'Registrar llegada' : 'Guardar llegada sin internet';
          }

          function requestLocation() {
            if (!navigator.geolocation) {
              locationStatus.textContent = 'Este navegador no permite obtener la ubicación.';
              showResult('No es posible registrar la llegada sin ubicación. Comunícate con Operaciones.', 'warning');
              return;
            }
            navigator.geolocation.getCurrentPosition(
              (position) => {
                locationEvidence = {
                  latitude: position.coords.latitude,
                  longitude: position.coords.longitude,
                  accuracyMeters: position.coords.accuracy,
                  clientCapturedAt: new Date(position.timestamp || Date.now()).toISOString()
                };
                locationStatus.textContent = `Ubicación obtenida con precisión aproximada de ${Math.round(position.coords.accuracy)} metros.`;
                updateSubmitState();
              },
              (error) => {
                const denied = error?.code === 1;
                locationStatus.textContent = denied
                  ? 'Permiso de ubicación rechazado.'
                  : 'No fue posible obtener una ubicación confiable.';
                showResult('Activa la ubicación y concede el permiso para registrar la llegada.', 'warning');
              },
              { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 }
            );
          }

          async function startCamera() {
            if (!photoRequired) return;
            if (!navigator.mediaDevices?.getUserMedia) {
              fileFallback.hidden = false;
              return;
            }
            try {
              cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 960 } },
                audio: false
              });
              cameraVideo.srcObject = cameraStream;
              cameraVideo.hidden = false;
              await cameraVideo.play();
              capturePhotoButton.disabled = false;
            } catch {
              fileFallback.hidden = false;
              showResult('No se pudo abrir la cámara. Usa la opción de foto disponible en esta pantalla.', 'warning');
            }
          }

          function setPhoto(blob) {
            clearPhotoUrl();
            photoBlob = blob;
            photoUrl = URL.createObjectURL(blob);
            photoPreview.src = photoUrl;
            photoPreview.hidden = false;
            cameraVideo.hidden = true;
            capturePhotoButton.disabled = true;
            retryPhotoButton.disabled = false;
            stopCamera();
            updateSubmitState();
          }

          capturePhotoButton.addEventListener('click', () => {
            const sourceWidth = cameraVideo.videoWidth || 720;
            const sourceHeight = cameraVideo.videoHeight || 960;
            const scale = Math.min(1, 720 / sourceWidth);
            cameraCanvas.width = Math.round(sourceWidth * scale);
            cameraCanvas.height = Math.round(sourceHeight * scale);
            const context = cameraCanvas.getContext('2d');
            context.drawImage(cameraVideo, 0, 0, cameraCanvas.width, cameraCanvas.height);
            cameraCanvas.toBlob((blob) => {
              if (blob) setPhoto(blob);
              else showResult('No fue posible tomar la fotografía. Intenta nuevamente.', 'warning');
            }, 'image/jpeg', 0.82);
          });

          retryPhotoButton.addEventListener('click', async () => {
            clearPhotoUrl();
            photoBlob = null;
            photoPreview.hidden = true;
            retryPhotoButton.disabled = true;
            updateSubmitState();
            await startCamera();
          });

          fallbackPhoto.addEventListener('change', () => {
            const file = fallbackPhoto.files?.[0];
            if (!file) return;
            if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) {
              fallbackPhoto.value = '';
              showResult('La fotografía debe ser JPG, PNG o WEBP y pesar máximo 3 MB.', 'warning');
              return;
            }
            setPhoto(file);
          });

          photoConsent.addEventListener('change', updateSubmitState);

          function receiptForAssignment(id) {
            return offlineState.receipts.find((receipt) => receipt.assignmentId === id) || null;
          }

          function queuedForAssignment(id) {
            return offlineState.queue.find((record) => record.assignmentId === id) || null;
          }

          function formatOpenTime(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return null;
            return new Intl.DateTimeFormat('es-CO', {
              hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/Bogota'
            }).format(date);
          }

          function evaluateAssignmentButton(button) {
            const id = button.dataset.assignmentId;
            const card = document.querySelector(`[data-assignment-card="${CSS.escape(id)}"]`);
            const localStatus = document.querySelector(`[data-local-status="${CSS.escape(id)}"]`);
            const queued = queuedForAssignment(id);
            const receipt = receiptForAssignment(id);
            button.classList.remove('queued');
            card?.classList.remove('has-pending');
            if (queued) {
              const labels = {
                PENDING: 'Llegada guardada offline',
                SYNCING: 'Sincronizando llegada…',
                SESSION_REQUIRED: 'Activa nuevamente para sincronizar'
              };
              button.disabled = true;
              button.classList.add('queued');
              button.textContent = labels[queued.state] || 'Llegada pendiente de sincronización';
              if (localStatus) localStatus.textContent = queued.state === 'SESSION_REQUIRED'
                ? 'La marca sigue segura en este celular, pero se necesita una nueva activación para enviarla.'
                : 'La marca está guardada en este celular y no se eliminará hasta que Lórren confirme la sincronización.';
              card?.classList.add('has-pending');
              return;
            }
            if (receipt && ['SYNCED', 'REVIEW_REQUIRED', 'ALREADY_RECORDED'].includes(receipt.state)) {
              button.disabled = true;
              button.textContent = receipt.state === 'REVIEW_REQUIRED'
                ? 'Llegada sincronizada · en revisión'
                : 'Llegada sincronizada';
              return;
            }
            if (button.dataset.arrivalReported === 'true') {
              button.disabled = true;
              button.textContent = button.dataset.serverActionLabel || 'Llegada registrada';
              return;
            }
            if (button.dataset.attendanceEnabled !== 'true') {
              button.disabled = true;
              button.textContent = 'Marcación no habilitada';
              return;
            }
            const now = Date.now();
            const opensAt = new Date(button.dataset.windowOpensAt || '').getTime();
            const closesAt = new Date(button.dataset.windowClosesAt || '').getTime();
            if (!Number.isFinite(opensAt) || !Number.isFinite(closesAt)) {
              button.disabled = true;
              button.textContent = button.dataset.serverActionLabel || 'Horario pendiente';
              return;
            }
            if (now < opensAt) {
              button.disabled = true;
              button.textContent = `Disponible desde ${formatOpenTime(opensAt) || ''}`.trim();
              return;
            }
            if (now > closesAt) {
              button.disabled = true;
              button.textContent = 'Jornada vencida';
              return;
            }
            button.disabled = false;
            button.textContent = navigator.onLine ? 'Registrar llegada' : 'Guardar llegada sin internet';
          }

          function refreshAssignmentButtons() {
            document.querySelectorAll('.arrival-button').forEach(evaluateAssignmentButton);
          }

          function renderConnectivity() {
            const pendingCount = offlineState.queue.length;
            const syncing = offlineState.queue.some((record) => record.state === 'SYNCING');
            connectivityBar.classList.toggle('offline', !offlineState.online);
            connectivityBar.classList.toggle('syncing', syncing);
            if (!offlineState.online) {
              connectivityTitle.textContent = 'Sin conexión';
              connectivityCopy.textContent = pendingCount
                ? `${pendingCount} marcación(es) guardada(s) en este celular.`
                : 'Puedes registrar la llegada y se enviará cuando vuelva internet.';
            } else if (syncing) {
              connectivityTitle.textContent = 'Sincronizando';
              connectivityCopy.textContent = 'Lórren está enviando las marcaciones guardadas.';
            } else if (pendingCount) {
              connectivityTitle.textContent = 'Con conexión · envío pendiente';
              connectivityCopy.textContent = `${pendingCount} marcación(es) esperan sincronización automática.`;
            } else {
              connectivityTitle.textContent = 'Con conexión';
              connectivityCopy.textContent = 'Las marcaciones se enviarán inmediatamente.';
            }
          }

          function handleOfflineState(state) {
            offlineState = state || offlineState;
            renderConnectivity();
            refreshAssignmentButtons();
          }

          async function queueCurrentArrival() {
            if (!offlineApi) throw new Error('El almacenamiento offline no está disponible en este navegador.');
            await offlineApi.queueArrival({
              assignmentId,
              idempotencyKey,
              latitude: locationEvidence.latitude,
              longitude: locationEvidence.longitude,
              accuracyMeters: locationEvidence.accuracyMeters,
              clientCapturedAt: locationEvidence.clientCapturedAt,
              photoConsent: Boolean(photoBlob && photoConsent.checked),
              selfie: photoBlob || null
            });
            showResult('Llegada guardada en este celular. Se sincronizará automáticamente cuando vuelva internet y quedará pendiente de revisión.', 'warning');
            stopCamera();
            submitButton.disabled = true;
            submitButton.textContent = 'Guardada sin conexión';
          }

          document.querySelectorAll('.arrival-button').forEach((button) => {
            button.addEventListener('click', () => {
              if (button.disabled) return;
              assignmentId = button.dataset.assignmentId;
              photoRequired = button.dataset.photoRequired === 'true';
              idempotencyKey = newIdempotencyKey();
              resetDialog();
              if (typeof dialog.showModal === 'function') dialog.showModal();
              else dialog.setAttribute('open', '');
              requestLocation();
              startCamera();
            });
          });

          async function submitArrival() {
            if (!assignmentId || !locationEvidence || (photoRequired && !photoBlob)) return;
            submitButton.disabled = true;
            submitButton.textContent = navigator.onLine ? 'Registrando…' : 'Guardando en este celular…';
            resultBox.hidden = true;

            if (!navigator.onLine) {
              try {
                await queueCurrentArrival();
              } catch (error) {
                showResult(error?.message || 'No fue posible guardar la llegada sin internet.', 'danger');
                submitButton.disabled = false;
                submitButton.textContent = 'Guardar llegada sin internet';
              }
              return;
            }

            const form = new FormData();
            form.set('idempotencyKey', idempotencyKey);
            form.set('latitude', String(locationEvidence.latitude));
            form.set('longitude', String(locationEvidence.longitude));
            form.set('accuracyMeters', String(locationEvidence.accuracyMeters));
            form.set('clientCapturedAt', locationEvidence.clientCapturedAt);
            form.set('captureMode', 'ONLINE_WEB');
            form.set('photoConsent', photoBlob && photoConsent.checked ? 'true' : 'false');
            if (photoBlob) form.set('selfie', photoBlob, 'selfie-llegada.jpg');

            try {
              const response = await fetch(`/operaciones/portal/asignaciones/${encodeURIComponent(assignmentId)}/llegada`, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'worker-portal' },
                body: form
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.ok) {
                if (response.status >= 500 && offlineApi) {
                  await queueCurrentArrival();
                  return;
                }
                const messages = {
                  arrival_window_not_open: 'La ventana para registrar la llegada todavía no está abierta o ya terminó.',
                  arrival_already_registered: 'Esta llegada ya había sido registrada.',
                  attendance_not_enabled: 'La marcación no está habilitada para esta operación.',
                  selfie_required: 'Debes tomar la selfie de evidencia.',
                  photo_consent_required: 'Debes aceptar el uso de la fotografía para continuar.',
                  portal_session_required: 'Tu sesión venció. Solicita un nuevo enlace de activación.',
                  arrival_temporarily_unavailable: 'El registro está temporalmente no disponible. La marca puede guardarse sin conexión.',
                  offline_capture_expired: 'La marcación guardada superó el tiempo máximo permitido para sincronizar.'
                };
                throw new Error(messages[payload.error] || 'No fue posible registrar la llegada. Revisa los permisos e intenta nuevamente.');
              }
              showResult(payload.message || 'Llegada registrada correctamente.', payload.requiresReview ? 'warning' : 'ok');
              stopCamera();
              setTimeout(() => window.location.reload(), 1400);
            } catch (error) {
              if (offlineApi && (error instanceof TypeError || !navigator.onLine)) {
                try {
                  await queueCurrentArrival();
                  return;
                } catch (queueError) {
                  showResult(queueError?.message || 'No fue posible guardar la llegada sin conexión.', 'danger');
                }
              } else {
                showResult(error?.message || 'No fue posible registrar la llegada.', 'danger');
              }
              submitButton.disabled = false;
              submitButton.textContent = navigator.onLine ? 'Registrar llegada' : 'Guardar llegada sin internet';
            }
          }

          submitButton.addEventListener('click', submitArrival);

          function closeDialog() {
            stopCamera();
            clearPhotoUrl();
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          }

          closeButton.addEventListener('click', closeDialog);
          cancelButton.addEventListener('click', closeDialog);
          dialog.addEventListener('cancel', (event) => {
            event.preventDefault();
            closeDialog();
          });

          window.addEventListener('online', () => {
            offlineState.online = true;
            renderConnectivity();
            refreshAssignmentButtons();
          });
          window.addEventListener('offline', () => {
            offlineState.online = false;
            renderConnectivity();
            refreshAssignmentButtons();
          });

          offlineApi?.init({ onStateChange: handleOfflineState }).catch(() => {
            connectivityTitle.textContent = navigator.onLine ? 'Con conexión' : 'Sin conexión';
            connectivityCopy.textContent = navigator.onLine
              ? 'La sincronización offline no está disponible en este navegador.'
              : 'Este navegador no pudo preparar el almacenamiento offline.';
          });
          renderConnectivity();
          refreshAssignmentButtons();
          window.setInterval(refreshAssignmentButtons, 30000);
        })();
      </script>
    <% } else if (mode === 'unavailable') { %>
      <section class="shell">
        <p class="brand">Lórren · Operaciones</p>
        <h1>Portal temporalmente no disponible</h1>
        <p>No pudimos validar la sesión en este momento. Tu dispositivo no fue desactivado.</p>
        <div class="status warning">Intenta abrir el portal nuevamente en unos minutos</div>
      </section>
    <% } else { %>
      <section class="shell">
        <p class="brand">Lórren · Operaciones</p>
        <h1>Acceso no activo</h1>
        <p>Este dispositivo no tiene una sesión vigente. Abre el enlace seguro enviado por Lórren o solicita uno nuevo.</p>
        <div class="status warning">Se requiere activación</div>
      </section>
    <% } %>
  </main>
</body>
</html>
