<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#176c36">
  <title>Portal del Auxiliar · Lórren</title>
  <link rel="manifest" href="/operaciones/portal/manifest.webmanifest">
  <link rel="icon" href="/operaciones/portal/icon.svg" type="image/svg+xml">
  <style>
    :root { color-scheme: light; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; padding: max(20px, env(safe-area-inset-top)) 18px max(28px, env(safe-area-inset-bottom)); background: #f4f6f8; color: #17212b; }
    main { width: min(100%, 580px); margin: 0 auto; }
    .shell, .assignment-card { background: #fff; border: 1px solid #dfe4ea; border-radius: 20px; box-shadow: 0 12px 36px rgba(23, 33, 43, .08); }
    .shell { padding: 26px; }
    .brand { margin: 0 0 10px; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #4d5b69; }
    h1 { margin: 0 0 10px; font-size: clamp(27px, 8vw, 36px); line-height: 1.08; }
    h2 { margin: 0; font-size: 20px; line-height: 1.2; }
    p { margin: 0; color: #4d5b69; line-height: 1.55; }
    button { font: inherit; }
    .status { margin-top: 18px; padding: 15px; border-radius: 12px; background: #f2f5f7; font-weight: 650; color: #263645; }
    .ok { background: #eaf8ef; color: #176c36; }
    .warning { background: #fff6df; color: #76520b; }
    .danger { background: #fdecec; color: #8f2525; }
    .meta { margin-top: 16px; font-size: 13px; color: #72808e; }
    .portal-header { display: flex; gap: 14px; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
    .session-chip { flex: 0 0 auto; padding: 8px 10px; border-radius: 999px; background: #eaf8ef; color: #176c36; font-size: 12px; font-weight: 800; }
    .connectivity-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding: 12px 14px; border: 1px solid #dfe4ea; border-radius: 14px; background: #fff; font-size: 13px; }
    .connectivity-dot { width: 10px; height: 10px; border-radius: 999px; background: #176c36; box-shadow: 0 0 0 4px #eaf8ef; flex: 0 0 auto; }
    .connectivity-bar.offline { background: #fff9e9; border-color: #efd89a; }
    .connectivity-bar.offline .connectivity-dot { background: #a66d00; box-shadow: 0 0 0 4px #fff0bd; }
    .assignment-list { display: grid; gap: 14px; }
    .assignment-card { padding: 18px; }
    .assignment-card.completed { border-color: #9dd4af; background: #fbfffc; }
    .assignment-date { margin-bottom: 8px; color: #176c36; font-size: 13px; font-weight: 800; text-transform: capitalize; }
    .assignment-time { margin-top: 5px; color: #263645; font-weight: 750; }
    .assignment-details { display: grid; gap: 7px; margin: 16px 0; font-size: 14px; }
    .detail-row { display: grid; grid-template-columns: 105px 1fr; gap: 10px; }
    .detail-label { color: #72808e; }
    .detail-value { color: #263645; font-weight: 600; overflow-wrap: anywhere; }
    .work-summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin: 12px 0; }
    .work-chip { padding: 10px; border-radius: 11px; background: #f3f6f8; color: #4d5b69; font-size: 12px; }
    .work-chip strong { display: block; margin-top: 3px; color: #263645; font-size: 13px; }
    .work-chip.overtime { background: #fff6df; color: #76520b; }
    .work-chip.overtime strong { color: #76520b; }
    .action-grid { display: grid; gap: 9px; }
    .mark-button, .primary-button, .secondary-button { width: 100%; border: 0; border-radius: 12px; padding: 14px 16px; font-weight: 800; cursor: pointer; }
    .mark-button, .primary-button { background: #176c36; color: #fff; }
    .mark-button.break { background: #a16610; }
    .mark-button.departure { background: #1f5b8f; }
    .secondary-button { background: #edf1f4; color: #263645; }
    button:disabled { cursor: not-allowed; opacity: .55; }
    .empty-state { padding: 24px; border: 1px dashed #cfd7df; border-radius: 16px; text-align: center; background: #fff; }
    dialog { width: min(calc(100% - 24px), 520px); max-height: calc(100vh - 28px); border: 0; border-radius: 20px; padding: 0; box-shadow: 0 24px 70px rgba(23, 33, 43, .28); }
    dialog::backdrop { background: rgba(12, 21, 29, .62); }
    .dialog-body { padding: 22px; overflow-y: auto; max-height: calc(100vh - 28px); }
    .dialog-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 18px; }
    .icon-button { width: 38px; height: 38px; border: 0; border-radius: 999px; background: #edf1f4; color: #263645; font-size: 22px; cursor: pointer; }
    .step { margin-top: 16px; padding: 15px; border-radius: 14px; background: #f5f7f9; }
    .step-title { margin-bottom: 6px; font-weight: 800; color: #263645; }
    .step-copy { font-size: 14px; }
    .face-stage { position: relative; overflow: hidden; margin-top: 12px; border-radius: 14px; background: #101820; aspect-ratio: 3 / 4; }
    .face-stage video, .face-stage .photo-preview { display: block; width: 100%; height: 100%; margin: 0; object-fit: cover; }
    .face-stage video { transform: scaleX(-1); }
    .face-stage .photo-preview[hidden], .face-stage video[hidden] { display: none; }
    .face-frame { position: absolute; left: 50%; top: 48%; width: 58%; height: 65%; transform: translate(-50%, -50%); border: 3px solid rgba(255,255,255,.92); border-radius: 48% 48% 44% 44%; box-shadow: 0 0 0 999px rgba(0,0,0,.25); pointer-events: none; }
    .camera-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .camera-actions button { padding: 12px; border: 0; border-radius: 10px; font-weight: 750; cursor: pointer; }
    .file-fallback { display: block; margin-top: 12px; font-size: 13px; }
    .consent { display: flex; gap: 10px; align-items: flex-start; margin: 16px 0; font-size: 13px; color: #4d5b69; }
    .consent input { width: 20px; height: 20px; margin: 0; flex: 0 0 auto; }
    .dialog-actions { display: grid; gap: 10px; margin-top: 16px; }
    @media (max-width: 420px) { body { padding-left: 12px; padding-right: 12px; } .detail-row { grid-template-columns: 86px 1fr; } .work-summary { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main>
    <% if (mode === 'activation') { %>
      <section class="shell">
        <p class="brand">Lórren · Operaciones</p>
        <h1>Activando este dispositivo</h1>
        <p>Estamos validando el enlace seguro. No cierres esta pantalla.</p>
        <div id="activation-status" class="status" role="status" aria-live="polite">Validando acceso…</div>
        <script nonce="<%= nonce %>">
          (() => {
            const status = document.getElementById('activation-status');
            const queryParams = new URLSearchParams(window.location.search);
            const fragment = window.location.hash.startsWith('#') ? window.location.hash.slice(1) : '';
            const fragmentParams = new URLSearchParams(fragment);
            const activationToken = queryParams.get('token') || fragmentParams.get('token') || (fragment.includes('=') ? '' : fragment);
            window.history.replaceState(null, document.title, window.location.pathname);
            if (!/^[A-Za-z0-9_-]{43}$/.test(activationToken || '')) {
              status.textContent = 'El enlace no es válido o está incompleto. Solicita uno nuevo.';
              status.classList.add('warning');
              return;
            }
            fetch('/operaciones/portal/activar', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'worker-portal' },
              body: JSON.stringify({ activationToken })
            }).then(async (response) => {
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.ok) throw new Error('activation_rejected');
              status.textContent = 'Dispositivo activado. Abriendo tu portal…';
              status.classList.add('ok');
              window.location.replace(payload.redirectTo || '/operaciones/portal');
            }).catch(() => {
              status.textContent = 'No fue posible activar este dispositivo. El enlace puede haber vencido o ya fue utilizado.';
              status.classList.add('warning');
            });
          })();
        </script>
      </section>
    <% } else if (mode === 'active') { %>
      <% const portalAssignments = Array.isArray(assignments) ? assignments : []; %>
      <header class="portal-header"><div><p class="brand">Lórren · Portal del Auxiliar</p><h1>Mi jornada</h1><p>Registra entrada, almuerzo y salida desde este celular.</p></div><span class="session-chip">Dispositivo verificado</span></header>
      <section id="portal-connectivity" class="connectivity-bar" aria-live="polite"><span class="connectivity-dot" aria-hidden="true"></span><div><strong id="connectivity-title">Con conexión</strong><div id="connectivity-copy">Las marcaciones se enviarán inmediatamente.</div></div></section>
      <% if (portalAssignments.length) { %>
        <section class="assignment-list" aria-label="Asignaciones activas">
          <% portalAssignments.forEach((assignment) => { %>
            <article class="assignment-card <%= assignment.departureReported ? 'completed' : '' %>" data-assignment-card="<%= assignment.id %>">
              <p class="assignment-date"><%= assignment.dateLabel %></p><h2><%= assignment.clientName %></h2><p class="assignment-time"><%= assignment.timeLabel %></p>
              <div class="assignment-details">
                <div class="detail-row"><span class="detail-label">Operación</span><span class="detail-value"><%= assignment.operationPointName %></span></div>
                <div class="detail-row"><span class="detail-label">Ciudad</span><span class="detail-value"><%= assignment.cityName %></span></div>
                <div class="detail-row"><span class="detail-label">Dirección</span><span class="detail-value"><%= assignment.address %></span></div>
              </div>
              <% if (assignment.arrivalReported || assignment.departureReported) { %>
                <div class="work-summary">
                  <div class="work-chip">Llegada<strong><%= assignment.arrivalReportedLabel || 'Registrada' %></strong></div>
                  <div class="work-chip">Salida<strong><%= assignment.departureReportedLabel || 'Pendiente' %></strong></div>
                  <% if (assignment.breakStarted) { %><div class="work-chip">Inicio almuerzo<strong><%= assignment.breakStartLabel %></strong></div><% } %>
                  <% if (assignment.breakEnded) { %><div class="work-chip">Fin almuerzo<strong><%= assignment.breakEndLabel %></strong></div><% } %>
                  <% if (assignment.workedLabel) { %><div class="work-chip">Tiempo trabajado<strong><%= assignment.workedLabel %></strong></div><% } %>
                  <% if (assignment.overtimeMinutes > 0) { %><div class="work-chip overtime">Horas extra<strong><%= assignment.overtimeLabel %></strong></div><% } %>
                  <% if (assignment.arrivalStatusLabel) { %><div class="work-chip">Estado<strong><%= assignment.arrivalStatusLabel %></strong></div><% } %>
                </div>
              <% } %>
              <div class="action-grid">
                <% if (!assignment.arrivalReported && !assignment.departureReported) { %>
                  <button type="button" class="mark-button" data-assignment-id="<%= assignment.id %>" data-mark-type="ARRIVAL" data-photo-required="<%= assignment.photoRequired ? 'true' : 'false' %>" <%= assignment.canRegisterArrival ? '' : 'disabled' %>><%= assignment.actionLabel %></button>
                <% } else if (!assignment.departureReported) { %>
                  <% if (assignment.breakActionType) { %><button type="button" class="mark-button break" data-assignment-id="<%= assignment.id %>" data-mark-type="<%= assignment.breakActionType %>" data-photo-required="false"><%= assignment.breakActionLabel %></button><% } %>
                  <button type="button" class="mark-button departure" data-assignment-id="<%= assignment.id %>" data-mark-type="DEPARTURE" data-photo-required="<%= assignment.photoRequired ? 'true' : 'false' %>" <%= assignment.canRegisterDeparture ? '' : 'disabled' %>><%= assignment.actionLabel %></button>
                <% } else { %>
                  <button type="button" class="mark-button" disabled><%= assignment.actionLabel %></button>
                <% } %>
              </div>
            </article>
          <% }); %>
        </section>
      <% } else { %><section class="empty-state"><h2>No tienes asignaciones activas</h2><p class="meta">Cuando Operaciones te programe un servicio, aparecerá aquí automáticamente.</p></section><% } %>
      <% if (expiresAt) { %><p class="meta">Tu sesión permanece en este dispositivo y puede revocarse desde Lórren.</p><% } %>

      <dialog id="mark-dialog" aria-labelledby="mark-title">
        <div class="dialog-body">
          <div class="dialog-head"><div><p class="brand">Registro seguro</p><h2 id="mark-title">Confirmar marcación</h2></div><button type="button" class="icon-button" id="close-mark" aria-label="Cerrar">×</button></div>
          <div class="step"><p class="step-title">1. Ubicación</p><p id="location-status" class="step-copy" role="status">Preparando GPS…</p></div>
          <div class="step" id="camera-step" hidden>
            <p class="step-title">2. Verificación</p>
            <p id="biometric-instruction" class="step-copy">Ubica tu rostro en el marco.</p>
            <div class="face-stage">
              <video id="camera-video" playsinline muted hidden></video>
              <img id="photo-preview" class="photo-preview" alt="Vista previa" hidden>
              <div class="face-frame" aria-hidden="true"></div>
            </div>
            <canvas id="camera-canvas" hidden></canvas>
            <div class="camera-actions"><button type="button" id="capture-photo" disabled>Continuar</button><button type="button" id="retry-photo" disabled>Repetir</button></div>
            <label class="file-fallback" id="file-fallback" hidden>Cámara no disponible:<input type="file" id="fallback-photo" accept="image/jpeg,image/png,image/webp" capture="user"></label>
          </div>
          <label class="consent" id="photo-consent-wrap" hidden><input type="checkbox" id="photo-consent"><span>Autorizo esta captura para validar mi identidad y asistencia.</span></label>
          <div id="mark-result" class="status" role="status" aria-live="polite" hidden></div>
          <div class="dialog-actions"><button type="button" class="primary-button" id="submit-mark" disabled>Registrar</button><button type="button" class="secondary-button" id="cancel-mark">Cancelar</button></div>
        </div>
      </dialog>

      <script src="/public/worker-biometric.js"></script>
      <script src="/operaciones/portal/offline.js"></script>
      <script nonce="<%= nonce %>">
        (() => {
          const dialog = document.getElementById('mark-dialog');
          const title = document.getElementById('mark-title');
          const locationStatus = document.getElementById('location-status');
          const cameraStep = document.getElementById('camera-step');
          const biometricInstruction = document.getElementById('biometric-instruction');
          const cameraVideo = document.getElementById('camera-video');
          const cameraCanvas = document.getElementById('camera-canvas');
          const photoPreview = document.getElementById('photo-preview');
          const capturePhotoButton = document.getElementById('capture-photo');
          const retryPhotoButton = document.getElementById('retry-photo');
          const fileFallback = document.getElementById('file-fallback');
          const fallbackPhoto = document.getElementById('fallback-photo');
          const photoConsentWrap = document.getElementById('photo-consent-wrap');
          const photoConsent = document.getElementById('photo-consent');
          const submitButton = document.getElementById('submit-mark');
          const resultBox = document.getElementById('mark-result');
          const connectivityBar = document.getElementById('portal-connectivity');
          const connectivityTitle = document.getElementById('connectivity-title');
          const connectivityCopy = document.getElementById('connectivity-copy');
          const offlineApi = window.LorrenWorkerPortalOffline || null;
          const biometricApi = window.LorrenWorkerBiometric || null;
          let assignmentId = null;
          let markType = 'ARRIVAL';
          let photoRequired = false;
          let locationEvidence = null;
          let photoBlob = null;
          let photoUrl = null;
          let cameraStream = null;
          let idempotencyKey = null;
          let biometricChallenge = null;
          let biometricEnabled = false;
          let offlineState = { queue: [], receipts: [], online: navigator.onLine };

          const labelFor = (type) => ({ ARRIVAL: 'llegada', BREAK_START: 'inicio de almuerzo', BREAK_END: 'fin de almuerzo', DEPARTURE: 'salida' })[type] || 'marcación';
          const endpointFor = (type) => ({ ARRIVAL: 'llegada', BREAK_START: 'inicio-almuerzo', BREAK_END: 'fin-almuerzo', DEPARTURE: 'salida' })[type];
          const supportsOffline = () => markType === 'ARRIVAL' || markType === 'DEPARTURE';
          const supportsBiometric = () => markType === 'ARRIVAL' || markType === 'DEPARTURE';

          function newIdempotencyKey() {
            if (window.crypto?.randomUUID) return window.crypto.randomUUID();
            return `${markType.toLowerCase()}_${Date.now()}_${Math.random().toString(36).slice(2, 14)}`;
          }

          function stopCamera() {
            cameraStream?.getTracks?.().forEach((track) => track.stop());
            cameraStream = null;
            cameraVideo.srcObject = null;
          }

          function clearPhotoUrl() {
            if (photoUrl) URL.revokeObjectURL(photoUrl);
            photoUrl = null;
          }

          function updateSubmitState() {
            submitButton.disabled = !locationEvidence
              || (photoRequired && !photoBlob)
              || (photoBlob && !photoConsent.checked)
              || (!navigator.onLine && !supportsOffline());
          }

          function showResult(message, className) {
            resultBox.hidden = false;
            resultBox.className = `status ${className || ''}`.trim();
            resultBox.textContent = message;
          }

          function showCameraStep(visible) {
            cameraStep.hidden = !visible;
            photoConsentWrap.hidden = !visible;
          }

          function resetDialog() {
            stopCamera();
            clearPhotoUrl();
            locationEvidence = null;
            photoBlob = null;
            biometricChallenge = null;
            biometricEnabled = false;
            photoConsent.checked = false;
            resultBox.hidden = true;
            locationStatus.textContent = 'Solicitando ubicación…';
            biometricInstruction.textContent = 'Ubica tu rostro en el marco.';
            showCameraStep(photoRequired);
            cameraVideo.hidden = true;
            photoPreview.hidden = true;
            capturePhotoButton.disabled = true;
            capturePhotoButton.textContent = 'Continuar';
            retryPhotoButton.disabled = true;
            fileFallback.hidden = true;
            fallbackPhoto.value = '';
            submitButton.disabled = true;
            title.textContent = `Confirmar ${labelFor(markType)}`;
            submitButton.textContent = `Registrar ${labelFor(markType)}`;
            if (!navigator.onLine && !supportsOffline()) showResult('El almuerzo requiere conexión.', 'warning');
          }

          function requestLocation() {
            if (!navigator.geolocation) {
              showResult('Este navegador no permite obtener la ubicación.', 'warning');
              return;
            }
            navigator.geolocation.getCurrentPosition((position) => {
              locationEvidence = {
                latitude: position.coords.latitude,
                longitude: position.coords.longitude,
                accuracyMeters: position.coords.accuracy,
                clientCapturedAt: new Date(position.timestamp || Date.now()).toISOString()
              };
              locationStatus.textContent = `Ubicación lista · precisión ${Math.round(position.coords.accuracy)} m`;
              updateSubmitState();
            }, (error) => {
              locationStatus.textContent = error?.code === 1 ? 'Permiso de ubicación rechazado.' : 'No fue posible obtener la ubicación.';
              showResult('Activa la ubicación para continuar.', 'warning');
            }, { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 });
          }

          async function startCamera() {
            if (!photoRequired) return;
            try {
              if (biometricApi) cameraStream = await biometricApi.startCamera(cameraVideo);
              else {
                if (!navigator.mediaDevices?.getUserMedia) throw new Error('camera_unavailable');
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 960 } }, audio: false });
                cameraVideo.srcObject = cameraStream;
                cameraVideo.hidden = false;
                await cameraVideo.play();
              }
              capturePhotoButton.disabled = false;
            } catch {
              fileFallback.hidden = false;
              showResult('No se pudo abrir la cámara. La marcación quedará para revisión.', 'warning');
            }
          }

          async function requestBiometricChallenge() {
            if (!supportsBiometric() || !navigator.onLine) return null;
            try {
              const response = await fetch('/admin/operaciones/portal-activaciones/biometria/desafio', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'worker-portal' },
                body: JSON.stringify({ assignmentId, markType, idempotencyKey })
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.ok || !payload.enabled) return null;
              return payload.challenge;
            } catch {
              return null;
            }
          }

          async function prepareCameraFlow() {
            if (!supportsBiometric()) {
              if (photoRequired) await startCamera();
              return;
            }
            biometricChallenge = await requestBiometricChallenge();
            biometricEnabled = Boolean(biometricChallenge);
            if (biometricEnabled) photoRequired = true;
            showCameraStep(photoRequired);
            if (photoRequired) {
              biometricInstruction.textContent = biometricEnabled ? 'Mira de frente para comenzar.' : 'Ubica tu rostro en el marco.';
              await startCamera();
            }
          }

          function capturePlainPhoto() {
            const scale = Math.min(1, 720 / (cameraVideo.videoWidth || 720));
            cameraCanvas.width = Math.round((cameraVideo.videoWidth || 720) * scale);
            cameraCanvas.height = Math.round((cameraVideo.videoHeight || 960) * scale);
            cameraCanvas.getContext('2d').drawImage(cameraVideo, 0, 0, cameraCanvas.width, cameraCanvas.height);
            return new Promise((resolve, reject) => cameraCanvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('photo_failed')), 'image/jpeg', .82));
          }

          function setPhoto(blob) {
            clearPhotoUrl();
            photoBlob = blob;
            photoUrl = URL.createObjectURL(blob);
            photoPreview.src = photoUrl;
            photoPreview.hidden = false;
            cameraVideo.hidden = true;
            capturePhotoButton.disabled = true;
            retryPhotoButton.disabled = false;
            stopCamera();
            updateSubmitState();
          }

          async function verifyBiometric(capture) {
            const response = await fetch('/admin/operaciones/portal-activaciones/biometria/verificar', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'worker-portal' },
              body: JSON.stringify({
                assignmentId,
                markType,
                idempotencyKey,
                challengeToken: biometricChallenge.token,
                challengeAction: capture.challengeAction,
                challengeCompleted: capture.challengeCompleted,
                descriptor: capture.descriptor,
                realScore: capture.realScore,
                liveScore: capture.liveScore,
                modelVersion: capture.modelVersion
              })
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok || !payload.ok) throw new Error('biometric_verification_failed');
            return payload;
          }

          capturePhotoButton.addEventListener('click', async () => {
            capturePhotoButton.disabled = true;
            try {
              if (biometricEnabled && biometricApi) {
                const capture = await biometricApi.captureVerification({
                  video: cameraVideo,
                  challenge: biometricChallenge,
                  onStatus: (message) => { biometricInstruction.textContent = message; }
                });
                const assessment = await verifyBiometric(capture);
                setPhoto(capture.photoBlob);
                biometricInstruction.textContent = assessment.verified ? 'Identidad verificada.' : 'Captura lista · revisión requerida.';
                if (assessment.requiresReview) showResult('La marcación quedará para revisión.', 'warning');
                return;
              }
              setPhoto(await capturePlainPhoto());
            } catch {
              try {
                setPhoto(await capturePlainPhoto());
                biometricInstruction.textContent = 'Captura lista · revisión requerida.';
                showResult('No se completó la validación automática. La marcación quedará para revisión.', 'warning');
              } catch {
                capturePhotoButton.disabled = false;
                showResult('No fue posible tomar la fotografía.', 'warning');
              }
            }
          });

          retryPhotoButton.addEventListener('click', async () => {
            clearPhotoUrl();
            photoBlob = null;
            photoPreview.hidden = true;
            retryPhotoButton.disabled = true;
            updateSubmitState();
            await startCamera();
          });

          fallbackPhoto.addEventListener('change', () => {
            const file = fallbackPhoto.files?.[0];
            if (!file) return;
            if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 3 * 1024 * 1024) {
              fallbackPhoto.value = '';
              showResult('Usa una foto JPG, PNG o WEBP de máximo 3 MB.', 'warning');
              return;
            }
            setPhoto(file);
            showResult('La captura quedará para revisión.', 'warning');
          });

          photoConsent.addEventListener('change', updateSubmitState);

          function renderConnectivity() {
            offlineState.online = navigator.onLine;
            connectivityBar.classList.toggle('offline', !navigator.onLine);
            connectivityTitle.textContent = navigator.onLine ? 'Con conexión' : 'Sin conexión';
            connectivityCopy.textContent = navigator.onLine ? 'Marcaciones inmediatas.' : 'Llegada y salida se guardan en el celular.';
          }

          async function queueCurrentMark() {
            if (!offlineApi || !supportsOffline()) throw new Error('Esta marcación requiere conexión.');
            await offlineApi.queueMark({
              markType, assignmentId, idempotencyKey,
              latitude: locationEvidence.latitude,
              longitude: locationEvidence.longitude,
              accuracyMeters: locationEvidence.accuracyMeters,
              clientCapturedAt: locationEvidence.clientCapturedAt,
              photoConsent: Boolean(photoBlob && photoConsent.checked),
              selfie: photoBlob || null
            });
            showResult(`${labelFor(markType)} guardada. Se sincronizará automáticamente.`, 'warning');
            submitButton.disabled = true;
          }

          document.querySelectorAll('.mark-button[data-mark-type]').forEach((button) => button.addEventListener('click', async () => {
            if (button.disabled) return;
            assignmentId = button.dataset.assignmentId;
            markType = button.dataset.markType;
            photoRequired = button.dataset.photoRequired === 'true';
            idempotencyKey = newIdempotencyKey();
            resetDialog();
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', '');
            requestLocation();
            await prepareCameraFlow();
          }));

          async function submitMark() {
            if (!assignmentId || !locationEvidence || (photoRequired && !photoBlob)) return;
            submitButton.disabled = true;
            submitButton.textContent = navigator.onLine ? 'Registrando…' : 'Guardando…';
            resultBox.hidden = true;
            if (!navigator.onLine) {
              try { await queueCurrentMark(); }
              catch (error) { showResult(error?.message || 'No fue posible guardar sin conexión.', 'danger'); submitButton.disabled = false; }
              return;
            }
            const form = new FormData();
            form.set('idempotencyKey', idempotencyKey);
            form.set('latitude', String(locationEvidence.latitude));
            form.set('longitude', String(locationEvidence.longitude));
            form.set('accuracyMeters', String(locationEvidence.accuracyMeters));
            form.set('clientCapturedAt', locationEvidence.clientCapturedAt);
            form.set('captureMode', 'ONLINE_WEB');
            form.set('photoConsent', photoBlob && photoConsent.checked ? 'true' : 'false');
            if (photoBlob) form.set('selfie', photoBlob, `selfie-${labelFor(markType).replaceAll(' ', '-')}.jpg`);
            try {
              const response = await fetch(`/operaciones/portal/asignaciones/${encodeURIComponent(assignmentId)}/${endpointFor(markType)}`, {
                method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'worker-portal' }, body: form
              });
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.ok) {
                const messages = {
                  arrival_already_registered: 'La llegada ya había sido registrada.',
                  departure_arrival_required: 'Debes registrar la llegada antes de la salida.',
                  departure_already_registered: 'La salida ya había sido registrada.',
                  break_arrival_required: 'Debes registrar la llegada antes del almuerzo.',
                  break_already_started: 'El almuerzo ya fue iniciado.',
                  break_start_required: 'Primero debes iniciar el almuerzo.',
                  break_already_completed: 'El almuerzo ya fue finalizado.',
                  attendance_not_enabled: 'La marcación no está habilitada.',
                  selfie_required: 'Debes tomar la fotografía.',
                  photo_consent_required: 'Debes aceptar el uso de la captura.',
                  portal_session_required: 'Tu sesión venció.'
                };
                throw new Error(messages[payload.error] || 'No fue posible registrar la marcación.');
              }
              showResult(payload.message || 'Marcación registrada.', payload.requiresReview ? 'warning' : 'ok');
              stopCamera();
              setTimeout(() => window.location.reload(), 1200);
            } catch (error) {
              showResult(error?.message || 'No fue posible registrar.', 'danger');
              submitButton.disabled = false;
              submitButton.textContent = `Registrar ${labelFor(markType)}`;
            }
          }

          submitButton.addEventListener('click', submitMark);
          function closeDialog() {
            stopCamera();
            clearPhotoUrl();
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          }
          document.getElementById('close-mark').addEventListener('click', closeDialog);
          document.getElementById('cancel-mark').addEventListener('click', closeDialog);
          dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeDialog(); });
          window.addEventListener('online', () => { renderConnectivity(); updateSubmitState(); });
          window.addEventListener('offline', () => { renderConnectivity(); updateSubmitState(); });
          offlineApi?.init({ onStateChange: (state) => { offlineState = state || offlineState; renderConnectivity(); } }).catch(() => {});
          renderConnectivity();
        })();
      </script>
    <% } else if (mode === 'unavailable') { %><section class="shell"><p class="brand">Lórren · Operaciones</p><h1>Portal temporalmente no disponible</h1><p>No pudimos validar la sesión en este momento. Tu dispositivo no fue desactivado.</p><div class="status warning">Intenta nuevamente en unos minutos</div></section>
    <% } else { %><section class="shell"><p class="brand">Lórren · Operaciones</p><h1>Acceso no activo</h1><p>Este dispositivo no tiene una sesión vigente. Abre el enlace seguro enviado por Lórren o solicita uno nuevo.</p><div class="status warning">Se requiere activación</div></section><% } %>
  </main>
</body>
</html>
