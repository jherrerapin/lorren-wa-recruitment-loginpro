<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHRzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    .attendance-page{display:grid;gap:16px}.filter-card,.metrics-card,.attendance-card,.attendance-list-tools{background:#fff;border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow-sm)}.filter-card{padding:16px}.filter-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;align-items:end}.filter-grid input,.filter-grid select{width:100%}.filter-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.metrics-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px}.metric{padding:14px;border-top:4px solid var(--teal)}.metric.review{border-top-color:#d97706}.metric.auto{border-top-color:#15803d}.metric.manual{border-top-color:#2563eb}.metric.late{border-top-color:#b45309}.metric.rejected{border-top-color:#b91c1c}.metric.no-show{border-top-color:#64748b}.metric-label{color:var(--muted);font-size:11px;font-weight:900;text-transform:uppercase}.metric-value{margin-top:5px;color:var(--navy);font-size:25px;font-weight:950}.attendance-list-tools{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:14px 16px}.attendance-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}details.attendance-card{overflow:hidden;min-width:0;border-left:5px solid #94a3b8}details.attendance-card[open]{grid-column:1 / -1;box-shadow:var(--shadow)}.attendance-summary{cursor:pointer;list-style:none;padding:15px 16px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px 14px}.attendance-summary::-webkit-details-marker{display:none}.summary-main{display:block;min-width:0}.summary-name{display:block;margin-top:2px;color:var(--navy);font-size:18px;font-weight:950}.summary-operation{display:block;margin-top:4px;color:var(--muted);font-size:12px}.summary-facts{grid-column:1 / -1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.summary-fact{padding:8px 9px;border:1px solid #e5eaf0;border-radius:10px;background:#fafcfd}.summary-fact>span{display:block;color:var(--muted);font-size:9px;font-weight:900;text-transform:uppercase}.summary-fact>strong{display:block;margin-top:3px;color:var(--navy);font-size:12px}.summary-footer{grid-column:1 / -1;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.summary-chips,.risk-row{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.attendance-body{padding:16px 18px;display:grid;gap:14px}.status-pill,.risk-score,.risk-flag,.risk-ok{display:inline-flex;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:900}.status-pill,.risk-score{background:#eef2f7;color:#475569}.risk-flag{background:#fff7ed;color:#9a3412}.risk-ok{background:#dcfce7;color:#166534}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.fact{padding:10px 12px;border:1px solid #e5eaf0;border-radius:12px;background:#fafcfd}.fact span{display:block;color:var(--muted);font-size:10px;font-weight:900;text-transform:uppercase}.fact strong{display:block;margin-top:4px;color:var(--navy);font-size:13px}.work-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.work-card{padding:12px;border-radius:12px;background:#effaf3;border:1px solid #b7dfc4}.work-card span{display:block;color:#39704c;font-size:10px;font-weight:900;text-transform:uppercase}.work-card strong{display:block;margin-top:4px;color:#174c2b;font-size:15px}.detail-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:14px}.attendance-map{height:320px;border:1px solid var(--border);border-radius:14px;background:#eef2f5}.review-panel,.policy-panel{border:1px solid var(--border);border-radius:14px;overflow:hidden}.review-panel>summary,.policy-panel>summary{cursor:pointer;padding:12px 14px;color:var(--navy);font-size:13px;font-weight:900;background:#f8fafc}.review-content{padding:14px;display:grid;gap:12px}.review-form{display:grid;gap:9px;padding:12px;border:1px solid #e5eaf0;border-radius:12px}.review-form textarea,.review-form select,.review-form input{width:100%}.review-form textarea{min-height:74px}.inline{display:grid;grid-template-columns:180px minmax(0,1fr);gap:9px}.alert-success{background:#dcfce7;border:1px solid #86efac;color:#166534;border-radius:12px;padding:11px}.alert-error{background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;border-radius:12px;padding:11px}.empty-state{padding:38px;text-align:center;background:#fff;border:1px dashed var(--border);border-radius:18px}@media(max-width:900px){.attendance-list{grid-template-columns:1fr}details.attendance-card[open]{grid-column:auto}}@media(max-width:820px){.facts,.work-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}}@media(max-width:620px){.metrics-grid,.filter-grid,.facts,.work-grid,.summary-facts{grid-template-columns:1fr}.inline{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <% const filters=board?.filters||{}; const range=board?.range||{}; const metrics=board?.metrics||{}; const rows=board?.rows||[]; %>
  <% const hiddenFilters=()=>`<input type="hidden" name="from" value="${String(range.from||'')}"/><input type="hidden" name="to" value="${String(range.to||'')}"/><input type="hidden" name="status" value="${String(filters.status||'ALL')}"/><input type="hidden" name="client" value="${String(filters.client||'ALL')}"/><input type="hidden" name="q" value="${String(filters.q||'')}"/>`; %>
  <nav class="navbar"><a class="brand" href="/admin"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a><a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a><span class="spacer"></span><form method="post" action="/logout"><button class="btn-logout">Cerrar sesión</button></form></nav>
  <main class="page attendance-page">
    <section class="hero"><div><div class="eyebrow">Control operativo</div><h1>Asistencia operativa</h1><p>Controla entrada, salida, descanso no remunerado y tiempo neto trabajado. Las horas mostradas son operativas; los recargos legales se liquidan con las reglas de nómina.</p></div><div class="actions"><a class="btn" href="/admin/operaciones">Volver al panel</a><a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ver asignaciones</a></div></section>
    <% if(success){ %><div class="alert-success"><%= success %></div><% } %><% if(error){ %><div class="alert-error"><%= error %></div><% } %>
    <section class="filter-card"><form method="get"><div class="filter-grid"><div class="field"><label>Desde</label><input name="from" type="date" value="<%= range.from||'' %>"/></div><div class="field"><label>Hasta</label><input name="to" type="date" value="<%= range.to||'' %>"/></div><div class="field"><label>Estado</label><select name="status"><% [['ALL','Todos'],['REVIEW_REQUIRED','Pendientes de revisión'],['AUTO_VALIDATED','Validadas automáticamente'],['MANUAL_VALIDATED','Validadas manualmente'],['REJECTED','Rechazadas'],['NO_SHOW','No registraron llegada'],['PENDING','Pendientes de llegada']].forEach(([v,l])=>{ %><option value="<%= v %>" <%= filters.status===v?'selected':'' %>><%= l %></option><% }) %></select></div><div class="field"><label>Cliente</label><select name="client"><option value="ALL">Todos</option><% (board.clients||[]).forEach(c=>{ %><option value="<%= c %>" <%= filters.client===c?'selected':'' %>><%= c %></option><% }) %></select></div><div class="field"><label>Auxiliar, documento o punto</label><input name="q" value="<%= filters.q||'' %>"/></div></div><div class="filter-actions"><button class="btn btn-primary">Aplicar filtros</button><a class="btn" href="/admin/operaciones/asistencia">Hoy</a></div></form></section>
    <section class="metrics-grid"><article class="metrics-card metric"><div class="metric-label">Asignaciones</div><div class="metric-value"><%= metrics.total||0 %></div></article><article class="metrics-card metric review"><div class="metric-label">Por revisar</div><div class="metric-value"><%= metrics.pendingReview||0 %></div></article><article class="metrics-card metric auto"><div class="metric-label">Automáticas</div><div class="metric-value"><%= metrics.autoValidated||0 %></div></article><article class="metrics-card metric manual"><div class="metric-label">Manuales</div><div class="metric-value"><%= metrics.manualValidated||0 %></div></article><article class="metrics-card metric late"><div class="metric-label">Llegadas tarde</div><div class="metric-value"><%= metrics.late||0 %></div></article><article class="metrics-card metric rejected"><div class="metric-label">Rechazadas</div><div class="metric-value"><%= metrics.rejected||0 %></div></article><article class="metrics-card metric no-show"><div class="metric-label">Sin llegada</div><div class="metric-value"><%= metrics.noShow||0 %></div></article></section>
    <% if(!rows.length){ %><section class="empty-state"><strong>No hay asistencias para los filtros seleccionados.</strong></section><% }else{ %>
      <section class="attendance-list-tools"><div><strong><%= rows.length %> auxiliar(es)</strong><p>La tarjeta comprimida muestra entrada, salida, tiempo neto y señales principales.</p></div><div class="actions"><button class="btn" id="expandAllAttendance">Desplegar todas</button><button class="btn" id="collapseAllAttendance">Comprimir todas</button></div></section>
      <section class="attendance-list"><% rows.forEach((row,index)=>{ %>
        <details class="attendance-card status-card-<%= row.status %>" data-attendance-card><summary class="attendance-summary"><span class="summary-main"><span class="eyebrow"><%= row.serviceDateLabel %> · <%= row.scheduleLabel %></span><span class="summary-name"><%= row.workerName %></span><span class="summary-operation"><%= row.clientName %> · <%= row.operationPointName %></span></span><span><span class="status-pill status-<%= row.status %>"><%= row.statusLabel %></span></span><span class="summary-facts"><span class="summary-fact"><span>Llegada</span><strong><%= row.arrivalReportedLabel %></strong></span><span class="summary-fact"><span>Salida</span><strong><%= row.departureReportedLabel||'Sin registro' %></strong></span><span class="summary-fact"><span>Tiempo neto</span><strong><%= row.workedLabel||'Pendiente' %></strong></span><span class="summary-fact"><span>Puntualidad</span><strong><%= row.punctualityLabel %></strong></span><span class="summary-fact"><span>Distancia</span><strong><%= row.distanceToPointMeters===null?'Sin dato':Math.round(row.distanceToPointMeters)+' m' %></strong></span><span class="summary-fact"><span>Precisión GPS</span><strong><%= row.accuracyMeters===null?'Sin dato':Math.round(row.accuracyMeters)+' m' %></strong></span></span><span class="summary-footer"><span class="summary-chips"><span class="risk-score">Riesgo: <%= row.riskScore %>/100</span><% if(row.insideGeofence===true){ %><span class="risk-ok">Dentro de geocerca</span><% } %><% if(row.insideGeofence===false){ %><span class="risk-flag">Fuera de geocerca</span><% } %></span></span></summary>
        <div class="attendance-body"><div class="work-grid"><div class="work-card"><span>Tiempo bruto</span><strong><%= row.grossWorkedLabel||'Pendiente' %></strong></div><div class="work-card"><span>Descanso descontado</span><strong><%= row.unpaidBreakLabel||'Pendiente' %></strong></div><div class="work-card"><span>Tiempo neto pagable</span><strong><%= row.workedLabel||'Pendiente' %></strong></div><div class="work-card"><span>Política configurada</span><strong><%= row.configuredBreakLabel||'Sin descanso no remunerado' %></strong></div></div>
        <div class="facts"><div class="fact"><span>Documento</span><strong><%= [row.documentType,row.documentNumber].filter(Boolean).join(' ')||'Sin documento' %></strong></div><div class="fact"><span>Teléfono</span><strong><%= row.phone||'Sin teléfono' %></strong></div><div class="fact"><span>Llegada reportada</span><strong><%= row.arrivalReportedLabel %></strong></div><div class="fact"><span>Salida reportada</span><strong><%= row.departureReportedLabel||'Sin registro' %></strong></div><div class="fact"><span>Ciudad</span><strong><%= row.cityName %></strong></div><div class="fact"><span>Dirección</span><strong><%= row.address %></strong></div><div class="fact"><span>Distancia al punto</span><strong><%= row.distanceToPointMeters===null?'Sin dato':Math.round(row.distanceToPointMeters)+' m' %></strong></div><div class="fact"><span>Precisión GPS</span><strong><%= row.accuracyMeters===null?'Sin dato':Math.round(row.accuracyMeters)+' m' %></strong></div></div>
        <div class="risk-row"><span class="risk-score">Riesgo: <%= row.riskScore %>/100</span><% row.riskFlags.forEach(flag=>{ %><span class="risk-flag"><%= flag.replaceAll('_',' ') %></span><% }) %><% if(row.arrivalEvidenceAvailable&&row.arrivalMarkId){ %><a class="btn" href="/admin/operaciones/asistencia/evidence/<%= row.arrivalMarkId %>" target="_blank" rel="noopener">Ver fotografía llegada</a><% } %><% if(row.departureEvidenceAvailable&&row.departureMarkId){ %><a class="btn" href="/admin/operaciones/asistencia/evidence/<%= row.departureMarkId %>" target="_blank" rel="noopener">Ver fotografía salida</a><% } %><% if(row.evidenceAvailable&&row.markId){ %><a class="btn" href="/admin/operaciones/asistencia/evidence/<%= row.markId %>" target="_blank" rel="noopener">Ver fotografía</a><% } %></div>
        <% if(row.serviceRequestId){ %><details class="policy-panel"><summary>Configurar descanso no remunerado</summary><div class="review-content"><form class="review-form break-policy-form" method="post" action="/admin/operaciones/asistencia/service-requests/<%= row.serviceRequestId %>/break-policy"><%- hiddenFilters() %><label>Política<select name="policy" data-break-policy><option value="NONE" <%= row.breakPolicy==='NONE'?'selected':'' %>>Sin descanso no remunerado</option><option value="FLEXIBLE" <%= row.breakPolicy==='FLEXIBLE'?'selected':'' %>>Descanso flexible no remunerado</option></select></label><label>Minutos a descontar<input type="number" name="unpaidBreakMinutes" min="1" max="240" value="<%= row.configuredUnpaidBreakMinutes||60 %>" data-break-minutes /></label><p class="muted">La primera fase descuenta la duración configurada entre la llegada y la salida. No requiere marcar inicio y regreso del almuerzo.</p><button class="btn btn-primary">Guardar política</button></form></div></details><% } %>
        <div class="detail-grid"><div><% if(row.pointLatitude!==null&&row.pointLongitude!==null){ %><details data-map-details><summary class="btn">Ver ubicación y geocerca</summary><div id="attendanceMap<%= index %>" class="attendance-map" data-point-lat="<%= row.pointLatitude %>" data-point-lng="<%= row.pointLongitude %>" data-mark-lat="<%= row.markLatitude===null?'':row.markLatitude %>" data-mark-lng="<%= row.markLongitude===null?'':row.markLongitude %>" data-radius="<%= row.geofenceRadiusMeters %>"></div></details><% } %></div>
        <details class="review-panel"><summary><%= row.sessionId?'Revisar o corregir asistencia':'Registrar asistencia manual' %></summary><div class="review-content"><% if(row.sessionId&&row.arrivalReportedAt){ %><form class="review-form" method="post" action="/admin/operaciones/asistencia/sessions/<%= row.sessionId %>/review"><%- hiddenFilters() %><input type="hidden" name="action" value="VALIDATE"/><div class="inline"><select name="attendanceStatus"><option value="ON_TIME">A tiempo</option><option value="LATE">Tarde</option></select><input name="reason" minlength="5" maxlength="500" required placeholder="Motivo obligatorio"/></div><button class="btn btn-primary">Guardar validación</button></form><form class="review-form" method="post" action="/admin/operaciones/asistencia/sessions/<%= row.sessionId %>/review"><%- hiddenFilters() %><input type="hidden" name="action" value="REJECT"/><h3>Rechazar marcación</h3><input name="reason" minlength="5" required placeholder="Motivo obligatorio"/><button class="btn btn-danger">Rechazar marcación</button></form><form class="review-form" method="post" action="/admin/operaciones/asistencia/sessions/<%= row.sessionId %>/review"><%- hiddenFilters() %><input type="hidden" name="action" value="REOPEN"/><h3>Reabrir revisión</h3><input name="reason" minlength="5" required/><button class="btn btn-warning">Reabrir revisión</button></form><% }else if(row.manualAttendanceAllowed){ %><form class="review-form" method="post" action="/admin/operaciones/asistencia/assignments/<%= row.assignmentId %>/manual"><%- hiddenFilters() %><h3>Marcación manual auditada</h3><select name="attendanceStatus"><option value="ON_TIME">A tiempo</option><option value="LATE">Tarde</option></select><input name="reason" minlength="5" required/><button class="btn btn-primary">Registrar asistencia manual</button></form><% } %></div></details></div></div></details>
      <% }) %></section><% } %>
  </main>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script>(()=>{const cards=[...document.querySelectorAll('[data-attendance-card]')];document.getElementById('expandAllAttendance')?.addEventListener('click',()=>cards.forEach(c=>c.open=true));document.getElementById('collapseAllAttendance')?.addEventListener('click',()=>cards.forEach(c=>c.open=false));document.querySelectorAll('.break-policy-form').forEach(form=>{const policy=form.querySelector('[data-break-policy]'),minutes=form.querySelector('[data-break-minutes]');const sync=()=>{minutes.disabled=policy.value==='NONE';minutes.required=policy.value==='FLEXIBLE'};policy.addEventListener('change',sync);sync()});const initialized=new WeakSet();function num(v){const n=Number(v);return Number.isFinite(n)?n:null}function init(container){if(!container||initialized.has(container)||!window.L)return;const lat=num(container.dataset.pointLat),lng=num(container.dataset.pointLng);if(lat===null||lng===null)return;initialized.add(container);const map=L.map(container,{scrollWheelZoom:false});L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);const op=[lat,lng],radius=Math.max(1,num(container.dataset.radius)||100),bounds=L.latLngBounds([op]);L.circleMarker(op,{radius:8,color:'#1d4ed8',fillOpacity:1}).addTo(map);const circle=L.circle(op,{radius,color:'#2563eb',fillOpacity:.15}).addTo(map);bounds.extend(circle.getBounds());const ml=num(container.dataset.markLat),mn=num(container.dataset.markLng);if(ml!==null&&mn!==null){L.circleMarker([ml,mn],{radius:8,color:'#dc2626',fillOpacity:1}).addTo(map);bounds.extend([ml,mn])}setTimeout(()=>{map.invalidateSize();map.fitBounds(bounds,{padding:[24,24],maxZoom:18})},100)}document.querySelectorAll('[data-map-details]').forEach(d=>d.addEventListener('toggle',()=>{if(d.open)init(d.querySelector('.attendance-map'))}))})();</script>
</body>
</html>
