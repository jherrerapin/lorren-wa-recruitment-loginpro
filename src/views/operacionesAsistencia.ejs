<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHRzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    .attendance-page { display: grid; gap: 16px; }
    .filter-card, .metrics-card, .attendance-card, .attendance-list-tools { background: #fff; border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-sm); }
    .filter-card { padding: 16px; }
    .filter-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; align-items: end; }
    .filter-grid input, .filter-grid select { width: 100%; }
    .filter-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    .metrics-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
    .metric { padding: 14px; border-top: 4px solid var(--teal); }
    .metric.review { border-top-color: #d97706; } .metric.auto { border-top-color: #15803d; } .metric.manual { border-top-color: #2563eb; }
    .metric.late { border-top-color: #b45309; } .metric.rejected { border-top-color: #b91c1c; } .metric.no-show { border-top-color: #64748b; }
    .metric-label { color: var(--muted); font-size: 11px; font-weight: 900; text-transform: uppercase; }
    .metric-value { margin-top: 5px; color: var(--navy); font-size: 25px; font-weight: 950; }
    .attendance-list-tools { padding: 14px 16px; }
    .attendance-list-tools p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
    .attendance-list { display: grid; grid-template-columns: 1fr; gap: 10px; align-items: start; }
    .attendance-card { overflow: hidden; min-width: 0; border-left: 4px solid #94a3b8; }
    .attendance-summary { padding: 11px 14px; overflow-x: auto; }
    .summary-main { display: grid; grid-template-columns: minmax(220px, 1.55fr) minmax(160px, 1.05fr) repeat(3, minmax(145px, 1fr)) minmax(150px, .9fr) minmax(150px, 1fr); gap: 8px 12px; align-items: center; min-width: 1160px; }
    .summary-name { display: block; color: var(--navy); font-size: 15px; font-weight: 950; line-height: 1.2; }
    .summary-secondary { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; line-height: 1.3; }
    .summary-identity, .attendance-mark-cell, .attendance-hours-cell, .attendance-state-cell { min-width: 0; }
    .summary-identity > span, .attendance-mark-cell > span, .attendance-hours-cell > span, .attendance-state-cell > span { display: block; color: var(--muted); font-size: 9px; font-weight: 900; text-transform: uppercase; }
    .summary-identity > strong, .attendance-mark-cell > strong, .attendance-hours-cell > strong { display: block; margin-top: 2px; color: var(--navy); font-size: 12px; overflow-wrap: anywhere; }
    .attendance-mark-cell > small, .attendance-hours-cell > small { display: block; margin-top: 3px; color: var(--muted); font-size: 9px; line-height: 1.25; }
    .attendance-hours-cell > strong { font-size: 11px; }
    .attendance-state-cell { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; }
    .attendance-body { padding: 0 14px 12px; }
    .status-pill, .risk-score, .risk-flag, .risk-ok, .info-chip { display: inline-flex; border-radius: 999px; padding: 5px 9px; font-size: 10px; font-weight: 900; }
    .status-pill, .risk-score { background: #eef2f7; color: #475569; }
    .risk-flag { background: #fff7ed; color: #9a3412; } .risk-ok { background: #dcfce7; color: #166534; }
    .info-chip { background: #e0f2fe; color: #075985; }
    .detail-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr); gap: 10px; align-items: start; }
    .detail-grid > div:empty { display: none; }
    .detail-grid > div:empty + .review-panel { grid-column: 1 / -1; }
    .attendance-map { height: 320px; border: 1px solid var(--border); border-radius: 14px; background: #eef2f5; overflow: hidden; }
    .map-switcher { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
    .map-switcher .btn { min-width: 92px; }
    .map-switcher .btn[aria-pressed="true"] { background: var(--teal); border-color: var(--teal); color: #fff; }
    .map-legend { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; color: var(--muted); font-size: 11px; }
    .map-legend span::before { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 5px; border-radius: 999px; }
    .map-legend .operation::before { background: #2563eb; } .map-legend .arrival::before { background: #dc2626; } .map-legend .departure::before { background: #d97706; }
    .evidence-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .review-panel, [data-map-details] { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .review-panel > summary, [data-map-details] > summary { cursor: pointer; padding: 10px 12px; color: var(--navy); font-size: 12px; font-weight: 900; background: #f8fafc; list-style: none; }
    .review-panel > summary::-webkit-details-marker, [data-map-details] > summary::-webkit-details-marker { display: none; }
    [data-map-details] > summary.btn { display: block; width: 100%; border: 0; border-radius: 0; text-align: left; }
    [data-map-details][open] { padding-bottom: 12px; }
    [data-map-details][open] > :not(summary) { margin-left: 12px; margin-right: 12px; }
    .review-content { padding: 14px; display: grid; gap: 12px; }
    .review-form { display: grid; gap: 9px; padding: 12px; border: 1px solid #e5eaf0; border-radius: 12px; }
    .review-form textarea, .review-form select, .review-form input { width: 100%; }
    .review-form textarea { min-height: 74px; }
    .inline { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 9px; }
    .recognize-early, .manual-break-toggle { display: flex; align-items: flex-start; gap: 9px; padding: 11px; border-radius: 10px; font-size: 12px; }
    .recognize-early { border: 1px solid #f2d085; background: #fff8e7; color: #6b4700; }
    .manual-break-toggle { border: 1px solid #f2d085; background: #fff8e7; color: #6b4700; }
    .recognize-early input, .manual-break-toggle input { width: auto; margin-top: 2px; }
    .manual-break-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
    .manual-break-fields[hidden], [data-manual-break-end-field][hidden] { display: none; }
    .review-hint { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.4; }
    .alert-success { background: #dcfce7; border: 1px solid #86efac; color: #166534; border-radius: 12px; padding: 11px; }
    .alert-error { background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; border-radius: 12px; padding: 11px; }
    .empty-state { padding: 38px; text-align: center; background: #fff; border: 1px dashed var(--border); border-radius: 18px; }
    @media (max-width: 900px) { .detail-grid { grid-template-columns: 1fr; } .detail-grid > .review-panel { grid-column: auto; } }
    @media (max-width: 620px) { .metrics-grid, .filter-grid { grid-template-columns: 1fr; } .manual-break-fields, .inline { grid-template-columns: 1fr; } .map-switcher .btn { flex: 1 1 100px; } }
  </style>
</head>
<body>
  <%
    const filters = board?.filters || {};
    const range = board?.range || {};
    const metrics = board?.metrics || {};
    const rows = board?.rows || [];
    const focusedSession = typeof focusSessionId === 'string' ? focusSessionId : '';
    const hiddenFilters = () => `<input type="hidden" name="from" value="${String(range.from || '')}"/><input type="hidden" name="to" value="${String(range.to || '')}"/><input type="hidden" name="status" value="${String(filters.status || 'ALL')}"/><input type="hidden" name="client" value="${String(filters.client || 'ALL')}"/><input type="hidden" name="q" value="${String(filters.q || '')}"/>`;
    const automaticLateReason = (minutesValue) => {
      const minutes = Math.max(0, Number(minutesValue) || 0);
      if (minutes === 1) return 'Llegada tarde por 1 minuto frente a la hora programada.';
      if (minutes > 1) return `Llegada tarde por ${minutes} minutos frente a la hora programada.`;
      return 'Llegada clasificada como tarde.';
    };
  %>
  <nav class="navbar"><a class="brand" href="/admin"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a><a href="/admin">Panel</a><a href="/admin/vacancies">Vacantes</a><a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a><span class="spacer"></span><form method="post" action="/logout"><button class="btn-logout">Cerrar sesión</button></form></nav>
  <main class="page attendance-page">
    <section class="hero"><div><div class="eyebrow">Control operativo</div><h1>Asistencia operativa</h1><p>La jornada ordinaria es de 7 horas trabajadas. El almuerzo se descuenta según las marcaciones; si se inició y no se finalizó, se aplican 1 hora y 30 minutos. Todo tiempo trabajado por encima de 7 horas se muestra como hora extra.</p></div><div class="actions"><a class="btn" href="/admin/operaciones">Volver al panel</a><a class="btn btn-primary" href="/admin/operaciones/asignaciones">Ver asignaciones</a></div></section>
    <% if (success) { %><div class="alert-success"><%= success %></div><% } %><% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <section class="filter-card"><form method="get"><div class="filter-grid"><div class="field"><label>Desde</label><input name="from" type="date" value="<%= range.from || '' %>"/></div><div class="field"><label>Hasta</label><input name="to" type="date" value="<%= range.to || '' %>"/></div><div class="field"><label>Estado</label><select name="status"><% [['ALL','Todos'],['REVIEW_REQUIRED','Pendientes de revisión'],['AUTO_VALIDATED','Validadas automáticamente'],['MANUAL_VALIDATED','Validadas manualmente'],['REJECTED','Rechazadas'],['NO_SHOW','No registraron llegada'],['PENDING','Pendientes de llegada']].forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option><% }) %></select></div><div class="field"><label>Cliente</label><select name="client"><option value="ALL">Todos</option><% (board.clients || []).forEach((client) => { %><option value="<%= client %>" <%= filters.client === client ? 'selected' : '' %>><%= client %></option><% }) %></select></div><div class="field"><label>Auxiliar, documento o punto</label><input name="q" value="<%= filters.q || '' %>"/></div></div><div class="filter-actions"><button class="btn btn-primary">Aplicar filtros</button><a class="btn" href="/admin/operaciones/asistencia">Hoy</a></div></form></section>
    <section class="metrics-grid"><article class="metrics-card metric"><div class="metric-label">Asignaciones</div><div class="metric-value"><%= metrics.total || 0 %></div></article><article class="metrics-card metric review"><div class="metric-label">Por revisar</div><div class="metric-value"><%= metrics.pendingReview || 0 %></div></article><article class="metrics-card metric auto"><div class="metric-label">Automáticas</div><div class="metric-value"><%= metrics.autoValidated || 0 %></div></article><article class="metrics-card metric manual"><div class="metric-label">Manuales</div><div class="metric-value"><%= metrics.manualValidated || 0 %></div></article><article class="metrics-card metric late"><div class="metric-label">Llegadas tarde</div><div class="metric-value"><%= metrics.late || 0 %></div></article><article class="metrics-card metric rejected"><div class="metric-label">Rechazadas</div><div class="metric-value"><%= metrics.rejected || 0 %></div></article><article class="metrics-card metric no-show"><div class="metric-label">Sin llegada</div><div class="metric-value"><%= metrics.noShow || 0 %></div></article></section>
    <% if (!rows.length) { %><section class="empty-state"><strong>No hay asistencias para los filtros seleccionados.</strong></section><% } else { %>
      <section class="attendance-list-tools"><div><strong><%= rows.length %> auxiliar(es)</strong><p>Entrada, almuerzo, salida y horas calculadas se muestran directamente. Ubicación/geocerca y acciones manuales se abren solo cuando se necesitan.</p></div></section>
      <section class="attendance-list">
        <% rows.forEach((row, index) => {
          const hasArrivalLocation = row.arrivalLatitude !== null && row.arrivalLongitude !== null;
          const hasDepartureLocation = row.departureLatitude !== null && row.departureLongitude !== null;
          const selectedReviewStatus = row.punctualityStatus === 'LATE' ? 'LATE' : 'ON_TIME';
          const initialReviewReason = selectedReviewStatus === 'LATE' ? automaticLateReason(row.lateMinutes) : '';
          const pendingCorrectionMarkTypes = Array.isArray(row.pendingCorrectionMarkTypes) ? row.pendingCorrectionMarkTypes : [];
          const granularCorrectionActive = pendingCorrectionMarkTypes.length > 0;
          const correctionFocused = Boolean(focusedSession && row.sessionId === focusedSession);
          const serviceDateTimeMin = row.serviceDateIso ? `${row.serviceDateIso}T00:00` : '';
          const serviceDateTimeMax = row.serviceDateIso ? `${row.serviceDateIso}T23:59` : '';
          const manualBreakStartMin = row.manualBreakStartMin || serviceDateTimeMin;
          const manualBreakStartMax = row.manualBreakStartMax || serviceDateTimeMax;
          const manualBreakEndMin = row.manualBreakEndMin || manualBreakStartMin;
          const manualBreakEndMax = row.manualBreakEndMax || manualBreakStartMax;
          const manualDepartureMin = row.manualDepartureMin || manualBreakStartMin;
          const manualDepartureMax = row.manualDepartureMax || manualBreakEndMax;
          const hasArrivalManualMark = Boolean(row.arrivalMarkId || row.arrivalReportedAt);
          const hasBreakStartManualMark = Boolean(row.breakStartMarkId);
          const hasBreakEndManualMark = Boolean(row.breakEndMarkId);
          const hasDepartureManualMark = Boolean(row.departureMarkId || row.departureReportedAt);
          const hasMissingManualMark = !hasArrivalManualMark || !hasBreakStartManualMark || !hasBreakEndManualMark || !hasDepartureManualMark;
          const lunchLabel = row.breakStarted
            ? `${row.breakStartLabel || 'Inicio registrado'}${row.breakEnded ? ` → ${row.breakEndLabel || 'Fin registrado'}` : (row.breakPenaltyApplied ? ' → sin regreso' : ' → pendiente')}`
            : 'Sin almuerzo';
          const lunchNote = row.breakPenaltyApplied
            ? `Descuento aplicado: ${row.unpaidBreakLabel || '1 h 30 min'}`
            : (row.breakStarted ? `Descuento: ${row.unpaidBreakLabel || '0 min'}` : 'Sin descuento');
        %>
          <article class="attendance-card status-card-<%= row.status %>" data-attendance-card data-correction-focused="<%= correctionFocused ? 'true' : 'false' %>">
            <div class="attendance-summary" data-visible-attendance-row>
              <div class="summary-main">
                <div style="min-width:0"><span class="eyebrow"><%= row.serviceDateLabel %> · <%= row.scheduleLabel %></span><span class="summary-name"><%= row.workerName %></span><span class="summary-secondary"><%= [row.documentType, row.documentNumber].filter(Boolean).join(' ') || 'Sin documento' %></span></div>
                <div class="summary-identity"><span>Operación</span><strong><%= row.operationPointName %></strong><span class="summary-secondary"><%= row.cityName %></span></div>
                <div class="attendance-mark-cell"><span>Entrada</span><strong><%= row.arrivalReportedLabel || 'Sin registro' %></strong><small>Contabiliza: <%= row.effectiveWorkStartLabel || 'Pendiente' %><% if (row.earlyMinutesExcludedLabel && row.earlyMinutesExcludedLabel !== '0 min') { %> · Anticipado excluido: <%= row.earlyMinutesExcludedLabel %><% } %></small></div>
                <div class="attendance-mark-cell"><span>Almuerzo</span><strong><%= lunchLabel %></strong><small><%= lunchNote %></small></div>
                <div class="attendance-mark-cell"><span>Salida</span><strong><%= row.departureReportedLabel || 'Sin registro' %></strong><small>Entrada a salida: <%= row.recordedSpanLabel || 'Pendiente' %></small></div>
                <div class="attendance-hours-cell"><span>Horas</span><strong>Ord. <%= row.ordinaryWorkedLabel || 'Pendiente' %></strong><small>Extra: <%= row.overtimeLabel || 'Pendiente' %> · Total: <%= row.workedLabel || 'Pendiente' %></small></div>
                <div class="attendance-state-cell"><span>Estado</span><span class="risk-score">Riesgo: <%= row.riskScore %>/100</span><% row.riskFlags.forEach((flag) => { %><span class="risk-flag"><%= flag.replaceAll('_', ' ') %></span><% }) %></div>
              </div>
            </div>
            <div class="attendance-body">
              <div class="detail-grid">
                <div><% if (row.pointLatitude !== null && row.pointLongitude !== null) { %><details data-map-details><summary class="btn">Ver ubicación y geocerca</summary><% if (hasArrivalLocation || hasDepartureLocation) { %><div class="map-switcher" role="group" aria-label="Marcación mostrada en el mapa"><% if (hasArrivalLocation) { %><button type="button" class="btn" data-map-mode="arrival">Entrada</button><% } %><% if (hasDepartureLocation) { %><button type="button" class="btn" data-map-mode="departure">Salida</button><% } %><% if (hasArrivalLocation && hasDepartureLocation) { %><button type="button" class="btn" data-map-mode="both">Ver ambas</button><% } %></div><% } %><div id="attendanceMap<%= index %>" class="attendance-map" data-point-lat="<%= row.pointLatitude %>" data-point-lng="<%= row.pointLongitude %>" data-arrival-lat="<%= hasArrivalLocation ? row.arrivalLatitude : '' %>" data-arrival-lng="<%= hasArrivalLocation ? row.arrivalLongitude : '' %>" data-departure-lat="<%= hasDepartureLocation ? row.departureLatitude : '' %>" data-departure-lng="<%= hasDepartureLocation ? row.departureLongitude : '' %>" data-radius="<%= row.geofenceRadiusMeters %>" data-default-map-mode="<%= hasArrivalLocation ? 'arrival' : (hasDepartureLocation ? 'departure' : 'operation') %>"></div><div class="map-legend"><span class="operation">Punto y geocerca</span><% if (hasArrivalLocation) { %><span class="arrival">Entrada reportada</span><% } %><% if (hasDepartureLocation) { %><span class="departure">Salida reportada</span><% } %></div><% if (row.arrivalEvidenceAvailable && row.arrivalMarkId || row.departureEvidenceAvailable && row.departureMarkId) { %><div class="evidence-row"><% if (row.arrivalEvidenceAvailable && row.arrivalMarkId) { %><a class="btn" href="/admin/operaciones/asistencia/evidence/<%= row.arrivalMarkId %>" target="_blank" rel="noopener">Ver fotografía de entrada</a><% } %><% if (row.departureEvidenceAvailable && row.departureMarkId) { %><a class="btn" href="/admin/operaciones/asistencia/evidence/<%= row.departureMarkId %>" target="_blank" rel="noopener">Ver fotografía de salida</a><% } %></div><% } %></details><% } %></div>
                <details class="review-panel" <%= correctionFocused ? 'open' : '' %>><summary><%= row.sessionId ? 'Revisar o corregir asistencia' : 'Registrar asistencia manual' %></summary><div class="review-content" data-attendance-review-action="<%= row.sessionId ? `/admin/operaciones/asistencia/sessions/${row.sessionId}/review` : '' %>" data-arrival-mark-id="<%= row.arrivalMarkId || '' %>" data-break-start-mark-id="<%= row.breakStartMarkId || '' %>" data-break-end-mark-id="<%= row.breakEndMarkId || '' %>" data-departure-mark-id="<%= row.departureMarkId || '' %>" data-pending-correction-mark-types="<%= pendingCorrectionMarkTypes.join(',') %>" data-last-review-action="<%= row.lastReview?.action || '' %>"><% if (row.sessionId && row.arrivalReportedAt && !granularCorrectionActive) { %><form class="review-form attendance-validation-form" method="post" action="/admin/operaciones/asistencia/sessions/<%= row.sessionId %>/review" data-late-minutes="<%= row.lateMinutes || 0 %>"><%- hiddenFilters() %><input type="hidden" name="action" value="VALIDATE"/><div class="inline"><select name="attendanceStatus" data-review-status><option value="ON_TIME" <%= selectedReviewStatus === 'ON_TIME' ? 'selected' : '' %>>A tiempo</option><option value="LATE" <%= selectedReviewStatus === 'LATE' ? 'selected' : '' %>>Tarde</option></select><input name="reason" maxlength="500" value="<%= initialReviewReason %>" data-review-reason data-auto-generated="<%= selectedReviewStatus === 'LATE' ? 'true' : 'false' %>" placeholder="<%= selectedReviewStatus === 'LATE' ? 'Motivo de la llegada tarde' : 'Observación opcional' %>" <%= selectedReviewStatus === 'LATE' ? 'required minlength="5"' : '' %>/></div><% if (row.canRecognizeEarlyArrival || row.earlyTimeRecognized) { %><label class="recognize-early"><input type="checkbox" name="recognizeEarlyArrival" value="true" <%= row.earlyTimeRecognized ? 'checked' : '' %>/><span><strong>Reconocer tiempo anterior al turno</strong><br/>Incluye en las horas trabajadas los minutos marcados antes de la hora de inicio. Esta decisión queda auditada.</span></label><% } %><p class="review-hint">La observación es opcional para llegadas a tiempo. Para llegadas tarde, Lórren calcula automáticamente el retraso.</p><button class="btn btn-primary">Guardar validación y recalcular</button></form><form class="review-form" method="post" action="/admin/operaciones/asistencia/sessions/<%= row.sessionId %>/review"><%- hiddenFilters() %><input type="hidden" name="action" value="REJECT"/><h3>Rechazar marcación</h3><input name="reason" minlength="5" required placeholder="Motivo obligatorio"/><button class="btn btn-danger">Rechazar marcación</button></form><form class="review-form" method="post" action="/admin/operaciones/asistencia/sessions/<%= row.sessionId %>/review"><%- hiddenFilters() %><input type="hidden" name="action" value="REOPEN"/><h3>Reabrir revisión</h3><input name="reason" minlength="5" required placeholder="Motivo obligatorio"/><button class="btn btn-warning">Reabrir revisión</button></form><% } %><% if (row.manualAttendanceAllowed && !granularCorrectionActive && hasMissingManualMark) { %><form class="review-form" method="post" action="/admin/operaciones/asistencia/assignments/<%= row.assignmentId %>/manual" data-manual-attendance-form><%- hiddenFilters() %><h3>Agregar marcaciones manuales</h3><% if (!hasBreakStartManualMark && !hasBreakEndManualMark) { %><label class="manual-break-toggle"><input type="checkbox" name="penalizeMissingBreak" value="true" data-manual-break-penalty/><span><strong>Penalizar no marcación de almuerzo</strong><br/>Úsalo cuando el auxiliar no registró el almuerzo y coordinación debe completar la novedad. Solo indica el inicio; Lórren registrará automáticamente el fin 1 h 30 min después.</span></label><% } %><div class="manual-break-fields"><div class="field"><label>Entrada</label><% if (hasArrivalManualMark) { %><p class="review-hint">Ya registrada: <%= row.arrivalReportedLabel %></p><% } else { %><input type="datetime-local" name="arrivalReportedAt" min="<%= serviceDateTimeMin %>" max="<%= serviceDateTimeMax %>"/><% } %></div><div class="field"><label>Inicio de almuerzo</label><% if (hasBreakStartManualMark) { %><p class="review-hint">Ya registrado: <%= row.breakStartLabel %></p><% } else { %><input type="datetime-local" name="breakStartAt" min="<%= manualBreakStartMin %>" max="<%= manualBreakStartMax %>"/><% } %></div><div class="field" data-manual-break-end-field><label>Fin de almuerzo</label><% if (hasBreakEndManualMark) { %><p class="review-hint">Ya registrado: <%= row.breakEndLabel %></p><% } else { %><input type="datetime-local" name="breakEndAt" min="<%= manualBreakEndMin %>" max="<%= manualBreakEndMax %>"/><% } %></div><div class="field"><label>Salida</label><% if (hasDepartureManualMark) { %><p class="review-hint">Ya registrada: <%= row.departureReportedLabel || 'Registrada' %></p><% } else { %><input type="datetime-local" name="departureReportedAt" min="<%= manualDepartureMin %>" max="<%= manualDepartureMax %>"/><% } %></div></div><p class="review-hint"><strong>Puedes guardar una sola marca.</strong> Diligencia únicamente la hora que necesitas registrar; las marcaciones anteriores se conservan y la jornada se recalcula cuando haya información suficiente.</p><button class="btn btn-primary">Guardar marcaciones ingresadas</button></form><% } %></div></details>
              </div>
            </div>
          </article>
        <% }) %>
      </section>
    <% } %>
  </main>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script>
    (() => {
      const cards = [...document.querySelectorAll('[data-attendance-card]')];
      const focusedCard = cards.find((card) => card.dataset.correctionFocused === 'true');
      if (focusedCard) window.requestAnimationFrame(() => focusedCard.scrollIntoView({ block: 'center', inline: 'nearest' }));
      function automaticLateReason(minutesValue) { const minutes = Math.max(0, Math.floor(Number(minutesValue) || 0)); if (minutes === 1) return 'Llegada tarde por 1 minuto frente a la hora programada.'; if (minutes > 1) return `Llegada tarde por ${minutes} minutos frente a la hora programada.`; return 'Llegada clasificada como tarde.'; }
      document.querySelectorAll('.attendance-validation-form').forEach((form) => { const status = form.querySelector('[data-review-status]'); const reason = form.querySelector('[data-review-reason]'); const generatedReason = automaticLateReason(form.dataset.lateMinutes); const sync = () => { const late = status.value === 'LATE'; reason.required = late; reason.minLength = late ? 5 : 0; reason.placeholder = late ? 'Motivo de la llegada tarde' : 'Observación opcional'; if (late && (!reason.value.trim() || reason.dataset.autoGenerated === 'true')) { reason.value = generatedReason; reason.dataset.autoGenerated = 'true'; } else if (!late && reason.dataset.autoGenerated === 'true') { reason.value = ''; reason.dataset.autoGenerated = 'false'; } }; reason.addEventListener('input', () => { reason.dataset.autoGenerated = reason.value === generatedReason ? 'true' : 'false'; }); status.addEventListener('change', sync); sync(); });
      document.querySelectorAll('[data-manual-attendance-form]').forEach((form) => {
        const penalty = form.querySelector('[data-manual-break-penalty]');
        const breakStart = form.querySelector('input[name="breakStartAt"]');
        const breakEnd = form.querySelector('input[name="breakEndAt"]');
        const breakEndField = form.querySelector('[data-manual-break-end-field]');
        const syncPenalty = () => {
          const active = Boolean(penalty?.checked);
          if (breakStart) breakStart.required = active;
          if (breakEnd) {
            breakEnd.disabled = active;
            if (active) breakEnd.value = '';
          }
          if (breakEndField) breakEndField.hidden = active;
        };
        penalty?.addEventListener('change', syncPenalty);
        syncPenalty();
      });
      const mapStates = new WeakMap();
      function numberOrNull(value) { if (value === null || value === undefined || value === '') return null; const number = Number(value); return Number.isFinite(number) ? number : null; }
      function coordinate(container, prefix) { const latitude = numberOrNull(container.dataset[`${prefix}Lat`]); const longitude = numberOrNull(container.dataset[`${prefix}Lng`]); return latitude === null || longitude === null ? null : [latitude, longitude]; }
      function fitMap(state, bounds) { [0, 100, 350].forEach((delay) => window.setTimeout(() => { state.map.invalidateSize({ pan: false }); state.map.fitBounds(bounds, { padding: [24, 24], maxZoom: 18, animate: false }); }, delay)); }
      function renderMapMode(state, requestedMode) { const hasArrival = Boolean(state.arrival); const hasDeparture = Boolean(state.departure); let mode = requestedMode; if (mode === 'arrival' && !hasArrival) mode = hasDeparture ? 'departure' : 'operation'; if (mode === 'departure' && !hasDeparture) mode = hasArrival ? 'arrival' : 'operation'; if (mode === 'both' && (!hasArrival || !hasDeparture)) mode = hasArrival ? 'arrival' : (hasDeparture ? 'departure' : 'operation'); state.mode = mode; state.markLayers.clearLayers(); const bounds = L.latLngBounds([state.operation]); bounds.extend(state.geofence.getBounds()); if ((mode === 'arrival' || mode === 'both') && state.arrival) { L.circleMarker(state.arrival, { radius: 8, color: '#dc2626', fillColor: '#dc2626', fillOpacity: 1 }).bindTooltip('Entrada reportada').addTo(state.markLayers); bounds.extend(state.arrival); } if ((mode === 'departure' || mode === 'both') && state.departure) { L.circleMarker(state.departure, { radius: 8, color: '#d97706', fillColor: '#d97706', fillOpacity: 1 }).bindTooltip('Salida reportada').addTo(state.markLayers); bounds.extend(state.departure); } state.details.querySelectorAll('[data-map-mode]').forEach((button) => button.setAttribute('aria-pressed', button.dataset.mapMode === mode ? 'true' : 'false')); fitMap(state, bounds); }
      function initializeMap(details) { const container = details.querySelector('.attendance-map'); if (!container || !window.L) return null; const existing = mapStates.get(container); if (existing) return existing; const operation = coordinate(container, 'point'); if (!operation) return null; const radius = Math.max(1, numberOrNull(container.dataset.radius) || 100); const map = L.map(container, { scrollWheelZoom: false }); container.__lorrenAttendanceMap = map; L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map); L.circleMarker(operation, { radius: 8, color: '#2563eb', fillColor: '#2563eb', fillOpacity: 1 }).bindTooltip('Punto operativo').addTo(map); const geofence = L.circle(operation, { radius, color: '#2563eb', fillOpacity: .15 }).addTo(map); const markLayers = L.layerGroup().addTo(map); const state = { details, container, map, geofence, markLayers, operation, arrival: coordinate(container, 'arrival'), departure: coordinate(container, 'departure'), mode: container.dataset.defaultMapMode || 'operation' }; mapStates.set(container, state); details.querySelectorAll('[data-map-mode]').forEach((button) => button.addEventListener('click', () => renderMapMode(state, button.dataset.mapMode))); renderMapMode(state, state.mode); return state; }
      document.querySelectorAll('[data-map-details]').forEach((details) => details.addEventListener('toggle', () => { if (!details.open) return; const state = initializeMap(details); if (state) renderMapMode(state, state.mode); }));
    })();
  </script>
</body>
