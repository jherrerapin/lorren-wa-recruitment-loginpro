<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> — LoginPro</title>
  <link rel="icon" type="image/png" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .dashboard-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 16px 18px; box-shadow: var(--shadow-sm); }
    .dashboard-toolbar h2 { color: var(--navy); font-size: 16px; margin-bottom: 4px; }
    .dashboard-toolbar p { color: var(--muted); font-size: 13px; }
    .date-filter { display: flex; align-items: end; gap: 10px; flex-wrap: wrap; }
    .date-filter .field { min-width: 190px; }
    .summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .summary-card { display: block; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 18px; box-shadow: var(--shadow-sm); border-top: 4px solid var(--teal); color: inherit; text-decoration: none; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
    .summary-card:hover, .summary-card:focus { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--teal); outline: none; }
    .summary-card.amber { border-top-color: var(--amber); }
    .summary-card.green { border-top-color: var(--green); }
    .summary-card.blue { border-top-color: var(--blue); }
    .summary-card .label { color: var(--muted); font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: .05em; }
    .summary-card .value { color: var(--navy); font-size: 28px; font-weight: 900; margin-top: 7px; }
    .summary-card .hint { color: var(--muted); font-size: 12px; }
    .summary-card .open-hint { color: var(--teal); font-size: 11px; font-weight: 900; margin-top: 8px; }
    .hero { align-items: start; }
    .hero > .actions { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; width: 100%; flex: 1 1 100%; align-items: start; }
    .action-item { display: grid; gap: 4px; max-width: none; min-width: 0; }
    .action-item .btn { width: 100%; min-height: 40px; padding: 9px 8px; font-size: 12px; line-height: 1.12; display: inline-flex; align-items: center; justify-content: center; text-align: center; white-space: normal; }
    .action-item small { display: block; color: var(--muted); font-size: 10px; line-height: 1.25; padding: 0 2px; }
    .action-item.attendance .btn { background: #0f766e; border-color: #0f766e; color: #fff; }
    .action-item.attendance small { color: #0f766e; font-weight: 900; }
    .action-item.session-online .btn { background: #166534; border-color: #166534; color: #fff; }
    .action-item.session-online .btn:hover, .action-item.session-online .btn:focus { background: #14532d; border-color: #14532d; }
    .action-item.session-online small { color: #166534; font-weight: 900; }
    .action-item.session-offline .btn { background: #b91c1c; border-color: #b91c1c; color: #fff; font-size: 11.5px; }
    .action-item.session-offline .btn:hover, .action-item.session-offline .btn:focus { background: #991b1b; border-color: #991b1b; }
    .action-item.session-offline small { color: #b91c1c; font-weight: 900; }
    .action-item.session-checking .btn { border-color: #f59e0b; color: #92400e; background: #fffbeb; }
    .action-item.session-checking .btn:hover, .action-item.session-checking .btn:focus { background: #fef3c7; }
    .action-item.session-checking small { color: #92400e; font-weight: 900; }
    .btn-excel { background: #166534; border-color: #166534; color: #fff; }
    .btn-excel:hover { background: #14532d; }
    .programming-card { background: #fff; border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow-sm); padding: 18px; display: grid; gap: 14px; }
    .programming-card.complete { border-color: var(--green); background: var(--green-soft); }
    .programming-head { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; align-items: start; }
    .programming-head h2 { margin: 0 0 4px; color: var(--navy); font-size: 18px; }
    .programming-head p { margin: 0; color: var(--muted); font-size: 13px; }
    .programming-pill { display: inline-flex; border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 900; background: var(--amber-soft); color: var(--amber); }
    .programming-pill.complete { background: #dcfce7; color: #166534; }
    .manager-row { display: grid; grid-template-columns: minmax(220px, 360px) auto minmax(180px, 260px); gap: 8px; align-items: end; }
    .manager-row label { display: block; color: var(--navy); font-size: 12px; font-weight: 900; margin-bottom: 4px; }
    .manager-row select, .manager-row input { width: 100%; border: 1px solid var(--border); border-radius: 10px; padding: 9px 10px; font: inherit; background: #fff; color: var(--navy); }
    .manager-row .btn { height: 39px; }
    .programming-options { display: flex; align-items: center; gap: 8px; padding: 11px 12px; border: 1px solid #bfdbfe; background: #eff6ff; border-radius: 12px; color: #1e3a8a; }
    .programming-options input { width: 17px; height: 17px; accent-color: var(--teal); cursor: pointer; }
    .programming-options label { cursor: pointer; font-size: 13px; font-weight: 800; }
    .programming-options small { display: block; color: #475569; font-size: 11px; font-weight: 500; margin-top: 2px; }
    .programming-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .programming-actions .btn[disabled] { opacity: .55; cursor: not-allowed; }
    .programming-note { color: var(--muted); font-size: 12px; line-height: 1.45; }
    .async-toast{position:fixed;right:18px;bottom:18px;max-width:360px;background:#172033;color:#fff;border-radius:14px;padding:11px 13px;box-shadow:var(--shadow);font-size:13px;line-height:1.35;z-index:9999;opacity:0;transform:translateY(8px);transition:opacity .18s,transform .18s}.async-toast.show{opacity:1;transform:translateY(0)}
    @media (max-width: 1100px) { .hero > .actions { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 900px) { .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .manager-row { grid-template-columns: 1fr; } }
    @media (max-width: 720px) { .hero > .actions { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 520px) { .summary-grid, .hero > .actions { grid-template-columns: 1fr; } .date-filter, .date-filter .field, .date-filter .btn { width: 100%; } .programming-actions .btn { width: 100%; } }
  </style>
</head>
<body>
  <% const totalRequests = Number(metrics?.totalRequests ?? 0); %>
  <% const completedRequests = Number(metrics?.completedRequests ?? 0); %>
  <% const programmingComplete = totalRequests > 0 && completedRequests >= totalRequests; %>
  <% const summaryUrl = (type) => `/admin/operaciones/dispatch/operations/summary?date=${encodeURIComponent(selectedDate)}&type=${encodeURIComponent(type)}`; %>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones" class="nav-active">Operaciones / Despacho</a>
    <% if (role === 'dev') { %><a href="/admin/monitor">Monitor</a><% } %>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page">
    <section class="hero">
      <div>
        <div class="eyebrow">Panel operativo</div>
        <h1><%= pageTitle %></h1>
        <p><%= subtitle %></p>
      </div>
      <div class="actions" aria-label="Acciones principales de operaciones">
        <div class="action-item">
          <a class="btn btn-primary" href="/admin/operaciones/clientes">Clientes</a>
          <small>Crea clientes, puntos operativos y links públicos de solicitud.</small>
        </div>
        <div class="action-item">
          <a class="btn" href="/admin/operaciones/solicitudes">Crear solicitud</a>
          <small>Abre el formulario para registrar una nueva solicitud operativa.</small>
        </div>
        <div class="action-item">
          <a class="btn" href="/admin/operaciones/asignaciones">Asignación de auxiliares</a>
          <small>Arrastra auxiliares disponibles y guarda asignaciones.</small>
        </div>
        <div class="action-item">
          <a class="btn" href="/admin/operaciones/personal">Personal operativo</a>
          <small>Consulta, sincroniza o crea auxiliares manualmente.</small>
        </div>
        <% if (typeof canAccessAttendanceFeature !== 'undefined' && canAccessAttendanceFeature) { %>
          <div class="action-item attendance">
            <a class="btn" href="/admin/operaciones/asistencia">Asistencia</a>
            <small>Valida llegadas, revisa geocerca, evidencia y ausencias.</small>
          </div>
        <% } %>
        <div class="action-item session-checking" id="dispatchSessionAction">
          <a class="btn" id="dispatchSessionButton" href="/admin/operaciones/whatsapp" aria-describedby="dispatchSessionHint">WhatsApp despacho</a>
          <small id="dispatchSessionHint">Revisando estado de la sesión...</small>
        </div>
      </div>
    </section>

    <section class="dashboard-toolbar" aria-label="Filtro de fecha del panel operativo">
      <div>
        <h2>Indicadores por fecha de servicio</h2>
        <p>Selecciona el día operativo que quieres revisar. También puedes descargar la programación de ese día en Excel, separada por cliente.</p>
      </div>
      <form class="date-filter" method="get" action="/admin/operaciones">
        <div class="field">
          <label for="fecha">Fecha operativa</label>
          <input id="fecha" name="fecha" type="date" value="<%= selectedDate %>" />
        </div>
        <button class="btn btn-primary" type="submit">Aplicar fecha</button>
        <button class="btn btn-excel" type="submit" formaction="/admin/operaciones/programacion.xlsx">Descargar Excel</button>
        <a class="btn" href="/admin/operaciones">Hoy</a>
      </form>
    </section>

    <section class="programming-card <%= programmingComplete ? 'complete' : '' %>" aria-label="Programación del día">
      <div class="programming-head">
        <div>
          <h2>Programación del día</h2>
          <p>Genera la programación operativa en PDF con clientes, horarios, auxiliares y el estado actual de cada solicitud incluida.</p>
        </div>
        <span class="programming-pill <%= programmingComplete ? 'complete' : '' %>"><%= programmingComplete ? 'Programación completa' : `Faltan ${Math.max(totalRequests - completedRequests, 0)} solicitud(es)` %></span>
      </div>
      <div class="manager-row">
        <div>
          <label for="programManagedBy">Gestionado por</label>
          <select id="programManagedBy"><option value="Julián Herrera">Julián Herrera</option></select>
        </div>
        <button class="btn" type="button" id="addProgramManager">+ Agregar</button>
        <div id="customProgramManagerWrap" hidden>
          <label for="customProgramManager">Nuevo nombre</label>
          <input id="customProgramManager" type="text" maxlength="80" placeholder="Nombre de quien gestionó" />
        </div>
      </div>
      <div class="programming-options">
        <input id="includePendingProgramming" type="checkbox" />
        <label for="includePendingProgramming">Incluir solicitudes pendientes o por confirmar<small>Marcado: incluye asignación pendiente, parcial y pendientes de confirmación. Sin marcar: envía únicamente solicitudes completas.</small></label>
      </div>
      <div class="programming-actions">
        <a class="btn" id="programPdfLink" href="/admin/operaciones/programacion.pdf?fecha=<%= selectedDate %>&includePending=false">Descargar PDF</a>
        <a class="btn" id="programEmailLink" href="#" target="_blank" rel="noopener">Abrir correo</a>
        <button class="btn btn-primary" type="button" id="sendProgramWhatsapp">Enviar PDF por WhatsApp</button>
      </div>
      <div class="programming-note">
        <strong>Estado del día:</strong> <%= completedRequests %>/<%= totalRequests %> solicitudes completas. El envío está siempre disponible. Sin marcar la opción se envían solo las completas; al marcarla también se muestran las pendientes y lo que falta por confirmar.
      </div>
    </section>

    <section class="summary-grid" aria-label="Resumen operativo">
      <a class="summary-card" href="<%= summaryUrl('total') %>"><div class="label">Solicitudes del día</div><div class="value"><%= metrics?.totalRequests ?? 0 %></div><div class="hint">Servicios programados para la fecha seleccionada</div><div class="open-hint">Ver solicitudes</div></a>
      <a class="summary-card amber" href="<%= summaryUrl('pending') %>"><div class="label">Pendientes</div><div class="value"><%= metrics?.pendingRequests ?? 0 %></div><div class="hint">Solicitudes de esa fecha que requieren asignación</div><div class="open-hint">Ver pendientes</div></a>
      <a class="summary-card green" href="<%= summaryUrl('complete') %>"><div class="label">Asignación completa</div><div class="value"><%= metrics?.completedRequests ?? 0 %></div><div class="hint">Servicios de esa fecha con cobertura confirmada</div><div class="open-hint">Ver completas</div></a>
      <a class="summary-card blue" href="<%= summaryUrl('incidents') %>"><div class="label">Novedades abiertas</div><div class="value"><%= metrics?.openIncidents ?? 0 %></div><div class="hint">Casos operativos abiertos para esa fecha</div><div class="open-hint">Ver solicitudes con novedad</div></a>
    </section>
  </main>
  <div class="async-toast" id="asyncToast" role="status" aria-live="polite"></div>
  <script>
    const selectedDate = <%- JSON.stringify(selectedDate) %>;
    const managerSelect = document.getElementById('programManagedBy');
    const addManagerButton = document.getElementById('addProgramManager');
    const customManagerWrap = document.getElementById('customProgramManagerWrap');
    const customManagerInput = document.getElementById('customProgramManager');
    const includePendingCheckbox = document.getElementById('includePendingProgramming');
    const pdfLink = document.getElementById('programPdfLink');
    const emailLink = document.getElementById('programEmailLink');
    const whatsappButton = document.getElementById('sendProgramWhatsapp');
    const toast = document.getElementById('asyncToast');
    const dispatchSessionAction = document.getElementById('dispatchSessionAction');
    const dispatchSessionButton = document.getElementById('dispatchSessionButton');
    const dispatchSessionHint = document.getElementById('dispatchSessionHint');
    const MANAGERS_KEY = 'dispatchProgrammingManagers';

    function showToast(message){if(!toast)return;toast.textContent=message;toast.classList.add('show');window.clearTimeout(showToast._t);showToast._t=window.setTimeout(()=>toast.classList.remove('show'),3000);}
    function currentManager(){return managerSelect?.value || 'Julián Herrera';}
    function includePendingRequests(){return Boolean(includePendingCheckbox?.checked);}
    function loadManagers(){try{return JSON.parse(localStorage.getItem(MANAGERS_KEY)||'[]');}catch(_error){return[];}}
    function saveManager(name){const clean=String(name||'').trim();if(!clean)return;const managers=[...new Set(['Julián Herrera',...loadManagers(),clean])];localStorage.setItem(MANAGERS_KEY,JSON.stringify(managers.filter((item)=>item!=='Julián Herrera')));renderManagers(clean);}
    function renderManagers(selected='Julián Herrera'){if(!managerSelect)return;const managers=[...new Set(['Julián Herrera',...loadManagers()])];managerSelect.innerHTML=managers.map((name)=>`<option value="${name.replace(/"/g,'&quot;')}">${name}</option>`).join('');managerSelect.value=managers.includes(selected)?selected:'Julián Herrera';refreshProgrammingLinks();}
    function refreshProgrammingLinks(){const manager=currentManager();const includePending=includePendingRequests();const params=new URLSearchParams({fecha:selectedDate,managedBy:manager,includePending:String(includePending)});if(pdfLink)pdfLink.href='/admin/operaciones/programacion.pdf?'+params.toString();if(emailLink){const scope=includePending?'incluyendo solicitudes pendientes o por confirmar':'con las solicitudes completas';const subject='Programación operativa - '+selectedDate;const body=['Hola,','','Adjunto programación operativa para la fecha '+selectedDate+', '+scope+'.','','Gestionado por: '+manager].join('\n');emailLink.href='mailto:?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);}}
    function setDispatchSessionState(state, hint){
      if(!dispatchSessionAction||!dispatchSessionButton||!dispatchSessionHint)return;
      dispatchSessionAction.classList.remove('session-online','session-offline','session-checking');
      dispatchSessionAction.classList.add(state);
      dispatchSessionHint.textContent=hint;
      dispatchSessionButton.textContent=state==='session-online'?'WhatsApp despacho activo':state==='session-offline'?'WhatsApp despacho sin sesión':'WhatsApp despacho';
    }
    async function refreshDispatchSessionState(){
      try{
        const response=await fetch('/admin/operaciones/whatsapp/estado',{cache:'no-store'});
        if(!response.ok)throw new Error('Estado no disponible');
        const data=await response.json();
        if(data.ready){
          setDispatchSessionState('session-online','Sesión iniciada. Puedes enviar mensajes desde despacho.');
          return;
        }
        if(data.qrImage){
          setDispatchSessionState('session-offline','Sesión no iniciada. Entra y escanea el QR para habilitar envíos.');
          return;
        }
        setDispatchSessionState('session-offline','Sesión no iniciada. Entra al módulo para revisar la conexión.');
      }catch(_error){
        setDispatchSessionState('session-offline','No se pudo validar la sesión. Entra al módulo para revisar.');
      }
    }
    addManagerButton?.addEventListener('click',()=>{customManagerWrap.hidden=false;customManagerInput?.focus();});
    customManagerInput?.addEventListener('keydown',(event)=>{if(event.key==='Enter'){event.preventDefault();saveManager(customManagerInput.value);customManagerInput.value='';customManagerWrap.hidden=true;}});
    customManagerInput?.addEventListener('blur',()=>{if(customManagerInput.value.trim()){saveManager(customManagerInput.value);customManagerInput.value='';}customManagerWrap.hidden=true;});
    managerSelect?.addEventListener('change',refreshProgrammingLinks);
    includePendingCheckbox?.addEventListener('change',refreshProgrammingLinks);
    whatsappButton?.addEventListener('click',async()=>{const includePending=includePendingRequests();whatsappButton.disabled=true;const original=whatsappButton.textContent;whatsappButton.textContent='Enviando PDF...';try{const response=await fetch('/admin/operaciones/programacion/whatsapp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fecha:selectedDate,managedBy:currentManager(),includePending})});const data=await response.json();if(!response.ok||!data.ok){const details=Array.isArray(data.results)?data.results.filter((item)=>!item.ok).map((item)=>`${item.name}: ${item.message}`).join(' · '):'';throw new Error(details||data.message||'No se pudo enviar el PDF.');}showToast(includePending?'PDF enviado con solicitudes completas y pendientes.':'PDF enviado con las solicitudes completas.');}catch(error){showToast(error.message||'No fue posible enviar el PDF.');}finally{whatsappButton.disabled=false;whatsappButton.textContent=original;}});
    renderManagers();
    refreshDispatchSessionState();
    window.setInterval(refreshDispatchSessionState,30000);
  </script>
</body>
</html>
