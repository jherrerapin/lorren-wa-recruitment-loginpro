<%
  const data = monitor || { items: [], summary: {}, dateKey: '', generatedAt: null };
  const items = Array.isArray(data.items) ? data.items : [];
  const summary = data.summary || {};
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ventanas 24 h · WhatsApp Despacho · DEV — LoginPro</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .monitor-page{max-width:min(1700px,calc(100vw - 28px));width:100%}
    .summary{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:10px;margin-bottom:12px}
    .metric{background:#fff;border:1px solid var(--border);border-radius:14px;padding:12px;box-shadow:var(--shadow-sm)}
    .metric span{display:block;color:var(--muted);font-size:11px;font-weight:850;text-transform:uppercase}.metric strong{display:block;color:var(--navy);font-size:24px;margin-top:3px}
    .note{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:14px;padding:12px 14px;margin-bottom:12px;font-size:12px;line-height:1.45}
    .table-wrap{background:#fff;border:1px solid var(--border);border-radius:14px;overflow:auto;box-shadow:var(--shadow-sm)}
    table{width:100%;border-collapse:collapse;min-width:1120px}th,td{padding:10px;border-bottom:1px solid #edf2f7;vertical-align:top;text-align:left;font-size:11px}th{position:sticky;top:0;background:#f8fafc;color:var(--muted);font-size:10px;text-transform:uppercase;z-index:1}
    .pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:9px;font-weight:900;white-space:nowrap}.open{background:#dcfce7;color:#166534}.closed{background:#fee2e2;color:#991b1b}.waiting{background:#fef3c7;color:#92400e}.provider{background:#eef2ff;color:#4338ca}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;word-break:break-all}.muted{color:var(--muted)}
    .live{display:inline-flex;align-items:center;gap:6px;color:var(--green);font-size:11px;font-weight:900}.dot{width:8px;height:8px;border-radius:50%;background:currentColor}
    @media(max-width:900px){.summary{grid-template-columns:repeat(2,1fr)}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones">Operaciones / Despacho</a>
    <a href="/admin/monitor">Monitor bot</a>
    <a href="/admin/operaciones/whatsapp/monitor" class="nav-active">Ventanas 24 h Despacho</a>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page monitor-page">
    <section class="hero">
      <div>
        <div class="eyebrow">DEV · Nueva línea oficial de WhatsApp Despacho</div>
        <h1>Ventanas de 24 horas de hoy</h1>
        <p>Solo muestra la actividad operativa registrada hoy en la línea de Despacho. No mezcla conversaciones ni datos del Monitor del bot de Reclutamiento.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/monitor">Ir al Monitor bot</a>
        <a class="btn" href="/admin/operaciones/whatsapp">Estado WhatsApp Despacho</a>
        <span class="live" id="liveState"><span class="dot"></span>Actualización automática</span>
      </div>
    </section>

    <section class="summary">
      <article class="metric"><span>Auxiliares monitoreados hoy</span><strong id="metricTotal"><%= summary.total || 0 %></strong></article>
      <article class="metric"><span>Ventana abierta ahora</span><strong id="metricOpen"><%= summary.open || 0 %></strong></article>
      <article class="metric"><span>Aún no la abrieron</span><strong id="metricNotOpened"><%= summary.notOpened || 0 %></strong></article>
      <article class="metric"><span>Mensajes enviados hoy</span><strong id="metricSent"><%= summary.assignmentsSentToday || 0 %></strong></article>
    </section>

    <section class="note">
      <strong>Cómo se determina:</strong> cuando un auxiliar envía cualquier mensaje o pulsa una respuesta hacia la línea de Despacho, Lórren actualiza <code>DispatchWhatsappContactWindow.lastInboundAt</code>. Desde ese último mensaje se cuentan 24 horas. Esta es la misma fuente que usa el backend para decidir si la ventana está abierta y puede enviar mensajes interactivos sin plantilla.
      <div>Fecha operativa: <strong id="dateKey"><%= data.dateKey || '—' %></strong> · Última lectura: <strong id="generatedAt"><%= data.generatedAt || '—' %></strong></div>
    </section>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Auxiliar</th><th>Teléfono</th><th>Envío de hoy</th><th>Último mensaje entrante</th><th>Ventana</th><th>Vence</th><th>Tiempo restante</th><th>Estado envío</th></tr>
        </thead>
        <tbody id="monitorRows">
          <% if (!items.length) { %><tr><td colspan="8" class="muted">Todavía no hay actividad de la línea operativa de Despacho para hoy.</td></tr><% } %>
          <% items.forEach((item) => { %>
            <tr>
              <td><strong><%= item.workerName || 'Auxiliar no identificado' %></strong></td>
              <td class="mono"><%= item.phone || '—' %></td>
              <td data-date="<%= item.sentAt || '' %>"><%= item.sentAt || '—' %></td>
              <td data-date="<%= item.lastInboundAt || '' %>"><%= item.lastInboundAt || 'Aún no responde' %></td>
              <td><span class="pill <%= item.windowStatus === 'ABIERTA' ? 'open' : (item.windowStatus === 'NO_ABIERTA' ? 'waiting' : 'closed') %>"><%= item.windowStatus.replaceAll('_',' ') %></span></td>
              <td data-date="<%= item.expiresAt || '' %>"><%= item.expiresAt || '—' %></td>
              <td data-remaining="<%= item.remainingMs || 0 %>"><%= item.remainingMs || 0 %></td>
              <td><span class="pill provider"><%= item.outboundStatus || 'SIN ENVÍO HOY' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    const dataEndpoint = <%- JSON.stringify(monitorDataEndpoint) %>;
    const rows = document.getElementById('monitorRows');
    const liveState = document.getElementById('liveState');

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
    }
    function formatBogota(value) {
      if (!value) return '—';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;
      return new Intl.DateTimeFormat('es-CO',{timeZone:'America/Bogota',year:'numeric',month:'2-digit',day:'2-digit',hour:'numeric',minute:'2-digit',second:'2-digit',hour12:true}).format(date);
    }
    function remainingLabel(ms) {
      const totalMinutes = Math.max(0, Math.ceil(Number(ms || 0) / 60000));
      if (!totalMinutes) return '—';
      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      return `${hours} h ${minutes} min`;
    }
    function renderItems(items) {
      if (!Array.isArray(items) || !items.length) {
        rows.innerHTML = '<tr><td colspan="8" class="muted">Todavía no hay actividad de la línea operativa de Despacho para hoy.</td></tr>';
        return;
      }
      rows.innerHTML = items.map((item) => {
        const statusClass = item.windowStatus === 'ABIERTA' ? 'open' : (item.windowStatus === 'NO_ABIERTA' ? 'waiting' : 'closed');
        return `<tr>
          <td><strong>${escapeHtml(item.workerName || 'Auxiliar no identificado')}</strong></td>
          <td class="mono">${escapeHtml(item.phone || '—')}</td>
          <td>${escapeHtml(item.sentAt ? formatBogota(item.sentAt) : '—')}</td>
          <td>${escapeHtml(item.lastInboundAt ? formatBogota(item.lastInboundAt) : 'Aún no responde')}</td>
          <td><span class="pill ${statusClass}">${escapeHtml(String(item.windowStatus || '').replaceAll('_',' '))}</span></td>
          <td>${escapeHtml(item.expiresAt ? formatBogota(item.expiresAt) : '—')}</td>
          <td>${escapeHtml(remainingLabel(item.remainingMs))}</td>
          <td><span class="pill provider">${escapeHtml(item.outboundStatus || 'SIN ENVÍO HOY')}</span></td>
        </tr>`;
      }).join('');
    }
    function render(data) {
      renderItems(data.items);
      const summary = data.summary || {};
      document.getElementById('metricTotal').textContent = summary.total || 0;
      document.getElementById('metricOpen').textContent = summary.open || 0;
      document.getElementById('metricNotOpened').textContent = summary.notOpened || 0;
      document.getElementById('metricSent').textContent = summary.assignmentsSentToday || 0;
      document.getElementById('dateKey').textContent = data.dateKey || '—';
      document.getElementById('generatedAt').textContent = data.generatedAt ? formatBogota(data.generatedAt) : '—';
    }
    async function refreshMonitor() {
      try {
        const response = await fetch(dataEndpoint,{cache:'no-store',credentials:'same-origin',headers:{Accept:'application/json'}});
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        render(await response.json());
        liveState.style.color = '';
        liveState.title = `Actualizado ${formatBogota(new Date().toISOString())}`;
      } catch (error) {
        liveState.style.color = '#b91c1c';
        liveState.title = 'No fue posible actualizar el monitor';
        console.error('No fue posible actualizar el monitor de ventanas de WhatsApp de Despacho.', error);
      }
    }

    document.querySelectorAll('[data-date]').forEach((cell) => {
      const value = cell.dataset.date;
      if (value) cell.textContent = formatBogota(value);
    });
    document.querySelectorAll('[data-remaining]').forEach((cell) => { cell.textContent = remainingLabel(cell.dataset.remaining); });
    document.getElementById('generatedAt').textContent = <%- JSON.stringify(data.generatedAt || '') %> ? formatBogota(<%- JSON.stringify(data.generatedAt || '') %>) : '—';
    window.setInterval(refreshMonitor, 5000);
  </script>
</body>
</html>
