<%
  const data = monitor || { items: [], summary: {}, dateKey: '', generatedAt: null, unmatchedInbound: [] };
  const items = Array.isArray(data.items) ? data.items : [];
  const unmatchedInbound = Array.isArray(data.unmatchedInbound) ? data.unmatchedInbound : [];
  const summary = data.summary || {};
  const configuredTemplate = typeof windowCheckTemplateName === 'string' && windowCheckTemplateName ? windowCheckTemplateName : null;
  const checkMessage = typeof windowCheckMessage === 'string' && windowCheckMessage ? windowCheckMessage : '';
  const checkButton = typeof windowCheckButton === 'string' && windowCheckButton ? windowCheckButton : 'CONFIRMAR CANAL';
  const initialPhoneQuery = typeof phoneQuery === 'string' ? phoneQuery : '';
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ventanas 24 h · WhatsApp Despacho · DEV — LoginPro</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon-loginpro.svg" />
  <link rel="stylesheet" href="/public/operaciones-ui.css" />
  <style>
    .monitor-page{max-width:min(1760px,calc(100vw - 28px));width:100%}
    .summary{display:grid;grid-template-columns:repeat(5,minmax(135px,1fr));gap:10px;margin-bottom:12px}
    .metric{background:#fff;border:1px solid var(--border);border-radius:14px;padding:12px;box-shadow:var(--shadow-sm)}
    .metric span{display:block;color:var(--muted);font-size:11px;font-weight:850;text-transform:uppercase}.metric strong{display:block;color:var(--navy);font-size:24px;margin-top:3px}
    .template-panel{display:grid;grid-template-columns:minmax(320px,1fr) minmax(280px,.75fr);gap:10px;margin-bottom:12px}
    .template-card,.note,.phone-search-card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:12px 14px;box-shadow:var(--shadow-sm);font-size:12px;line-height:1.45}
    .template-card h2,.phone-search-card h2{margin:0 0 7px;color:var(--navy);font-size:14px}.template-preview{white-space:pre-line;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:10px;color:#334155}.template-buttons{display:flex;gap:6px;margin-top:8px}.template-buttons span{border-radius:8px;padding:5px 8px;background:#eef2ff;color:#3730a3;font-size:10px;font-weight:900}.note{background:#eff6ff;border-color:#bfdbfe;color:#1e40af;box-shadow:none}.note code{font-size:10px}
    .phone-search-card{margin-bottom:12px}.phone-search-card[hidden]{display:none!important}.phone-search-form{display:flex;gap:8px;align-items:end;flex-wrap:wrap}.phone-search-field{display:grid;gap:4px;min-width:min(420px,100%);flex:1}.phone-search-field label{font-size:10px;font-weight:900;color:var(--muted);text-transform:uppercase}.phone-search-field input{width:100%;border:1px solid var(--border);border-radius:10px;padding:9px 10px;font:inherit}.phone-search-help{margin:7px 0 0;color:var(--muted);font-size:10px}.phone-lookup{margin-top:10px;border-top:1px solid #e2e8f0;padding-top:10px}.phone-lookup[hidden]{display:none}.phone-lookup-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px}.phone-lookup-head strong{color:var(--navy)}.phone-lookup-meta{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:10px;color:var(--muted)}.phone-lookup-panel{max-height:440px;overflow:auto;border:1px solid #dbe4ee;border-radius:12px;background:#f8fafc;padding:10px;overflow-anchor:none}
    .bulk-result{margin-bottom:12px;border-radius:12px;padding:10px 12px;font-size:11px;font-weight:800;display:none}.bulk-result.show{display:block}.bulk-result.ok{background:#dcfce7;color:#166534}.bulk-result.warn{background:#fef3c7;color:#92400e}
    .table-wrap{background:#fff;border:1px solid var(--border);border-radius:14px;overflow:auto;box-shadow:var(--shadow-sm);overflow-anchor:none}
    table{width:100%;border-collapse:collapse;min-width:1320px}th,td{padding:9px 10px;border-bottom:1px solid #edf2f7;vertical-align:middle;text-align:left;font-size:11px}th{position:sticky;top:0;background:#f8fafc;color:var(--muted);font-size:10px;text-transform:uppercase;z-index:1}
    .pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:9px;font-weight:900;white-space:nowrap}.open{background:#dcfce7;color:#166534}.closed{background:#fee2e2;color:#991b1b}.review{background:#fef3c7;color:#92400e}.confirmed{background:#dcfce7;color:#166534}.pending{background:#fef3c7;color:#92400e}
    .window-check{display:inline-flex;width:18px;height:18px;border-radius:50%;align-items:center;justify-content:center;background:#16a34a;color:#fff;font-size:11px;font-weight:900;margin-right:5px;vertical-align:middle}.window-off{display:inline-flex;width:18px;height:18px;border-radius:50%;align-items:center;justify-content:center;background:#e2e8f0;color:#64748b;font-size:10px;font-weight:900;margin-right:5px;vertical-align:middle}.window-review{display:inline-flex;width:18px;height:18px;border-radius:50%;align-items:center;justify-content:center;background:#f59e0b;color:#fff;font-size:10px;font-weight:900;margin-right:5px;vertical-align:middle}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px}.muted{color:var(--muted)}.live{display:inline-flex;align-items:center;gap:6px;color:var(--green);font-size:11px;font-weight:900}.dot{width:8px;height:8px;border-radius:50%;background:currentColor}.evidence{font-size:9px;color:var(--muted);margin-top:2px}.phone-warning{font-size:9px;color:#92400e;font-weight:800;margin-top:2px}
    .row-action{padding:5px 8px;font-size:10px;min-height:0}.row-action[disabled]{opacity:.45;cursor:not-allowed}.chat-toggle{white-space:nowrap}
    .chat-row[hidden]{display:none}.chat-row td{padding:0 12px 12px;background:#f8fafc}.chat-panel{border:1px solid #dbe4ee;border-radius:12px;background:#fff;padding:10px;max-height:360px;overflow:auto;overflow-anchor:none}.chat-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:8px;color:#475569;font-size:10px}.chat-feed{display:flex;flex-direction:column;gap:7px}.chat-message{max-width:min(760px,88%);border-radius:11px;padding:8px 10px;border:1px solid #e2e8f0}.chat-in{align-self:flex-start;background:#eff6ff;border-color:#bfdbfe}.chat-out{align-self:flex-end;background:#ecfdf5;border-color:#bbf7d0}.chat-meta{display:flex;gap:8px;align-items:center;font-size:9px;color:#64748b;margin-bottom:3px}.chat-meta strong{color:#334155}.chat-body{white-space:pre-wrap;word-break:break-word;color:#1f2937;font-size:11px;line-height:1.4}.chat-reconstructed{display:inline-flex;border-radius:999px;background:#fef3c7;color:#92400e;padding:1px 6px;font-size:8px;font-weight:900}.chat-empty{font-size:10px;color:#64748b;padding:4px}.chat-note{font-size:9px;color:#64748b;margin-top:8px}
    .unmatched-panel{margin-top:12px;background:#fff;border:1px solid var(--border);border-radius:14px;padding:12px 14px;box-shadow:var(--shadow-sm);overflow-anchor:none}.unmatched-panel h2{font-size:14px;margin:0 0 4px;color:var(--navy)}.unmatched-panel p{font-size:11px;color:var(--muted);margin:0 0 10px}.unmatched-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:8px}.unmatched-item{appearance:none;background:#f8fafc;border:1px solid #dbe4ee;border-radius:10px;padding:9px 10px;font:inherit;text-align:left;font-size:10px;color:#334155;cursor:pointer}.unmatched-item:hover{border-color:#94a3b8}.unmatched-item.conversation-active{background:#eefcf8;border-color:#0d7a6b}.unmatched-item strong{display:block;color:var(--navy);font-size:11px;margin-bottom:3px}.unmatched-item span{display:block;color:var(--muted)}.conversation-close{margin-top:8px}.conversation-section-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap}
    .message-dialog{border:0;border-radius:16px;padding:0;width:min(620px,calc(100vw - 24px));box-shadow:0 24px 70px rgba(15,23,42,.3)}.message-dialog::backdrop{background:rgba(15,23,42,.45)}.message-dialog form{padding:18px;display:grid;gap:12px}.message-dialog h3{margin:0;color:var(--navy)}.message-dialog textarea{width:100%;min-height:125px;border:1px solid var(--border);border-radius:10px;padding:10px;font:inherit;resize:vertical}.dialog-actions{display:flex;justify-content:flex-end;gap:8px}
    @media(max-width:1100px){.summary{grid-template-columns:repeat(3,1fr)}}
    @media(max-width:700px){.summary{grid-template-columns:repeat(2,1fr)}.template-panel{grid-template-columns:1fr}.chat-message{max-width:96%}.phone-search-field{min-width:100%}.unmatched-list{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/admin" aria-label="LoginPro"><img src="/public/logo-loginpro.svg" alt="LoginPro" /></a>
    <a href="/admin">Panel</a>
    <a href="/admin/vacancies">Vacantes</a>
    <a href="/admin/operaciones">Operaciones / Despacho</a>
    <a href="/admin/monitor">Monitor bot</a>
    <a href="/admin/operaciones/whatsapp/monitor" class="nav-active">WhatsApp Despacho · DEV</a>
    <span class="spacer"></span>
    <form method="post" action="/logout"><button type="submit" class="btn-logout">Cerrar sesión</button></form>
  </nav>

  <main class="page monitor-page">
    <section class="hero">
      <div>
        <div class="eyebrow">DEV · Línea oficial de WhatsApp Despacho</div>
        <h1>Ventanas de 24 horas · asignados de mañana</h1>
        <p>Los que siguen con ventana cerrada o tienen un teléfono que requiere revisión aparecen primero. El estado y la conversación propia de Despacho se consultan nuevamente cada 5 segundos; no se mezclan mensajes del bot de Reclutamiento.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/admin/operaciones/asignaciones?fecha=<%= encodeURIComponent(data.dateKey || '') %>">Ver asignaciones de mañana</a>
        <button class="btn btn-primary" type="button" id="sendBulkWindowCheck" <%= summary.missingWindow ? '' : 'disabled' %>>Enviar verificación a faltantes</button>
        <span class="live" id="liveState"><span class="dot"></span>En vivo · 5 s</span>
      </div>
    </section>

    <section class="summary">
      <article class="metric"><span>Asignados mañana</span><strong id="metricTotal"><%= summary.total || 0 %></strong></article>
      <article class="metric"><span>Ya abrieron ventana</span><strong id="metricOpen"><%= summary.open || 0 %></strong></article>
      <article class="metric"><span>Faltan por abrir</span><strong id="metricMissing"><%= summary.missingWindow || 0 %></strong></article>
      <article class="metric"><span>Revisar teléfono</span><strong id="metricReview"><%= summary.phoneReview || 0 %></strong></article>
      <article class="metric"><span>Otras conversaciones</span><strong id="metricUnmatched"><%= summary.unmatchedInbound || 0 %></strong></article>
    </section>

    <section class="phone-search-card" id="phoneSearchCard" hidden aria-hidden="true">
      <h2>Consultar cualquier número de WhatsApp Despacho</h2>
      <form class="phone-search-form" id="phoneSearchForm">
        <div class="phone-search-field">
          <label for="phoneSearchInput">Número</label>
          <input id="phoneSearchInput" name="phone" inputmode="tel" autocomplete="off" value="<%= initialPhoneQuery %>" placeholder="3001234567 o 573001234567" />
        </div>
        <button class="btn btn-primary" type="submit">Ver conversación</button>
        <button class="btn" type="button" id="clearPhoneSearch" <%= initialPhoneQuery ? '' : 'hidden' %>>Limpiar</button>
      </form>
      <p class="phone-search-help">Consulta solo la auditoría de la línea oficial de Despacho, su ventana de 24 horas y evidencia reconstruible de asignaciones. No consulta conversaciones del bot de Reclutamiento y no habilita envío arbitrario.</p>
      <div class="phone-lookup" id="phoneLookupResult" hidden></div>
    </section>

    <section class="template-panel">
      <article class="template-card">
        <h2>Mensaje para abrir/verificar la ventana</h2>
        <div class="template-preview"><%= checkMessage %></div>
        <div class="template-buttons"><span><%= checkButton %></span></div>
      </article>
      <article class="note">
        <strong>No confirma la asignación.</strong> Este mensaje solo busca que el auxiliar responda desde WhatsApp. Esa respuesta es la que abre o renueva la ventana de atención de 24 horas. La plantilla configurada es <code><%= configuredTemplate || 'DISPATCH_META_WINDOW_CHECK_TEMPLATE_NAME pendiente' %></code>.
        <div style="margin-top:8px">Fecha objetivo: <strong id="dateKey"><%= data.dateKey || '—' %></strong> · Última lectura: <strong id="generatedAt"><%= data.generatedAt || '—' %></strong></div>
      </article>
    </section>

    <div class="bulk-result" id="bulkResult"></div>

    <div class="table-wrap" id="monitorTableWrap">
      <table>
        <thead>
          <tr><th>Auxiliar</th><th>Teléfono</th><th>Operación</th><th>Asignación</th><th>Ventana 24 h</th><th>Último mensaje recibido</th><th>Vence</th><th>Mensajes</th><th>Acción DEV</th></tr>
        </thead>
        <tbody id="monitorRows">
          <% if (!items.length) { %><tr><td colspan="9" class="muted">No hay auxiliares con asignación activa para mañana.</td></tr><% } %>
          <% items.forEach((item) => { %>
            <tr data-assignment-id="<%= item.assignmentId %>">
              <td><strong><%= item.workerName %></strong></td>
              <td class="mono"><%= item.phone || 'Sin teléfono' %><% if (item.phoneIssue) { %><div class="phone-warning">⚠ formato a revisar</div><% } %><% if (item.possibleInboundPhone) { %><div class="phone-warning">Posible inbound: <%= item.possibleInboundPhone %></div><% } %></td>
              <td><%= item.operationName || '—' %><% if (item.startTime) { %><div class="muted"><%= item.startTime %></div><% } %></td>
              <td><span class="pill <%= item.confirmed ? 'confirmed' : 'pending' %>"><%= item.assignmentStatus %></span></td>
              <td><% if (item.isOpen) { %><span class="window-check">✓</span><span class="pill open">ABIERTA</span><% } else if (item.phoneIssue || item.possibleInboundAt) { %><span class="window-review">!</span><span class="pill review">REVISAR NÚMERO</span><% } else { %><span class="window-off">–</span><span class="pill closed">CERRADA</span><% } %></td>
              <td><span data-date="<%= item.lastInboundAt || '' %>"><%= item.lastInboundAt || 'Sin inbound exacto registrado' %></span><% if (item.evidenceSource) { %><div class="evidence"><%= item.evidenceSource === 'CONFIRMATION_EVIDENCE' ? 'evidencia de confirmación' : 'registro de inbound' %></div><% } %><% if (item.possibleInboundAt) { %><div class="phone-warning">Posible inbound <span data-date="<%= item.possibleInboundAt %>"><%= item.possibleInboundAt %></span></div><% } %></td>
              <td data-date="<%= item.expiresAt || '' %>"><%= item.expiresAt || '—' %></td>
              <td><button class="btn row-action chat-toggle" type="button" data-chat-toggle="<%= item.assignmentId %>">Ver mensajes (<%= item.messageCount || 0 %>)</button></td>
              <td><button class="btn row-action manual-message-button" type="button" data-assignment-id="<%= item.assignmentId %>" data-worker-name="<%= item.workerName %>" <%= item.phone ? '' : 'disabled title="No hay teléfono"' %>><%= item.isOpen ? 'Enviar mensaje' : 'Probar envío' %></button></td>
            </tr>
            <tr class="chat-row" data-chat-row="<%= item.assignmentId %>" hidden><td colspan="9"><div class="chat-panel"><div class="chat-head"><strong>Conversación WhatsApp Despacho · <%= item.workerName %></strong><span>Últimos <%= item.messageCount || 0 %> registros disponibles</span></div><div class="chat-feed"><% if (!(item.messageHistory || []).length) { %><div class="chat-empty">Todavía no hay mensajes persistidos o reconstruibles para este auxiliar.</div><% } %><% (item.messageHistory || []).forEach((message) => { %><div class="chat-message <%= message.direction === 'INBOUND' ? 'chat-in' : 'chat-out' %>"><div class="chat-meta"><strong><%= message.direction === 'INBOUND' ? 'Auxiliar → Lórren' : 'Lórren → auxiliar' %></strong><span data-date="<%= message.at || '' %>"><%= message.at || '—' %></span><% if (message.reconstructed) { %><span class="chat-reconstructed">RECONSTRUIDO</span><% } %></div><div class="chat-body"><%= message.body || '(mensaje sin texto)' %></div></div><% }) %></div><div class="chat-note">Los mensajes nuevos se guardan en una auditoría exclusiva de WhatsApp Despacho. Los elementos RECONSTRUIDOS son evidencia anterior cuyo texto completo no siempre se persistía.</div></div></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <section class="unmatched-panel" id="unmatchedPanel" <%= unmatchedInbound.length ? '' : 'hidden' %>>
      <div class="conversation-section-head">
        <div>
          <h2>Conversaciones de Despacho</h2>
          <p>Aquí aparecen automáticamente los inbound recientes que no coinciden con los asignados de mañana. Abre cualquier conversación directamente; no necesitas copiar ni buscar el número.</p>
        </div>
      </div>
      <div class="unmatched-list" id="unmatchedList">
        <% unmatchedInbound.forEach((item) => { %><button class="unmatched-item conversation-item" type="button" data-conversation-phone="<%= item.phone %>"><strong><%= item.workerName ? `${item.workerName} · ${item.phone}` : item.phone %></strong><span>Último inbound: <span data-date="<%= item.lastInboundAt %>"><%= item.lastInboundAt %></span></span></button><% }) %>
      </div>
    </section>
  </main>

  <dialog class="message-dialog" id="manualMessageDialog">
    <form method="dialog" id="manualMessageForm">
      <div><div class="eyebrow">DEV · Mensaje libre</div><h3 id="manualMessageTitle">Enviar mensaje</h3></div>
      <input type="hidden" id="manualAssignmentId" />
      <textarea id="manualMessageText" maxlength="1200" placeholder="Escribe el mensaje para el auxiliar..." required></textarea>
      <div class="muted">DEV intentará el envío aunque el monitor figure CERRADA. Meta será quien acepte o rechace el mensaje; un rechazo no modifica artificialmente el estado de la ventana.</div>
      <div class="dialog-actions"><button class="btn" type="button" id="cancelManualMessage">Cancelar</button><button class="btn btn-primary" type="submit">Intentar envío</button></div>
    </form>
  </dialog>

  <script>
    const dataEndpoint = <%- JSON.stringify(monitorDataEndpoint) %>;
    const bulkEndpoint = <%- JSON.stringify(bulkSendEndpoint) %>;
    const manualEndpoint = <%- JSON.stringify(manualSendEndpoint) %>;
    const rows = document.getElementById('monitorRows');
    const liveState = document.getElementById('liveState');
    const bulkButton = document.getElementById('sendBulkWindowCheck');
    const bulkResult = document.getElementById('bulkResult');
    const manualDialog = document.getElementById('manualMessageDialog');
    const manualForm = document.getElementById('manualMessageForm');
    const manualAssignmentId = document.getElementById('manualAssignmentId');
    const manualMessageText = document.getElementById('manualMessageText');
    const unmatchedPanel = document.getElementById('unmatchedPanel');
    const unmatchedList = document.getElementById('unmatchedList');
    const tableWrap = document.getElementById('monitorTableWrap');
    const phoneSearchCard = document.getElementById('phoneSearchCard');
    const phoneSearchForm = document.getElementById('phoneSearchForm');
    const phoneSearchInput = document.getElementById('phoneSearchInput');
    const clearPhoneSearch = document.getElementById('clearPhoneSearch');
    const phoneLookupResult = document.getElementById('phoneLookupResult');
    const openChats = new Set();
    let currentPhoneQuery = '';
    let refreshBusy = false;

    phoneSearchCard.hidden = true;
    phoneSearchInput.value = '';
    clearPhoneSearch.textContent = 'Cerrar conversación';
    clearPhoneSearch.classList.add('conversation-close');
    unmatchedPanel.appendChild(phoneLookupResult);
    unmatchedPanel.appendChild(clearPhoneSearch);

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
    }
    function formatBogota(value) {
      if (!value) return '—';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return value;
      return new Intl.DateTimeFormat('es-CO',{timeZone:'America/Bogota',year:'numeric',month:'2-digit',day:'2-digit',hour:'numeric',minute:'2-digit',second:'2-digit',hour12:true}).format(date);
    }
    function evidenceLabel(source) {
      if (source === 'CONFIRMATION_EVIDENCE') return '<div class="evidence">evidencia de confirmación</div>';
      if (source === 'CONTACT_WINDOW') return '<div class="evidence">registro de inbound</div>';
      return '';
    }
    function windowHtml(item) {
      if (item.isOpen) return '<span class="window-check">✓</span><span class="pill open">ABIERTA</span>';
      if (item.phoneIssue || item.possibleInboundAt) return '<span class="window-review">!</span><span class="pill review">REVISAR NÚMERO</span>';
      return '<span class="window-off">–</span><span class="pill closed">CERRADA</span>';
    }
    function phoneHtml(item) {
      let value = escapeHtml(item.phone || 'Sin teléfono');
      if (item.phoneIssue) value += '<div class="phone-warning">⚠ formato a revisar</div>';
      if (item.possibleInboundPhone) value += `<div class="phone-warning">Posible inbound: ${escapeHtml(item.possibleInboundPhone)}</div>`;
      return value;
    }
    function chatMessagesHtml(item, inboundLabel = 'Auxiliar → Lórren', outboundLabel = 'Lórren → auxiliar') {
      const history = Array.isArray(item?.messageHistory) ? item.messageHistory : [];
      if (!history.length) return '<div class="chat-empty">No hay mensajes persistidos o reconstruibles para este número.</div>';
      return history.map((message) => {
        const inbound = message.direction === 'INBOUND';
        const reconstruction = message.reconstructed ? '<span class="chat-reconstructed">RECONSTRUIDO</span>' : '';
        return `<div class="chat-message ${inbound ? 'chat-in' : 'chat-out'}">
          <div class="chat-meta"><strong>${escapeHtml(inbound ? inboundLabel : outboundLabel)}</strong><span>${escapeHtml(formatBogota(message.at))}</span>${reconstruction}</div>
          <div class="chat-body">${escapeHtml(message.body || '(mensaje sin texto)')}</div>
        </div>`;
      }).join('');
    }
    function chatRowHtml(item) {
      const assignmentId = escapeHtml(item.assignmentId);
      const hidden = openChats.has(item.assignmentId) ? '' : ' hidden';
      return `<tr class="chat-row" data-chat-row="${assignmentId}"${hidden}><td colspan="9"><div class="chat-panel">
        <div class="chat-head"><strong>Conversación WhatsApp Despacho · ${escapeHtml(item.workerName || 'Auxiliar')}</strong><span>Últimos ${Number(item.messageCount || 0)} registros disponibles</span></div>
        <div class="chat-feed">${chatMessagesHtml(item)}</div>
        <div class="chat-note">Los mensajes nuevos se guardan en una auditoría exclusiva de WhatsApp Despacho. Los elementos RECONSTRUIDOS son evidencia anterior cuyo texto completo no siempre se persistía.</div>
      </div></td></tr>`;
    }
    function renderItems(items) {
      if (!Array.isArray(items) || !items.length) {
        rows.innerHTML = '<tr><td colspan="9" class="muted">No hay auxiliares con asignación activa para mañana.</td></tr>';
        return;
      }
      rows.innerHTML = items.map((item) => `<tr data-assignment-id="${escapeHtml(item.assignmentId)}">
        <td><strong>${escapeHtml(item.workerName || 'Auxiliar')}</strong></td>
        <td class="mono">${phoneHtml(item)}</td>
        <td>${escapeHtml(item.operationName || '—')}${item.startTime ? `<div class="muted">${escapeHtml(item.startTime)}</div>` : ''}</td>
        <td><span class="pill ${item.confirmed ? 'confirmed' : 'pending'}">${escapeHtml(item.assignmentStatus || '—')}</span></td>
        <td>${windowHtml(item)}</td>
        <td>${item.lastInboundAt ? escapeHtml(formatBogota(item.lastInboundAt)) : 'Sin inbound exacto registrado'}${evidenceLabel(item.evidenceSource)}${item.possibleInboundAt ? `<div class="phone-warning">Posible inbound ${escapeHtml(formatBogota(item.possibleInboundAt))}</div>` : ''}</td>
        <td>${item.expiresAt ? escapeHtml(formatBogota(item.expiresAt)) : '—'}</td>
        <td><button class="btn row-action chat-toggle" type="button" data-chat-toggle="${escapeHtml(item.assignmentId)}">${openChats.has(item.assignmentId) ? 'Ocultar' : 'Ver mensajes'} (${Number(item.messageCount || 0)})</button></td>
        <td><button class="btn row-action manual-message-button" type="button" data-assignment-id="${escapeHtml(item.assignmentId)}" data-worker-name="${escapeHtml(item.workerName || 'Auxiliar')}" ${item.phone ? '' : 'disabled title="No hay teléfono"'}>${item.isOpen ? 'Enviar mensaje' : 'Probar envío'}</button></td>
      </tr>${chatRowHtml(item)}`).join('');
      bindManualButtons();
      bindChatButtons();
    }
    function bindChatButtons() {
      document.querySelectorAll('[data-chat-toggle]').forEach((button) => {
        button.onclick = () => {
          const assignmentId = button.dataset.chatToggle || '';
          const chatRow = document.querySelector(`[data-chat-row="${CSS.escape(assignmentId)}"]`);
          if (!chatRow) return;
          if (openChats.has(assignmentId)) {
            openChats.delete(assignmentId);
            chatRow.hidden = true;
            button.textContent = button.textContent.replace(/^Ocultar/, 'Ver mensajes');
          } else {
            openChats.add(assignmentId);
            chatRow.hidden = false;
            button.textContent = button.textContent.replace(/^Ver mensajes/, 'Ocultar');
          }
        };
      });
    }
    function bindConversationButtons() {
      document.querySelectorAll('[data-conversation-phone]').forEach((button) => {
        button.onclick = async () => {
          const phone = String(button.dataset.conversationPhone || '').trim();
          if (!phone) return;
          currentPhoneQuery = phone;
          await refreshMonitor({ preservePosition: true });
        };
      });
    }
    function renderUnmatched(items) {
      const list = Array.isArray(items) ? items : [];
      unmatchedPanel.hidden = list.length === 0 && !currentPhoneQuery;
      unmatchedList.innerHTML = list.map((item) => {
        const identity = item.workerName ? `${escapeHtml(item.workerName)} · ${escapeHtml(item.phone || '—')}` : escapeHtml(item.phone || '—');
        const active = currentPhoneQuery && String(item.phone || '') === currentPhoneQuery ? ' conversation-active' : '';
        return `<button class="unmatched-item conversation-item${active}" type="button" data-conversation-phone="${escapeHtml(item.phone || '')}"><strong>${identity}</strong><span>Último inbound: ${escapeHtml(formatBogota(item.lastInboundAt))}</span></button>`;
      }).join('');
      bindConversationButtons();
    }
    function renderPhoneLookup(lookup) {
      if (!currentPhoneQuery) {
        phoneLookupResult.hidden = true;
        phoneLookupResult.innerHTML = '';
        clearPhoneSearch.hidden = true;
        document.querySelectorAll('[data-conversation-phone]').forEach((button) => button.classList.remove('conversation-active'));
        return;
      }
      clearPhoneSearch.hidden = false;
      phoneLookupResult.hidden = false;
      document.querySelectorAll('[data-conversation-phone]').forEach((button) => {
        button.classList.toggle('conversation-active', button.dataset.conversationPhone === currentPhoneQuery);
      });
      if (!lookup?.phone) {
        phoneLookupResult.innerHTML = '<div class="chat-empty">No hay evidencia persistida para esta conversación.</div>';
        return;
      }
      const names = Array.isArray(lookup.workerNames) && lookup.workerNames.length
        ? ` · ${escapeHtml(lookup.workerNames.join(' / '))}`
        : '';
      const evidence = lookup.hasEvidence
        ? `${Number(lookup.messageCount || 0)} registros disponibles`
        : 'Sin evidencia persistida en WhatsApp Despacho';
      phoneLookupResult.innerHTML = `<div class="phone-lookup-head">
        <strong>${escapeHtml(lookup.phone)}${names}</strong>
        <div class="phone-lookup-meta">${windowHtml(lookup)}<span>${escapeHtml(evidence)}</span>${lookup.lastInboundAt ? `<span>Último inbound: ${escapeHtml(formatBogota(lookup.lastInboundAt))}</span>` : ''}</div>
      </div>
      <div class="phone-lookup-panel"><div class="chat-feed">${chatMessagesHtml(lookup, 'Contacto → Lórren', 'Lórren → contacto')}</div></div>`;
    }
    function captureViewState() {
      const chats = {};
      document.querySelectorAll('[data-chat-row]').forEach((row) => {
        if (row.hidden) return;
        const panel = row.querySelector('.chat-panel');
        if (!panel) return;
        chats[row.dataset.chatRow || ''] = { top: panel.scrollTop, left: panel.scrollLeft };
      });
      const lookupPanel = phoneLookupResult.querySelector('.phone-lookup-panel');
      return {
        pageY: window.scrollY || 0,
        pageX: window.scrollX || 0,
        tableTop: tableWrap?.scrollTop || 0,
        tableLeft: tableWrap?.scrollLeft || 0,
        lookupTop: lookupPanel?.scrollTop || 0,
        lookupLeft: lookupPanel?.scrollLeft || 0,
        chats
      };
    }
    function restoreViewState(state) {
      if (!state) return;
      requestAnimationFrame(() => {
        if (tableWrap) {
          tableWrap.scrollTop = state.tableTop;
          tableWrap.scrollLeft = state.tableLeft;
        }
        Object.entries(state.chats || {}).forEach(([assignmentId, scroll]) => {
          const row = document.querySelector(`[data-chat-row="${CSS.escape(assignmentId)}"]`);
          const panel = row?.querySelector('.chat-panel');
          if (panel) {
            panel.scrollTop = scroll.top;
            panel.scrollLeft = scroll.left;
          }
        });
        const lookupPanel = phoneLookupResult.querySelector('.phone-lookup-panel');
        if (lookupPanel) {
          lookupPanel.scrollTop = state.lookupTop;
          lookupPanel.scrollLeft = state.lookupLeft;
        }
        window.scrollTo(state.pageX, state.pageY);
      });
    }
    function render(data, preservePosition = true) {
      const viewState = preservePosition ? captureViewState() : null;
      renderItems(data.items);
      renderUnmatched(data.unmatchedInbound);
      renderPhoneLookup(data.phoneLookup || null);
      const current = data.summary || {};
      document.getElementById('metricTotal').textContent = current.total || 0;
      document.getElementById('metricOpen').textContent = current.open || 0;
      document.getElementById('metricMissing').textContent = current.missingWindow || 0;
      document.getElementById('metricReview').textContent = current.phoneReview || 0;
      document.getElementById('metricUnmatched').textContent = current.unmatchedInbound || 0;
      document.getElementById('dateKey').textContent = data.dateKey || '—';
      document.getElementById('generatedAt').textContent = data.generatedAt ? formatBogota(data.generatedAt) : '—';
      bulkButton.disabled = !(current.missingWindow > 0);
      restoreViewState(viewState);
    }
    function monitorDataUrl() {
      const url = new URL(dataEndpoint, window.location.origin);
      if (currentPhoneQuery) url.searchParams.set('phone', currentPhoneQuery);
      return url.toString();
    }
    async function refreshMonitor({ preservePosition = true } = {}) {
      if (refreshBusy) return null;
      refreshBusy = true;
      try {
        const response = await fetch(monitorDataUrl(),{cache:'no-store',credentials:'same-origin',headers:{Accept:'application/json'}});
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        render(data, preservePosition);
        liveState.style.color = '';
        liveState.textContent = `● En vivo · ${new Intl.DateTimeFormat('es-CO',{timeZone:'America/Bogota',hour:'numeric',minute:'2-digit',second:'2-digit'}).format(new Date())}`;
        return data;
      } catch (_error) {
        liveState.style.color = '#b91c1c';
        liveState.textContent = '● Sin actualizar';
        return null;
      } finally {
        refreshBusy = false;
      }
    }
    function showNotice(message, ok = false) {
      bulkResult.className = `bulk-result show ${ok ? 'ok' : 'warn'}`;
      bulkResult.textContent = message;
    }
    function bindManualButtons() {
      document.querySelectorAll('.manual-message-button').forEach((button) => {
        button.onclick = () => {
          if (button.disabled) return;
          manualAssignmentId.value = button.dataset.assignmentId || '';
          document.getElementById('manualMessageTitle').textContent = `Enviar mensaje a ${button.dataset.workerName || 'auxiliar'}`;
          manualMessageText.value = '';
          manualDialog.showModal();
        };
      });
    }
    async function sendBulk() {
      if (bulkButton.disabled) return;
      bulkButton.disabled = true;
      showNotice('Enviando verificación a quienes todavía no tienen una ventana confirmada...');
      try {
        const response = await fetch(bulkEndpoint,{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});
        const result = await response.json();
        showNotice(`Intentados: ${result.attempted || 0} · enviados: ${result.sent || 0} · fallidos: ${result.failed || 0} · ya abiertos omitidos: ${result.alreadyOpen || 0}.`, !result.failed);
      } catch (_error) {
        showNotice('No fue posible ejecutar el envío de verificación.');
      }
      await refreshMonitor();
    }
    async function sendManual(event) {
      event.preventDefault();
      const assignmentId = manualAssignmentId.value;
      const message = manualMessageText.value.trim();
      if (!assignmentId || !message) return;
      const response = await fetch(manualEndpoint,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({assignmentId,message})});
      const result = await response.json();
      if (!response.ok) {
        showNotice(result.message || 'Meta no permitió enviar el mensaje.');
        await refreshMonitor();
        return;
      }
      showNotice(result.monitorStateWasOpen
        ? 'Meta aceptó el envío con la ventana marcada como abierta.'
        : 'Meta aceptó el intento aunque el monitor la mostraba cerrada. Revisa el monitor y la coincidencia del número.', true);
      manualDialog.close();
      await refreshMonitor();
    }
    async function searchPhone(event) {
      event.preventDefault();
      currentPhoneQuery = phoneSearchInput.value.trim();
      await refreshMonitor({ preservePosition: true });
    }
    async function clearPhoneLookup() {
      currentPhoneQuery = '';
      phoneSearchInput.value = '';
      await refreshMonitor({ preservePosition: true });
    }

    bulkButton?.addEventListener('click', sendBulk);
    manualForm?.addEventListener('submit', sendManual);
    phoneSearchForm?.addEventListener('submit', searchPhone);
    clearPhoneSearch?.addEventListener('click', clearPhoneLookup);
    document.getElementById('cancelManualMessage')?.addEventListener('click', () => manualDialog.close());
    document.querySelectorAll('[data-date]').forEach((cell) => { const value = cell.dataset.date; if (value) cell.textContent = formatBogota(value); });
    document.getElementById('generatedAt').textContent = <%- JSON.stringify(data.generatedAt || '') %> ? formatBogota(<%- JSON.stringify(data.generatedAt || '') %>) : '—';
    bindManualButtons();
    bindChatButtons();
    bindConversationButtons();
    renderPhoneLookup(null);
    window.setInterval(() => refreshMonitor({ preservePosition: true }), 5000);
  </script>
</body>
</html>