PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loginpro_contingency?schema=public

# WhatsApp del bot de reclutamiento
META_VERIFY_TOKEN=pon_este_mismo_valor_en_meta
META_ACCESS_TOKEN=pega_tu_access_token_permanente
META_PHONE_NUMBER_ID=pega_tu_phone_number_id
ADMIN_WHATSAPP_NUMBER=3052982551

APP_BASE_URL=https://tu-dominio-api.com
ADMIN_USER=reclutador
ADMIN_PASS=cambia-esta-clave-ya
DEV_USER=desarrollador
DEV_PASS=cambia-esta-clave-dev
DISPATCH_MODULE_URL=
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=loginpro-recruitment-cv-contingency
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_MODEL=
OPENAI_CV_MODEL=
OPENAI_ATTACHMENT_MODEL=
OPENAI_CONTEXTUAL_REPLY_MODEL=
OPENAI_SUPERVISOR_REPLY_MODEL=
OPENAI_ENABLED=true
OPENAI_TIMEOUT_MS=14000
FF_RESPONSES_EXTRACTOR=true
USE_CONVERSATION_ENGINE=true
OPENAI_MIN_FIELD_CONFIDENCE=0.7
OPENAI_MIN_INTENT_CONFIDENCE=0.7

# Sesiones
SESSION_SECRET=cambia-este-secreto
SESSION_COOKIE_NAME=loginpro.sid

# WhatsApp oficial de Operaciones / Despacho (Meta Cloud API)
# Callback: https://TU_DOMINIO/webhook/dispatch
#
# Plantilla de asignación real:
#   nombre sugerido: dispatch_assignment_confirmation
#   body {{1}} nombre, {{2}} fecha, {{3}} operación, {{4}} dirección, {{5}} hora
#   quick reply 0 = CONFIRMADO
#   quick reply 1 = REPORTAR NOVEDAD
#
# Plantilla separada para abrir/verificar la ventana de 24 horas desde el monitor DEV:
#   nombre sugerido: dispatch_window_check
#   body fijo: "Hola. Este es el canal oficial de Despacho de LoginPro. Para poder enviarte novedades de tu programación por este WhatsApp, confirma la recepción tocando el botón."
#   quick reply 0 = CONFIRMAR CANAL
# Esta plantilla NO confirma la asignación ni reporta novedad; la respuesta solo genera un inbound y abre/renueva la ventana de 24 h.
#
# Plantilla de programación: header DOCUMENT y body {{1}} fecha, {{2}} alcance,
# {{3}} solicitudes, {{4}} estado general, {{5}} auxiliares, {{6}} gestionado por.
DISPATCH_META_GRAPH_VERSION=v23.0
DISPATCH_META_ACCESS_TOKEN=pega_tu_access_token_permanente_de_despacho
DISPATCH_META_PHONE_NUMBER_ID=pega_el_phone_number_id_de_despacho
DISPATCH_META_VERIFY_TOKEN=define_un_token_de_verificacion_exclusivo
DISPATCH_META_APP_SECRET=pega_el_app_secret_de_la_app_de_despacho
DISPATCH_META_ASSIGNMENT_TEMPLATE_NAME=dispatch_assignment_confirmation
DISPATCH_META_WINDOW_CHECK_TEMPLATE_NAME=dispatch_window_check
DISPATCH_META_PROGRAMMING_TEMPLATE_NAME=dispatch_programming_document
DISPATCH_META_TEMPLATE_LANGUAGE=es
DISPATCH_META_TIMEOUT_MS=15000
DISPATCH_META_DUPLICATE_SEND_WINDOW_MS=120000
DISPATCH_PROGRAMMING_WHATSAPP_RECIPIENTS=Operaciones 1|573001112233;Operaciones 2|573004445566

# Línea oficial opcional para el entorno DEV de despacho.
DISPATCH_TEST_META_GRAPH_VERSION=v23.0
DISPATCH_TEST_META_ACCESS_TOKEN=pega_tu_access_token_de_pruebas
DISPATCH_TEST_META_PHONE_NUMBER_ID=pega_el_phone_number_id_de_pruebas
DISPATCH_TEST_META_VERIFY_TOKEN=define_un_token_de_verificacion_de_pruebas
DISPATCH_TEST_META_APP_SECRET=pega_el_app_secret_de_pruebas
DISPATCH_TEST_META_ASSIGNMENT_TEMPLATE_NAME=dispatch_assignment_confirmation
DISPATCH_TEST_META_WINDOW_CHECK_TEMPLATE_NAME=dispatch_window_check
DISPATCH_TEST_META_TEMPLATE_LANGUAGE=es
