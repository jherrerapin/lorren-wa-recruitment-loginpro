+  await mergeConversationMessagePayload(prisma, {
+    messageId: claim.messageId,
+    patch: {
+      consentGateProcessing: {
+        state: 'COMPLETED',
+        decision: claim.decision,
+        completedAt: new Date().toISOString()
+      }
+    }
+  });
+}
