              documentType: true, documentNumber: true,
              age: true, neighborhood: true, locality: true, zone: true, status: true,
              medicalRestrictions: true, transportMode: true,
              interviewNotes: true,
              cvOriginalName: true, cvMimeType: true, cvStorageKey: true,
