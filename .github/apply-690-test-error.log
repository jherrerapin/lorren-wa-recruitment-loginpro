          function updateUrlDate(value){const url=new URL(window.location.href);url.searchParams.delete('date');if(value){url.searchParams.set('fecha',value);url.searchParams.delete('allDates');}else{url.searchParams.delete('fecha');url.searchParams.set('allDates','1');}history.replaceState(null,'',url.toString());syncDateProxy();}
          function normalizeCity(value){return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();}
          function compatibleCitiesForRequest(cityName){const n=normalizeCity(cityName);if(!n)return[];if(n==='siberia')return['siberia','bogota','bogota d.c.','bogota dc','madrid','funza','mosquera'];return[n];}
          function applyAutomaticCityFilter(){const city=qs('#selectedRequestSummary')?.dataset.requestCity||'';const allowed=compatibleCitiesForRequest(city);const cards=qsa('.worker-card');const empty=qs('#autoFilterEmpty');if(!allowed.length){if(empty)empty.hidden=true;return;}let count=0;cards.forEach((card)=>{const workerCities=String(card.dataset.workerCities||'').split('|').map(normalizeCity).filter(Boolean);const vacancyCities=String(card.dataset.vacancyCities||'').split('|').map(normalizeCity).filter(Boolean);const visible=workerCities.some((item)=>allowed.includes(item))||vacancyCities.some((item)=>allowed.includes(item));card.hidden=!visible;if(visible)count+=1;});const text=qs('#cityAutoFilterText');if(text)text.textContent=`Filtro automático aplicado por ciudad: ${city}.`;if(empty)empty.hidden=count>0;}
          function applyDateFilter(){const input=qs('#assignmentDateFilter');const value=currentDateFilter();if(input&&input.value!==value)input.value=value;const label=qs('#assignmentDateLabel');if(label)label.textContent=value||'Todas las fechas';let visible=0;qsa('.request-card[data-request-date]').forEach((card)=>{const match=!value||card.dataset.requestDate===value;card.hidden=!match;if(match)visible+=1;});const empty=qs('#requestDateEmpty');if(empty)empty.hidden=visible>0;const summary=qs('#selectedRequestSummary');const drop=qs('#assignmentDropZone');const mismatch=Boolean(value&&summary?.dataset.requestDate&&summary.dataset.requestDate!==value);summary?.classList.toggle('out-of-date',mismatch);if(drop&&mismatch){drop.classList.add('disabled');drop.dataset.disabled='true';drop.textContent='Selecciona una solicitud de la fecha filtrada antes de asignar auxiliares.';}syncDateProxy();}
          async function replaceBoardFromUrl(urlValue, pushUrl=true){saveBoardPosition();const response=await fetch(urlValue,{headers:{'X-Requested-With':'fetch'}});if(!response.ok)throw new Error('No fue posible actualizar el tablero.');const html=await response.text();const doc=new DOMParser().parseFromString(html,'text/html');const newBoard=doc.querySelector('.board-layout');const board=qs('.board-layout');if(!newBoard||!board)throw new Error('No fue posible leer el tablero actualizado.');board.innerHTML=newBoard.innerHTML;const oldNote=qs('.section-note');const newNote=doc.querySelector('.section-note');if(oldNote&&newNote)oldNote.textContent=newNote.textContent;else if(!oldNote&&newNote){document.querySelector('.hero')?.insertAdjacentElement('afterend',newNote.cloneNode(true));}if(pushUrl)history.replaceState(null,'',urlValue);selectedWorkerIds.clear();bindBoard();restoreBoardPosition();}
