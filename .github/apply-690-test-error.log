            medicalRestrictions: true, transportMode: true,
            interviewNotes: true,
            cvOriginalName: true, cvMimeType: true, cvStorageKey: true, createdAt: true,
            gender: true, botPaused: true, botPausedAt: true, botPauseReason: true,
            currentStep: true,
            lastInboundAt: true,
            lastOutboundAt: true,
            devLastSeenAt: true
