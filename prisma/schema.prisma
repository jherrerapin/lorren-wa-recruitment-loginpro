generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CandidateStatus {
  NUEVO
  REGISTRADO
  VALIDANDO
  APROBADO
  RECHAZADO
  CONTACTADO
  CONTRATADO
}

enum CandidateSourceType {
  UNKNOWN
  META_ADS
  REFERRED
  MANUAL
  OTHER
}

enum DataConsentStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum AppUserRole {
  DEV
  ADMIN
}

enum UserAccessScope {
  ALL
  CITY
  VACANCY
}

enum ConversationStep {
  MENU
  GREETING_SENT
  COLLECTING_DATA
  CONFIRMING_DATA
  ASK_CV
  DONE
  SCHEDULING
  SCHEDULED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  DOCUMENT
  IMAGE
  INTERACTIVE
  UNKNOWN
}

enum ReminderState {
  NONE
  SCHEDULED
  SENT
  CANCELLED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum ExperienceRequirement {
  YES
  NO
  INDIFFERENT
}

enum BookingStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  NO_RESPONSE
  RESCHEDULED
  NO_SHOW
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AttachmentClassification {
  CV_VALID
  CV_IMAGE_ONLY
  ID_DOC
  OTHER
  UNREADABLE
}

enum CitySourceModule {
  RECRUITMENT
  DISPATCH
}

enum DispatchContractType {
  DIRECTO
  CONTRATISTA
}

model City {
  id                 String           @id @default(cuid())
  name               String           @unique
  sourceModule       CitySourceModule @default(RECRUITMENT)
  usedForRecruitment Boolean          @default(false)
  usedForDispatch    Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  operations         Operation[]
  dispatchWorkers    DispatchWorkerCity[]

  @@index([sourceModule])
  @@index([usedForRecruitment])
  @@index([usedForDispatch])
}

model Operation {
  id        String    @id @default(cuid())
  name      String
  cityId    String
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vacancies Vacancy[]

  @@unique([name, cityId])
}

model Vacancy {
  id                     String                @id @default(cuid())
  title                  String
  key                    String                @unique
  role                   String
  roleDescription        String?
  city                   String
  operationAddress       String
  interviewAddress       String?
  requirements           String
  conditions             String
  requiredDocuments      String?
  minAge                 Int?
  maxAge                 Int?
  experienceRequired     ExperienceRequirement @default(INDIFFERENT)
  experienceTimeText     String?
  minExperienceMonths    Int?
  maxExperienceMonths    Int?
  imageData              Bytes?
  imageMimeType          String?
  zoneFilterEnabled      Boolean               @default(false)
  zoneContext            String?
  schedulingEnabled      Boolean               @default(false)
  acceptingApplications  Boolean               @default(true)
  dashboardReviewEnabled Boolean               @default(false)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  operationId            String?
  operation              Operation?            @relation(fields: [operationId], references: [id], onDelete: SetNull)
  candidates             Candidate[]
  campaigns              Campaign[]
  interviewSlots         InterviewSlot[]
  interviewBookings      InterviewBooking[]
  accessUsers            AppUser[]              @relation("AppUserVacancies")
  scopedAccessUsers      AppUser[]              @relation("AppUserScopeVacancy")
  dispatchWorkers        DispatchWorkerVacancy[]
}

model Campaign {
  id                String              @id @default(cuid())
  code              String              @unique
  name              String
  sourceType        CandidateSourceType @default(META_ADS)
  city              String?
  vacancyId         String?
  vacancy           Vacancy?            @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  isActive          Boolean             @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  notes             String?
  createdByUsername String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  candidates        Candidate[]

  @@index([sourceType])
  @@index([city])
  @@index([vacancyId])
  @@index([isActive])
}

model InterviewSlot {
  id              String             @id @default(cuid())
  vacancyId       String
  vacancy         Vacancy            @relation(fields: [vacancyId], references: [id])
  dayOfWeek       Int?
  specificDate    DateTime?
  startTime       String
  maxCandidates   Int                @default(10)
  currentWeekOnly Boolean            @default(false)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  bookings        InterviewBooking[]
}

model InterviewBooking {
  id                   String        @id @default(cuid())
  candidateId          String
  candidate            Candidate     @relation(fields: [candidateId], references: [id])
  vacancyId            String
  vacancy              Vacancy       @relation(fields: [vacancyId], references: [id])
  slotId               String
  slot                 InterviewSlot @relation(fields: [slotId], references: [id])
  scheduledAt          DateTime
  status               BookingStatus @default(SCHEDULED)
  reminderSentAt       DateTime?
  reminderWindowClosed Boolean       @default(false)
  reminderResponse     String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Candidate {
  id                     String              @id @default(cuid())
  phone                  String              @unique
  vacancyId              String?
  vacancy                Vacancy?            @relation(fields: [vacancyId], references: [id])
  campaignId             String?
  campaign               Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sourceType             CandidateSourceType @default(UNKNOWN)
  campaignCodeRaw        String?
  referrerName           String?
  referrerPhone          String?
  metaCtwaClid           String?
  metaAdId               String?
  metaCampaignId         String?
  metaCampaignName       String?
  dataConsentStatus      DataConsentStatus   @default(PENDING)
  dataConsentVersion     String?
  dataConsentText        String?
  dataConsentSource      String?
  dataConsentAcceptedAt  DateTime?
  dataConsentRevokedAt   DateTime?
  dataConsentRecordedBy  String?
  fullName               String?
  documentType           String?
  documentNumber         String?
  age                    Int?
  gender                 Gender              @default(UNKNOWN)
  neighborhood           String?
  locality               String?
  zoneViable             Boolean?
  experienceInfo         String?
  experienceTime         String?
  medicalRestrictions    String?
  transportMode          String?
  rejectionReason        String?
  rejectionDetails       String?
  zone                   String?
  experienceSummary      String?
  availability           String?
  status                 CandidateStatus     @default(NUEVO)
  currentStep            ConversationStep    @default(MENU)
  cvOriginalName         String?
  cvMimeType             String?
  cvStorageKey           String?
  cvData                 Bytes?
  multilineWindowUntil   DateTime?
  multilineBatchVersion  Int                 @default(0)
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  devLastSeenAt          DateTime?
  lastReminderAt         DateTime?
  reminderScheduledFor   DateTime?
  reminderState          ReminderState       @default(NONE)
  botPaused              Boolean             @default(false)
  botPausedAt            DateTime?
  botPausedBy            String?
  botPauseReason         String?
  botResumeMode          String?
  potentialDuplicate     Boolean             @default(false)
  potentialDuplicateAt   DateTime?
  potentialDuplicateNote String?
  interviewNotes         String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  messages               Message[]
  interviewBookings      InterviewBooking[]
  adminEvents            CandidateAdminEvent[]
  attachmentAnalyses     AttachmentAnalysis[]
  dataConsentEvents      CandidateDataConsentEvent[]
  dispatchWorker         DispatchWorker?

  @@index([campaignId])
  @@index([sourceType])
  @@index([dataConsentStatus])
  @@index([status, createdAt])
  @@index([metaAdId])
  @@index([metaCampaignId])
}

model CandidateDataConsentEvent {
  id            String            @id @default(cuid())
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status        DataConsentStatus
  version       String
  text          String
  source        String
  actorUsername String?
  ipAddress     String?
  userAgent     String?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([candidateId, createdAt])
  @@index([status, createdAt])
}

model Message {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id])
  waMessageId String?          @unique
  direction   MessageDirection
  messageType MessageType
  body        String?
  rawPayload  Json?
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
}

model CandidateAdminEvent {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actorRole   String
  eventType   String
  eventLabel  String
  fromValue   String?
  toValue     String?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model AttachmentAnalysis {
  id                  String                   @id @default(cuid())
  candidateId         String
  candidate           Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  originalName        String?
  mimeType            String?
  classification      AttachmentClassification @default(OTHER)
  extractedText       String?
  summary             String?
  confidence          Float?
  analysedAt          DateTime                 @default(now())
  modelUsed           String?
  rawResponse         Json?

  @@index([candidateId])
  @@index([classification])
}

model AppUser {
  id                  String          @id @default(cuid())
  username            String          @unique
  passwordHash        String
  recoveryCodeHash    String?
  role                AppUserRole     @default(ADMIN)
  accessScope         UserAccessScope @default(ALL)
  scopeCity           String?
  scopeVacancyId      String?
  scopeVacancy        Vacancy?        @relation("AppUserScopeVacancy", fields: [scopeVacancyId], references: [id], onDelete: SetNull)
  recoveryPhone       String?
  recoveryEmail       String?
  createdByUsername   String?
  lastPasswordResetAt DateTime?
  canAccessDispatch   Boolean         @default(false)
  canAccessAttendance Boolean         @default(false)
  canAccessStatistics Boolean         @default(false)
  canAccessMetaAds    Boolean         @default(false)
  canAccessCvAnalysis Boolean         @default(false)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  vacancies           Vacancy[]       @relation("AppUserVacancies")

  @@index([role])
  @@index([isActive])
  @@index([accessScope, scopeCity])
  @@index([scopeVacancyId])
  @@index([canAccessDispatch])
  @@index([canAccessAttendance])
  @@index([canAccessStatistics])
  @@index([canAccessMetaAds])
  @@index([canAccessCvAnalysis])
}

model BotKnowledge {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model DevAuditEvent {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String?
  entityLabel   String?
  action        String
  actorUserId   String?
  actorUsername String?
  actorRole     String?
  actorSource   String?
  ipAddress     String?
  forwardedFor String?
  userAgent     String?
  method        String?
  path          String?
  fromValue     Json?
  toValue       Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUsername, createdAt])
  @@index([action, createdAt])
}

model JobQueueItem {
  id          String    @id @default(cuid())
  type        String
  payload     Json?
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([type])
}

model DispatchClient {
  id                String                   @id @default(cuid())
  name              String
  nit               String?
  cityName          String?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  publicToken       String                   @unique
  notes             String?
  isActive          Boolean                  @default(true)
  isTestClient      Boolean                  @default(false)
  createdByUsername String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  operationPoints   DispatchOperationPoint[]
  services          DispatchClientService[]

  @@index([name])
  @@index([cityName])
  @@index([isActive])
  @@index([isTestClient])
}

model DispatchClientService {
  id                String                   @id @default(cuid())
  clientId          String
  client            DispatchClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  isActive          Boolean                  @default(true)
  createdByUsername String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  serviceRequests   DispatchServiceRequest[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([isActive])
}

model DispatchOperationPoint {
  id                          String                   @id @default(cuid())
  clientId                    String
  client                      DispatchClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                        String
  cityName                    String?
  address                     String?
  contactName                 String?
  contactPhone                String?
  publicToken                 String                   @unique
  isActive                    Boolean                  @default(true)
  notes                       String?
  createdByUsername           String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  attendanceEnabled           Boolean                  @default(false)
  attendanceLatitude          Decimal?                 @db.Decimal(10, 7)
  attendanceLongitude         Decimal?                 @db.Decimal(10, 7)
  geofenceRadiusMeters        Int?
  maxLocationAccuracyMeters   Int?
  earlyArrivalWindowMinutes   Int                      @default(60)
  lateToleranceMinutes        Int                      @default(10)
  absenceGraceMinutes         Int                      @default(15)
  attendanceTimezone          String                   @default("America/Bogota")
  attendancePhotoPolicy       String                   @default("RISK_ONLY")
  manualAttendanceAllowed     Boolean                  @default(true)
  serviceRequests             DispatchServiceRequest[]

  @@index([clientId])
  @@index([cityName])
  @@index([isActive])
  @@index([attendanceEnabled])
}

model DispatchWorker {
  id                String                  @id @default(cuid())
  candidateId       String?                 @unique
  candidate         Candidate?              @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  fullName          String
  phone             String?
  documentType      String?
  documentNumber    String?
  residenceCity     String?
  residenceLocality String?
  transportMode     String?
  contractType      DispatchContractType    @default(DIRECTO)
  isTestProfile    Boolean                 @default(false)
  cvOriginalName    String?
  cvMimeType        String?
  cvData            Bytes?
  source            String                  @default("CANDIDATE")
  operationalStatus String                  @default("ACTIVE")
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  cities            DispatchWorkerCity[]
  vacancies         DispatchWorkerVacancy[]
  assignments       DispatchAssignment[]
  incidents         DispatchIncident[]
  devices           DispatchWorkerDevice[]
  activations       DispatchWorkerActivation[]
  portalSessions    DispatchWorkerPortalSession[]

  @@index([candidateId])
  @@index([documentNumber])
  @@index([phone])
  @@index([operationalStatus])
}

model DispatchWorkerImportBatch {
  id                String   @id @default(cuid())
  createdByUsername String
  originalFileName  String?
  status            String   @default("PENDING")
  items             Json
  summary           Json
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdByUsername, status, expiresAt])
  @@index([expiresAt])
}

model DispatchWorkerCity {
  id        String         @id @default(cuid())
  workerId  String
  worker    DispatchWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  cityId    String
  city      City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([workerId, cityId])
  @@index([workerId])
  @@index([cityId])
}

model DispatchWorkerVacancy {
  id        String         @id @default(cuid())
  workerId  String
  worker    DispatchWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  vacancyId String
  vacancy   Vacancy        @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([workerId, vacancyId])
  @@index([workerId])
  @@index([vacancyId])
}

model DispatchServiceRequest {
  id                        String                  @id @default(cuid())
  clientName                String
  operationPointName        String?
  cityName                  String?
  address                   String?
  serviceDate               DateTime
  startTime                 String?
  endTime                   String?
  requiredWorkers           Int                     @default(1)
  status                    String                  @default("PENDING_ASSIGNMENT")
  notes                     String?
  createdByUsername         String?
  operationPointId          String?
  operationPoint            DispatchOperationPoint? @relation(fields: [operationPointId], references: [id], onDelete: SetNull)
  serviceId                 String?
  service                   DispatchClientService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName               String?
  requestedByName           String?
  requestedByPhone          String?
  requestedByEmail          String?
  completionEmailSentAt     DateTime?
  completionEmailTo         String?
  completionEmailProviderId String?
  completionEmailLastError  String?
  source                    String                  @default("INTERNAL")
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  assignments               DispatchAssignment[]
  incidents                 DispatchIncident[]

  @@index([serviceDate])
  @@index([status])
  @@index([cityName])
  @@index([operationPointId])
  @@index([serviceId])
  @@index([source])
  @@index([completionEmailSentAt])
}

model DispatchAssignment {
  id                    String                    @id @default(cuid())
  serviceRequestId      String
  serviceRequest        DispatchServiceRequest    @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  workerId              String
  worker                DispatchWorker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status                String                    @default("ASSIGNED")
  notes                 String?
  createdByUsername     String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  incidents             DispatchIncident[]
  whatsappConfirmations DispatchWhatsappConfirmation[]
  attendanceSession     DispatchAttendanceSession?

  @@unique([serviceRequestId, workerId])
  @@index([serviceRequestId])
  @@index([workerId])
  @@index([status])
}

model DispatchWorkerDevice {
  id                   String                   @id @default(cuid())
  workerId             String
  worker               DispatchWorker           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  installationIdHash   String
  authorizationType    String                   @default("PRIMARY")
  status               String                   @default("ACTIVE")
  authorizedFrom       DateTime                 @default(now())
  authorizedUntil      DateTime?
  lastSeenAt           DateTime?
  revokedAt            DateTime?
  revokedByUsername    String?
  revocationReason     String?
  userAgent            String?
  platform             String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  attendanceMarks      DispatchAttendanceMark[]
  consumedActivations  DispatchWorkerActivation[]
  portalSessions       DispatchWorkerPortalSession[]

  @@unique([workerId, installationIdHash])
  @@index([installationIdHash, status])
  @@index([workerId, status])
  @@index([authorizedUntil])
}

model DispatchWorkerActivation {
  id                   String                @id @default(cuid())
  workerId             String
  worker               DispatchWorker        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  purpose              String
  tokenHash            String                @unique
  status               String                @default("PENDING")
  expiresAt            DateTime
  consumedAt           DateTime?
  consumedByDeviceId   String?
  consumedByDevice     DispatchWorkerDevice? @relation(fields: [consumedByDeviceId], references: [id], onDelete: SetNull)
  revokedAt            DateTime?
  revokedByUsername    String?
  revocationReason     String?
  createdByUsername    String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  portalSession         DispatchWorkerPortalSession?

  @@index([workerId, purpose, status])
  @@index([status, expiresAt])
  @@index([consumedByDeviceId])
  @@index([workerId, createdAt])
}

model DispatchWorkerPortalSession {
  id                  String                   @id @default(cuid())
  workerId            String
  worker              DispatchWorker           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  workerDeviceId      String
  workerDevice        DispatchWorkerDevice      @relation(fields: [workerDeviceId], references: [id], onDelete: Restrict)
  activationId        String                   @unique
  activation          DispatchWorkerActivation @relation(fields: [activationId], references: [id], onDelete: Restrict)
  sessionTokenHash    String                   @unique
  status              String                   @default("ACTIVE")
  issuedAt            DateTime                 @default(now())
  expiresAt           DateTime
  lastSeenAt          DateTime?
  revokedAt           DateTime?
  revokedByUsername   String?
  revocationReason    String?
  ipAddress           String?
  userAgent           String?
  platform            String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([workerId, status, expiresAt])
  @@index([workerDeviceId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([lastSeenAt])
}

model DispatchAttendanceSession {
  id                   String                     @id @default(cuid())
  assignmentId         String                     @unique
  assignment           DispatchAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  expectedStartAt      DateTime
  expectedEndAt        DateTime?
  attendanceStatus     String                     @default("PENDING")
  validationStatus     String                     @default("PENDING")
  punctualityStatus    String?
  riskScore            Int                        @default(0)
  riskFlags            Json?
  arrivalReportedAt    DateTime?
  arrivalValidatedAt   DateTime?
  departureReportedAt  DateTime?
  departureValidatedAt DateTime?
  workedMinutes        Int?
  source               String                     @default("SYSTEM")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  marks                DispatchAttendanceMark[]
  reviews              DispatchAttendanceReview[]

  @@index([expectedStartAt])
  @@index([attendanceStatus, expectedStartAt])
  @@index([validationStatus, expectedStartAt])
}

model DispatchAttendanceMark {
  id                    String                    @id @default(cuid())
  attendanceSessionId   String
  attendanceSession     DispatchAttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  workerDeviceId        String?
  workerDevice          DispatchWorkerDevice?     @relation(fields: [workerDeviceId], references: [id], onDelete: SetNull)
  markType              String
  idempotencyKey        String                    @unique
  serverReceivedAt      DateTime                  @default(now())
  clientCapturedAt      DateTime?
  latitude              Decimal?                  @db.Decimal(10, 7)
  longitude             Decimal?                  @db.Decimal(10, 7)
  accuracyMeters        Decimal?                  @db.Decimal(10, 2)
  distanceToPointMeters Decimal?                  @db.Decimal(12, 2)
  insideGeofence        Boolean?
  installationIdHash    String?
  ipAddress             String?
  userAgent             String?
  evidenceStorageKey    String?
  evidenceMimeType      String?
  decision              String                    @default("PENDING")
  riskScore             Int                       @default(0)
  riskFlags             Json?
  createdAt             DateTime                  @default(now())

  @@index([attendanceSessionId, markType, serverReceivedAt])
  @@index([workerDeviceId, serverReceivedAt])
  @@index([decision, serverReceivedAt])
}

model DispatchAttendanceReview {
  id                       String                    @id @default(cuid())
  attendanceSessionId      String
  attendanceSession        DispatchAttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  action                   String
  previousAttendanceStatus String?
  newAttendanceStatus      String?
  previousValidationStatus String?
  newValidationStatus      String?
  reason                   String
  notes                    String?
  actorUsername            String
  actorRole                String?
  metadata                 Json?
  createdAt                DateTime                  @default(now())

  @@index([attendanceSessionId, createdAt])
  @@index([actorUsername, createdAt])
  @@index([action, createdAt])
}

model DispatchWhatsappConfirmation {
  id                String             @id @default(cuid())
  assignmentId      String
  assignment        DispatchAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  serviceRequestId  String?
  phone             String?
  chatId            String?
  providerMessageId       String?
  confirmationMessageId String?
  confirmationReceivedAt DateTime?
  status                  String             @default("PENDING")
  expiresAt               DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([assignmentId])
  @@index([phone, status, expiresAt])
  @@index([chatId, status, expiresAt])
  @@index([providerMessageId])
  @@index([status, confirmationReceivedAt], map: "DispatchWaConfirmation_reply_evidence_idx")
}

model DispatchIncident {
  id                 String                 @id @default(cuid())
  serviceRequestId   String
  serviceRequest     DispatchServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  assignmentId       String?
  assignment         DispatchAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workerId           String?
  worker             DispatchWorker?        @relation(fields: [workerId], references: [id], onDelete: SetNull)
  type               String
  status             String                 @default("OPEN")
  description        String
  reportedBy         String?
  resolutionNote     String?
  createdByUsername  String?
  resolvedByUsername String?
  resolvedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([serviceRequestId])
  @@index([assignmentId])
  @@index([workerId])
  @@index([status])
}

model MetaAdAccount {
  id           String   @id @default(cuid())
  accountId    String   @unique
  name         String?
  currency     String?
  timezoneName String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MetaCampaignSnapshot {
  id               String   @id @default(cuid())
  date             DateTime
  metaCampaignId   String
  metaCampaignName String?
  spend            Decimal  @default(0) @db.Decimal(14, 4)
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0)
  inlineLinkClicks Int      @default(0)
  ctr              Decimal  @default(0) @db.Decimal(10, 4)
  cpc              Decimal  @default(0) @db.Decimal(14, 4)
  cpm              Decimal  @default(0) @db.Decimal(14, 4)
  rawActions       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, metaCampaignId])
  @@index([date])
  @@index([metaCampaignId])
  @@index([date, metaCampaignId])
}

model MetaAdSnapshot {
  id               String   @id @default(cuid())
  date             DateTime
  metaCampaignId   String?
  metaCampaignName String?
  metaAdsetId      String?
  metaAdsetName    String?
  metaAdId         String
  metaAdName       String?
  spend            Decimal  @default(0) @db.Decimal(14, 4)
  impressions      Int      @default(0)
  reach            Int      @default(0)
  clicks           Int      @default(0)
  inlineLinkClicks Int      @default(0)
  ctr              Decimal  @default(0) @db.Decimal(10, 4)
  cpc              Decimal  @default(0) @db.Decimal(14, 4)
  cpm              Decimal  @default(0) @db.Decimal(14, 4)
  rawActions       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, metaAdId])
  @@index([date])
  @@index([metaCampaignId])
  @@index([metaAdId])
  @@index([date, metaCampaignId])
  @@index([date, metaAdId])
}
