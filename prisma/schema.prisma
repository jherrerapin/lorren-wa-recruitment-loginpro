generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CandidateStatus {
  NUEVO
  REGISTRADO
  VALIDANDO
  APROBADO
  RECHAZADO
  CONTACTADO
  CONTRATADO
}

enum AppUserRole {
  DEV
  ADMIN
}

enum UserAccessScope {
  ALL
  CITY
  VACANCY
}

enum ConversationStep {
  MENU
  GREETING_SENT
  COLLECTING_DATA
  CONFIRMING_DATA
  ASK_CV
  DONE
  SCHEDULING
  SCHEDULED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  DOCUMENT
  IMAGE
  INTERACTIVE
  UNKNOWN
}

enum ReminderState {
  NONE
  SCHEDULED
  SENT
  CANCELLED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum ExperienceRequirement {
  YES
  NO
  INDIFFERENT
}

enum BookingStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  NO_RESPONSE
  RESCHEDULED
  NO_SHOW
  CANCELLED
}



enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AttachmentClassification {
  CV_VALID
  CV_IMAGE_ONLY
  ID_DOC
  OTHER
  UNREADABLE
}

enum CitySourceModule {
  RECRUITMENT
  DISPATCH
}
model City {
  id                 String           @id @default(cuid())
  name               String           @unique
  sourceModule       CitySourceModule @default(RECRUITMENT)
  usedForRecruitment Boolean          @default(false)
  usedForDispatch    Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  operations         Operation[]
  dispatchWorkers    DispatchWorkerCity[]

  @@index([sourceModule])
  @@index([usedForRecruitment])
  @@index([usedForDispatch])
}

model Operation {
  id        String    @id @default(cuid())
  name      String
  cityId    String
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vacancies Vacancy[]
  @@unique([name, cityId])
}

model Vacancy {
  id                    String                @id @default(cuid())
  title                 String
  key                   String                @unique
  role                  String
  roleDescription       String?
  city                  String
  operationAddress      String
  interviewAddress      String?
  requirements          String
  conditions            String
  requiredDocuments     String?
  minAge                Int?
  maxAge                Int?
  experienceRequired    ExperienceRequirement @default(INDIFFERENT)
  experienceTimeText    String?
  minExperienceMonths   Int?
  maxExperienceMonths   Int?
  imageData             Bytes?
  imageMimeType         String?
  zoneFilterEnabled     Boolean               @default(false)
  zoneContext           String?
  schedulingEnabled     Boolean               @default(false)
  acceptingApplications Boolean               @default(true)
  dashboardReviewEnabled Boolean               @default(false)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  operationId           String?
  operation             Operation?            @relation(fields: [operationId], references: [id], onDelete: SetNull)
  candidates            Candidate[]
  interviewSlots        InterviewSlot[]
  interviewBookings     InterviewBooking[]
  accessUsers           AppUser[]
  dispatchWorkers       DispatchWorkerVacancy[]
}

model InterviewSlot {
  id            String             @id @default(cuid())
  vacancyId     String
  vacancy       Vacancy            @relation(fields: [vacancyId], references: [id])
  dayOfWeek     Int?
  specificDate  DateTime?
  startTime     String
  maxCandidates Int                @default(10)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  bookings      InterviewBooking[]
}

model InterviewBooking {
  id                   String        @id @default(cuid())
  candidateId          String
  candidate            Candidate     @relation(fields: [candidateId], references: [id])
  vacancyId            String
  vacancy              Vacancy       @relation(fields: [vacancyId], references: [id])
  slotId               String
  slot                 InterviewSlot @relation(fields: [slotId], references: [id])
  scheduledAt          DateTime
  status               BookingStatus @default(SCHEDULED)
  reminderSentAt       DateTime?
  reminderWindowClosed Boolean       @default(false)
  reminderResponse     String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Candidate {
  id                     String            @id @default(cuid())
  phone                  String            @unique
  vacancyId              String?
  vacancy                Vacancy?          @relation(fields: [vacancyId], references: [id])
  fullName               String?
  documentType           String?
  documentNumber         String?
  age                    Int?
  gender                 Gender            @default(UNKNOWN)
  neighborhood           String?
  locality               String?
  zoneViable             Boolean?
  experienceInfo         String?
  experienceTime         String?
  medicalRestrictions    String?
  transportMode          String?
  rejectionReason        String?
  rejectionDetails       String?
  zone                   String?
  experienceSummary      String?
  availability           String?
  status                 CandidateStatus   @default(NUEVO)
  currentStep            ConversationStep  @default(MENU)
  cvOriginalName         String?
  cvMimeType             String?
  cvStorageKey           String?
  cvData                 Bytes?
  multilineWindowUntil   DateTime?
  multilineBatchVersion  Int               @default(0)
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  devLastSeenAt          DateTime?
  lastReminderAt         DateTime?
  reminderScheduledFor   DateTime?
  reminderState          ReminderState     @default(NONE)
  botPaused              Boolean           @default(false)
  botPausedAt            DateTime?
  botPausedBy            String?
  botPauseReason         String?
  botResumeMode          String?
  potentialDuplicate     Boolean           @default(false)
  potentialDuplicateAt   DateTime?
  potentialDuplicateNote String?
  interviewNotes         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  messages               Message[]
  interviewBookings      InterviewBooking[]
  adminEvents            CandidateAdminEvent[]
  attachmentAnalyses     AttachmentAnalysis[]
  dispatchWorker         DispatchWorker?
}

model Message {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id])
  waMessageId String?          @unique
  direction   MessageDirection
  messageType MessageType
  body        String?
  rawPayload  Json?
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
}

model CandidateAdminEvent {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actorRole   String
  eventType   String
  eventLabel  String
  fromValue   String?
  toValue     String?
  note        String?
  createdAt   DateTime  @default(now())
  @@index([candidateId, createdAt])
}




model DispatchClient {
  id                String                   @id @default(cuid())
  name              String
  nit               String?
  cityName          String?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  publicToken       String                   @unique
  notes             String?
  isActive          Boolean                  @default(true)
  createdByUsername String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  operationPoints   DispatchOperationPoint[]
  services          DispatchClientService[]
  @@index([name])
  @@index([cityName])
  @@index([isActive])
}

model DispatchClientService {
  id                String                   @id @default(cuid())
  clientId          String
  client            DispatchClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  isActive          Boolean                  @default(true)
  createdByUsername String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  serviceRequests   DispatchServiceRequest[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([isActive])
}

model DispatchOperationPoint {
  id                String                   @id @default(cuid())
  clientId          String
  client            DispatchClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  cityName          String?
  address           String?
  contactName       String?
  contactPhone      String?
  publicToken       String                   @unique
  isActive          Boolean                  @default(true)
  notes             String?
  createdByUsername String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  serviceRequests   DispatchServiceRequest[]
  @@index([clientId])
  @@index([cityName])
  @@index([isActive])
}

model DispatchWorker {
  id                String                 @id @default(cuid())
  candidateId       String?                @unique
  candidate         Candidate?             @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  fullName          String
  phone             String?
  documentType      String?
  documentNumber    String?
  residenceCity     String?
  residenceLocality String?
  transportMode     String?
  cvOriginalName    String?
  cvMimeType        String?
  cvData            Bytes?

  source            String                 @default("CANDIDATE")
  operationalStatus String                 @default("ACTIVE")
  notes             String?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  cities            DispatchWorkerCity[]
  vacancies         DispatchWorkerVacancy[]
  assignments       DispatchAssignment[]
  incidents         DispatchIncident[]

  @@index([candidateId])
  @@index([documentNumber])
  @@index([phone])
  @@index([operationalStatus])
}

model DispatchServiceRequest {
  id                       String               @id @default(cuid())
  clientName               String
  operationPointName       String?
  cityName                 String?
  address                  String?
  serviceDate              DateTime
  startTime                String?
  endTime                  String?
  requiredWorkers          Int                  @default(1)
  status                   String               @default("PENDING_ASSIGNMENT")
  notes                    String?
  createdByUsername        String?
  operationPointId         String?
  operationPoint           DispatchOperationPoint? @relation(fields: [operationPointId], references: [id], onDelete: SetNull)
  serviceId                String?
  service                  DispatchClientService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName              String?
  requestedByName          String?
  requestedByPhone         String?
  requestedByEmail         String?
  completionEmailSentAt    DateTime?
  completionEmailTo        String?
  completionEmailProviderId String?
  completionEmailLastError String?
  source                   String               @default("INTERNAL")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  assignments              DispatchAssignment[]
  incidents                DispatchIncident[]

  @@index([serviceDate])
  @@index([status])
  @@index([cityName])
  @@index([operationPointId])
  @@index([serviceId])
  @@index([source])
  @@index([completionEmailSentAt])
}

model DispatchAssignment {
  id                String                 @id @default(cuid())
  serviceRequestId  String
  serviceRequest    DispatchServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  workerId          String
  worker            DispatchWorker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  status            String                 @default("ASSIGNED")
  notes             String?
  createdByUsername String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  incidents         DispatchIncident[]

  @@unique([serviceRequestId, workerId])
  @@index([serviceRequestId])
  @@index([workerId])
  @@index([status])
}

model DispatchIncident {
  id                String                  @id @default(cuid())
  serviceRequestId  String
  serviceRequest    DispatchServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  assignmentId      String?
  assignment        DispatchAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workerId          String?
  worker            DispatchWorker?          @relation(fields: [workerId], references: [id], onDelete: SetNull)
  type              String
  status            String                  @default("OPEN")
  description       String
  reportedBy        String?
  resolutionNote    String?
  createdByUsername String?
  resolvedByUsername String?
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([serviceRequestId])
  @@index([assignmentId])
  @@index([workerId])
  @@index([status])
  @@index([createdAt])
}

model DispatchMessageTemplate {
  id                String   @id @default(cuid())
  key               String   @unique
  content           String
  createdByUsername String?
  updatedByUsername String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([key])
}

model DispatchWorkerCity {
  id        String         @id @default(cuid())
  workerId  String
  worker    DispatchWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  cityId    String
  city      City           @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt DateTime       @default(now())

  @@unique([workerId, cityId])
  @@index([cityId])
}

model DispatchWorkerVacancy {
  id        String         @id @default(cuid())
  workerId  String
  worker    DispatchWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  vacancyId String
  vacancy   Vacancy        @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  createdAt DateTime       @default(now())

  @@unique([workerId, vacancyId])
  @@index([vacancyId])
}
model AppUser {
  id                  String          @id @default(cuid())
  username            String          @unique
  passwordHash        String
  recoveryCodeHash    String?
  role                AppUserRole     @default(ADMIN)
  accessScope         UserAccessScope @default(ALL)
  scopeCity           String?
  scopeVacancyId      String?
  scopeVacancy        Vacancy?        @relation(fields: [scopeVacancyId], references: [id], onDelete: SetNull)
  recoveryPhone       String?
  recoveryEmail       String?
  createdByUsername   String?
  lastPasswordResetAt DateTime?
  isActive            Boolean         @default(true)
  canAccessDispatch   Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  @@index([accessScope, scopeCity])
  @@index([scopeVacancyId])
  @@index([canAccessDispatch])
}



model DevAuditEvent {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String?
  entityLabel   String?
  action        String
  actorUserId   String?
  actorUsername String?
  actorRole     String?
  actorSource   String?
  ipAddress     String?
  forwardedFor  String?
  userAgent     String?
  method        String?
  path          String?
  fromValue     Json?
  toValue       Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUsername, createdAt])
  @@index([action, createdAt])
}

model JobQueue {
  id          String   @id @default(cuid())
  type        String
  payload     Json
  dedupeKey   String?  @map("dedupe_key")
  runAt       DateTime @map("run_at")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  status      JobStatus @default(PENDING)
  lastError   String?  @map("last_error")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@unique([type, dedupeKey])
}

model AttachmentAnalysis {
  id             String                   @id @default(cuid())
  candidateId    String
  candidate      Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messageId      String?
  classification AttachmentClassification
  confidence     Float
  evidence       String?
  mimeType       String?
  fileName       String?
  createdAt      DateTime                 @default(now())

  @@index([candidateId, createdAt])
}

model BotKnowledge {
  id          String   @id @default(cuid())
  scope       String   @default("GLOBAL")
  content     String
  tags        String?
  vacancyId   String?
  candidateId String?
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, isActive, updatedAt])
  @@index([vacancyId, isActive])
  @@index([candidateId, isActive])
}